{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windows-deployment-builder.local/schemas/applications-result.v2.json",
  "title": "Windows Deployment Builder application stage result",
  "description": "Written by ApplicationEngine.ps1 to C:\\ProgramData\\WindowsDeploymentBuilder\\Applications\\result.json when the stage reaches a final status. Every selected package appears in \"packages\" with a terminal status, or \"Pending\" when it was not attempted. Schema 2 (engine 1.2.0) adds each operation's lifecycle, failure class and attempt history, and \"outstanding\": the work the deployment recovery tool can retry or resume.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "status",
    "reason",
    "engineVersion",
    "finishedUtc",
    "starts",
    "reboots",
    "bootstrap",
    "counts",
    "packages",
    "additionalSoftware",
    "followUp",
    "outstanding",
    "retryPolicy",
    "recoveries",
    "stateRecoveredFrom"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "stage": {
      "const": "applications"
    },
    "status": {
      "enum": [
        "Succeeded",
        "CompletedWithFollowUp",
        "CompletedWithFailures",
        "Failed",
        "Offline"
      ],
      "description": "The completion marker state\\applications.done is written for Succeeded, CompletedWithFollowUp and CompletedWithFailures."
    },
    "reason": {
      "type": "string"
    },
    "engineVersion": {
      "type": "string"
    },
    "computer": {
      "type": [
        "string",
        "null"
      ]
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedUtc": {
      "type": [
        "string",
        "null"
      ]
    },
    "finishedUtc": {
      "type": "string"
    },
    "starts": {
      "type": "integer",
      "minimum": 0
    },
    "reboots": {
      "type": "integer",
      "minimum": 0
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "winGetVersion",
        "message"
      ],
      "properties": {
        "status": {
          "enum": [
            "NotRun",
            "Healthy",
            "Repaired",
            "NeedsRepair",
            "Unsupported",
            "Failed"
          ]
        },
        "method": {
          "type": "string"
        },
        "winGetVersion": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "succeeded",
        "alreadyInstalled",
        "skipped",
        "skippedByUser",
        "requiresInteraction",
        "requiresRestart",
        "failed",
        "unavailable",
        "pending"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "alreadyInstalled": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "skippedByUser": {
          "type": "integer",
          "minimum": 0
        },
        "requiresInteraction": {
          "type": "integer",
          "minimum": 0
        },
        "requiresRestart": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "packageIdentifier",
          "source",
          "status",
          "attempts",
          "exitCode",
          "message",
          "timestampUtc",
          "operationId",
          "lifecycle",
          "failureClass",
          "retryable",
          "detection",
          "nextAttemptUtc",
          "waitingFor",
          "totalAttempts",
          "manualRetries",
          "history"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "packageIdentifier": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "installerExitCode": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Pending",
              "Installing",
              "Succeeded",
              "AlreadyInstalled",
              "Skipped",
              "SkippedByUser",
              "RequiresInteraction",
              "RequiresRestart",
              "Failed",
              "Unavailable"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "exitCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string"
          },
          "operationId": {
            "type": "string",
            "pattern": "^(app|additional|settings):"
          },
          "lifecycle": {
            "enum": [
              "Pending",
              "Running",
              "Succeeded",
              "AlreadySatisfied",
              "FailedRetryable",
              "FailedPermanent",
              "WaitingForNetwork",
              "WaitingForReboot",
              "ManualActionRequired",
              "SkippedByUser",
              "BlockedByDependency"
            ]
          },
          "failureClass": {
            "enum": [
              "",
              "Success",
              "Restart",
              "Network",
              "Transient",
              "Timeout",
              "Resource",
              "Unknown",
              "Permanent",
              "Integrity",
              "Policy",
              "User",
              "Manual",
              "Elevation",
              "Dependency",
              "Budget",
              "Interrupted"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "detection": {
            "enum": [
              "",
              "Installed",
              "InstalledRequiresRestart",
              "NotInstalled",
              "Unconfirmed",
              "Unknown"
            ]
          },
          "nextAttemptUtc": {
            "type": [
              "string",
              "null"
            ]
          },
          "waitingFor": {
            "type": "string"
          },
          "totalAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "manualRetries": {
            "type": "integer",
            "minimum": 0
          },
          "history": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "trigger",
                "attempt",
                "result",
                "class",
                "countsTowardLimit",
                "nextAction",
                "message"
              ]
            }
          }
        }
      }
    },
    "additionalSoftware": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "attempts",
          "exitCode",
          "message",
          "timestampUtc",
          "operationId",
          "lifecycle",
          "failureClass",
          "retryable",
          "detection",
          "nextAttemptUtc",
          "waitingFor",
          "totalAttempts",
          "manualRetries",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Pending",
              "Installing",
              "Succeeded",
              "AlreadyInstalled",
              "Skipped",
              "SkippedByUser",
              "RequiresInteraction",
              "RequiresRestart",
              "Failed",
              "Unavailable"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "exitCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string"
          },
          "operationId": {
            "type": "string",
            "pattern": "^(app|additional|settings):"
          },
          "lifecycle": {
            "enum": [
              "Pending",
              "Running",
              "Succeeded",
              "AlreadySatisfied",
              "FailedRetryable",
              "FailedPermanent",
              "WaitingForNetwork",
              "WaitingForReboot",
              "ManualActionRequired",
              "SkippedByUser",
              "BlockedByDependency"
            ]
          },
          "failureClass": {
            "enum": [
              "",
              "Success",
              "Restart",
              "Network",
              "Transient",
              "Timeout",
              "Resource",
              "Unknown",
              "Permanent",
              "Integrity",
              "Policy",
              "User",
              "Manual",
              "Elevation",
              "Dependency",
              "Budget",
              "Interrupted"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "detection": {
            "enum": [
              "",
              "Installed",
              "InstalledRequiresRestart",
              "NotInstalled",
              "Unconfirmed",
              "Unknown"
            ]
          },
          "nextAttemptUtc": {
            "type": [
              "string",
              "null"
            ]
          },
          "waitingFor": {
            "type": "string"
          },
          "totalAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "manualRetries": {
            "type": "integer",
            "minimum": 0
          },
          "history": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "trigger",
                "attempt",
                "result",
                "class",
                "countsTowardLimit",
                "nextAction",
                "message"
              ]
            }
          }
        }
      }
    },
    "followUp": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outstanding": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "name",
          "status",
          "lifecycle",
          "failureClass",
          "retryable",
          "message"
        ],
        "properties": {
          "operationId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Pending",
              "Installing",
              "Succeeded",
              "AlreadyInstalled",
              "Skipped",
              "SkippedByUser",
              "RequiresInteraction",
              "RequiresRestart",
              "Failed",
              "Unavailable"
            ]
          },
          "lifecycle": {
            "enum": [
              "Pending",
              "Running",
              "Succeeded",
              "AlreadySatisfied",
              "FailedRetryable",
              "FailedPermanent",
              "WaitingForNetwork",
              "WaitingForReboot",
              "ManualActionRequired",
              "SkippedByUser",
              "BlockedByDependency"
            ]
          },
          "failureClass": {
            "enum": [
              "",
              "Success",
              "Restart",
              "Network",
              "Transient",
              "Timeout",
              "Resource",
              "Unknown",
              "Permanent",
              "Integrity",
              "Policy",
              "User",
              "Manual",
              "Elevation",
              "Dependency",
              "Budget",
              "Interrupted"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic",
        "maxAttempts",
        "baseDelaySeconds",
        "maxDelaySeconds",
        "jitterRatio",
        "continueAfterFailure",
        "maxNetworkDeferrals"
      ],
      "properties": {
        "automatic": {
          "type": "boolean"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "baseDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "maxDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "jitterRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "continueAfterFailure": {
          "type": "boolean"
        },
        "maxNetworkDeferrals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        }
      }
    },
    "recoveries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stateRecoveredFrom": {
      "enum": [
        "",
        "backup",
        "rebuilt"
      ]
    },
    "settings": {
      "type": "array",
      "description": "Phase 6 (engine 1.3.0), only when settings are restored: one operation per settings adapter (operationId settings:<adapter>).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "restoreOutcome",
          "attempts",
          "message",
          "timestampUtc",
          "items",
          "followUps",
          "operationId",
          "lifecycle",
          "failureClass",
          "retryable",
          "detection",
          "nextAttemptUtc",
          "waitingFor",
          "totalAttempts",
          "manualRetries",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Pending",
              "Installing",
              "Succeeded",
              "AlreadyInstalled",
              "Skipped",
              "SkippedByUser",
              "RequiresInteraction",
              "RequiresRestart",
              "Failed",
              "Unavailable"
            ]
          },
          "restoreOutcome": {
            "enum": [
              "InstalledSuccessfully",
              "AlreadyInstalled",
              "ConfigurationRestored",
              "ConfigurationPartiallyRestored",
              "KeptExisting",
              "ManualActionRequired",
              "WaitingForUser",
              "WaitingForBackup",
              "BlockedByDependency",
              "Unsupported",
              "Failed",
              "SkippedByUser",
              "Pending"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "logical",
                "action",
                "detail"
              ]
            }
          },
          "followUps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operationId": {
            "type": "string",
            "pattern": "^(app|additional|settings):"
          },
          "lifecycle": {
            "enum": [
              "Pending",
              "Running",
              "Succeeded",
              "AlreadySatisfied",
              "FailedRetryable",
              "FailedPermanent",
              "WaitingForNetwork",
              "WaitingForReboot",
              "ManualActionRequired",
              "SkippedByUser",
              "BlockedByDependency"
            ]
          },
          "failureClass": {
            "enum": [
              "",
              "Success",
              "Restart",
              "Network",
              "Transient",
              "Timeout",
              "Resource",
              "Unknown",
              "Permanent",
              "Integrity",
              "Policy",
              "User",
              "Manual",
              "Elevation",
              "Dependency",
              "Budget",
              "Interrupted"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "detection": {
            "enum": [
              "",
              "Installed",
              "InstalledRequiresRestart",
              "NotInstalled",
              "Unconfirmed",
              "Unknown"
            ]
          },
          "nextAttemptUtc": {
            "type": [
              "string",
              "null"
            ]
          },
          "waitingFor": {
            "type": "string"
          },
          "totalAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "manualRetries": {
            "type": "integer",
            "minimum": 0
          },
          "history": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "trigger",
                "attempt",
                "result",
                "class",
                "countsTowardLimit",
                "nextAction",
                "message"
              ]
            }
          }
        }
      }
    },
    "settingsBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "message"
      ],
      "properties": {
        "status": {
          "enum": [
            "NotSearched",
            "Staged",
            "NotFound",
            "Invalid",
            "LibraryMissing"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
