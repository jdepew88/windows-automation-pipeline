        },
        {
          "PackageIdentifier": "SumatraPDF.SumatraPDF"
        },
        {
          "PackageIdentifier": "DuongDieuPhap.ImageGlass"
        },
        {
          "PackageIdentifier": "Microsoft.VCRedist.2015+.x64"
        },
        {
          "PackageIdentifier": "Microsoft.VCRedist.2015+.x86"
        }
      ],
      "SourceDetails": {
        "Name": "winget",
        "Identifier": "Microsoft.Winget.Source_8wekyb3d8bbwe",
        "Argument": "https://cdn.winget.microsoft.com/cache",
        "Type": "Microsoft.PreIndexed.Package"
      }
    }
  ]
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\common\\DeploymentCommon.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Windows Deployment Builder - shared functions of the deployment orchestrator.

.DESCRIPTION
    Dot-sourced by Stage-Deployment.ps1, Initialize-Deployment.ps1, DeploymentOrchestrator.ps1,
    Show-DeploymentStatus.ps1, Resume-Deployment.ps1 and Complete-Deployment.ps1. Defines functions
    only; it never acts by itself.

    Everything that touches the system (scheduled tasks, ACLs, processes, shortcuts, the event log,
    time, identity) is a small adapter function, so tests can replace it with a simulation.

    The orchestrator coordinates; it does not install. Windows Update and applications are
    installed by the existing engines (WindowsUpdateEngine.ps1 as SYSTEM, ApplicationEngine.ps1 as
    the signed-in user), each from its own scheduled task. The orchestrator launches each engine's
    installer once, follows their real result files and writes one deployment status and report.

    Phase 5 (orchestrator 1.1.0): state files are replaced atomically with a backup of the last good
    copy (Read-WddDeploymentState falls back to it and never mistakes a damaged state for "no
    deployment"), and every snapshot carries a machine-readable outcome with a stable exit code
    (Get-WddDeploymentOutcome) for DeploymentRecovery.ps1 and later health reporting.

    Orchestrator 1.2.0 (deployment reliability):
      - Every stage in a snapshot says what it is doing in words (activity), why it waits
        (waitingReason), when its engine last reported progress (lastActivityUtc) and how it stands
        (condition: active, waiting, idle, blocked, finished). A stage with no progress for longer
        than its limit is flagged (stale); the limit is longer for Windows Update downloads and
        installations, and never applies while Windows itself is still servicing updates.
      - The activity feed &lt;dataRoot&gt;\\Deployment\\activity.jsonl: one timestamped JSON line per event
        (restarts, recoveries, stage changes, retries and failures reported by the engines).
#&gt;

Set-StrictMode -Version 2.0

$script:DeployVersion = '1.3.0'
$script:DeployStateVersion = 2
$script:EventSource = 'WindowsDeploymentBuilder'
$script:ManifestFormat = 'windows-deployment-builder/deployment-manifest'
$script:MutexName = 'Global\\WindowsDeploymentBuilder-Deployment'
$script:FinalStageStatuses = @('Succeeded', 'CompletedWithFollowUp', 'CompletedWithFailures', 'Failed', 'Offline')
$script:WddLogFile = $null

# ------------------------------------------------------------------------------------------------
# Adapters (replaced by the scenario tests)
# ------------------------------------------------------------------------------------------------

function Get-WddNow { [DateTime]::UtcNow }

function Get-WddIdentity {
    $id = [Security.Principal.WindowsIdentity]::GetCurrent()
    $p = New-Object Security.Principal.WindowsPrincipal($id)
    @{ Name = $id.Name; IsSystem = ($id.User.Value -eq 'S-1-5-18'); IsAdmin = $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) }
}

# Windows PE (the installation environment) must never run the orchestrator.
function Test-WddWinPE { (Test-Path -LiteralPath 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\MiniNT') -or ($env:SystemDrive -eq 'X:') }

function Get-WddTask {
    param([string] $TaskPath, [string] $TaskName)
    $null -ne (Get-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath -ErrorAction SilentlyContinue)
}

function Unregister-WddTask {
    param([string] $TaskPath, [string] $TaskName)
    Get-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath -ErrorAction SilentlyContinue | Unregister-ScheduledTask -Confirm:$false
}

function Start-WddTask {
    param([string] $TaskPath, [string] $TaskName)
    Start-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath
}

function Get-WddBootTime { (Get-CimInstance -ClassName Win32_OperatingSystem).LastBootUpTime.ToUniversalTime() }

&lt;# Task state for the watchdog: @{ Exists; State (Ready, Running, Disabled, Queued); LastRunUtc; LastResult }. #&gt;
function Get-WddTaskInfo {
    param([string] $TaskPath, [string] $TaskName)
    $t = Get-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath -ErrorAction SilentlyContinue
    if (-not $t) { return @{ Exists = $false; State = ''; LastRunUtc = $null; LastResult = $null } }
    $i = $t | Get-ScheduledTaskInfo -ErrorAction SilentlyContinue
    @{ Exists = $true; State = [string] $t.State
       LastRunUtc = $(if ($i -and $i.LastRunTime -and $i.LastRunTime.Year -gt 2000) { $i.LastRunTime.ToUniversalTime() } else { $null })
       LastResult = $(if ($i) { [int64] $i.LastTaskResult } else { $null }) }
}

&lt;# True while Windows is installing updates itself (the Windows Update installer or TrustedInstaller is busy). #&gt;
function Test-WddUpdateServicing {
    try { if ((New-Object -ComObject 'Microsoft.Update.Installer').IsBusy) { return $true } } catch { }
    return [bool] (Get-Process -Name 'TiWorker' -ErrorAction SilentlyContinue)
}

&lt;#
    Orchestrator 1.3.0: restart coordination adapters.
    Get-WddServicingRestart  what Windows itself reports as a pending servicing restart (Windows
                             Update and component servicing). PendingFileRenameOperations is
                             deliberately not used: many installers leave entries there that do not
                             need a restart, and acting on it would restart for nothing.
    Test-WddInstallerActive  why restarting now would interrupt an installation ('' = nothing runs):
                             the Windows Update installer is busy, or a Windows Installer (MSI)
                             installation holds its machine-wide mutex.
#&gt;
function Get-WddServicingRestart {
    $r = @()
    $wu = $false
    try { $wu = [bool] (New-Object -ComObject 'Microsoft.Update.SystemInfo').RebootRequired } catch { }
    if ($wu -or (Test-Path -LiteralPath 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\RebootRequired')) { $r += 'Windows Update reports that a restart is required to finish installed updates' }
    if (Test-Path -LiteralPath 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Component Based Servicing\\RebootPending') { $r += 'Windows component servicing has a pending restart' }
    $r
}

function Test-WddInstallerActive {
    try { if ((New-Object -ComObject 'Microsoft.Update.Installer').IsBusy) { return 'the Windows Update installer is busy' } } catch { }
    $m = $null
    try { if ([System.Threading.Mutex]::TryOpenExisting('Global\\_MSIExecute', [ref] $m)) { $m.Dispose(); return 'a Windows Installer (MSI) installation is running' } }
    catch [System.UnauthorizedAccessException] { return 'a Windows Installer (MSI) installation is running' } catch { }
    return ''
}

&lt;# The machine-wide install lock shared with the engines (&lt;dataRoot&gt;\\state\\install.lock); $null when another installation holds it. #&gt;
function Enter-WddInstallLock {
    param([hashtable] $Paths)
    if (-not (Test-Path -LiteralPath $Paths.StateDir)) { New-Item -ItemType Directory -Path $Paths.StateDir -Force | Out-Null }
    try {
        $fs = [System.IO.File]::Open((Join-Path $Paths.StateDir 'install.lock'), [System.IO.FileMode]::OpenOrCreate, [System.IO.FileAccess]::ReadWrite, [System.IO.FileShare]::Read)
        $bytes = [System.Text.Encoding]::UTF8.GetBytes(('{{"owner":"Deployment","pid":{0},"sinceUtc":"{1}"}}' -f $PID, [DateTime]::UtcNow.ToString('o')))
        $fs.SetLength(0); $fs.Write($bytes, 0, $bytes.Length); $fs.Flush()
        return $fs
    } catch [System.IO.IOException] { return $null }
}

function Exit-WddInstallLock { param($Lock) if ($Lock) { try { $Lock.Dispose() } catch { } } }

&lt;# The restart marker in the engines' format, so they start nothing new before the restart. #&gt;
function Set-WddRestartMarker {
    param([hashtable] $Paths, [string] $Reason)
    $boot = $(try { (Get-WddBootTime).ToString('yyyy-MM-ddTHH:mm:ssZ') } catch { 'unknown' })
    Write-WddJson $Paths.RestartMarker ([ordered]@{ owner = 'Deployment'; reason = $Reason; requestedUtc = (Get-WddNow).ToString('o'); bootTimeUtc = $boot })
}

function Invoke-WddRestart {
    param([int] $WarningSeconds, [string] $Reason)
    # p:2:17 = planned, Operating System: Hot fix
    &amp; "$env:SystemRoot\\System32\\shutdown.exe" /r /t $WarningSeconds /d p:2:17 /c "Windows Deployment Builder: $Reason. The computer restarts in $WarningSeconds seconds; the deployment continues automatically."
    if ($LASTEXITCODE -ne 0) { throw "shutdown.exe failed with exit code $LASTEXITCODE" }
}

&lt;#
    Read-only Windows Update search (the documented WUA COM API, as SYSTEM) under the Windows Update
    engine's own policy ($Config = its config.json): what it would install if it ran now. Feature
    updates and Insider builds are never counted; optional updates and drivers only when the policy
    installs them. Installs, downloads and hides nothing.
#&gt;
function Get-WddOfferedUpdates {
    param($Config)
    $c = $(if ($Config -is [hashtable]) { $Config } else { @{} })
    $session = New-Object -ComObject 'Microsoft.Update.Session'
    $session.ClientApplicationID = 'Windows Deployment Builder (re-check)'
    $searcher = $session.CreateUpdateSearcher()
    if ($c['microsoftUpdate']) { $searcher.ServerSelection = 3; $searcher.ServiceID = '7971f918-a847-4430-9279-4a52d1efe18d' }
    $criteria = 'IsInstalled=0 and IsHidden=0'
    if ([string] $c['drivers'] -ne 'include') { $criteria += " and Type='Software'" }
    $result = $searcher.Search($criteria)
    if ($result.ResultCode -notin 2, 3) { throw "Windows Update search returned result code $($result.ResultCode)." }
    $excluded = @(@($c['excludedKbs']) | Where-Object { $_ } | ForEach-Object { ([string] $_).ToUpperInvariant() })
    foreach ($u in $result.Updates) {
        $title = [string] $u.Title
        $cats = @(foreach ($x in $u.Categories) { ([string] $x.CategoryID).ToLowerInvariant() })
        if ($cats -contains '3689bdc8-b205-4af4-8d4b-a63924c5e9d5' -or $title -match '(?i)^\\s*(Feature update to Windows|Upgrade to Windows)\\b' -or $title -match '(?i)\\bInsider Preview\\b') { continue }
        if ([bool] $u.BrowseOnly -and [string] $c['optionalUpdates'] -ne 'install') { continue }
        $kbs = @(foreach ($k in $u.KBArticleIDs) { "KB$k" })
        if (@($kbs | Where-Object { $excluded -contains $_.ToUpperInvariant() }).Count) { continue }
        @{ id = [string] $u.Identity.UpdateID; title = $title; kbs = $kbs; optional = [bool] $u.BrowseOnly; driver = ([int] $u.Type -eq 2) }
    }
}

&lt;# Holds the install lock through the restart warning, so nothing starts installing before the restart. #&gt;
function Wait-WddRestart { param([int] $Seconds) if ($Seconds -gt 0) { Start-Sleep -Seconds $Seconds } }

&lt;#
    Orchestrator 1.3.0: whether this process can see the deployment's scheduled tasks. The tasks
    of SYSTEM and of an elevated user are not readable with a filtered (non-elevated) token, so
    the progress window, which runs without elevation, must never conclude that a task is missing:
    'Limited' makes the snapshot rely on the SYSTEM monitor's own view (status.json) instead.
#&gt;
$script:WddTaskVisibility = 'Full'
function Get-WddTaskVisibility {
    $id = Get-WddIdentity
    if ($id.IsSystem -or $id['IsAdmin']) { return 'Full' }
    return 'Limited'
}

function Write-WddEvent {
    param([int] $EventId, [string] $Message, [ValidateSet('Information', 'Warning', 'Error')] [string] $EntryType = 'Information')
    try {
        if (-not [System.Diagnostics.EventLog]::SourceExists($script:EventSource)) { New-EventLog -LogName Application -Source $script:EventSource }
        Write-EventLog -LogName Application -Source $script:EventSource -EventId $EventId -EntryType $EntryType -Message $Message
    } catch {
        Write-WddLog "Could not write event $EventId to the Application log: $($_.Exception.Message)" 'WARN'
    }
}

function New-WddShortcut {
    param([string] $Name, [string] $Target, [string] $Arguments, [string] $Description)
    $path = Join-Path ([Environment]::GetFolderPath('CommonDesktopDirectory')) "$Name.lnk"
    $shell = New-Object -ComObject WScript.Shell
    $lnk = $shell.CreateShortcut($path)
    $lnk.TargetPath = $Target
    $lnk.Arguments = $Arguments
    $lnk.Description = $Description
    $lnk.Save()
}

function Remove-WddShortcut {
    param([string] $Name)
    $path = Join-Path ([Environment]::GetFolderPath('CommonDesktopDirectory')) "$Name.lnk"
    if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force }
}

# ------------------------------------------------------------------------------------------------
# JSON, logging, paths
# ------------------------------------------------------------------------------------------------

function ConvertTo-WddHashtable {
    param($InputObject)
    if ($null -eq $InputObject) { return $null }
    if ($InputObject -is [System.Collections.IDictionary]) {
        $h = @{}
        foreach ($k in $InputObject.Keys) { $h[$k] = ConvertTo-WddHashtable $InputObject[$k] }
        return $h
    }
    if ($InputObject -is [System.Management.Automation.PSCustomObject]) {
        $h = @{}
        foreach ($p in $InputObject.PSObject.Properties) { $h[$p.Name] = ConvertTo-WddHashtable $p.Value }
        return $h
    }
    if ($InputObject -is [System.Collections.IEnumerable] -and $InputObject -isnot [string]) {
        return , @($InputObject | ForEach-Object { ConvertTo-WddHashtable $_ })
    }
    return $InputObject
}

&lt;#
    Atomic write: &lt;Path&gt;.tmp is written through to disk, then replaces &lt;Path&gt; in one file-system
    operation; -Backup keeps the replaced file as &lt;Path&gt;.bak (the last good copy).
#&gt;
function Write-WddJson {
    param([string] $Path, $Value, [switch] $Backup)
    $dir = Split-Path -Parent $Path
    if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    $json = $Value | ConvertTo-Json -Depth 12
    $tmp = "$Path.tmp"
    $bytes = (New-Object System.Text.UTF8Encoding($false)).GetBytes($json)
    $fs = New-Object System.IO.FileStream($tmp, [System.IO.FileMode]::Create, [System.IO.FileAccess]::Write, [System.IO.FileShare]::None, 4096, [System.IO.FileOptions]::WriteThrough)
    try { $fs.Write($bytes, 0, $bytes.Length); $fs.Flush($true) } finally { $fs.Dispose() }
    if (Test-Path -LiteralPath $Path) {
        try {
            [System.IO.File]::Replace($tmp, $Path, $(if ($Backup) { "$Path.bak" } else { $null }))
            return
        } catch {
            if ($Backup) { Copy-Item -LiteralPath $Path -Destination "$Path.bak" -Force }
        }
    }
    Move-Item -LiteralPath $tmp -Destination $Path -Force
}

function Read-WddJson {
    param([string] $Path)
    if (-not (Test-Path -LiteralPath $Path)) { return $null }
    # Engines write UTF-8 without a BOM; Get-Content would read that as ANSI in PowerShell 5.1.
    try { ConvertTo-WddHashtable ([System.IO.File]::ReadAllText($Path, [System.Text.Encoding]::UTF8) | ConvertFrom-Json) } catch { $null }
}

function Write-WddLog {
    param([string] $Message, [ValidateSet('INFO', 'WARN', 'ERROR')] [string] $Level = 'INFO')
    $line = '{0}  {1,-5}  {2}' -f (Get-WddNow).ToString('yyyy-MM-dd HH:mm:ss'), $Level, $Message
    Write-Verbose $line
    if (-not $script:WddLogFile) { return }
    $err = $null
    for ($i = 0; $i -lt 3; $i++) {
        try { [System.IO.File]::AppendAllText($script:WddLogFile, $line + "\`r\`n"); return } catch { $err = $_.Exception.Message; Start-Sleep -Milliseconds 200 }
    }
    # Once per process: a log that cannot be written is visible on the console and in task output.
    if (-not $script:WddLogWarned) { $script:WddLogWarned = $true; Write-Warning "Cannot write the deployment log $($script:WddLogFile): $err" }
}

function Get-WddPaths {
    param([string] $DataRoot)
    $deployment = Join-Path $DataRoot 'Deployment'
    $state = Join-Path $DataRoot 'state'
    $reports = Join-Path $DataRoot 'reports'
    @{
        Root          = $DataRoot
        Package       = Join-Path $DataRoot 'Package'
        Deployment    = $deployment
        Logs          = Join-Path $deployment 'logs'
        Log           = Join-Path (Join-Path $deployment 'logs') 'deployment.log'
        Status        = Join-Path $deployment 'status.json'
        StateDir      = $state
        State         = Join-Path $state 'deployment.json'
        Marker        = Join-Path $state 'deployment.done'
        RestartMarker = Join-Path $state 'restart-pending.json'
        Reports       = $reports
        ReportJson    = Join-Path $reports 'deployment-report.json'
        ReportText    = Join-Path $reports 'deployment-report.txt'
        # Orchestrator 1.2.0: the timestamped activity feed and the LAN monitor's address and token.
        Activity      = Join-Path $deployment 'activity.jsonl'
        MonitorInfo   = Join-Path $state 'monitor.json'
    }
}

# ------------------------------------------------------------------------------------------------
# Activity feed (orchestrator 1.2.0)
# ------------------------------------------------------------------------------------------------

&lt;#
    Appends one event to &lt;dataRoot&gt;\\Deployment\\activity.jsonl: {utc, level, source, message}.
    The engines append their own retry and failure messages to the same file (Add-WdbActivity).
    Never contains secrets: only the deployment's own messages.
#&gt;
function Add-WddActivity {
    param([hashtable] $Paths, [string] $Message, [ValidateSet('info', 'warning', 'error')] [string] $Level = 'info', [string] $Source = 'deployment')
    $line = ([ordered]@{ utc = (Get-WddNow).ToString('o'); level = $Level; source = $Source; message = $Message } | ConvertTo-Json -Compress)
    Write-WddLog "Activity: $Message" $(switch ($Level) { 'error' { 'ERROR' } 'warning' { 'WARN' } default { 'INFO' } })
    $dir = Split-Path -Parent $Paths.Activity
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    for ($i = 0; $i -lt 3; $i++) {
        try {
            # A line left unfinished by a writer that was stopped must not swallow this one.
            $fs = New-Object System.IO.FileStream($Paths.Activity, [System.IO.FileMode]::OpenOrCreate, [System.IO.FileAccess]::ReadWrite, [System.IO.FileShare]::Read)
            try {
                $prefix = ''
                if ($fs.Length -gt 0) { [void] $fs.Seek(-1, [System.IO.SeekOrigin]::End); if ($fs.ReadByte() -ne 10) { $prefix = "\`r\`n" } }
                [void] $fs.Seek(0, [System.IO.SeekOrigin]::End)
                $bytes = (New-Object System.Text.UTF8Encoding($false)).GetBytes($prefix + $line + "\`r\`n")
                $fs.Write($bytes, 0, $bytes.Length)
            } finally { $fs.Dispose() }
            return
        } catch { Start-Sleep -Milliseconds 100 }
    }
}

&lt;# The last $Last events, oldest first. A line that is being written (incomplete JSON) is skipped. #&gt;
function Read-WddActivity {
    param([hashtable] $Paths, [int] $Last = 30)
    # Returns the events one by one (callers collect them with @()).
    if (-not $Paths.ContainsKey('Activity') -or -not (Test-Path -LiteralPath $Paths.Activity)) { return }
    $lines = $null
    for ($i = 0; $i -lt 3 -and $null -eq $lines; $i++) {
        try {
            $fs = New-Object System.IO.FileStream($Paths.Activity, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
            try { $lines = (New-Object System.IO.StreamReader($fs, [System.Text.Encoding]::UTF8)).ReadToEnd() -split "\`r?\`n" } finally { $fs.Dispose() }
        } catch { Start-Sleep -Milliseconds 100 }
    }
    $out = @()
    foreach ($l in @($lines | Where-Object { $_ -and $_.Trim() } | Select-Object -Last $Last)) {
        try { $e = ConvertTo-WddHashtable ($l | ConvertFrom-Json); if ($e -is [hashtable] -and $e['utc'] -and $e['message']) { $out += , $e } } catch { }
    }
    return $out
}

&lt;# Keeps the feed small: above $MaxBytes only the last $Keep events are kept. #&gt;
function Limit-WddActivity {
    param([hashtable] $Paths, [int64] $MaxBytes = 1MB, [int] $Keep = 500)
    if (-not (Test-Path -LiteralPath $Paths.Activity) -or (Get-Item -LiteralPath $Paths.Activity).Length -le $MaxBytes) { return }
    try {
        $keep = @([System.IO.File]::ReadAllLines($Paths.Activity, [System.Text.Encoding]::UTF8) | Select-Object -Last $Keep)
        $tmp = "$($Paths.Activity).tmp"
        [System.IO.File]::WriteAllLines($tmp, [string[]] $keep, (New-Object System.Text.UTF8Encoding($false)))
        Move-Item -LiteralPath $tmp -Destination $Paths.Activity -Force
    } catch { Write-WddLog "Could not shorten the activity feed: $($_.Exception.Message)" 'WARN' }
}

&lt;# "just now", "1 minute ago", "12 minutes ago", "3 hours ago". #&gt;
function Format-WddAge {
    param($Since)
    $d = ConvertTo-WddDate $Since
    if (-not $d) { return 'unknown' }
    $m = [int] [Math]::Floor(((Get-WddNow) - $d).TotalMinutes)
    if ($m -lt 1) { return 'just now' }
    if ($m -eq 1) { return '1 minute ago' }
    if ($m -lt 120) { return "$m minutes ago" }
    return "$([int] [Math]::Floor($m / 60)) hours ago"
}

function Initialize-WddLogging {
    param([hashtable] $Paths)
    foreach ($d in $Paths.Deployment, $Paths.Logs, $Paths.StateDir) { if (-not (Test-Path -LiteralPath $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null } }
    $script:WddLogFile = $Paths.Log
    if ((Test-Path -LiteralPath $Paths.Log) -and (Get-Item -LiteralPath $Paths.Log).Length -gt 5MB) { Move-Item -LiteralPath $Paths.Log -Destination "$($Paths.Log).1" -Force }
}

# ------------------------------------------------------------------------------------------------
# Manifest and integrity
# ------------------------------------------------------------------------------------------------

# Only plain relative paths: no drive, no root, no "..", a conservative character set.
function Test-WddRelativePath {
    param([string] $Path)
    if ([string]::IsNullOrWhiteSpace($Path) -or $Path.Length -gt 200) { return $false }
    if ($Path -notmatch '^[A-Za-z0-9._ -]+([\\\\/][A-Za-z0-9._ -]+)*$') { return $false }
    foreach ($seg in $Path -split '[\\\\/]') { if ($seg -eq '..' -or $seg -eq '.' -or $seg.Trim() -eq '') { return $false } }
    return $true
}

function Read-WddManifest {
    param([string] $Path)
    if (-not (Test-Path -LiteralPath $Path)) { throw "Deployment manifest not found: $Path" }
    try { $m = ConvertTo-WddHashtable ([System.IO.File]::ReadAllText($Path, [System.Text.Encoding]::UTF8) | ConvertFrom-Json) } catch { throw "Deployment manifest is not valid JSON: $Path" }
    if ($m -isnot [hashtable] -or $m.format -ne $script:ManifestFormat) { throw "Not a Windows Deployment Builder deployment manifest: $Path" }
    if ([int] $m.manifestVersion -ne 1) { throw "Unsupported deployment manifest version $($m.manifestVersion) (this orchestrator reads version 1)." }
    if ([string] $m.packageId -notmatch '^[0-9A-F]{16}$') { throw 'Deployment manifest has no valid packageId.' }
    if ([string] $m.dataRoot -notmatch '^[A-Za-z]:\\\\[^"*?&lt;&gt;|]+$') { throw 'Deployment manifest has an invalid dataRoot.' }
    foreach ($f in @($m.files)) {
        if (-not (Test-WddRelativePath $f.path)) { throw "Deployment manifest lists an unsafe path: $($f.path)" }
        if ([string] $f.sha256 -notmatch '^[0-9A-F]{64}$') { throw "Deployment manifest has an invalid hash for $($f.path)." }
        if ($f.textSha256 -and [string] $f.textSha256 -notmatch '^[0-9A-F]{64}$') { throw "Deployment manifest has an invalid text hash for $($f.path)." }
        if ($f.embedded -and -not (Test-WddRelativePath $f.embedded)) { throw "Deployment manifest lists an unsafe embedded path: $($f.embedded)" }
    }
    $known = 'staging', 'windowsUpdate', 'applications', 'drivers', 'office', 'finalization'
    foreach ($s in @($m.stages)) {
        if ($s.id -notin $known) { throw "Deployment manifest lists an unknown stage: $($s.id)" }
        foreach ($k in 'launcher', 'result', 'status') { if ($s.ContainsKey($k) -and $s[$k] -and -not (Test-WddRelativePath $s[$k])) { throw "Stage $($s.id) has an unsafe $k path." } }
    }
    return $m
}

function Get-WddSha256 {
    param([byte[]] $Bytes)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try { -join ($sha.ComputeHash($Bytes) | ForEach-Object { $_.ToString('X2') }) } finally { $sha.Dispose() }
}

# Hash of the exact file bytes (files in the package folder are byte-identical to the ZIP).
function Get-WddRawHash { param([string] $Path) Get-WddSha256 ([System.IO.File]::ReadAllBytes($Path)) }

# Hash of the text as the answer-file extraction writes it: .ps1/.xml as UTF-8 (BOM), other files
# in the system code page, line breaks normalised by the XML parser and the text trimmed. The
# manifest gives a text hash only where this is exact (ASCII text, or .ps1/.xml).
function Get-WddTextHash {
    param([string] $Path)
    $bytes = [System.IO.File]::ReadAllBytes($Path)
    $ext = [System.IO.Path]::GetExtension($Path).ToLowerInvariant()
    $hasBom = $bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF
    $encoding = if ($hasBom -or $ext -in '.ps1', '.xml') { New-Object System.Text.UTF8Encoding($false) } else { [System.Text.Encoding]::Default }
    $start = if ($hasBom) { 3 } else { 0 }
    $text = $encoding.GetString($bytes, $start, $bytes.Length - $start)
    $text = $text.Replace("\`r\`n", "\`n").Replace("\`r", "\`n").Trim()
    Get-WddSha256 ((New-Object System.Text.UTF8Encoding($false)).GetBytes($text))
}

&lt;#
    Checks files under $Root against the manifest.
      Raw   exact bytes (a package folder copied from the ZIP).
      Text  the text hash (files extracted from the answer file, and the staged copy of either).
    $Paths limits the check to these manifest paths. A JSON file without a text hash (non-ASCII
    content in the system code page) must at least parse.
#&gt;
function Test-WddFiles {
    param([string] $Root, [hashtable] $Manifest, [ValidateSet('Raw', 'Text')] [string] $Mode, [string[]] $Only = $null)
    $missing = @(); $mismatched = @(); $checked = 0
    foreach ($f in @($Manifest.files)) {
        if ($null -ne $Only -and $f.path -notin $Only) { continue }
        $p = Join-Path $Root ($f.path -replace '/', '\\')
        if (-not (Test-Path -LiteralPath $p -PathType Leaf)) { $missing += $f.path; continue }
        $checked++
        if ($Mode -eq 'Raw') {
            if ((Get-WddRawHash $p) -ne $f.sha256) { $mismatched += $f.path }
        } elseif ($f.textSha256) {
            if ((Get-WddTextHash $p) -ne $f.textSha256) { $mismatched += $f.path }
        } elseif ($p -like '*.json') {
            try { Get-Content -LiteralPath $p -Raw | ConvertFrom-Json | Out-Null } catch { $mismatched += $f.path }
        }
    }
    @{ Ok = ($missing.Count -eq 0 -and $mismatched.Count -eq 0); Missing = $missing; Mismatched = $mismatched; Checked = $checked }
}

# ------------------------------------------------------------------------------------------------
# Single instance
# ------------------------------------------------------------------------------------------------

function Enter-WddMutex {
    param([int] $TimeoutSeconds = 0)
    $created = $false
    $m = New-Object System.Threading.Mutex($false, $script:MutexName, [ref] $created)
    try { if ($m.WaitOne([TimeSpan]::FromSeconds($TimeoutSeconds))) { return $m } } catch [System.Threading.AbandonedMutexException] { return $m }
    $m.Dispose()
    return $null
}

function Exit-WddMutex { param($Mutex) if ($Mutex) { try { $Mutex.ReleaseMutex() } catch { }; $Mutex.Dispose() } }

# ------------------------------------------------------------------------------------------------
# Deployment state and stage snapshot
# ------------------------------------------------------------------------------------------------

function Get-WddStage { param([hashtable] $Manifest, [string] $Id) @($Manifest.stages) | Where-Object { $_.id -eq $Id } | Select-Object -First 1 }

# Phase 8: the driver stage is an engine stage when the manifest enables it (older manifests never do).
function Get-WddEngineStages { param([hashtable] $Manifest) @(@($Manifest.stages) | Where-Object { $_.id -in 'windowsUpdate', 'applications', 'drivers', 'office' -and $_.enabled -and ($_.id -ne 'drivers' -or $_['launcher']) } | Sort-Object { [int] $_.order }) }

&lt;# Phase 8: the driver engine's flag for a computer that is offline because no network adapter has a driver. #&gt;
function Get-WddNetworkDriverFlag {
    param([hashtable] $Paths)
    $f = Read-WddJson (Join-Path $Paths.StateDir 'network-driver-missing.json')
    if ($f -and $f['detail']) { return [string] $f['detail'] }
    return ''
}

function ConvertTo-WddDate {
    param($Value)
    if (-not $Value) { return $null }
    try { [DateTime]::Parse([string] $Value, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToUniversalTime() } catch { $null }
}

function Get-WddOutcome {
    param([string] $Status)
    switch ($Status) {
        'Succeeded' { 'ok' }
        'CompletedWithFollowUp' { 'followUp' }
        'CompletedWithFailures' { 'failures' }
        'Failed' { 'failed' }
        'Offline' { 'offline' }
        default { 'unknown' }
    }
}

function Test-WddRestartPending {
    param([hashtable] $Paths)
    $m = Read-WddJson $Paths.RestartMarker
    if (-not $m) { return $false }
    # The engines' shared Set-WdbRestartPending writes requestedUtc and the boot it was written in
    # (bootTimeUtc); writtenUtc is the Phase 4 name. A marker from an earlier boot is not pending.
    if ($m['bootTimeUtc']) {
        $markerBoot = ConvertTo-WddDate $m['bootTimeUtc']
        try { $boot = Get-WddBootTime } catch { return $true }
        if (-not $markerBoot -or [Math]::Abs(($markerBoot - $boot).TotalSeconds) -gt 2) { return $false }
    }
    $written = ConvertTo-WddDate $(if ($m['writtenUtc']) { $m['writtenUtc'] } else { $m['requestedUtc'] })
    if (-not $written -or ((Get-WddNow) - $written).TotalMinutes -gt 30) { return $false }
    try { $boot = Get-WddBootTime } catch { return $true }
    return $written -ge $boot
}

&lt;#
    Snapshot of one engine stage, from what the engine itself wrote:
      Final       result.json exists (its status is the real outcome; a marker alone is never trusted)
      Running     the engine has checked in (status.json)
      Pending     launched, its task exists, not started yet
      Stalled     launched, but no task, no status and no result after the grace period, or the
                  task has gone while the stage is not final: needs manual attention
      NotStarted  not launched (yet)
      LaunchFailed the installer could not register the task
#&gt;
&lt;# The SYSTEM monitor's last view of one stage (from its status.json, if written in the last 30 minutes), or $null. #&gt;
function Get-WddMonitorStageView {
    param([hashtable] $Paths, [string] $Id)
    $s = Read-WddJson $Paths.Status
    if ($s -isnot [hashtable] -or -not $s.ContainsKey('stages')) { return $null }
    $at = ConvertTo-WddDate $s['updatedUtc']
    if (-not $at -or ((Get-WddNow) - $at).TotalMinutes -gt 30) { return $null }
    return (@($s['stages']) | Where-Object { $_ -is [hashtable] -and $_['id'] -eq $Id } | Select-Object -First 1)
}

function Get-WddStageSnapshot {
    param([hashtable] $Stage, [hashtable] $Paths, [hashtable] $State)
    $root = $Paths.Root
    $launch = if ($State -and $State.stages -and $State.stages.ContainsKey($Stage.id)) { $State.stages[$Stage.id] } else { $null }
    $o = [ordered]@{ id = $Stage.id; name = $Stage.name; enabled = [bool] $Stage.enabled; context = $Stage.context; state = 'NotStarted'; status = ''; outcome = ''; detail = ''; reboots = 0; updatedUtc = $null; current = ''; done = $null; total = $null; result = $null; idle = ''; outstanding = 0
                     condition = 'waiting'; activity = ''; waitingReason = ''; lastActivityUtc = $null; stale = $false; staleMinutes = 0; counts = [ordered]@{}; lastError = ''; lastErrorUtc = $null; progress = 'unavailable'; engine = $null }
    $result = Read-WddJson (Join-Path $root $Stage.result)
    if ($result -and $result.status -in $script:FinalStageStatuses) {
        $o.state = 'Final'; $o.status = $result.status; $o.outcome = Get-WddOutcome $result.status; $o.detail = [string] $result.reason
        $o.reboots = [int] $result.reboots; $o.updatedUtc = $result.finishedUtc; $o.result = $result
        if ($result.ContainsKey('outstanding')) { $o.outstanding = @($result.outstanding).Count }
        Set-WddStageNarrative $o $Stage $null $null $State
        return $o
    }
    $status = Read-WddJson (Join-Path $root $Stage.status)
    $o.engine = $status
    # Orchestrator 1.3.0: a non-elevated process cannot see the SYSTEM tasks; it never concludes "missing".
    $taskKnown = $script:WddTaskVisibility -ne 'Limited'
    $taskExists = $(if ($taskKnown) { Get-WddTask $Stage.task.path $Stage.task.name } else { $false })
    if ($status) {
        $o.status = [string] $status.phase; $o.detail = [string] $status.detail; $o.updatedUtc = $status.updatedUtc
        if ($status.ContainsKey('reboots')) { $o.reboots = [int] $status.reboots }
        if ($status.ContainsKey('done')) { $o.done = [int] $status.done; $o.total = [int] $status.total }
        if ($status.phase -eq 'Installing' -and $status.detail) { $o.current = [string] $status.detail }
    }
    if (-not $launch) { Set-WddStageNarrative $o $Stage $status $launch $State; return $o }
    if ($launch.launchResult -eq 'LaunchFailed') { $o.state = 'LaunchFailed'; $o.detail = [string] $launch.message; Set-WddStageNarrative $o $Stage $status $launch $State; return $o }
    $since = ConvertTo-WddDate $launch.launchedUtc
    $age = if ($since) { ((Get-WddNow) - $since).TotalMinutes } else { 0 }
    if (-not $taskKnown) {
        # What the SYSTEM monitor saw at its last run decides Stalled; otherwise the task is assumed present.
        $mv = Get-WddMonitorStageView $Paths $Stage.id
        if ($mv -and [string] $mv['state'] -in 'Stalled', 'LaunchFailed') {
            $o.state = [string] $mv['state']; $o.detail = "$([string] $mv['detail']) (reported by the deployment monitor)".Trim()
            Set-WddStageNarrative $o $Stage $status $launch $State
            return $o
        }
        $taskExists = $true
    }
    if ($taskExists) {
        $o.state = $(if ($status) { 'Running' } else { 'Pending' })
        # Phase 5: the user-context stage runs only while its user is signed in; say so when it has
        # not checked in for a long time instead of looking busy.
        $seen = ConvertTo-WddDate $o.updatedUtc
        $limit = [int] $State.stalledAfterMinutes
        if ($Stage.context -eq 'user' -and $limit -gt 0 -and $age -ge $limit -and (-not $seen -or ((Get-WddNow) - $seen).TotalMinutes -ge $limit)) {
            $who = $(if ($launch.ContainsKey('user') -and $launch.user) { [string] $launch.user } else { 'the user who started the deployment' })
            $o.idle = "has not run for more than $limit minutes; it runs only while $who is signed in."
        }
        Set-WddStageNarrative $o $Stage $status $launch $State
        return $o
    }
    # No task and no result: the engine removed its task without a result, or the task was deleted.
    if ($age -ge [int] $State.stalledAfterMinutes) { $o.state = 'Stalled'; if (-not $o.detail) { $o.detail = 'The scheduled task is missing and there is no result. Run Resume-Deployment.ps1.' } }
    else { $o.state = $(if ($status) { 'Running' } else { 'Pending' }) }
    Set-WddStageNarrative $o $Stage $status $launch $State
    return $o
}

# Engine phases that mean "waiting for something", with the reason in words.
$script:WaitingPhases = @{
    WaitingForNetwork   = 'Waiting for a network connection.'
    WaitingForInstaller = 'Waiting for Windows Update to finish.'
    WaitingForLock      = 'Waiting for another installation to finish.'
    WaitingForRetry     = 'Waiting before the next retry.'
    WaitingForUpdates   = 'Waiting for Windows Update to finish first.'
    WaitingForDrivers   = 'Waiting for the driver stage to finish first.'
    WaitingForApplications = 'Waiting for the WinGet applications to finish first.'
    WaitingForRestart   = 'Waiting for the scheduled restart.'
    WaitingForReboot    = 'Waiting for a restart.'
    RebootDeferred      = 'A restart is needed; it waits until the current installation has finished.'
    Rebooting           = 'Restarting Windows; the deployment continues after the restart.'
    Error               = 'The engine hit an unexpected error and tries again at its next run.'
}
# Phases during which Windows Update legitimately works for a long time without a new status.
$script:LongPhases = @('Downloading', 'Installing', 'WaitingForInstaller', 'Rebooting', 'ResettingComponents', 'PreparingTool')

&lt;#
    Orchestrator 1.2.0: what a stage is doing, in words, from evidence only (the engine's own
    status.json and result.json, its task, the launch record):
      condition  finished | active | waiting | idle | blocked
      activity   one sentence for people (the progress window and the LAN monitor)
      stale      no progress reported for longer than the limit (not while Windows is servicing)
#&gt;
function Set-WddStageNarrative {
    param($O, [hashtable] $Stage, $Status, $Launch, $State)
    $limit = [int] $(if ($State -and $State['stalledAfterMinutes']) { $State['stalledAfterMinutes'] } else { 120 })
    $long = [int] $(if ($State -and $State['longOperationMinutes']) { $State['longOperationMinutes'] } else { [Math]::Max(240, $limit) })
    if ($Status -is [hashtable]) {
        $O.lastActivityUtc = $Status['updatedUtc']
        foreach ($k in 'installed', 'failed', 'needsPerson', 'selected', 'done', 'total', 'attempt', 'maxAttempts', 'queued') { if ($Status.ContainsKey($k) -and $null -ne $Status[$k]) { $O.counts[$k] = $Status[$k] } }
        if ($Status.ContainsKey('current') -and $Status['current']) { $O.current = [string] $Status['current'] }
        if ($Status.ContainsKey('lastError') -and $Status['lastError']) { $O.lastError = [string] $Status['lastError']; $O.lastErrorUtc = $Status['lastErrorUtc'] }
        if ($Status.ContainsKey('lastFailure') -and $Status['lastFailure'] -is [hashtable]) { $O.lastError = [string] $Status['lastFailure']['message']; $O.lastErrorUtc = $Status['lastFailure']['atUtc'] }
    }
    switch ($O.state) {
        'Final' {
            $O.condition = 'finished'; $O.lastActivityUtc = $O.updatedUtc
            $O.activity = "Finished: $($O.status).$(if ($O.detail) { " $($O.detail)" })"
            if ($O.result -is [hashtable]) {
                foreach ($k in 'installed', 'failed', 'skipped', 'requiresInteraction') { if ($O.result.ContainsKey($k) -and $O.result[$k] -is [array]) { $O.counts[$k] = @($O.result[$k]).Count } }
                if ($O.result.ContainsKey('counts') -and $O.result['counts'] -is [hashtable]) { foreach ($k in $O.result['counts'].Keys) { $O.counts[$k] = $O.result['counts'][$k] } }
            }
            return
        }
        'LaunchFailed' { $O.condition = 'blocked'; $O.activity = "Could not be started: $($O.detail)"; return }
        'Stalled' { $O.condition = 'blocked'; $O.activity = "No progress: $($O.detail)"; return }
        'NotStarted' { $O.condition = 'waiting'; $O.activity = 'Not started yet.'; $O.waitingReason = 'Waiting for the deployment to launch this stage.'; return }
        'Pending' {
            $O.condition = 'waiting'
            $since = $(if ($Launch -is [hashtable]) { $Launch['launchedUtc'] } else { $null })
            $O.waitingReason = $(if ($Stage.context -eq 'user') { 'Scheduled; it starts when the deployment user is signed in.' } else { 'Scheduled; waiting for the engine to start.' })
            $O.activity = "$($O.waitingReason) Launched $(Format-WddAge $since)."
            $O.lastActivityUtc = $since
            return
        }
    }
    # Running: the engine has checked in.
    $phase = [string] $O.status
    $age = $(if (ConvertTo-WddDate $O.lastActivityUtc) { ((Get-WddNow) - (ConvertTo-WddDate $O.lastActivityUtc)).TotalMinutes } else { 0 })
    if ($O.idle) {
        $O.condition = 'idle'; $O.activity = "Idle: $($O.idle)"; $O.waitingReason = $O.idle
    } elseif ($script:WaitingPhases.ContainsKey($phase)) {
        $O.condition = 'waiting'; $O.waitingReason = $script:WaitingPhases[$phase]
        $O.activity = "$($script:WaitingPhases[$phase])$(if ($O.detail -and $O.detail -ne $script:WaitingPhases[$phase]) { " $($O.detail)" }) Last activity: $(Format-WddAge $O.lastActivityUtc)."
    } else {
        $O.condition = 'active'
        $O.activity = "$(if ($O.detail) { $O.detail } else { $phase })$(if ($O.detail -notmatch '\\.$') { '.' }) Last activity: $(Format-WddAge $O.lastActivityUtc)."
    }
    # No progress for longer than the limit. Never while Windows Update is still servicing.
    $max = $(if ($phase -in $script:LongPhases -and $Stage.id -eq 'windowsUpdate') { $long } else { $limit })
    if ($O.condition -ne 'idle' -and $age -ge $max -and $phase -notin 'Rebooting') {
        $servicing = $false
        if ($Stage.id -eq 'windowsUpdate' -or $phase -eq 'WaitingForInstaller') { try { $servicing = [bool] (Test-WddUpdateServicing) } catch { } }
        if (-not $servicing) {
            $O.stale = $true; $O.staleMinutes = [int] $age; $O.condition = 'blocked'
            $O.activity = "No progress detected for $([int] $age) minutes (limit $max). Last step: $(if ($O.detail) { $O.detail } else { $phase })."
        } else {
            $O.activity = "$($O.activity) Windows is still installing updates, so this is not treated as stalled."
        }
    }
}

function Get-WddSnapshot {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State)
    $stages = @()
    foreach ($s in Get-WddEngineStages $Manifest) { $stages += , (Get-WddStageSnapshot $s $Paths $State) }
    $drivers = Get-WddStage $Manifest 'drivers'
    $drvSnap = @($stages | Where-Object { $_.id -eq 'drivers' } | Select-Object -First 1)
    $drvState = $(if ($drvSnap.Count) { [ordered]@{ id = 'drivers'; state = $drvSnap[0].state; status = $drvSnap[0].status; detail = $drvSnap[0].detail } }
                  elseif ($drivers -and $drivers['implemented']) { [ordered]@{ id = 'drivers'; state = 'NotPartOfDeployment'; detail = [string] $drivers['note'] } }
                  else { [ordered]@{ id = 'drivers'; state = 'NotImplemented'; detail = $(if ($drivers) { [string] $drivers['note'] } else { '' }) } })
    $engine = @($stages)
    $allFinal = ($engine.Count -eq 0) -or (@($engine | Where-Object { $_.state -ne 'Final' }).Count -eq 0)
    $blocked = @($engine | Where-Object { $_.state -in 'Stalled', 'LaunchFailed' -or $_.stale })
    $current = @($engine | Where-Object { $_.state -in 'Running', 'Pending' } | Select-Object -First 1)
    $snap = [ordered]@{
        packageId       = $Manifest.packageId
        updatedUtc      = (Get-WddNow).ToString('o')
        deploymentState = $(if ($State) { [string] $State.status } else { 'NotInitialized' })
        currentStage    = $(if ($current.Count) { $current[0].id } else { '' })
        stages          = $stages
        drivers         = $drvState
        networkDriverMissing = (Get-WddNetworkDriverFlag $Paths)
        allFinal        = $allFinal
        restartPending  = (Test-WddRestartPending $Paths)
        needsAttention  = @($blocked | ForEach-Object { if ($_.stale) { "$($_.name): $($_.activity)" } else { "$($_.name): $($_.state). $($_.detail)" } })
        overall         = $(if ($allFinal) { Get-WddOverall $engine } else { 'InProgress' })
        lastActivityUtc = (Get-WddLastActivity $engine)
        recovering      = [bool] ($State -and $State['recoveringUntilUtc'] -and (ConvertTo-WddDate $State['recoveringUntilUtc']) -gt (Get-WddNow))
        restarts        = @(if ($State -and $State['restarts']) { @($State['restarts']) | Select-Object -Last 10 })
        # Orchestrator 1.3.0: the coordinated restart, finalization and whether the monitor still runs.
        restart         = (Get-WddRestartView $State)
        finalizing      = [bool] ($allFinal -and $State -and [string] $State['status'] -notin 'Completed', 'StagingFailed', 'IntegrityFailed')
        finalizeError   = $(if ($State -and $State['lastFinalizeError']) { [string] $State['lastFinalizeError'] } else { '' })
        monitorLastRunUtc = $(if ($State) { $State['lastMonitorUtc'] } else { $null })
        monitorOverdue  = (Test-WddMonitorOverdue $Manifest $State)
    }
    # Schema 9: the activation stage (only when the deployment has one).
    if ($Manifest.ContainsKey('activation') -and $Manifest.activation) { $snap.activation = Get-WddActivationView $Manifest $State }
    if ($snap.monitorOverdue) {
        $snap.needsAttention = @(@($snap.needsAttention) + @("Deployment monitor: it has not run since $(if ($snap.monitorLastRunUtc) { Format-WddAge $snap.monitorLastRunUtc } else { 'the deployment started' }) (it should run every $(Get-WddMonitorInterval $Manifest) minutes as SYSTEM, task \\WindowsDeploymentBuilder\\Deployment). Nothing is finished or restarted automatically until it runs again; run Resume-Deployment.ps1 as administrator."))
    }
    Set-WddSnapshotOutcome $snap $State
    $snap.condition = Get-WddCondition $snap $State
    return $snap
}

&lt;#
    Schema 9: activation per target for the progress window, the LAN monitor and status.json:
    status and a message, never a key (not even the five characters Windows itself reports).
    Before the activation step ran: Waiting (requested) or NotRequested.
#&gt;
function Get-WddActivationView {
    param([hashtable] $Manifest, $State)
    $act = $(if ($State -and $State['activation'] -is [hashtable]) { $State['activation'] } else { $null })
    $o = [ordered]@{}
    foreach ($k in 'windows', 'office') {
        $plan = $Manifest.activation[$k]
        $e = $(if ($act) { $act[$k] } else { $null })
        if ($e) { $o[$k] = [ordered]@{ action = [string] $plan['action']; status = [string] $e['status']; verified = [bool] $e['verified']; message = ([string] $e['message'] -replace '\\s*\\(key ending [^)]*\\)', '') } }
        elseif ([string] $plan['action'] -eq 'none') { $o[$k] = [ordered]@{ action = 'none'; status = 'NotRequested'; verified = $false; message = 'No activation was requested.' } }
        else { $o[$k] = [ordered]@{ action = [string] $plan['action']; status = 'Waiting'; verified = $false; message = 'Runs at the end of the deployment, after every stage and any restart.' } }
    }
    return $o
}

&lt;# The most recent progress any stage reported (ISO 8601), or $null. #&gt;
function Get-WddLastActivity {
    param([object[]] $Stages)
    $best = $null
    foreach ($s in @($Stages)) { $d = ConvertTo-WddDate $s.lastActivityUtc; if ($d -and (-not $best -or $d -gt $best)) { $best = $d } }
    if ($best) { return $best.ToString('o') }
    return $null
}

&lt;# Minutes between monitor runs (orchestrator 1.2.0 packages: 5; older: 15). #&gt;
function Get-WddMonitorInterval {
    param([hashtable] $Manifest)
    $o = $(if ($Manifest -and $Manifest['failureHandling'] -is [hashtable]) { $Manifest.failureHandling['orchestrator'] } else { $null })
    if ($o -is [hashtable] -and $o.ContainsKey('monitorIntervalMinutes') -and [int] $o.monitorIntervalMinutes -ge 1) { return [int] $o.monitorIntervalMinutes }
    return 15
}

&lt;#
    Orchestrator 1.3.0: the SYSTEM monitor has not run for three intervals (plus 5 minutes) although
    Windows has been running that long. Nothing finishes or restarts automatically without it, so
    the progress window says so instead of looking busy.
#&gt;
function Test-WddMonitorOverdue {
    param([hashtable] $Manifest, $State)
    if (-not $State -or [string] $State['status'] -notin 'Launching', 'InProgress') { return $false }
    $limit = 3 * (Get-WddMonitorInterval $Manifest) + 5
    $last = ConvertTo-WddDate $(if ($State['lastMonitorUtc']) { $State['lastMonitorUtc'] } else { $State['initializedUtc'] })
    if (-not $last -or ((Get-WddNow) - $last).TotalMinutes -lt $limit) { return $false }
    try { $boot = Get-WddBootTime } catch { return $false }
    return ((Get-WddNow) - $boot).TotalMinutes -ge $limit
}

&lt;# True when Windows still needed a restart the deployment did not do (limit reached, blocked, failed, or not done yet). #&gt;
function Test-WddRestartOutstanding {
    param($State)
    return ((Get-WddRestartView $State).status -in 'Announced', 'Blocked', 'LimitReached', 'Failed')
}

&lt;# The coordinated restart as the progress window and the LAN monitor show it. #&gt;
function Get-WddRestartView {
    param($State)
    $rc = $(if ($State -and $State['restartCoordinator'] -is [hashtable]) { $State['restartCoordinator'] } else { $null })
    if (-not $rc) { return [ordered]@{ status = 'NotRequired'; reasons = @(); blockers = @(); restarts = 0; message = '' } }
    [ordered]@{ status = [string] $rc['status']; reasons = @($rc['reasons'] | Where-Object { $_ }); blockers = @($rc['blockers'] | Where-Object { $_ })
                restarts = [int] $rc['restarts']; message = [string] $rc['message'] }
}

&lt;#
    One word for the whole deployment (progress window, LAN monitor):
      complete   finished (see overall)            attention  something needs a person
      recovering after a restart or an automatic recovery, while unfinished work is checked
      active     an engine is working              waiting    every running stage waits for something
#&gt;
function Get-WddCondition {
    param($Snapshot, $State)
    if ($State -and [string] $State['status'] -eq 'Completed') { return 'complete' }
    if (-not $State -or [string] $State['status'] -in 'StagingFailed', 'IntegrityFailed') { return 'attention' }
    if (@($Snapshot.needsAttention).Count) { return 'attention' }
    if ($Snapshot.recovering) { return 'recovering' }
    if ($Snapshot.Contains('restart') -and $Snapshot.restart.status -in 'Announced', 'Restarting', 'Blocked') { return 'waiting' }
    if (@($Snapshot.stages | Where-Object { $_.condition -eq 'active' }).Count) { return 'active' }
    if (@($Snapshot.stages | Where-Object { $_.condition -ne 'finished' }).Count -eq 0) { return 'active' }
    return 'waiting'
}

&lt;# Adds outcome, outcomeCode and outcomeDetail (Phase 5) to a snapshot. #&gt;
function Set-WddSnapshotOutcome {
    param($Snapshot, $State, [string] $Problem = '')
    $out = Get-WddDeploymentOutcome $State $Snapshot $Problem
    $Snapshot.outcome = $out.outcome
    $Snapshot.outcomeCode = $out.exitCode
    $Snapshot.outcomeDetail = $out.detail
}

&lt;#
    Overall result, from the worst stage:
      Succeeded              every enabled stage Succeeded (or nothing to do)
      CompletedWithFollowUp  finished; some items need a person (interaction, sign-in, restart)
      CompletedWithFailures  finished; some updates or packages failed or were unavailable
      Incomplete             a stage ended Offline, stalled, or the deadline passed first
      Failed                 a stage Failed (or staging/integrity failed before any stage ran)
#&gt;
function Get-WddOverall {
    param([object[]] $Stages, [switch] $DeadlineReached)
    $rank = @{ ok = 0; followUp = 1; failures = 2; offline = 3; incomplete = 3; failed = 4 }
    $worst = 'ok'
    foreach ($s in @($Stages)) {
        $o = if ($s.state -eq 'Final') { $s.outcome } else { 'incomplete' }
        if (-not $rank.ContainsKey($o)) { $o = 'failed' }
        if ($rank[$o] -gt $rank[$worst]) { $worst = $o }
    }
    if ($DeadlineReached -and $worst -ne 'failed' -and @($Stages | Where-Object { $_.state -ne 'Final' }).Count -gt 0) { $worst = 'incomplete' }
    switch ($worst) { 'ok' { 'Succeeded' } 'followUp' { 'CompletedWithFollowUp' } 'failures' { 'CompletedWithFailures' } 'failed' { 'Failed' } default { 'Incomplete' } }
}

function Save-WddState { param([hashtable] $Paths, [hashtable] $State) Write-WddJson $Paths.State $State -Backup }

$script:DeployStates = @('Staging', 'StagingFailed', 'Launching', 'InProgress', 'Completed', 'IntegrityFailed')

&lt;# Shape check of deployment.json: a reason, or $null when the state is usable. #&gt;
function Test-WddStateShape {
    param($S)
    if ($S -isnot [hashtable]) { return 'not an object' }
    if ("$($S['schemaVersion'])" -notmatch '^\\d{1,3}$' -or [int] $S['schemaVersion'] -lt 1 -or [int] $S['schemaVersion'] -gt $script:DeployStateVersion) { return "unsupported schema version '$($S['schemaVersion'])'" }
    if ([string] $S['packageId'] -notmatch '^[0-9A-F]{16}$') { return 'no valid packageId' }
    if ([string] $S['status'] -notin $script:DeployStates) { return "unknown status '$($S['status'])'" }
    if ($S.ContainsKey('stages') -and $null -ne $S['stages'] -and $S['stages'] -isnot [hashtable]) { return 'stages is not a map' }
    return $null
}

&lt;#
    Reads deployment.json, falling back to the last good copy (deployment.json.bak). Returns
      @{ State; Source = main | backup | missing | corrupt; Problem }
    "corrupt" (a state file exists but neither copy is usable) is never treated as "no deployment":
    callers stop and leave the decision to a technician (DeploymentRecovery.ps1 -Action Resume
    rebuilds the state from the manifest and the engines' own files).
#&gt;
function Read-WddDeploymentState {
    param([hashtable] $Paths)
    $problems = @()
    $exists = $false
    foreach ($candidate in @($Paths.State, "$($Paths.State).bak")) {
        if (-not (Test-Path -LiteralPath $candidate)) { continue }
        $exists = $true
        $s = Read-WddJson $candidate
        $why = $(if ($null -eq $s) { 'not valid JSON' } else { Test-WddStateShape $s })
        if (-not $why) {
            if (-not $s.ContainsKey('recoveries') -or $null -eq $s['recoveries']) { $s['recoveries'] = @() }
            if (-not $s.ContainsKey('stages') -or $null -eq $s['stages']) { $s['stages'] = @{} }
            $s.schemaVersion = $script:DeployStateVersion
            if ($candidate -ne $Paths.State) {
                Write-WddLog "Deployment state recovered from its last good copy ($(Split-Path -Leaf $candidate)); the damaged file was kept as deployment.json.corrupt." 'WARN'
                if (Test-Path -LiteralPath $Paths.State) { Copy-Item -LiteralPath $Paths.State -Destination "$($Paths.State).corrupt" -Force -ErrorAction SilentlyContinue }
                return @{ State = $s; Source = 'backup'; Problem = ($problems -join '; ') }
            }
            return @{ State = $s; Source = 'main'; Problem = '' }
        }
        $problems += "$(Split-Path -Leaf $candidate): $why"
    }
    if (-not $exists) { return @{ State = $null; Source = 'missing'; Problem = '' } }
    return @{ State = $null; Source = 'corrupt'; Problem = ($problems -join '; ') }
}

# ------------------------------------------------------------------------------------------------
# Outcome (Phase 5): one machine-readable result with a stable exit code
# ------------------------------------------------------------------------------------------------

$script:OutcomeCodes = [ordered]@{
    Succeeded = 0; CompletedWithWarnings = 10; CompletedWithFailures = 20; Incomplete = 25
    PausedAwaitingNetwork = 30; PausedAwaitingReboot = 31; PausedAwaitingUser = 32; InProgress = 40
    FailedToInitialize = 50; Failed = 60
}

&lt;#
    Where the deployment stands, for people and programs:
      ended    Succeeded, CompletedWithWarnings (manual actions or follow-ups), CompletedWithFailures,
               Incomplete (ended before every stage finished), Failed
      running  PausedAwaitingNetwork, PausedAwaitingReboot, PausedAwaitingUser, InProgress
      never    FailedToInitialize (no usable state, staging or integrity failure)
#&gt;
function Get-WddDeploymentOutcome {
    param($State, $Snapshot, [string] $Problem = '')
    $o = { param([string] $Name, [string] $Detail) [ordered]@{ outcome = $Name; exitCode = $script:OutcomeCodes[$Name]; detail = $Detail } }
    if (-not $State) { return &amp; $o 'FailedToInitialize' $(if ($Problem) { "The deployment state is unusable: $Problem" } else { 'No deployment has been started on this computer.' }) }
    switch ([string] $State.status) {
        'StagingFailed' { return &amp; $o 'FailedToInitialize' ([string] $State.message) }
        'IntegrityFailed' { return &amp; $o 'FailedToInitialize' ([string] $State.message) }
        'Completed' {
            $map = @{ Succeeded = 'Succeeded'; CompletedWithFollowUp = 'CompletedWithWarnings'; CompletedWithFailures = 'CompletedWithFailures'; Incomplete = 'Incomplete'; Failed = 'Failed' }
            $name = $(if ($map.ContainsKey([string] $State.overall)) { $map[[string] $State.overall] } else { 'Failed' })
            return &amp; $o $name ([string] $State.message)
        }
    }
    $stages = @(if ($Snapshot) { @($Snapshot.stages) } else { @() })
    $live = @($stages | Where-Object { $_ -and $_.state -ne 'Final' })
    # Orchestrator 1.3.0: every stage has its final result, the deployment is not finished yet
    # (the bare-metal run showed code 40 with a startup message here): say exactly what is left.
    if ($stages.Count -and -not $live.Count) {
        $results = ($stages | ForEach-Object { "$($_.name): $($_.status)" }) -join '; '
        $rv = $(if ($Snapshot.Contains('restart')) { $Snapshot.restart } else { $null })
        if ($rv -and $rv.status -in 'Announced', 'Restarting', 'Blocked') {
            $what = $(if ($rv.status -eq 'Blocked') { "It waits because $(@($rv.blockers) -join '; ')." } elseif ($rv.status -eq 'Restarting') { 'The restart has been started.' } else { 'The deployment restarts the computer automatically at its next check when nothing is installing.' })
            return &amp; $o 'PausedAwaitingReboot' "Every stage has finished ($results). Windows needs a restart: $(@($rv.reasons) -join '; '). $what After the restart Windows Update and Device Manager are checked again and the final report is written."
        }
        if ($Snapshot.Contains('finalizeError') -and $Snapshot.finalizeError) { return &amp; $o 'InProgress' "Every stage has finished ($results), but writing the final report failed: $($Snapshot.finalizeError) It is tried again at the monitor's next run." }
        if ($Snapshot.Contains('monitorOverdue') -and $Snapshot.monitorOverdue) { return &amp; $o 'PausedAwaitingUser' "Every stage has finished ($results), but the deployment monitor has not run to finish the deployment. Run Resume-Deployment.ps1 as administrator." }
        return &amp; $o 'InProgress' "Every stage has finished ($results). The deployment monitor is finishing the deployment (restart check, Windows Update and Device Manager check, final report) at its next run."
    }
    if (($Snapshot -and $Snapshot.restartPending) -or @($live | Where-Object { $_.status -in 'Rebooting', 'RebootDeferred' }).Count) { return &amp; $o 'PausedAwaitingReboot' 'A restart is scheduled or in progress; the deployment continues after it.' }
    $net = @($live | Where-Object { $_.status -eq 'WaitingForNetwork' })
    # Phase 8: offline because no network adapter has a driver: say so, the network will not appear by itself.
    if ($Snapshot -and $Snapshot.Contains('networkDriverMissing') -and $Snapshot.networkDriverMissing) { return &amp; $o 'PausedAwaitingNetwork' ([string] $Snapshot.networkDriverMissing) }
    if ($net.Count) { return &amp; $o 'PausedAwaitingNetwork' ("$(($net | ForEach-Object { $_.name }) -join ', '): waiting for the network. $(($net | ForEach-Object { $_.detail } | Where-Object { $_ }) -join '; ')".Trim()) }
    if ($Snapshot -and $Snapshot.Contains('monitorOverdue') -and $Snapshot.monitorOverdue) { return &amp; $o 'PausedAwaitingUser' (@($Snapshot.needsAttention) | Select-Object -Last 1) }
    $user = @($live | Where-Object { $_.state -in 'Stalled', 'LaunchFailed' -or $_.idle })
    if ($user.Count) { return &amp; $o 'PausedAwaitingUser' (($user | ForEach-Object { "$($_.name): $(if ($_.idle) { $_.idle } else { "$($_.state). $($_.detail)" })" }) -join ' ') }
    if ($Snapshot -and $Snapshot.currentStage) {
        $cur = @($live | Where-Object { $_.id -eq $Snapshot.currentStage } | Select-Object -First 1)
        return &amp; $o 'InProgress' $(if ($cur.Count -and $cur[0].activity) { "$($cur[0].name): $($cur[0].activity)" } else { "Current stage: $($Snapshot.currentStage)." })
    }
    $waiting = @($live | Where-Object { $_.activity })
    return &amp; $o 'InProgress' $(if ($waiting.Count) { (($waiting | ForEach-Object { "$($_.name): $($_.activity)" }) -join ' ') } else { 'Launching the deployment stages; no engine has reported yet.' })
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\bootstrap\\Stage-Deployment.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Verifies the deployment files and copies them to the protected package folder.

.DESCRIPTION
    Called by Initialize-Deployment.ps1 (and by Resume-Deployment.ps1 for a re-check). Run by hand
    it only verifies a package and changes nothing.

    Sources:
      Embedded  The files the answer file extracted during specialize under C:\\Windows\\Setup\\Scripts
                (Administrators-only). Used at the first sign-in of a USB installation, so nothing
                depends on the USB drive still being attached or on its drive letter.
      Package   A WindowsDeployment folder (from the ZIP, on a USB drive or a local disk), identified
                by the location of the script that was started, never by guessing a drive letter.

    Every file is checked against deployment-manifest.json before anything is copied, copied to
    &lt;dataRoot&gt;\\Package, and checked again there. Nothing is executed from the source location.
#&gt;
[CmdletBinding()]
param(
    [ValidateSet('Embedded', 'Package')]
    [string] $SourceMode = 'Embedded',
    [string] $SourceRoot = '',
    [string] $EmbeddedRoot = 'C:\\Windows\\Setup\\Scripts'
)

$script:StageMain = $MyInvocation.InvocationName -ne '.'
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')

# Files the orchestrator needs before it can launch anything (both modes).
$script:RequiredForStart = @(
    'scripts/common/DeploymentCommon.ps1',
    'scripts/bootstrap/Initialize-Deployment.ps1',
    'scripts/orchestrator/DeploymentOrchestrator.ps1',
    'scripts/finalization/Complete-Deployment.ps1'
)

# SYSTEM and Administrators full control, Users read and execute, no entries inherited from
# ProgramData (the same rule as the engine installers). Elevated tasks run scripts from here.
function Set-WddAcl {
    param([string] $Root, [string[]] $Grant = @('*S-1-5-18:(OI)(CI)F', '*S-1-5-32-544:(OI)(CI)F', '*S-1-5-32-545:(OI)(CI)RX'))
    # Only the folder itself gets explicit entries; Windows propagates them to everything below.
    # Never icacls /T with (OI)(CI) grants: on files those entries are dropped, which leaves every
    # file protected with no entries at all, unreadable even for SYSTEM and Administrators.
    # No /C either: with it icacls exits with 0 even when it fails.
    &amp; icacls.exe $Root /inheritance:r /grant:r @Grant /Q | Out-Null
    if ($LASTEXITCODE -ne 0) { throw "icacls failed with exit code $LASTEXITCODE on $Root; refusing to run elevated scripts from an unprotected folder." }
    # Repairs what an earlier version left below (files protected with no entries, folders with a
    # protected copy of these entries): they inherit again. Deliberately private folders (settings
    # backups) have other entries and keep them.
    function Get-Entries { param($Acl) (@($Acl.Access | ForEach-Object { "$($_.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value)=$([int] $_.FileSystemRights)" }) | Sort-Object) -join ';' }
    $own = Get-Entries (Get-Acl -LiteralPath $Root)
    foreach ($item in @(Get-ChildItem -LiteralPath $Root -Recurse -Force -Attributes !ReparsePoint -ErrorAction SilentlyContinue)) {
        $damaged = $true
        try {
            $acl = Get-Acl -LiteralPath $item.FullName
            $e = Get-Entries $acl
            $damaged = $acl.AreAccessRulesProtected -and ($e -eq '' -or $e -eq $own)
        } catch { }
        if (-not $damaged) { continue }
        &amp; icacls.exe $item.FullName /reset /Q | Out-Null
        if ($LASTEXITCODE -ne 0) { throw "icacls /reset failed with exit code $LASTEXITCODE on $($item.FullName); refusing to run elevated scripts from an unprotected folder." }
    }
}

# Where a manifest file comes from in each mode.
function Get-WddSourcePath {
    param([hashtable] $File, [string] $SourceMode, [string] $SourceRoot, [string] $EmbeddedRoot)
    if ($SourceMode -eq 'Package') { return Join-Path $SourceRoot ($File.path -replace '/', '\\') }
    if (-not $File.embedded) { return $null }
    return Join-Path $EmbeddedRoot $File.embedded
}

&lt;#
    Returns @{ Ok; Message; Files (staged manifest paths); Missing; Mismatched }.
#&gt;
function Invoke-WddStage {
    param([hashtable] $Manifest, [string] $ManifestPath, [string] $SourceMode, [string] $SourceRoot, [string] $EmbeddedRoot, [hashtable] $Paths, [switch] $VerifyOnly)
    $files = @(@($Manifest.files) | Where-Object { $SourceMode -eq 'Package' -or $_.embedded })
    $relPaths = @($files | ForEach-Object { $_.path })
    foreach ($r in $script:RequiredForStart) {
        if ($r -notin $relPaths) { return @{ Ok = $false; Message = "The manifest does not list the required file $r."; Files = @(); Missing = @($r); Mismatched = @() } }
    }

    # 1. Verify the source.
    $missing = @(); $mismatched = @()
    foreach ($f in $files) {
        $src = Get-WddSourcePath $f $SourceMode $SourceRoot $EmbeddedRoot
        if (-not $src -or -not (Test-Path -LiteralPath $src -PathType Leaf)) { $missing += $f.path; continue }
        if ($SourceMode -eq 'Package') {
            if ((Get-WddRawHash $src) -ne $f.sha256) { $mismatched += $f.path }
        } elseif ($f.textSha256) {
            if ((Get-WddTextHash $src) -ne $f.textSha256) { $mismatched += $f.path }
        } elseif ($src -like '*.json') {
            try { Get-Content -LiteralPath $src -Raw | ConvertFrom-Json | Out-Null } catch { $mismatched += $f.path }
        }
    }
    if ($missing.Count -or $mismatched.Count) {
        $msg = "Package verification failed ($SourceMode): $($missing.Count) missing, $($mismatched.Count) modified."
        Write-WddLog $msg 'ERROR'
        foreach ($m in $missing) { Write-WddLog "  missing   $m" 'ERROR' }
        foreach ($m in $mismatched) { Write-WddLog "  modified  $m" 'ERROR' }
        return @{ Ok = $false; Message = $msg; Files = @(); Missing = $missing; Mismatched = $mismatched }
    }
    Write-WddLog "Verified $($files.Count) file(s) from the $SourceMode source against manifest $($Manifest.packageId)."
    if ($VerifyOnly) { return @{ Ok = $true; Message = 'Verified (no changes made).'; Files = $relPaths; Missing = @(); Mismatched = @() } }

    # 2. Copy into a fresh package folder; the previous one (from an earlier run) is kept aside.
    $target = $Paths.Package
    if (Test-Path -LiteralPath $target) {
        $previous = "$target.previous"
        if (Test-Path -LiteralPath $previous) { Remove-Item -LiteralPath $previous -Recurse -Force }
        Move-Item -LiteralPath $target -Destination $previous -Force
    }
    New-Item -ItemType Directory -Path $target -Force | Out-Null
    foreach ($f in $files) {
        $src = Get-WddSourcePath $f $SourceMode $SourceRoot $EmbeddedRoot
        $dst = Join-Path $target ($f.path -replace '/', '\\')
        $dir = Split-Path -Parent $dst
        if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
        Copy-Item -LiteralPath $src -Destination $dst -Force
    }
    Copy-Item -LiteralPath $ManifestPath -Destination (Join-Path $target 'deployment-manifest.json') -Force

    # 3. Verify the copies (text hash works for both sources).
    $check = Test-WddFiles $target $Manifest 'Text' $relPaths
    if (-not $check.Ok) {
        $msg = "Staged copy failed verification: $($check.Missing.Count) missing, $($check.Mismatched.Count) modified."
        Write-WddLog $msg 'ERROR'
        return @{ Ok = $false; Message = $msg; Files = @(); Missing = $check.Missing; Mismatched = $check.Mismatched }
    }
    Write-WddLog "Staged $($files.Count) file(s) to $target and verified them."
    @{ Ok = $true; Message = "Staged $($files.Count) file(s)."; Files = $relPaths; Missing = @(); Mismatched = @() }
}

# Dot-sourcing (tests, Initialize-Deployment.ps1) only defines the functions.
if ($script:StageMain) {
    $root = if ($SourceRoot) { $SourceRoot } else { Split-Path -Parent (Split-Path -Parent $PSScriptRoot) }
    $manifestPath = Join-Path $root 'deployment-manifest.json'
    $manifest = Read-WddManifest $manifestPath
    $paths = Get-WddPaths $manifest.dataRoot
    $r = Invoke-WddStage $manifest $manifestPath $SourceMode $root $EmbeddedRoot $paths -VerifyOnly
    $r.Message
    foreach ($m in $r.Missing) { "  missing   $m" }
    foreach ($m in $r.Mismatched) { "  modified  $m" }
    if (-not $r.Ok) { exit 1 }
    exit 0
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\bootstrap\\Initialize-Deployment.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Starts the post-installation deployment: verifies and stages the package, launches each
    enabled stage once in its own context and registers the deployment monitor.

.DESCRIPTION
    The answer file runs this as the last FirstLogon command (elevated, as the user that signs in
    first). setup.ps1 runs it for a manual deployment from a WindowsDeployment folder.

    1. Refuses Windows PE, non-elevated sessions, and a second concurrent run (mutex).
    2. Reads deployment-manifest.json and the persistent state (&lt;dataRoot&gt;\\state\\deployment.json).
       A finished deployment is not started again; a running one is not launched twice.
    3. Secures &lt;dataRoot&gt;, verifies the package and copies it to &lt;dataRoot&gt;\\Package
       (Stage-Deployment.ps1). Nothing is launched if verification fails.
    4. Launches each enabled stage once, in manifest order, by running that engine's own installer
       from the staged copy:
         windowsUpdate  Install-UpdateEngine.ps1      registers a SYSTEM task
         applications   Install-ApplicationEngine.ps1 registers a task for this user (WinGet is not
                        supported as SYSTEM, so this script must run as the user, not SYSTEM)
       Each launch is recorded before it starts, so a crash cannot launch a stage twice.
    5. Registers \\WindowsDeploymentBuilder\\Deployment (SYSTEM; at startup and every
       monitorIntervalMinutes), which follows the engines, writes status.json, recovers stalled
       stages within a bound and, at the end, writes the deployment report.
    6. Orchestrator 1.2.0: registers \\WindowsDeploymentBuilder\\Progress for the signed-in user (at
       every sign-in while the deployment runs; opens the read-only progress window, which can be
       closed at any time) and, when the package enables it, \\WindowsDeploymentBuilder\\StatusServer
       (SYSTEM, at startup: the read-only LAN monitor). Every task is checked after registration.
       A stage whose task could not be registered ends initialization with InitializedWithProblems
       (exit code 1) and the reason, never with a plain success.
    7. Opens the progress window for the signed-in user (unless -NoConsole).
#&gt;
[CmdletBinding()]
param(
    [ValidateSet('Embedded', 'Package')]
    [string] $SourceMode = 'Embedded',
    [string] $SourceRoot = '',
    [string] $EmbeddedRoot = 'C:\\Windows\\Setup\\Scripts',
    [switch] $NoConsole
)

$script:InitMain = $MyInvocation.InvocationName -ne '.'
# Captured first: dot-sourcing Stage-Deployment.ps1 binds its own parameters in this scope.
$script:InitArgs = @{ SourceMode = $SourceMode; SourceRoot = $SourceRoot; EmbeddedRoot = $EmbeddedRoot; NoConsole = [bool] $NoConsole }
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')
. (Join-Path $PSScriptRoot 'Stage-Deployment.ps1')

$script:MonitorTask = @{ path = '\\WindowsDeploymentBuilder\\'; name = 'Deployment' }
$script:ProgressTask = @{ path = '\\WindowsDeploymentBuilder\\'; name = 'Progress' }
$script:StatusServerTask = @{ path = '\\WindowsDeploymentBuilder\\'; name = 'StatusServer' }
$script:StatusServerScript = 'scripts\\monitor\\DeploymentStatusServer.ps1'

# ------------------------------------------------------------------------------------------------
# Adapters
# ------------------------------------------------------------------------------------------------

# Runs an engine installer in its own Windows PowerShell process; returns the exit code. Its
# output goes to the log, and its last line is kept as the reason when no task is registered.
function Invoke-WddInstaller {
    param([string] $Path)
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $out = &amp; $ps -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $Path 2&gt;&amp;1
    foreach ($line in @($out)) { Write-WddLog "    | $line" }
    $script:WddInstallerOutput = @(@($out) | ForEach-Object { "$_".Trim() } | Where-Object { $_ })
    return $LASTEXITCODE
}

function Register-WddMonitorTask {
    param([hashtable] $Paths, [hashtable] $Manifest)
    $script = Join-Path $Paths.Package 'scripts\\orchestrator\\DeploymentOrchestrator.ps1'
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $action = New-ScheduledTaskAction -Execute $ps -Argument "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File \`"$script\`""
    $atStartup = New-ScheduledTaskTrigger -AtStartup
    $atStartup.Delay = 'PT2M'
    $days = [Math]::Ceiling(([double] $Manifest.failureHandling.orchestrator.deadlineHours) / 24) + 1
    $every = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(2) -RepetitionInterval (New-TimeSpan -Minutes (Get-WddMonitorInterval $Manifest)) -RepetitionDuration (New-TimeSpan -Days $days)
    $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -MultipleInstances IgnoreNew -ExecutionTimeLimit (New-TimeSpan -Minutes 30)
    Register-ScheduledTask -TaskName $script:MonitorTask.name -TaskPath $script:MonitorTask.path -Action $action -Trigger @($atStartup, $every) -Principal $principal -Settings $settings -Force \`
        -Description 'Windows Deployment Builder: follows the deployment stages, writes status.json and the final report, then removes itself.' | Out-Null
}

&lt;#
    Orchestrator 1.2.0: opens the progress window at every sign-in of the deployment user while the
    deployment runs. It runs as that user without elevation (a viewer, not an engine); a second
    copy exits at once (single instance), and the task is removed when the deployment finishes.
#&gt;
function Register-WddProgressTask {
    param([hashtable] $Paths, [string] $User, [int] $IntervalSeconds = 7)
    $show = Join-Path $Paths.Package 'scripts\\orchestrator\\Show-DeploymentStatus.ps1'
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $action = New-ScheduledTaskAction -Execute $ps -Argument "-NoProfile -ExecutionPolicy Bypass -File \`"$show\`" -Watch -AutoStarted -IntervalSeconds $IntervalSeconds"
    $trigger = New-ScheduledTaskTrigger -AtLogOn -User $User
    $trigger.Delay = 'PT20S'
    $principal = New-ScheduledTaskPrincipal -UserId $User -LogonType Interactive -RunLevel Limited
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew -ExecutionTimeLimit ([TimeSpan]::Zero)
    Register-ScheduledTask -TaskName $script:ProgressTask.name -TaskPath $script:ProgressTask.path -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force \`
        -Description 'Windows Deployment Builder: opens the read-only deployment progress window at sign-in while the deployment runs. Closing the window does not stop the deployment. Removed when the deployment finishes.' | Out-Null
}

&lt;#
    Orchestrator 1.2.0: the read-only LAN monitor (DeploymentStatusServer.ps1) as SYSTEM, started at
    every startup and restarted if it stops. It serves status only; it ends itself after the
    deployment (see the script).
#&gt;
function Register-WddStatusServerTask {
    param([hashtable] $Paths)
    $server = Join-Path $Paths.Package $script:StatusServerScript
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $action = New-ScheduledTaskAction -Execute $ps -Argument "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File \`"$server\`""
    $trigger = New-ScheduledTaskTrigger -AtStartup
    $trigger.Delay = 'PT1M'
    $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -MultipleInstances IgnoreNew -ExecutionTimeLimit ([TimeSpan]::Zero) -RestartCount 5 -RestartInterval (New-TimeSpan -Minutes 1)
    Register-ScheduledTask -TaskName $script:StatusServerTask.name -TaskPath $script:StatusServerTask.path -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force \`
        -Description 'Windows Deployment Builder: read-only deployment monitor (HTTP). Serves status only; removes itself after the deployment.' | Out-Null
}

function Start-WddConsole {
    param([hashtable] $Paths)
    $show = Join-Path $Paths.Package 'scripts\\orchestrator\\Show-DeploymentStatus.ps1'
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    Start-Process -FilePath $ps -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', "\`"$show\`"", '-Watch')
}

function Get-WddRecoveryShortcut {
    param([hashtable] $Paths)
    $tool = Join-Path $Paths.Package 'scripts\\recovery\\DeploymentRecovery.ps1'
    if (-not (Test-Path -LiteralPath $tool)) { return $null }
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    @{ Target = $ps; Arguments = "-NoProfile -ExecutionPolicy Bypass -File \`"$tool\`" -Elevate" }
}

function Get-WddProgressShortcut {
    param([hashtable] $Paths)
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    @{ Target = $ps; Arguments = "-NoProfile -ExecutionPolicy Bypass -File \`"$(Join-Path $Paths.Package 'scripts\\orchestrator\\Show-DeploymentStatus.ps1')\`" -Watch" }
}

# ------------------------------------------------------------------------------------------------
# Initialization
# ------------------------------------------------------------------------------------------------

&lt;# Minutes between monitor runs (the manifest's value; 15 for manifests written before 1.2.0). #&gt;
&lt;# The LAN monitor block of the manifest (absent or disabled: $null). #&gt;
function Get-WddMonitorConfig {
    param([hashtable] $Manifest)
    if (-not $Manifest.ContainsKey('monitor') -or $Manifest.monitor -isnot [hashtable] -or -not $Manifest.monitor['enabled']) { return $null }
    return $Manifest.monitor
}

&lt;#
    Registers the viewer tasks that follow the deployment user and the LAN monitor, and checks that
    each one exists afterwards. Returns the problems (empty when everything is registered).
#&gt;
function Register-WddHelperTasks {
    param([hashtable] $Manifest, [hashtable] $Paths, [string] $User)
    $problems = @()
    if ($User -and $User -notmatch '(?i)^(NT AUTHORITY\\\\)?SYSTEM$') {
        try { Register-WddProgressTask $Paths $User } catch { $problems += "progress window task: $($_.Exception.Message)" }
        if (-not (Get-WddTask $script:ProgressTask.path $script:ProgressTask.name) -and -not ($problems -match 'progress window')) { $problems += 'progress window task: not found after registration' }
    }
    if (Get-WddMonitorConfig $Manifest) {
        if (-not (Test-Path -LiteralPath (Join-Path $Paths.Package $script:StatusServerScript))) { $problems += "LAN monitor: $($script:StatusServerScript) is missing from the package" }
        else {
            try { Register-WddStatusServerTask $Paths } catch { $problems += "LAN monitor task: $($_.Exception.Message)" }
            if (Get-WddTask $script:StatusServerTask.path $script:StatusServerTask.name) {
                try { Start-WddTask $script:StatusServerTask.path $script:StatusServerTask.name } catch { Write-WddLog "Could not start the LAN monitor now; it starts at the next startup: $($_.Exception.Message)" 'WARN' }
            } elseif (-not ($problems -match 'LAN monitor')) { $problems += 'LAN monitor task: not found after registration' }
        }
    }
    foreach ($p in $problems) { Write-WddLog "Helper task: $p" 'WARN' }
    # One problem per pipeline object; callers collect them with @().
    return $problems
}

function New-WddState {
    param([hashtable] $Manifest, [string] $SourceMode, [hashtable] $Identity)
    $now = Get-WddNow
    $o = $Manifest.failureHandling.orchestrator
    $boot = $null
    try { $boot = (Get-WddBootTime).ToString('o') } catch { }
    @{
        schemaVersion        = 2
        packageId            = $Manifest.packageId
        packageVersion       = $Manifest.packageVersion
        orchestratorVersion  = $script:DeployVersion
        sourceMode           = $SourceMode
        status               = 'Staging'
        initializedUtc       = $now.ToString('o')
        initializedBy        = $Identity.Name
        deadlineUtc          = $now.AddHours([double] $Manifest.failureHandling.orchestrator.deadlineHours).ToString('o')
        stalledAfterMinutes  = [int] $Manifest.failureHandling.orchestrator.stalledAfterMinutes
        # Orchestrator 1.2.0: no-progress limit for long Windows Update phases, restart history.
        longOperationMinutes = $(if ($o -is [hashtable] -and $o.ContainsKey('longOperationMinutes')) { [int] $o.longOperationMinutes } else { 240 })
        lastBootUtc          = $boot
        restarts             = @()
        stagedFiles          = @()
        stages               = @{}
        monitorRuns          = 0
        overall              = ''
        message              = ''
        recoveries           = @()
    }
}

&lt;#
    Launches one engine stage unless it was already launched. Returns its launch record.
#&gt;
function Invoke-WddLaunchStage {
    param([hashtable] $Stage, [hashtable] $Paths, [hashtable] $State, [hashtable] $Identity, [int] $MaxAttempts)
    $rec = if ($State.stages.ContainsKey($Stage.id)) { $State.stages[$Stage.id] } else { @{ launchResult = ''; attempts = 0; launchedUtc = $null; exitCode = $null; message = '' } }
    $State.stages[$Stage.id] = $rec
    # Phase 5: who the stage runs as (a user-context stage only runs while that user is signed in).
    if (-not $rec.ContainsKey('user') -or -not $rec.user) { $rec.user = $(if ($Stage.context -eq 'user') { [string] $Identity.Name } else { 'SYSTEM' }) }
    if ($rec.launchResult -eq 'Launched') { Write-WddLog "Stage $($Stage.id) was already launched; not launching it again."; return $rec }
    # Interrupted earlier launch: if its task exists the installer finished registering it.
    if ($rec.launchResult -eq 'Launching' -and (Get-WddTask $Stage.task.path $Stage.task.name)) {
        $rec.launchResult = 'Launched'; $rec.message = 'Task found after an interrupted launch.'
        Write-WddLog "Stage $($Stage.id): task found after an interrupted launch; marked launched."
        return $rec
    }
    if ($Stage.context -eq 'user' -and $Identity.IsSystem) {
        $rec.launchResult = 'LaunchFailed'
        $rec.message = 'This stage must be started by the signed-in user (WinGet is not supported as SYSTEM). Sign in and run Resume-Deployment.ps1 -RestartStage applications.'
        Write-WddLog "Stage $($Stage.id): $($rec.message)" 'ERROR'
        return $rec
    }
    if ([int] $rec.attempts -ge $MaxAttempts) {
        $rec.launchResult = 'LaunchFailed'
        if (-not $rec.message) { $rec.message = "Launch attempts exhausted ($MaxAttempts)." }
        return $rec
    }
    $installer = Join-Path $Paths.Package ($Stage.launcher -replace '/', '\\')
    $rec.attempts = [int] $rec.attempts + 1
    $rec.launchResult = 'Launching'
    $rec.launchedUtc = (Get-WddNow).ToString('o')
    Save-WddState $Paths $State
    Write-WddLog "Launching stage $($Stage.id) ($($Stage.context)): $installer"
    $code = $null
    $script:WddInstallerOutput = @()
    # The reason of THIS attempt (an earlier message, such as "Restarted manually.", is not one).
    $failure = $null
    if (-not (Test-Path -LiteralPath $installer)) { $failure = "The installer is missing from the staged package: $installer" }
    else { try { $code = Invoke-WddInstaller $installer } catch { $failure = $_.Exception.Message; Write-WddLog "  installer error: $failure" 'ERROR' } }
    $rec.exitCode = $code
    if (Get-WddTask $Stage.task.path $Stage.task.name) {
        $rec.launchResult = 'Launched'
        if ($code -ne 0) { $rec.message = "The installer returned $code, but the task is registered; it will run at the next start or sign-in." }
        Write-WddLog "Stage $($Stage.id) launched (task $($Stage.task.path)$($Stage.task.name), installer exit code $code)."
    } elseif (Test-Path -LiteralPath (Join-Path $Paths.Root $Stage.result)) {
        $rec.launchResult = 'Launched'; $rec.message = 'Finished during launch.'
    } else {
        $rec.launchResult = $(if ([int] $rec.attempts -ge $MaxAttempts) { 'LaunchFailed' } else { 'Launching' })
        $reason = @($script:WddInstallerOutput) | Select-Object -Last 1
        $rec.message = $(if ($failure) { $failure } else { "The installer returned $code and registered no task $($Stage.task.path)$($Stage.task.name)$(if ($reason) { ": $reason" } else { '.' })" })
        Write-WddLog "Stage $($Stage.id): $($rec.message)" 'ERROR'
    }
    Save-WddState $Paths $State
    return $rec
}

function Invoke-WddInitialize {
    param([hashtable] $Manifest, [string] $ManifestPath, [string] $SourceMode, [string] $SourceRoot, [string] $EmbeddedRoot, [hashtable] $Paths, [switch] $NoConsole)
    Initialize-WddLogging $Paths
    $identity = Get-WddIdentity
    Write-WddLog "==== Deployment orchestrator $($script:DeployVersion): initialize ($SourceMode) as $($identity.Name), package $($Manifest.packageId) ===="
    if (Test-WddWinPE) { Write-WddLog 'Refusing to run in Windows PE.' 'ERROR'; return 'RefusedWinPE' }
    if (-not $identity.IsAdmin) { Write-WddLog 'Refusing to run without administrator rights.' 'ERROR'; return 'RefusedNotElevated' }

    $mutex = Enter-WddMutex 120
    if (-not $mutex) { Write-WddLog 'Another deployment process is running; nothing to do.' 'WARN'; return 'Busy' }
    try {
        $read = Read-WddDeploymentState $Paths
        if ($read.Source -eq 'corrupt') {
            # Never start over on top of a damaged state: that would launch stages a second time.
            Write-WddLog "The deployment state is damaged ($($read.Problem)); refusing to start over. Run DeploymentRecovery.ps1 -Action Resume." 'ERROR'
            return 'StateCorrupt'
        }
        $state = $read.State
        if ($state) {
            if ($state.packageId -ne $Manifest.packageId -and $state.status -notin 'Completed', 'StagingFailed') {
                Write-WddLog "A different deployment ($($state.packageId)) is still in progress; refusing to start $($Manifest.packageId). Finish or reset it first (see recovery instructions)." 'ERROR'
                return 'AnotherDeploymentInProgress'
            }
            if ($state.packageId -eq $Manifest.packageId -and $state.status -eq 'Completed') {
                Write-WddLog "This deployment already finished ($($state.overall)). Report: $($Paths.ReportText)"
                return 'AlreadyCompleted'
            }
            if ($state.packageId -ne $Manifest.packageId) { $state = $null }
        }
        if (-not $state -or $state.status -eq 'StagingFailed') { $state = New-WddState $Manifest $SourceMode $identity }
        # A staged copy that failed its integrity check is replaced; launch records are kept, so
        # stages that were already launched are not launched again.
        if ($state.status -eq 'IntegrityFailed') { $state.status = 'Staging'; $state.sourceMode = $SourceMode; $state.message = 'Re-staging after an integrity failure.' }
        foreach ($k in 'stages') { if (-not $state[$k]) { $state[$k] = @{} } }

        # Stage (verify + copy) unless already staged for this package.
        if ($state.status -eq 'Staging') {
            Set-WddAcl $Paths.Root
            $staged = Invoke-WddStage $Manifest $ManifestPath $SourceMode $SourceRoot $EmbeddedRoot $Paths
            if (-not $staged.Ok) {
                $state.status = 'StagingFailed'; $state.overall = 'Failed'; $state.message = $staged.Message
                Save-WddState $Paths $state
                $snap = [ordered]@{ packageId = $Manifest.packageId; updatedUtc = (Get-WddNow).ToString('o'); deploymentState = 'StagingFailed'; overall = 'Failed'; message = $staged.Message; missing = $staged.Missing; modified = $staged.Mismatched }
                Set-WddSnapshotOutcome $snap $state
                Write-WddJson $Paths.Status $snap
                Write-WddEvent 3002 "Deployment not started: $($staged.Message) See $($Paths.Log)." 'Error'
                return 'StagingFailed'
            }
            Set-WddAcl $Paths.Root
            $state.stagedFiles = $staged.Files
            $state.status = 'Launching'
            Save-WddState $Paths $state
        }

        # Launch each enabled engine stage once.
        $max = [int] $Manifest.failureHandling.orchestrator.launchAttempts
        foreach ($stage in Get-WddEngineStages $Manifest) {
            Invoke-WddLaunchStage $stage $Paths $state $identity $max | Out-Null
        }

        $state.status = 'InProgress'
        Save-WddState $Paths $state
        $monitorError = $null
        try { Register-WddMonitorTask $Paths $Manifest } catch { $monitorError = $_.Exception.Message }
        if (-not $monitorError -and -not (Get-WddTask $script:MonitorTask.path $script:MonitorTask.name)) { $monitorError = 'the task was not found after registration.' }
        if ($monitorError) {
            # Without the monitor nothing follows the stages: say so instead of failing silently.
            $state.message = "The monitor task $($script:MonitorTask.path)$($script:MonitorTask.name) could not be registered: $monitorError Run Resume-Deployment.ps1 as administrator."
            Save-WddState $Paths $state
            Write-WddLog $state.message 'ERROR'
            Write-WddEvent 3002 "Deployment $($Manifest.packageId): $($state.message)" 'Error'
            return 'MonitorRegistrationFailed'
        }
        Write-WddLog "Registered $($script:MonitorTask.path)$($script:MonitorTask.name) (SYSTEM; at startup and every $(Get-WddMonitorInterval $Manifest) minutes)."
        $helperProblems = @(Register-WddHelperTasks $Manifest $Paths ([string] $identity.Name))
        # Orchestrator 1.2.0: initialization is complete only when every stage task exists.
        $notLaunched = @(Get-WddEngineStages $Manifest | Where-Object { [string] $state.stages[$_.id].launchResult -ne 'Launched' })
        if ($notLaunched.Count) {
            $state.message = "Initialized, but $($notLaunched.Count) stage(s) could not be started: $(($notLaunched | ForEach-Object { "$($_.name): $($state.stages[$_.id].message)" }) -join ' ') The monitor retries automatically where it can; see the progress window."
            Write-WddLog $state.message 'ERROR'
            Write-WddEvent 3002 "Deployment $($Manifest.packageId): $($state.message)" 'Warning'
        } elseif ($helperProblems.Count) {
            $state.message = "The deployment runs, but a helper task could not be registered: $($helperProblems -join '; ')"
        }
        Save-WddState $Paths $state
        Add-WddActivity $Paths $(if ($notLaunched.Count) { $state.message } else { "Deployment started: $(@(Get-WddEngineStages $Manifest).Count) stage(s) scheduled ($((Get-WddEngineStages $Manifest | ForEach-Object { $_.name }) -join ', '))." }) $(if ($notLaunched.Count) { 'error' } else { 'info' })
        $snapshot = Get-WddSnapshot $Manifest $Paths $state
        Write-WddJson $Paths.Status $snapshot
        try {
            $sc = Get-WddProgressShortcut $Paths
            New-WddShortcut 'Deployment progress' $sc.Target $sc.Arguments 'Windows Deployment Builder: deployment progress'
        } catch { Write-WddLog "Could not create the progress shortcut: $($_.Exception.Message)" 'WARN' }
        # Phase 5: the technician recovery entry point, when the package carries it.
        $rt = Get-WddRecoveryShortcut $Paths
        if ($rt) {
            try { New-WddShortcut 'Deployment recovery' $rt.Target $rt.Arguments 'Windows Deployment Builder: status, retry failed applications, resume, diagnostics (asks for administrator rights)' }
            catch { Write-WddLog "Could not create the recovery shortcut: $($_.Exception.Message)" 'WARN' }
        }
        Write-WddEvent 3000 "Deployment $($Manifest.packageId) started. Status: $($Paths.Status)."
        try { Start-WddTask $script:MonitorTask.path $script:MonitorTask.name } catch { Write-WddLog "Could not start the monitor now; it runs within $(Get-WddMonitorInterval $Manifest) minutes: $($_.Exception.Message)" 'WARN' }
        if (-not $NoConsole) {
            # The progress task opens the window without elevation (single instance); a direct start is the fallback.
            $opened = $false
            if (Get-WddTask $script:ProgressTask.path $script:ProgressTask.name) { try { Start-WddTask $script:ProgressTask.path $script:ProgressTask.name; $opened = $true } catch { Write-WddLog "Could not start the progress task: $($_.Exception.Message)" 'WARN' } }
            if (-not $opened) { try { Start-WddConsole $Paths } catch { Write-WddLog "Could not open the progress window: $($_.Exception.Message)" 'WARN' } }
        }
        if ($notLaunched.Count) { return 'InitializedWithProblems' }
        return 'Initialized'
    } finally {
        Exit-WddMutex $mutex
    }
}

# Dot-sourcing (tests) only defines the functions.
if ($script:InitMain) {
    $a = $script:InitArgs
    $root = if ($a.SourceRoot) { $a.SourceRoot } else { Split-Path -Parent (Split-Path -Parent $PSScriptRoot) }
    $manifestPath = Join-Path $root 'deployment-manifest.json'
    try {
        $manifest = Read-WddManifest $manifestPath
    } catch {
        Write-Output "ERROR: $($_.Exception.Message)"
        exit 2
    }
    $paths = Get-WddPaths $manifest.dataRoot
    $outcome = Invoke-WddInitialize $manifest $manifestPath $a.SourceMode $root $a.EmbeddedRoot $paths -NoConsole:$a.NoConsole
    $detail = ''
    if ($outcome -eq 'InitializedWithProblems') { $s = (Read-WddDeploymentState $paths).State; if ($s) { $detail = " $($s.message)" } }
    Write-Output "Deployment: $outcome.$detail Log: $($paths.Log)"
    if ($outcome -in 'Initialized', 'AlreadyCompleted', 'Busy') { exit 0 }
    exit 1
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\orchestrator\\DeploymentOrchestrator.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Deployment monitor: follows the stages, keeps status.json current and finishes the deployment.

.DESCRIPTION
    Runs as SYSTEM from \\WindowsDeploymentBuilder\\Deployment (registered by
    Initialize-Deployment.ps1) at startup and every monitorIntervalMinutes (5 for packages from
    orchestrator 1.2.0, 15 before), so it survives every restart. Each run is short and idempotent:

      1. Single instance (mutex shared with Initialize and Resume).
      2. Verifies the staged package against its manifest before doing anything else. A modified
         or missing file stops the deployment monitor (IntegrityFailed); nothing is executed.
      3. Reads what each engine wrote (result.json, status.json, its task) and writes
         &lt;dataRoot&gt;\\Deployment\\status.json. Completion markers are not trusted on their own:
         the final status always comes from result.json.
      4. Once the windowsUpdate stage is final, applies the ongoing update policy if the package
         carries one (Set-UpdatePolicy.ps1, Phase 4.3).
      5. When every enabled stage is final, or the deadline has passed, runs
         Complete-Deployment.ps1 (report, marker, event, cleanup).

    Orchestrator 1.2.0 (watchdog, startup reconciliation; the same monitor, not a second one):
      - Restart detection: a new boot is recorded as planned (an engine scheduled it: restart
        marker, a stage that was Rebooting or whose restart count grew) or unexpected, in the
        state (restarts) and the activity feed, and the deployment shows "recovering" while the
        unfinished stages are checked.
      - Bounded automatic recovery, at most autoRecoveries times per stage (2 by default):
          SYSTEM stage whose task is gone without a result  -&gt; its installer runs again
                                                               (Invoke-WddLaunchStage, as Resume does)
          stage with no progress whose task is not running -&gt; its task is started again
        A stage of the signed-in user is never started from SYSTEM: it is reported with what to do.
        When the budget is used up the stage stays Stalled and needs a technician; no loop.
      - Stage changes, recoveries and restarts go to the activity feed.
      - The progress window and LAN monitor tasks are registered again if they are missing.
    Engines keep their own single-instance guards, so a recovery never runs an engine twice.

    Orchestrator 1.3.0 (bare-metal review):
      - Restart coordination (Step-WddRestartCoordinator): a restart Windows still needs (servicing
        indicators, devices with code 14, applications that need one) is announced, then done
        when nothing installs, under the install lock, after saving the state; at most
        coordinatedRestarts per deployment, never twice in one boot.
      - The deployment finishes only after that restart: Windows Update is searched again
        (one more run of its stage when it offers more) and Device Manager is checked in the new
        boot.
      - Finalization never hangs: an error is logged and retried; after finalizeAttempts a
        minimal report ends the deployment with a follow-up.

    Phase 5: a damaged deployment.json is replaced by its last good copy; if neither is usable the
    monitor stops (StateCorrupt) instead of acting on a guess, and the recovery tool rebuilds it.
    status.json carries the machine-readable outcome (outcome, outcomeCode, outcomeDetail).
#&gt;
[CmdletBinding()]
param()

$script:MonitorMain = $MyInvocation.InvocationName -ne '.'
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')
. (Join-Path $PSScriptRoot '..\\finalization\\Complete-Deployment.ps1')
# Orchestrator 1.2.0: the launch and task functions used by the watchdog (functions only when dot-sourced).
. (Join-Path $PSScriptRoot '..\\bootstrap\\Initialize-Deployment.ps1')

&lt;#
    Records a new boot: planned when an engine scheduled it (restart marker of the previous boot, a
    stage that was Rebooting, or a stage whose restart count grew since the last run), otherwise
    unexpected. Returns the record, or $null when Windows has not restarted since the last run.
#&gt;
function Step-WddRestartCheck {
    param([hashtable] $Paths, [hashtable] $State, [hashtable] $Manifest)
    try { $boot = Get-WddBootTime } catch { return $null }
    $prev = ConvertTo-WddDate $State['lastBootUtc']
    $State.lastBootUtc = $boot.ToString('o')
    if (-not $prev -or [Math]::Abs(($boot - $prev).TotalSeconds) -le 2) { return $null }
    $planned = $false; $by = ''; $reason = ''
    $m = Read-WddJson $Paths.RestartMarker
    if ($m -is [hashtable]) {
        $mb = ConvertTo-WddDate $m['bootTimeUtc']
        if ($mb -and [Math]::Abs(($mb - $prev).TotalSeconds) -le 2) { $planned = $true; $by = [string] $m['owner']; $reason = [string] $m['reason'] }
    }
    $seen = $(if ($State['seenReboots'] -is [hashtable]) { $State['seenReboots'] } else { @{} })
    $phases = $(if ($State['seenPhases'] -is [hashtable]) { $State['seenPhases'] } else { @{} })
    foreach ($s in Get-WddEngineStages $Manifest) {
        if ($planned) { break }
        $st = Read-WddJson (Join-Path $Paths.Root $s.status)
        $now = $(if ($st -is [hashtable] -and $st.ContainsKey('reboots')) { [int] $st['reboots'] } else { 0 })
        if ($now -gt [int] $seen[$s.id] -or [string] $phases[$s.id] -in 'Rebooting', 'RebootDeferred') { $planned = $true; $by = $s.name; $reason = $(if ($st -is [hashtable]) { [string] $st['detail'] } else { '' }) }
    }
    $rec = [ordered]@{ bootUtc = $boot.ToString('o'); previousBootUtc = $prev.ToString('o'); detectedUtc = (Get-WddNow).ToString('o'); planned = $planned; by = $by; reason = $reason }
    $State.restarts = @(@(@($State['restarts']) | Where-Object { $_ }) + @($rec) | Select-Object -Last 50)
    $State.recoveringUntilUtc = (Get-WddNow).AddMinutes(10).ToString('o')
    $msg = $(if ($planned) { "Windows restarted (scheduled by $(if ($by) { $by } else { 'the deployment' })$(if ($reason) { ": $reason" })). Restoring deployment progress and checking unfinished tasks." }
             else { 'Windows restarted unexpectedly (the deployment had not scheduled a restart). Restoring deployment progress and checking unfinished tasks; interrupted operations are resumed or reported.' })
    Add-WddActivity $Paths $msg $(if ($planned) { 'info' } else { 'warning' })
    Write-WddEvent 3007 $msg $(if ($planned) { 'Information' } else { 'Warning' })
    return $rec
}

&lt;# What the next restart check compares against: each stage's restart count and phase. #&gt;
function Save-WddSeenStages {
    param([hashtable] $State, $Snapshot)
    $r = @{}; $p = @{}
    foreach ($s in @($Snapshot.stages)) { $r[$s.id] = [int] $s.reboots; $p[$s.id] = [string] $s.status }
    $State.seenReboots = $r; $State.seenPhases = $p
}

&lt;#
    Bounded automatic recovery of stalled stages (see the description). Returns the number of
    recoveries attempted in this run.
#&gt;
function Invoke-WddWatchdog {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State, $Snapshot)
    $o = $Manifest.failureHandling.orchestrator
    $max = $(if ($o -is [hashtable] -and $o.ContainsKey('autoRecoveries')) { [int] $o.autoRecoveries } else { 2 })
    $acted = 0
    foreach ($s in @($Snapshot.stages)) {
        if ($s.state -eq 'Final' -or -not $State.stages.ContainsKey($s.id)) { continue }
        $stage = Get-WddStage $Manifest $s.id
        $rec = $State.stages[$s.id]
        $action = $null; $why = ''
        if ($s.state -eq 'Stalled') { $action = 'Relaunch'; $why = 'its scheduled task is missing and it has no result' }
        elseif ($s.state -eq 'LaunchFailed' -and [string] $rec['message'] -notlike '*must be started by the signed-in user*') { $action = 'Relaunch'; $why = "it could not be started ($($rec['message']))" }
        elseif ($s.stale) {
            $info = Get-WddTaskInfo $stage.task.path $stage.task.name
            if ($info.Exists -and $info.State -ne 'Running') { $action = 'StartTask'; $why = "no progress for $($s.staleMinutes) minutes and its task is not running (last result 0x$('{0:X8}' -f ([int64] $info.LastResult -band 4294967295)))" }
            elseif ($info.Exists) {
                if (-not $rec['staleReported']) {
                    $rec.staleReported = $true
                    Add-WddActivity $Paths "$($s.name): no progress detected for $($s.staleMinutes) minutes while its task is still running. Waiting; technician attention may be required if this continues." 'warning'
                }
                continue
            }
        }
        if (-not $action) { if ($rec['staleReported'] -and -not $s.stale) { $rec.staleReported = $false }; continue }
        if ($stage.context -eq 'user') {
            # WinGet runs only as the signed-in user: never started from SYSTEM.
            if (-not $rec['userActionReported']) {
                $rec.userActionReported = $true
                $who = $(if ($rec['user']) { [string] $rec['user'] } else { 'the deployment user' })
                Add-WddActivity $Paths "$($s.name): $why. It must be restarted by $who\`: sign in and run Resume-Deployment.ps1 -RestartStage $($s.id) as administrator. Technician attention required." 'error'
            }
            continue
        }
        $used = [int] $rec['autoRecoveries']
        if ($used -ge $max) {
            if (-not $rec['autoRecoveryExhausted']) {
                $rec.autoRecoveryExhausted = $true
                $msg = "$($s.name): $why. Automatic recovery was already attempted $max time(s). Technician attention required: see the log, then run Resume-Deployment.ps1 -RestartStage $($s.id)."
                Add-WddActivity $Paths $msg 'error'
                Write-WddEvent 3008 $msg 'Error'
            }
            continue
        }
        $rec.autoRecoveries = $used + 1
        $ok = $false; $err = ''
        if ($action -eq 'Relaunch') {
            $rec.launchResult = ''; $rec.attempts = 0
            $r = Invoke-WddLaunchStage $stage $Paths $State (Get-WddIdentity) ([int] $o.launchAttempts)
            $ok = $r.launchResult -eq 'Launched'
            if (-not $ok) { $err = [string] $r.message }
        } else {
            try { Start-WddTask $stage.task.path $stage.task.name; $ok = $true } catch { $err = $_.Exception.Message }
        }
        $State.recoveries = @(@($State['recoveries']) + @(@{ atUtc = (Get-WddNow).ToString('o'); by = 'monitor (automatic)'; action = "Automatic$action"; stage = $s.id; reason = $why
                                                            accepted = @(if ($ok) { "stage:$($s.id)" }); refused = @(if (-not $ok) { "stage:$($s.id)" }); attempt = $rec.autoRecoveries; message = $err }))
        $State.recoveringUntilUtc = (Get-WddNow).AddMinutes(10).ToString('o')
        $msg = "$($s.name): no progress ($why). Automatic recovery attempted ($(if ($action -eq 'Relaunch') { 'stage started again' } else { 'task started again' }), $($rec.autoRecoveries) of $max): $(if ($ok) { 'done; technician attention may be required if it still does not progress.' } else { "it failed: $err Technician attention may be required." })"
        Add-WddActivity $Paths $msg $(if ($ok) { 'warning' } else { 'error' })
        Write-WddEvent 3008 $msg $(if ($ok) { 'Warning' } else { 'Error' })
        $acted++
    }
    return $acted
}

&lt;# One activity entry for every stage whose state or phase changed since the last run. #&gt;
function Step-WddStageActivity {
    param([hashtable] $Paths, [hashtable] $State, $Snapshot)
    $seen = $(if ($State['seenStages'] -is [hashtable]) { $State['seenStages'] } else { @{} })
    foreach ($s in @($Snapshot.stages)) {
        $sig = "$($s.state)|$($s.status)"
        if ([string] $seen[$s.id] -eq $sig) { continue }
        $seen[$s.id] = $sig
        $level = $(if ($s.condition -eq 'blocked') { 'warning' } elseif ($s.state -eq 'Final') { $(if ($s.outcome -eq 'ok') { 'info' } elseif ($s.outcome -eq 'failed') { 'error' } else { 'warning' }) } else { 'info' })
        Add-WddActivity $Paths "$($s.name): $($s.activity)" $level
    }
    $State.seenStages = $seen
}

# ------------------------------------------------------------------------------------------------
# Orchestrator 1.3.0: restart coordination, update re-check, safe finalization
# ------------------------------------------------------------------------------------------------

# Stage phases during which a restart interrupts nothing (the engine is not working; it continues after the boot).
$script:RestartSafePhases = @('RebootDeferred', 'WaitingForRestart', 'WaitingForReboot', 'WaitingForLock', 'WaitingForNetwork', 'WaitingForUpdates', 'WaitingForDrivers', 'WaitingForApplications', 'Error')

function Get-WddOrchestratorLimit {
    param([hashtable] $Manifest, [string] $Name, [int] $Default)
    $o = $Manifest.failureHandling['orchestrator']
    if ($o -is [hashtable] -and $o.ContainsKey($Name) -and $null -ne $o[$Name]) { return [int] $o[$Name] }
    return $Default
}

&lt;#
    Why Windows needs a restart now (empty: it does not): its own servicing indicators, devices
    whose driver needs a restart (Device Manager code 14) and applications that finished with
    "restart required". Device problems that a restart does not fix are not reasons.
#&gt;
function Get-WddRestartNeed {
    param($Snapshot)
    $reasons = @(Get-WddServicingRestart | Where-Object { $_ })
    try {
        $dev = @(Get-WddPnpDevices | Where-Object { $_ -is [System.Collections.IDictionary] -and [int] $_['problemCode'] -eq 14 })
        if ($dev.Count) { $reasons += "$($dev.Count) device(s) need a restart to finish installing their driver ($((@($dev | ForEach-Object { [string] $_['name'] }) | Select-Object -First 3) -join ', '))" }
    } catch { }
    foreach ($s in @($Snapshot.stages)) {
        if ($s.state -ne 'Final' -or $s.result -isnot [hashtable] -or -not $s.result.ContainsKey('packages')) { continue }
        $apps = @(@($s.result['packages']) | Where-Object { $_ -is [hashtable] -and [string] $_['status'] -eq 'RequiresRestart' })
        if ($apps.Count) { $reasons += "$($apps.Count) application(s) need a restart to finish ($((@($apps | ForEach-Object { [string] $_['name'] }) | Select-Object -First 3) -join ', '))" }
    }
    return @{ Required = ($reasons.Count -gt 0); Reasons = $reasons }
}

&lt;#
    Restarts the computer when Windows needs it and nothing is being installed. The engines restart
    for themselves while they run; this covers what they cannot: a restart still required when a
    stage (or every stage) has finished, and a restart an engine had to defer.
      1. A restart is needed (Get-WddRestartNeed) and no engine has scheduled one in this boot.
      2. First sighting: announced (activity feed, progress window); the restart happens at the
         next run at the earliest, so an engine that is about to restart itself goes first.
      3. Blockers, re-checked at every run: a stage that is working (installing, downloading,
         scanning ...), the Windows Update installer busy, an MSI installation running, a stage
         task that would not resume after the boot, the install lock held by an engine.
      4. Then: install lock taken (and held through the warning), restart marker written, state
         saved, shutdown /r with a warning; the restart is recorded and expected at the next boot.
    Loop prevention: at most coordinatedRestarts per deployment, never twice in the same boot; when
    the limit is reached Windows' pending restart is reported for the technician instead.
    Returns the restart view status: NotRequired, EngineRestartScheduled, Announced, Blocked,
    Restarting, LimitReached, Failed.
#&gt;
function Step-WddRestartCoordinator {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State, $Snapshot)
    $max = Get-WddOrchestratorLimit $Manifest 'coordinatedRestarts' 3
    $warn = Get-WddOrchestratorLimit $Manifest 'restartWarningSeconds' 120
    $rc = $(if ($State['restartCoordinator'] -is [hashtable]) { $State['restartCoordinator'] } else { @{ restarts = 0; status = 'NotRequired'; reasons = @(); blockers = @(); history = @() } })
    $State.restartCoordinator = $rc
    $boot = $(try { (Get-WddBootTime).ToString('o') } catch { '' })
    if ($rc['lastRestartBoot'] -and [string] $rc['lastRestartBoot'] -eq $boot -and $rc['status'] -eq 'Restarting') { return 'Restarting' }
    if ($Snapshot.restartPending) { $rc.status = 'EngineRestartScheduled'; $rc.message = 'An engine has scheduled a restart.'; return $rc.status }
    $need = Get-WddRestartNeed $Snapshot
    if (-not $need.Required) {
        if ($rc['status'] -in 'Announced', 'Blocked') { Add-WddActivity $Paths 'Windows no longer reports a pending restart; no restart is needed.' }
        $rc.status = 'NotRequired'; $rc.reasons = @(); $rc.blockers = @(); $rc.message = ''; $rc.pendingSinceUtc = $null
        return $rc.status
    }
    $rc.reasons = @($need.Reasons)
    if ([int] $rc['restarts'] -ge $max) {
        if ($rc['status'] -ne 'LimitReached') {
            $rc.message = "Windows still needs a restart ($(@($need.Reasons) -join '; ')) after $max automatic restart(s); no further automatic restart (restart-loop protection). Restart the computer once by hand, then check the report."
            Add-WddActivity $Paths $rc.message 'error'
            Write-WddEvent 3010 $rc.message 'Error'
        }
        $rc.status = 'LimitReached'
        return $rc.status
    }
    $blockers = @()
    foreach ($s in @($Snapshot.stages)) {
        if ($s.state -eq 'Final') { continue }
        if ($s.state -eq 'Running' -and [string] $s.status -notin $script:RestartSafePhases) { $blockers += "$($s.name) is working ($($s.status))" }
        $stage = Get-WddStage $Manifest $s.id
        if ($stage -and $s.state -in 'Running', 'Pending' -and -not (Get-WddTask $stage.task.path $stage.task.name)) { $blockers += "the task of $($s.name) is missing, so it would not continue after the restart" }
        if ($s.state -in 'Stalled', 'LaunchFailed') { $blockers += "$($s.name) is $($s.state) and would not continue after the restart" }
    }
    $inst = Test-WddInstallerActive
    if ($inst) { $blockers += $inst }
    $now = Get-WddNow
    if ($rc['status'] -notin 'Announced', 'Blocked' -or -not $rc['pendingSinceUtc']) {
        $rc.pendingSinceUtc = $now.ToString('o'); $rc.status = 'Announced'; $rc.blockers = @($blockers)
        $rc.message = "Windows needs a restart: $(@($need.Reasons) -join '; '). The deployment restarts the computer automatically at its next check (in about $(Get-WddMonitorInterval $Manifest) minutes) when nothing is being installed."
        Add-WddActivity $Paths $rc.message
        return $rc.status
    }
    if ($blockers.Count) {
        $sig = ($blockers -join '|')
        if ([string] $rc['blockedBy'] -ne $sig) {
            $rc.blockedBy = $sig
            Add-WddActivity $Paths "A restart is needed but waits: $($blockers -join '; '). It happens automatically once this clears." 'warning'
        }
        $rc.status = 'Blocked'; $rc.blockers = @($blockers)
        $rc.message = "A restart is needed ($(@($need.Reasons) -join '; ')) but waits: $($blockers -join '; ')."
        return $rc.status
    }
    $lock = Enter-WddInstallLock $Paths
    if (-not $lock) {
        $rc.status = 'Blocked'; $rc.blockers = @('another installation holds the install lock')
        $rc.message = "A restart is needed ($(@($need.Reasons) -join '; ')) but an installation holds the install lock; it waits for it to finish."
        return $rc.status
    }
    try {
        $reason = "Windows needs a restart ($(@($need.Reasons) -join '; '))"
        $rc.restarts = [int] $rc['restarts'] + 1
        $rc.status = 'Restarting'; $rc.blockers = @(); $rc.blockedBy = ''; $rc.lastRestartBoot = $boot; $rc.lastRestartUtc = $now.ToString('o'); $rc.pendingSinceUtc = $null
        $rc.history = @(@(@($rc['history']) | Where-Object { $_ }) + @([ordered]@{ atUtc = $now.ToString('o'); reasons = @($need.Reasons); restart = [int] $rc.restarts }) | Select-Object -Last 20)
        $rc.message = "$reason. Restarting the computer (automatic restart $($rc.restarts) of at most $max); the deployment continues after the restart."
        # Durable before anything else: the next boot is recognised as planned, the engines start nothing new.
        Set-WddRestartMarker $Paths $reason
        Save-WddState $Paths $State
        Add-WddActivity $Paths $rc.message
        Write-WddEvent 3009 $rc.message 'Information'
        Write-WddLog $rc.message 'WARN'
        Invoke-WddRestart $warn $reason
        Wait-WddRestart ($warn + 60)
    } catch {
        $rc.status = 'Failed'; $rc.message = "The automatic restart could not be started: $($_.Exception.Message) Restart the computer by hand."
        Add-WddActivity $Paths $rc.message 'error'
        Write-WddLog $rc.message 'ERROR'
        Remove-Item -LiteralPath $Paths.RestartMarker -Force -ErrorAction SilentlyContinue
    } finally {
        Exit-WddInstallLock $lock
    }
    return $rc.status
}

&lt;#
    After the stages have finished and Windows needs no further restart: a read-only Windows Update
    search under the deployment's own policy. Updates Windows offers only now (often after a
    restart) get one more run of the Windows Update stage (updateRechecks, 1 by default); after
    that, what is still offered is reported, never hidden behind "no updates remain".
    Returns Relaunched, NothingOffered, Remaining, CheckFailed or Skipped.
#&gt;
function Step-WddUpdateRecheck {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State, $Snapshot)
    $wu = @(@($Snapshot.stages) | Where-Object { $_.id -eq 'windowsUpdate' } | Select-Object -First 1)
    if (-not $wu.Count -or $wu[0].state -ne 'Final' -or $wu[0].status -eq 'Offline') { return 'Skipped' }
    $rk = $(if ($State['updateRecheck'] -is [hashtable]) { $State['updateRecheck'] } else { @{ relaunches = 0; status = '' } })
    $State.updateRecheck = $rk
    # Once per final result of the stage: a relaunched stage that finishes again is checked again.
    $sig = "$($wu[0].status)|$($wu[0].updatedUtc)"
    if ([string] $rk['checkedFor'] -eq $sig) { return [string] $rk['status'] }
    $cfg = Read-WddJson (Join-Path $Paths.Root 'Updates\\config.json')
    $list = $null
    try { $list = @(Get-WddOfferedUpdates $cfg | Where-Object { $_ -is [System.Collections.IDictionary] }) }
    catch {
        $rk.checkedFor = $sig; $rk.status = 'CheckFailed'; $rk.checkedUtc = (Get-WddNow).ToString('o'); $rk.message = "Windows Update could not be searched again: $($_.Exception.Message)"
        Add-WddActivity $Paths $rk.message 'warning'
        return $rk.status
    }
    $rk.checkedFor = $sig; $rk.checkedUtc = (Get-WddNow).ToString('o'); $rk.remaining = @($list)
    if (-not $list.Count) { $rk.status = 'NothingOffered'; $rk.message = 'Windows Update was searched again after the stages finished: nothing the deployment installs is offered.'; Add-WddActivity $Paths $rk.message; return $rk.status }
    $names = (@($list | ForEach-Object { "$((@($_['kbs']) -join ',')) $($_['title'])".Trim() }) | Select-Object -First 5) -join '; '
    $max = Get-WddOrchestratorLimit $Manifest 'updateRechecks' 1
    $stage = Get-WddStage $Manifest 'windowsUpdate'
    if ([int] $rk['relaunches'] -lt $max -and $stage) {
        $rk.relaunches = [int] $rk['relaunches'] + 1
        $State.stages['windowsUpdate'] = @{ launchResult = ''; attempts = 0; launchedUtc = $null; exitCode = $null; message = "Run again: Windows Update offered $($list.Count) more update(s) after the stage finished."; user = 'SYSTEM' }
        $r = Invoke-WddLaunchStage $stage $Paths $State (Get-WddIdentity) ([int] $Manifest.failureHandling.orchestrator.launchAttempts)
        if ($r.launchResult -eq 'Launched') {
            $rk.status = 'Relaunched'
            $rk.message = "Windows Update offers $($list.Count) more update(s) ($names); the Windows Update stage runs once more ($($rk.relaunches) of $max)."
            Add-WddActivity $Paths $rk.message
            return $rk.status
        }
        Add-WddActivity $Paths "Windows Update offers $($list.Count) more update(s), but its stage could not be started again: $($r.message)" 'warning'
    }
    $rk.status = 'Remaining'
    $rk.message = "Windows Update still offers $($list.Count) update(s) the deployment would install ($names). Install them from Settings &gt; Windows Update."
    Add-WddActivity $Paths $rk.message 'warning'
    return $rk.status
}

&lt;#
    Finishes the deployment and never leaves it hanging: an error while writing the report is
    logged with its location and retried at the next run; after finalizeAttempts failures a minimal
    report is written and the deployment ends with a follow-up (the error is in the report).
#&gt;
function Invoke-WddFinalize {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State, $Snapshot, [switch] $DeadlineReached)
    try {
        $overall = Complete-WddDeployment $Manifest $Paths $State $Snapshot -DeadlineReached:$DeadlineReached
        return "Completed:$overall"
    } catch {
        $err = $_
        $State.finalizeFailures = [int] $State['finalizeFailures'] + 1
        $State.lastFinalizeError = "$($err.Exception.Message) ($(@($err.ScriptStackTrace -split "\`n")[0]))"
        Write-WddLog "Finishing the deployment failed ($($State.finalizeFailures)): $($err.Exception.Message)\`r\`n$($err.ScriptStackTrace)" 'ERROR'
        $max = Get-WddOrchestratorLimit $Manifest 'finalizeAttempts' 3
        if ([int] $State.finalizeFailures -lt $max) {
            Add-WddActivity $Paths "Writing the final report failed (attempt $($State.finalizeFailures) of $max): $($err.Exception.Message). Tried again at the next check." 'error'
            Save-WddState $Paths $State
            $Snapshot.finalizeError = $State.lastFinalizeError
            Set-WddSnapshotOutcome $Snapshot $State
            Write-WddJson $Paths.Status $Snapshot
            return 'FinalizeFailed'
        }
        $overall = Get-WddOverall $Snapshot.stages -DeadlineReached:$DeadlineReached
        if ($overall -eq 'Succeeded') { $overall = 'CompletedWithFollowUp' }
        $now = (Get-WddNow).ToString('o')
        $msg = "The final report could not be written after $max attempts ($($State.lastFinalizeError)); this minimal report lists the stage results. See $($Paths.Log)."
        $report = [ordered]@{ packageId = $Manifest.packageId; generatedUtc = $now; overall = $overall; reason = $msg; minimal = $true
                              stages = @(@($Snapshot.stages) | ForEach-Object { [ordered]@{ id = $_.id; name = $_.name; state = $_.state; status = $_.status; detail = $_.detail } }) }
        try { Write-WddJson $Paths.ReportJson $report; [IO.File]::WriteAllText($Paths.ReportText, "Windows Deployment Builder - deployment report (minimal)\`r\`nOverall: $overall\`r\`n$msg\`r\`n" + ((@($report.stages) | ForEach-Object { "$($_.name): $($_.state) $($_.status) $($_.detail)" }) -join "\`r\`n"), (New-Object System.Text.UTF8Encoding($true))) } catch { }
        Write-WddJson $Paths.Marker ([ordered]@{ status = $overall; finishedUtc = $now; report = $Paths.ReportJson })
        $State.status = 'Completed'; $State.overall = $overall; $State.completedUtc = $now; $State.message = $msg
        Save-WddState $Paths $State
        $Snapshot.deploymentState = 'Completed'; $Snapshot.overall = $overall
        Set-WddSnapshotOutcome $Snapshot $State
        Write-WddJson $Paths.Status $Snapshot
        Add-WddActivity $Paths "Deployment finished: $overall. $msg" 'error'
        Write-WddEvent 3105 $msg 'Error'
        try { Unregister-WddTask '\\WindowsDeploymentBuilder\\' 'Deployment'; Unregister-WddTask '\\WindowsDeploymentBuilder\\' 'Progress' } catch { }
        return "Completed:$overall"
    }
}

&lt;# The progress window and LAN monitor tasks, registered again if they were removed while the deployment runs. #&gt;
function Confirm-WddHelperTasks {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State)
    $user = [string] $State['initializedBy']
    $missing = (-not (Get-WddTask $script:ProgressTask.path $script:ProgressTask.name) -and $user -and $user -notmatch '(?i)^(NT AUTHORITY\\\\)?SYSTEM$') -or
               ((Get-WddMonitorConfig $Manifest) -and -not (Get-WddTask $script:StatusServerTask.path $script:StatusServerTask.name))
    if (-not $missing) { return }
    $problems = @(Register-WddHelperTasks $Manifest $Paths $user)
    Add-WddActivity $Paths $(if ($problems.Count) { "A helper task could not be registered again: $($problems -join '; ')" } else { 'The progress window and monitor tasks were registered again.' }) $(if ($problems.Count) { 'warning' } else { 'info' })
}

function Invoke-WddMonitor {
    param([hashtable] $Paths)
    Initialize-WddLogging $Paths
    $mutex = Enter-WddMutex 30
    if (-not $mutex) { Write-WddLog 'Monitor: another deployment process is running; skipping this run.'; return 'Busy' }
    try {
        $read = Read-WddDeploymentState $Paths
        $state = $read.State
        if ($read.Source -eq 'corrupt') {
            $msg = "The deployment state is damaged and its backup is unusable ($($read.Problem)). The monitor stopped; nothing is run. Run DeploymentRecovery.ps1 -Action Resume to rebuild it."
            Write-WddLog $msg 'ERROR'
            $snap = [ordered]@{ updatedUtc = (Get-WddNow).ToString('o'); deploymentState = 'StateCorrupt'; overall = 'Failed'; message = $msg }
            Set-WddSnapshotOutcome $snap $null $read.Problem
            Write-WddJson $Paths.Status $snap
            Write-WddEvent 3004 $msg 'Error'
            return 'StateCorrupt'
        }
        if (-not $state) { Write-WddLog 'Monitor: no deployment state; nothing to follow.' 'WARN'; return 'NoState' }
        if ($state.status -eq 'Completed') { Unregister-WddTask '\\WindowsDeploymentBuilder\\' 'Deployment'; return 'AlreadyCompleted' }
        if ($state.status -eq 'IntegrityFailed') { return 'IntegrityFailed' }

        $manifestPath = Join-Path $Paths.Package 'deployment-manifest.json'
        try { $manifest = Read-WddManifest $manifestPath } catch { $manifest = $null; $err = $_.Exception.Message }
        $check = if ($manifest) { Test-WddFiles $Paths.Package $manifest 'Text' @($state.stagedFiles) } else { @{ Ok = $false; Missing = @('deployment-manifest.json'); Mismatched = @() } }
        if (-not $check.Ok -or ($manifest -and $manifest.packageId -ne $state.packageId)) {
            $state.status = 'IntegrityFailed'
            $state.message = "The staged package was modified or is incomplete ($($check.Missing.Count) missing, $($check.Mismatched.Count) modified). The monitor stopped; nothing more is run by it."
            Save-WddState $Paths $state
            Write-WddLog $state.message 'ERROR'
            foreach ($m in @($check.Missing) + @($check.Mismatched)) { Write-WddLog "  $m" 'ERROR' }
            $snap = [ordered]@{ packageId = $state.packageId; updatedUtc = (Get-WddNow).ToString('o'); deploymentState = 'IntegrityFailed'; overall = 'Failed'; message = $state.message }
            Set-WddSnapshotOutcome $snap $state
            Write-WddJson $Paths.Status $snap
            Write-WddEvent 3003 $state.message 'Error'
            return 'IntegrityFailed'
        }

        $state.monitorRuns = [int] $state.monitorRuns + 1
        $state.lastMonitorUtc = (Get-WddNow).ToString('o')
        Limit-WddActivity $Paths
        # Orchestrator 1.2.0: restart detection, bounded recovery, activity feed, helper tasks.
        [void] (Step-WddRestartCheck $Paths $state $manifest)
        $snapshot = Get-WddSnapshot $manifest $Paths $state
        if ((Invoke-WddWatchdog $manifest $Paths $state $snapshot) -gt 0) { $snapshot = Get-WddSnapshot $manifest $Paths $state }
        Step-WddStageActivity $Paths $state $snapshot
        Save-WddSeenStages $state $snapshot
        if (-not $snapshot.allFinal) { try { Confirm-WddHelperTasks $manifest $Paths $state } catch { Write-WddLog "Helper tasks: $($_.Exception.Message)" 'WARN' } }
        # Phase 4.3: the ongoing update policy, once the initial Windows Update stage is final.
        if (Get-Command Step-WddUpdatePolicy -ErrorAction SilentlyContinue) {
            $policy = Step-WddUpdatePolicy $manifest $Paths $state $snapshot
            if ($policy) { $snapshot.updatePolicy = $policy }
        }
        $deadline = ConvertTo-WddDate $state.deadlineUtc
        $deadlineReached = [bool] ($deadline -and (Get-WddNow) -ge $deadline)
        # Orchestrator 1.3.0: a restart Windows needs, before finishing and whenever no stage is working.
        $restart = 'NotRequired'
        if (-not $deadlineReached) {
            try { $restart = Step-WddRestartCoordinator $manifest $Paths $state $snapshot } catch { Write-WddLog "Restart coordination: $($_.Exception.Message)" 'WARN' }
            $snapshot.restart = Get-WddRestartView $state
        }
        # After the stages and any restart: Windows Update is searched again (one more run if it offers more).
        $recheck = ''
        if ($snapshot.allFinal -and $restart -in 'NotRequired', 'LimitReached', 'Failed') {
            try { $recheck = Step-WddUpdateRecheck $manifest $Paths $state $snapshot } catch { Write-WddLog "Windows Update re-check: $($_.Exception.Message)" 'WARN' }
            if ($recheck -eq 'Relaunched') { $snapshot = Get-WddSnapshot $manifest $Paths $state }
        }
        Set-WddSnapshotOutcome $snapshot $state
        $snapshot.condition = Get-WddCondition $snapshot $state
        Save-WddState $Paths $state
        Write-WddJson $Paths.Status $snapshot
        $summary = (@($snapshot.stages) | ForEach-Object { "$($_.id)=$($_.state)$(if ($_.status) { "/$($_.status)" })" }) -join ', '
        Write-WddLog "Monitor run $($state.monitorRuns): $summary; restart: $restart$(if ($recheck) { "; update re-check: $recheck" })"

        if ($snapshot.allFinal) {
            # Finished only when no restart is still to be done (a blocked one waits at most restartWaitMinutes).
            $hold = $restart -in 'Announced', 'Restarting', 'EngineRestartScheduled'
            if ($restart -eq 'Blocked') {
                $since = ConvertTo-WddDate $state.restartCoordinator['pendingSinceUtc']
                $hold = -not $since -or ((Get-WddNow) - $since).TotalMinutes -lt (Get-WddOrchestratorLimit $manifest 'restartWaitMinutes' 120)
            }
            if ($hold) { return 'WaitingForRestart' }
            # Schema 9: the optional activation stage, last, once (never holds the deployment).
            if (Get-Command Step-WddActivation -ErrorAction SilentlyContinue) {
                try { [void] (Step-WddActivation $manifest $Paths $state $snapshot $restart); $snapshot.activation = Get-WddActivationView $manifest $state } catch { Write-WddLog "Activation: $($_.Exception.Message)" 'WARN' }
            }
            return (Invoke-WddFinalize $manifest $Paths $state $snapshot)
        }
        if ($deadlineReached) {
            Write-WddLog "Deadline $($state.deadlineUtc) reached with unfinished stages." 'WARN'
            return (Invoke-WddFinalize $manifest $Paths $state $snapshot -DeadlineReached)
        }
        return 'InProgress'
    } finally {
        Exit-WddMutex $mutex
    }
}

if ($script:MonitorMain) {
    # The monitor lives in &lt;dataRoot&gt;\\Package\\scripts\\orchestrator; dataRoot comes from the manifest.
    $package = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
    $manifest = Read-WddManifest (Join-Path $package 'deployment-manifest.json')
    $outcome = Invoke-WddMonitor (Get-WddPaths $manifest.dataRoot)
    Write-Output $outcome
    if ($outcome -in 'IntegrityFailed', 'StateCorrupt') { exit 1 }
    exit 0
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\orchestrator\\Show-DeploymentStatus.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Shows the deployment progress in the console (read-only; no elevation needed).

.DESCRIPTION
    Reads the deployment state and what each engine wrote, live (it does not wait for the monitor):
    current stage, what each stage is doing and why it waits, when it last made progress, the
    application being installed, applications remaining, pending restart, recent activity
    (restarts, retries, failures, recoveries), whether a person needs to act, and the address of
    the LAN monitor when the package enables it.

    Orchestrator 1.3.0: the window runs without elevation and cannot see the SYSTEM tasks, so it
    never reports a task as missing itself (the SYSTEM monitor's own view is used); it shows the
    restart Windows still needs and when the monitor last ran (overdue: needs attention).

    -Watch refreshes every 7 seconds until the deployment has finished. Orchestrator 1.2.0: the
    task \\WindowsDeploymentBuilder\\Progress opens it with -Watch -AutoStarted at every sign-in of
    the deployment user while the deployment runs. Only one window runs per session (a second one
    exits at once). It is a viewer: closing it never affects the deployment, and it stops opening
    once the deployment has finished (the task is removed then; -AutoStarted also exits at once
    when the deployment is already complete).

    Phase 9: when the deployment verifies itself and its configuration asks for it, the watching
    window opens the technician health report once, when verification has written it (never at a
    later sign-in).
#&gt;
[CmdletBinding()]
param(
    [switch] $Watch,
    [int] $IntervalSeconds = 7,
    [switch] $AutoStarted
)

$script:ShowMain = $MyInvocation.InvocationName -ne '.'
$script:ShowArgs = @{ Watch = [bool] $Watch; Interval = [Math]::Max(2, $IntervalSeconds); AutoStarted = [bool] $AutoStarted }
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')

$script:ProgressMutexName = 'Local\\WindowsDeploymentBuilder-Progress'
$script:ConditionText = @{ active = 'Working'; waiting = 'Waiting'; idle = 'Idle'; blocked = 'NEEDS ATTENTION'; finished = 'Finished' }

&lt;# The LAN monitor's address and token as the status server wrote them (state\\monitor.json), or $null. #&gt;
function Get-WddMonitorInfo {
    param([hashtable] $Paths)
    if (-not $Paths.ContainsKey('MonitorInfo')) { return $null }
    $m = Read-WddJson $Paths.MonitorInfo
    if ($m -is [hashtable] -and $m['token'] -and $m['port']) { return $m }
    return $null
}

&lt;# Lines describing how to reach the LAN monitor (empty when the package has none). #&gt;
function Format-WddMonitorLines {
    param([hashtable] $Manifest, [hashtable] $Paths)
    $l = @()
    if (-not $Manifest.ContainsKey('monitor') -or $Manifest.monitor -isnot [hashtable] -or -not $Manifest.monitor['enabled']) { return }
    $m = Get-WddMonitorInfo $Paths
    if (-not $m) { return 'Monitor        : starting (the address appears here once it runs)' }
    if ([string] $m['mode'] -in 'stopped', 'error') { return "Monitor        : $($m['mode']). $($m['message'])" }
    $fragment = "/#t=$($m['token'])"
    $lan = @(@($m['urls']) | Where-Object { $_ -and $_ -notmatch '127\\.0\\.0\\.1|localhost' })
    if ($m['lanAccess'] -and $lan.Count) {
        $l += "Monitor        : $($lan[0])$fragment"
        foreach ($u in @($lan | Select-Object -Skip 1)) { $l += "                 $u$fragment" }
        $l += '                 Open it in a browser on another computer, phone or tablet on this network (read-only).'
    } else {
        $l += "Monitor        : http://127.0.0.1:$($m['port'])$fragment  (this computer only)"
    }
    if ($m['message']) { $l += "                 $($m['message'])" }
    return $l
}

function Format-WddStatus {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State)
    $s = Get-WddSnapshot $Manifest $Paths $State
    $l = New-Object System.Collections.Generic.List[string]
    $l.Add('Windows Deployment Builder - deployment progress')
    $l.Add('================================================')
    $overall = if ($State -and $State.status -eq 'Completed') { "Finished: $($State.overall)" } elseif ($State) { $State.status } else { 'Not started' }
    $cond = $(if ($s.Contains('condition')) { [string] $s.condition } else { '' })
    $l.Add("Deployment     : $overall$(if ($cond -and $cond -ne 'complete') { " ($cond)" })")
    $l.Add("Outcome        : $($s.outcome) (code $($s.outcomeCode)) $($s.outcomeDetail)")
    if ($State -and $State.message) { $l.Add("                 $($State.message)") }
    if ($State) { $l.Add("Started (UTC)  : $($State.initializedUtc)   deadline: $($State.deadlineUtc)") }
    $l.Add("Current stage  : $(if ($s.currentStage) { $s.currentStage } else { '-' })")
    $l.Add("Last activity  : $(if ($s.Contains('lastActivityUtc') -and $s.lastActivityUtc) { "$(Format-WddAge $s.lastActivityUtc) ($($s.lastActivityUtc))" } else { 'none reported yet' })")
    # Orchestrator 1.3.0: the restart Windows needs, and whether the SYSTEM monitor still runs.
    $rv = $(if ($s.Contains('restart')) { $s.restart } else { $null })
    if ($rv -and $rv.status -in 'Announced', 'Blocked', 'Restarting', 'LimitReached', 'Failed') { $l.Add("Restart        : $($rv.status). $($rv.message)") }
    else { $l.Add("Restart pending: $(if ($s.restartPending) { 'yes (a restart has been scheduled)' } else { 'no' })") }
    if ($s.Contains('monitorLastRunUtc') -and $State -and $State.status -ne 'Completed') {
        $l.Add("Monitor checks : $(if ($s.monitorLastRunUtc) { "last $(Format-WddAge $s.monitorLastRunUtc)" } else { 'not run yet' }), every $(Get-WddMonitorInterval $Manifest) min$(if ($s.monitorOverdue) { ' - OVERDUE (see NEEDS ATTENTION)' })")
    }
    if ($script:WddTaskVisibility -eq 'Limited') { $l.Add('Task view      : this window runs without administrator rights, so task problems are taken from the deployment monitor.') }
    # Schema 9: activation, reported apart from the installation results (never a key).
    if ($s.Contains('activation') -and $s.activation) {
        $l.Add("Activation     : Windows $($s.activation['windows']['status']); Office $($s.activation['office']['status'])")
        foreach ($k in 'windows', 'office') { $e = $s.activation[$k]; if ($e -and [string] $e['status'] -notin 'NotRequested', 'Waiting') { $l.Add("  $($k.PadRight(13)): $($e['message'])") } }
    }
    if ($s.Contains('recovering') -and $s.recovering) { $l.Add('Recovering     : Windows restarted or a stage was recovered; unfinished tasks are being checked.') }
    foreach ($m in Format-WddMonitorLines $Manifest $Paths) { $l.Add($m) }
    $l.Add('')
    $l.Add(('{0,-22} {1,-16} {2}' -f 'Stage', 'State', 'What is happening'))
    foreach ($st in @($s.stages)) {
        $c = $(if ($st.Contains('condition') -and $script:ConditionText.ContainsKey([string] $st.condition)) { $script:ConditionText[[string] $st.condition] } else { $st.state })
        $what = $(if ($st.Contains('activity') -and $st.activity) { $st.activity } else { "$($st.status) $($st.detail)".Trim() })
        $l.Add(('{0,-22} {1,-16} {2}' -f $st.name, $c, $what))
        if ($st.id -eq 'applications') {
            if ($st.current) { $l.Add("  installing now: $($st.current) (progress unavailable: WinGet does not report it)") }
            if ($null -ne $st.total -and [int] $st.total -gt 0) { $l.Add("  applications: $($st.done) of $($st.total) done, $([int] $st.total - [int] $st.done) remaining$(if ($st.Contains('counts') -and $st.counts.Contains('failed') -and [int] $st.counts.failed) { ", $($st.counts.failed) failed" })") }
        }
        if ($st.Contains('lastError') -and $st.lastError -and $st.state -ne 'Final') { $l.Add("  last problem ($(Format-WddAge $st.lastErrorUtc)): $($st.lastError)") }
        if ($st.reboots) { $l.Add("  restarts so far: $($st.reboots)") }
        if ($st.outstanding) { $l.Add("  outstanding operations: $($st.outstanding) (retry them with the deployment recovery tool)") }
    }
    if ($s.drivers.state -eq 'NotPartOfDeployment') { $l.Add(('{0,-22} {1,-16} {2}' -f 'Hardware &amp; drivers', 'Off', 'Not part of this deployment')) }
    elseif ($s.drivers.state -eq 'NotImplemented') { $l.Add(('{0,-22} {1,-16} {2}' -f 'Manufacturer drivers', 'NotImplemented', 'Not part of this version')) }
    if ($s.Contains('networkDriverMissing') -and $s.networkDriverMissing) { $l.Add("NETWORK: $($s.networkDriverMissing)") }
    $l.Add('')
    $recent = @(Read-WddActivity $Paths 6)
    if ($recent.Count) {
        $l.Add('Recent activity')
        foreach ($e in $recent) {
            $t = ConvertTo-WddDate $e['utc']
            $l.Add(('  {0}  {1}' -f $(if ($t) { $t.ToLocalTime().ToString('HH:mm:ss') } else { '--:--:--' }), $e['message']))
        }
        $l.Add('')
    }
    if (@($s.needsAttention).Count) {
        $l.Add('NEEDS ATTENTION')
        foreach ($n in $s.needsAttention) { $l.Add("  - $n") }
        $l.Add("  Recovery: run (elevated) $(Join-Path $Paths.Package 'scripts\\orchestrator\\Resume-Deployment.ps1')")
        $l.Add('')
    }
    if ($State -and $State.status -in 'StagingFailed', 'IntegrityFailed') { $l.Add("FAILED: $($State.message)"); $l.Add('') }
    if (Test-Path -LiteralPath $Paths.ReportText) { $l.Add("Report: $($Paths.ReportText)") }
    $l.Add("Logs  : $($Paths.Log)")
    [pscustomobject]@{ Text = ($l -join "\`r\`n"); Done = [bool] ($State -and $State.status -in 'Completed', 'StagingFailed', 'IntegrityFailed') }
}

&lt;# Phase 9: the technician report, once it has been written for the finished deployment. #&gt;
function Get-WddHealthReportToOpen {
    param([hashtable] $Paths, $State)
    $cfg = Read-WddJson (Join-Path $Paths.Package 'scripts\\health\\health-config.json')
    if (-not $cfg -or -not ($cfg['options'] -is [hashtable]) -or -not $cfg['options']['openReportAfterDeployment'] -or -not $cfg['options']['technicianReport']) { return '' }
    $html = Join-Path (Join-Path $Paths.Root ([string] $cfg['reportDir'])) 'technician-report.html'
    $done = ConvertTo-WddDate $(if ($State) { $State['completedUtc'] } else { $null })
    if ((Test-Path -LiteralPath $html) -and (-not $done -or (Get-Item -LiteralPath $html).LastWriteTimeUtc -ge $done.AddSeconds(-5))) { return $html }
    return ''
}

&lt;#
    Orchestrator 1.2.0: one progress window per session. Returns the held mutex, or $null when
    another window already shows the progress.
#&gt;
function Enter-WddProgressWindow {
    $created = $false
    $m = New-Object System.Threading.Mutex($false, $script:ProgressMutexName, [ref] $created)
    try { if ($m.WaitOne(0)) { return $m } } catch [System.Threading.AbandonedMutexException] { return $m }
    $m.Dispose()
    return $null
}

&lt;# What an automatically opened window does: $true = show the progress, $false = exit (finished or not started). #&gt;
function Test-WddShowAutomatically {
    param($State)
    return [bool] ($State -and [string] $State.status -notin 'Completed', 'StagingFailed')
}

if ($script:ShowMain) {
    $package = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
    $manifest = Read-WddManifest (Join-Path $package 'deployment-manifest.json')
    $paths = Get-WddPaths $manifest.dataRoot
    # Orchestrator 1.3.0: without elevation the SYSTEM tasks are invisible; never report them as missing.
    $script:WddTaskVisibility = Get-WddTaskVisibility
    $state = (Read-WddDeploymentState $paths).State
    # Opened at sign-in: nothing to show once the deployment has finished.
    if ($script:ShowArgs.AutoStarted -and -not (Test-WddShowAutomatically $state)) { exit 0 }
    $window = $null
    if ($script:ShowArgs.Watch) {
        $window = Enter-WddProgressWindow
        if (-not $window) { Write-Output 'The deployment progress window is already open.'; exit 0 }
        try { $Host.UI.RawUI.WindowTitle = 'Deployment Progress - Windows Deployment Builder' } catch { }
    }
    try {
        do {
            $state = (Read-WddDeploymentState $paths).State
            $out = Format-WddStatus $manifest $paths $state
            if ($script:ShowArgs.Watch) { Clear-Host }
            Write-Output $out.Text
            if (-not $script:ShowArgs.Watch -or $out.Done) { break }
            Write-Output ''
            Write-Output "Refreshing every $($script:ShowArgs.Interval) s ($((Get-Date).ToString('HH:mm:ss'))). You can close this window; the deployment continues."
            Start-Sleep -Seconds $script:ShowArgs.Interval
        } while ($true)
        if ($script:ShowArgs.Watch -and $state -and $state.status -eq 'Completed') {
            # Verification runs right after completion: wait for its report (at most 5 minutes), open it once.
            $html = ''
            for ($i = 0; $i -lt 20 -and -not $html; $i++) { $html = Get-WddHealthReportToOpen $paths $state; if (-not $html) { Start-Sleep -Seconds 15; $state = (Read-WddDeploymentState $paths).State } }
            if ($html) {
                Write-Output ''
                Write-Output "Health report: $html"
                try { Start-Process -FilePath (Join-Path $env:SystemRoot 'explorer.exe') -ArgumentList "\`"$html\`"" } catch { Write-Output "Open it by hand: $($_.Exception.Message)" }
            }
        }
        if ($script:ShowArgs.Watch) { Write-Output ''; Read-Host 'Press Enter to close' | Out-Null }
    } finally {
        if ($window) { try { $window.ReleaseMutex() } catch { }; $window.Dispose() }
    }
    exit 0
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\orchestrator\\Resume-Deployment.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Manual recovery for a deployment: re-checks the package, re-registers the monitor and, only
    when asked, restarts a stage.

.DESCRIPTION
    Run elevated (as the signed-in user when restarting the applications stage):

      Resume-Deployment.ps1
          Verifies &lt;dataRoot&gt;\\Package, registers the monitor task again and runs it once. Use it
          after a stalled stage was fixed, after the deadline passed, or if the monitor task was
          removed. A finished deployment is reopened (its report is rewritten at the end).
      Resume-Deployment.ps1 -RestartStage windowsUpdate|applications|drivers|office
          Runs that engine's installer again. The installer archives the previous run and starts
          a new one; work already done is detected (installed updates are not offered again,
          installed applications are reported AlreadyInstalled). If the installer does not
          register its task, the result is StageRestartFailed with the reason (exit code 1),
          never Resumed. Windows Setup and the disk are never touched.
      Resume-Deployment.ps1 -Status
          Prints the progress and changes nothing.

    It never deletes logs, results or the state file.
#&gt;
[CmdletBinding()]
param(
    [ValidateSet('', 'windowsUpdate', 'applications', 'drivers', 'office')]
    [string] $RestartStage = '',
    [switch] $Status
)

$script:ResumeMain = $MyInvocation.InvocationName -ne '.'
$script:ResumeArgs = @{ RestartStage = $RestartStage; Status = [bool] $Status }
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')
. (Join-Path $PSScriptRoot '..\\bootstrap\\Initialize-Deployment.ps1')
. (Join-Path $PSScriptRoot 'Show-DeploymentStatus.ps1')

function Invoke-WddResume {
    param([hashtable] $Paths, [string] $RestartStage)
    Initialize-WddLogging $Paths
    $identity = Get-WddIdentity
    if (-not $identity.IsAdmin) { return 'RefusedNotElevated' }
    $mutex = Enter-WddMutex 60
    if (-not $mutex) { return 'Busy' }
    try {
        $read = Read-WddDeploymentState $Paths
        if ($read.Source -eq 'corrupt') { Write-WddLog "Resume: the deployment state is damaged ($($read.Problem)). Use DeploymentRecovery.ps1 -Action Resume, which rebuilds it." 'ERROR'; return 'StateCorrupt' }
        $state = $read.State
        if (-not $state) { Write-WddLog 'Resume: no deployment state. Start a deployment with setup.ps1 or Initialize-Deployment.ps1.' 'ERROR'; return 'NoState' }
        $manifestPath = Join-Path $Paths.Package 'deployment-manifest.json'
        $manifest = Read-WddManifest $manifestPath
        $check = Test-WddFiles $Paths.Package $manifest 'Text' @($state.stagedFiles)
        if (-not $check.Ok) {
            Write-WddLog "Resume refused: the staged package is modified or incomplete ($($check.Missing.Count) missing, $($check.Mismatched.Count) modified). Run setup.ps1 from the original package to stage it again." 'ERROR'
            return 'IntegrityFailed'
        }
        Write-WddLog "==== Resume requested by $($identity.Name)$(if ($RestartStage) { " (restart stage $RestartStage)" }) ===="
        if ($state.status -in 'Completed', 'IntegrityFailed') {
            if (Test-Path -LiteralPath $Paths.Marker) { Move-Item -LiteralPath $Paths.Marker -Destination "$($Paths.Marker).$((Get-WddNow).ToString('yyyyMMddHHmmss')).bak" -Force }
        }
        $state.status = 'InProgress'
        $state.message = 'Resumed manually.'
        $state.deadlineUtc = (Get-WddNow).AddHours([double] $manifest.failureHandling.orchestrator.deadlineHours).ToString('o')
        if ($RestartStage) {
            $stage = Get-WddStage $manifest $RestartStage
            if (-not $stage -or -not $stage.enabled) { Write-WddLog "Stage $RestartStage is not part of this deployment." 'ERROR'; return 'UnknownStage' }
            $state.stages[$RestartStage] = @{ launchResult = ''; attempts = 0; launchedUtc = $null; exitCode = $null; message = 'Restarted manually.' }
            $rec = Invoke-WddLaunchStage $stage $Paths $state $identity ([int] $manifest.failureHandling.orchestrator.launchAttempts)
            if ($rec.launchResult -ne 'Launched') {
                # Recorded (the monitor reports the stage as failed to launch); never reported as resumed.
                $state.message = "Restart of stage $RestartStage failed: $($rec.message)"
                $script:ResumeDetail = $state.message
                Save-WddState $Paths $state
                Write-WddLog "Resume: $($state.message)" 'ERROR'
                Write-WddEvent 3006 "Deployment $($manifest.packageId): $($state.message) See $($Paths.Log)." 'Error'
                try { Register-WddMonitorTask $Paths $manifest } catch { Write-WddLog "Resume: the monitor task could not be registered either: $($_.Exception.Message)" 'ERROR' }
                return 'StageRestartFailed'
            }
        }
        Save-WddState $Paths $state
        try { Register-WddMonitorTask $Paths $manifest }
        catch {
            $script:ResumeDetail = "The monitor task $($script:MonitorTask.path)$($script:MonitorTask.name) could not be registered: $($_.Exception.Message)"
            Write-WddLog "Resume: $($script:ResumeDetail)" 'ERROR'
            return 'MonitorRegistrationFailed'
        }
        try { Start-WddTask $script:MonitorTask.path $script:MonitorTask.name } catch { Write-WddLog "Resume: could not start the monitor now; it runs within $(Get-WddMonitorInterval $manifest) minutes: $($_.Exception.Message)" 'WARN' }
        Write-WddEvent 3001 "Deployment $($manifest.packageId) resumed manually$(if ($RestartStage) { " (stage $RestartStage restarted)" })."
        return 'Resumed'
    } finally {
        Exit-WddMutex $mutex
    }
}

if ($script:ResumeMain) {
    $package = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
    $manifest = Read-WddManifest (Join-Path $package 'deployment-manifest.json')
    $paths = Get-WddPaths $manifest.dataRoot
    if ($script:ResumeArgs.Status) { (Format-WddStatus $manifest $paths (Read-WddDeploymentState $paths).State).Text; exit 0 }
    $script:ResumeDetail = ''
    $outcome = Invoke-WddResume $paths $script:ResumeArgs.RestartStage
    Write-Output "Resume: $outcome.$(if ($script:ResumeDetail) { " $($script:ResumeDetail)" }) Log: $($paths.Log)"
    if ($outcome -eq 'Resumed') { exit 0 }
    exit 1
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\finalization\\Complete-Deployment.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Writes the final deployment report and cleans up the deployment monitor.

.DESCRIPTION
    Called by DeploymentOrchestrator.ps1 when every enabled stage has a final result, or when the
    deployment deadline has passed. Run by hand (elevated) it writes the report for the current
    state without ending the deployment (-Preview), or ends it now (-Finish).

    Writes &lt;dataRoot&gt;\\reports\\deployment-report.json and deployment-report.txt, the marker
    &lt;dataRoot&gt;\\state\\deployment.done (with the overall status; a marker is never proof of success
    on its own), an Application event, and a "Deployment report" shortcut on the public desktop.
    It removes only the monitor task. Logs, state and the engines' results are kept.

    Phase 9: when the package carries DeploymentHealth.ps1, the deployment is then verified against
    Windows itself (read-only), the result is added to the report, and the "Windows Deployment -
    Health Report" shortcut opens the technician dashboard. A pending restart registers a startup
    re-check that removes itself.

    Orchestrator 1.2.0: the report also contains
      - a Device Manager check (read-only): devices with a problem code, without a driver, or
        unknown to Windows, with friendly names, hardware IDs and the problem in words. A USB
        descriptor or reset failure is reported as a likely hardware or connection problem, not
        as a missing driver. Unresolved devices make a successful deployment CompletedWithFollowUp.
      - how each application was confirmed: Verified (WinGet finds the exact package ID
        installed), EngineReported (the installer reported success, not independently confirmed),
        NotVerified (reported success, but WinGet does not find it), Failed, Deferred (manual,
        deselected, needs a person or a restart) or Incomplete;
      - Windows Update counts for optional updates and drivers, and the updates needing a person;
      - the restart history (planned or unexpected) and every recovery.
    The progress window task is removed; the LAN monitor ends itself (see its script).
#&gt;
[CmdletBinding()]
param(
    [switch] $Preview,
    [switch] $Finish
)

$script:CompleteMain = $MyInvocation.InvocationName -ne '.'
$script:CompleteArgs = @{ Preview = [bool] $Preview; Finish = [bool] $Finish }
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')
# Phase 4.3: present only when the ongoing update policy is applied after the initial updates.
$script:PolicyScript = Join-Path $PSScriptRoot 'Set-UpdatePolicy.ps1'
if (Test-Path -LiteralPath $script:PolicyScript) { . $script:PolicyScript }
# Schema 9: present when the deployment activates Windows or Office (functions only).
$script:ActivationScript = Join-Path $PSScriptRoot 'Activation.ps1'
if (Test-Path -LiteralPath $script:ActivationScript) { . $script:ActivationScript }
# Phase 9: present when the deployment verifies itself (functions only).
$script:HealthScript = Join-Path $PSScriptRoot '..\\health\\DeploymentHealth.ps1'
if (Test-Path -LiteralPath $script:HealthScript) { . $script:HealthScript -Mode Library }
$script:HealthShortcut = "Windows Deployment $([char] 0x2014) Health Report"

function Get-WddSystemInfo {
    $os = Get-CimInstance -ClassName Win32_OperatingSystem
    $cs = Get-CimInstance -ClassName Win32_ComputerSystem
    $cv = Get-ItemProperty -LiteralPath 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -ErrorAction SilentlyContinue
    [ordered]@{
        computerName   = $env:COMPUTERNAME
        windows        = [string] $os.Caption
        edition        = $(if ($cv) { [string] $cv.EditionID } else { '' })
        displayVersion = $(if ($cv -and $cv.PSObject.Properties['DisplayVersion']) { [string] $cv.DisplayVersion } else { '' })
        build          = $(if ($cv) { '{0}.{1}' -f $cv.CurrentBuildNumber, $cv.UBR } else { [string] $os.BuildNumber })
        installDateUtc = $os.InstallDate.ToUniversalTime().ToString('o')
        manufacturer   = [string] $cs.Manufacturer
        model          = [string] $cs.Model
    }
}

# Windows' documented Device Manager problem codes (CM_PROB_*), in words (same wording as the health check).
$script:WddProblemCodes = @{
    1 = 'not configured correctly'; 3 = 'driver may be corrupted or memory is low'; 10 = 'cannot start'; 12 = 'not enough free resources'; 14 = 'needs a restart to work'
    18 = 'drivers must be reinstalled'; 19 = 'configuration in the registry is damaged'; 21 = 'being removed'; 22 = 'disabled'; 24 = 'not present, not working or missing drivers'
    28 = 'no driver installed'; 29 = 'disabled by the firmware'; 31 = 'not working properly (driver could not be loaded)'; 32 = 'driver service disabled'; 37 = 'driver failed to initialize'
    39 = 'driver is corrupted or missing'; 40 = 'driver registry entry is damaged'; 41 = 'driver loaded but the hardware was not found'; 43 = 'the device reported a problem'
    45 = 'not connected'; 47 = 'prepared for safe removal'; 48 = 'driver blocked'; 52 = 'driver signature could not be verified'
}

&lt;# Present Plug and Play devices (read-only): name, class, problem code and up to five hardware IDs. #&gt;
function Get-WddPnpDevices {
    @(Get-CimInstance -ClassName Win32_PnPEntity -ErrorAction Stop | Where-Object { $_.Present -ne $false } | ForEach-Object {
        @{ name = [string] $_.Name; class = [string] $_.PNPClass; problemCode = $(if ($null -ne $_.ConfigManagerErrorCode) { [int] $_.ConfigManagerErrorCode } else { 0 })
           hardwareIds = @(@($_.HardwareID) | Where-Object { $_ } | Select-Object -First 5) }
    })
}

&lt;#
    Devices that still need attention at the end of the deployment. Disabled (22) and disconnected
    (45) devices are not counted. Kinds: NoDriver, UnknownDevice, RestartRequired,
    HardwareOrConnection (USB descriptor/reset failures: usually a cable, hub, port or device fault,
    not a missing driver), Problem (any other problem code). Instance IDs are not reported (they can
    contain serial numbers).
#&gt;
function Get-WddDeviceReport {
    $devices = $null
    # Each device is one pipeline object (a hashtable); an empty list is an empty array.
    try { $devices = @(Get-WddPnpDevices | Where-Object { $_ -is [System.Collections.IDictionary] }) } catch { return [ordered]@{ checked = $false; checkedUtc = (Get-WddNow).ToString('o'); error = "The device list could not be read: $($_.Exception.Message)"; devices = 0; unresolved = @() } }
    $out = @()
    foreach ($d in $devices) {
        $code = [int] $d['problemCode']
        $name = [string] $d['name']
        $class = [string] $d['class']
        $ids = @(@($d['hardwareIds']) | Where-Object { $_ })
        $unknown = (-not $class -or $class -eq 'Unknown' -or $name -match '(?i)^unknown device$' -or -not $name)
        if ($code -in 22, 45) { continue }
        # Orchestrator 1.3.0: a display adapter running on Windows' generic driver works, but without acceleration.
        $basicDisplay = $code -eq 0 -and $name -match '(?i)^Microsoft Basic Display Adapter$'
        if ($code -eq 0 -and -not $unknown -and -not $basicDisplay) { continue }
        $descriptor = (@($ids | Where-Object { $_ -match '(?i)(DEVICE_DESCRIPTOR_FAILURE|CONFIG_DESCRIPTOR_FAILURE|RESET_FAILURE|SET_ADDRESS_FAILURE)' }).Count -gt 0) -or $name -match '(?i)(Descriptor Request Failed|Port Reset Failed|Set Address Failed)'
        $problem = $(if ($code -and $script:WddProblemCodes.ContainsKey($code)) { $script:WddProblemCodes[$code] } elseif ($code) { "problem code $code" } else { 'no matching driver' })
        if ($descriptor) { $kind = 'HardwareOrConnection'; $note = 'The USB device did not answer Windows correctly (descriptor or reset failure). This usually means a hardware, cable, hub or port problem, not a missing driver: reconnect it, try another port, or check the device.' }
        elseif ($code -eq 28) { $kind = 'NoDriver'; $note = 'No driver is installed. Find the driver by the hardware ID (Windows Update optional updates, or the manufacturer''s support page).' }
        elseif ($unknown) { $kind = 'UnknownDevice'; $note = 'Windows does not recognise this device. Identify it by its hardware ID.' }
        elseif ($code -eq 14) { $kind = 'RestartRequired'; $note = 'Restart the computer to finish installing its driver.' }
        elseif ($basicDisplay) { $kind = 'GenericDriver'; $note = 'The graphics adapter runs on Windows'' generic display driver (no acceleration). Windows Update did not provide its driver.' }
        else { $kind = 'Problem'; $note = "Device Manager reports code \${code}: $problem. This is not necessarily a missing driver; check the device in Device Manager." }
        $hint = Get-WddDriverHint $name $class $ids $kind
        $out += , ([ordered]@{ name = $(if ($name) { $name } else { 'Unknown device' }); class = $class; problemCode = $code; problem = $problem; kind = $kind; hardwareIds = $ids; note = $note; vendor = $hint.vendor; driverSource = $hint.source })
    }
    return [ordered]@{ checked = $true; checkedUtc = (Get-WddNow).ToString('o'); devices = @($devices).Count; unresolved = $out }
}

&lt;#
    Orchestrator 1.3.0: where a missing chipset or graphics driver officially comes from, by the PCI
    vendor ID in the hardware ID. Guidance for the technician only: nothing is downloaded, and no
    third-party driver site is ever suggested. A USB descriptor failure gets no driver hint.
#&gt;
$script:WddPciVendors = @{ '8086' = 'Intel'; '1022' = 'AMD'; '1002' = 'AMD'; '10DE' = 'NVIDIA'; '10EC' = 'Realtek'; '14E4' = 'Broadcom'; '1B21' = 'ASMedia'; '168C' = 'Qualcomm Atheros'; '1969' = 'Qualcomm Atheros' }
function Get-WddDriverHint {
    param([string] $Name, [string] $Class, [object[]] $Ids, [string] $Kind)
    $o = [ordered]@{ vendor = ''; source = '' }
    if ($Kind -eq 'HardwareOrConnection') { return $o }
    foreach ($id in @($Ids)) { if ([string] $id -match '(?i)VEN_([0-9A-F]{4})') { $v = $Matches[1].ToUpperInvariant(); if ($script:WddPciVendors.ContainsKey($v)) { $o.vendor = $script:WddPciVendors[$v] } else { $o.vendor = "PCI vendor $v" }; break } }
    $chipset = $Name -match '(?i)(SM ?Bus Controller|PCI Memory Controller|PCI Simple Communications Controller|PCI Data Acquisition|Base System Device|PCI Encryption|Signal Processing Controller)'
    $graphics = $Class -eq 'Display' -or $Name -match '(?i)(Video Controller|Basic Display Adapter|3D Video Controller)'
    if ($chipset) {
        $o.source = switch ($o.vendor) {
            'Intel' { 'Chipset driver: Intel Chipset Device Software (Intel Driver &amp; Support Assistant, intel.com) or the motherboard/computer manufacturer''s support page.' }
            'AMD' { 'Chipset driver: AMD Chipset Software (amd.com/support) or the motherboard/computer manufacturer''s support page.' }
            default { 'Chipset driver: the motherboard or computer manufacturer''s support page for this model.' }
        }
    } elseif ($graphics) {
        $o.source = switch ($o.vendor) {
            'NVIDIA' { 'Graphics driver: nvidia.com/drivers (or NVIDIA App), or the computer manufacturer''s support page for laptops.' }
            'AMD' { 'Graphics driver: AMD Software: Adrenalin Edition (amd.com/support), or the computer manufacturer''s support page for laptops.' }
            'Intel' { 'Graphics driver: Intel Driver &amp; Support Assistant (intel.com), or the computer manufacturer''s support page for laptops.' }
            default { 'Graphics driver: the graphics card or computer manufacturer''s support page.' }
        }
    } elseif ($Kind -in 'NoDriver', 'UnknownDevice' -and $o.vendor) {
        $o.source = "Driver: $($o.vendor)'s support site or the computer/motherboard manufacturer's support page (search by the hardware ID)."
    }
    return $o
}

&lt;#
    How an application result was confirmed (see the description). Verification is by the exact
    package ID (winget list --id &lt;id&gt; --exact), so a similarly named package or another version of
    a different product never counts.
#&gt;
function Get-WddAppVerification {
    param($Package)
    $st = [string] $Package['status']
    $det = $(if ($Package.Contains('detection')) { [string] $Package['detection'] } else { '' })
    switch ($st) {
        'Succeeded' { if ($det -eq 'Installed') { return 'Verified' } elseif ($det -eq 'Unconfirmed') { return 'NotVerified' } else { return 'EngineReported' } }
        'AlreadyInstalled' { return 'Verified' }
        { $_ -in 'Failed', 'Unavailable' } { return 'Failed' }
        { $_ -in 'RequiresInteraction', 'RequiresRestart', 'SkippedByUser', 'Skipped' } { return 'Deferred' }
    }
    return 'Incomplete'
}

function New-WddReport {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State, $Snapshot, [string] $Overall, [string] $Reason)
    $system = try { Get-WddSystemInfo } catch { [ordered]@{ computerName = $env:COMPUTERNAME; error = $_.Exception.Message } }
    $wu = @($Snapshot.stages | Where-Object { $_.id -eq 'windowsUpdate' }) | Select-Object -First 1
    $apps = @($Snapshot.stages | Where-Object { $_.id -eq 'applications' }) | Select-Object -First 1
    $drv = @($Snapshot.stages | Where-Object { $_.id -eq 'drivers' }) | Select-Object -First 1
    $remaining = @(); $errors = @(); $incomplete = @()
    $wuReport = $null
    if ($wu) {
        $r = $wu.result
        $failed = @(if ($r) { @($r.failed) | Where-Object { $_ } | ForEach-Object { [ordered]@{ kbs = @($_.kbs); title = $_.title; attempts = $_.attempts; lastResult = $_.lastResult; lastHResult = $_.lastHResult } } })
        $person = @(if ($r -and $r.ContainsKey('requiresInteraction')) { @($r.requiresInteraction) | Where-Object { $_ } | ForEach-Object { [ordered]@{ kbs = @($_.kbs); title = $_.title; reason = $_.reason } } })
        $counts = $(if ($r -and $r.ContainsKey('counts')) { $r.counts } else { $null })
        $wuReport = [ordered]@{ state = $wu.state; status = $wu.status; reason = $wu.detail; reboots = $wu.reboots
                                installed = $(if ($r) { @($r.installed).Count } else { $null }); skipped = $(if ($r) { @($r.skipped).Count } else { $null }); failedUpdates = $failed
                                installedOptional = $(if ($counts) { $counts['installedOptional'] } else { $null }); installedDrivers = $(if ($counts) { $counts['installedDrivers'] } else { $null })
                                requiresInteraction = $person; policy = $(if ($r -and $r.ContainsKey('policy')) { $r.policy } else { $null }) }
        foreach ($f in $failed) { $remaining += "Windows Update: $((@($f.kbs) -join ', ')) $($f.title) failed after $($f.attempts) attempt(s) ($($f.lastHResult))." }
        foreach ($f in $person) { $remaining += "Windows Update: $((@($f.kbs) -join ', ')) $($f.title) needs a person to install it (Settings &gt; Windows Update)." }
        if ($wu.state -ne 'Final') { $incomplete += "Windows Update ($($wu.state))" }
        elseif ($wu.status -eq 'Offline') { $incomplete += 'Windows Update (Offline: no network before its runtime limit)' }
        elseif ($wu.status -eq 'Failed') { $errors += "Windows Update failed: $($wu.detail)" }
    }
    $appsReport = $null
    if ($apps) {
        $r = $apps.result
        # Phase 5: lifecycle, failure class and attempt totals come from result schema 2 (absent in schema 1).
        $pk = @(if ($r) { @($r.packages) | Where-Object { $_ } | ForEach-Object {
            $x = [ordered]@{ name = $_.name; packageIdentifier = $_.packageIdentifier; source = $_.source; status = $_.status; attempts = $_.attempts; exitCode = $_.exitCode; message = $_.message }
            foreach ($k in 'operationId', 'lifecycle', 'failureClass', 'retryable', 'detection', 'totalAttempts', 'manualRetries', 'installerExitCode') { if ($_.ContainsKey($k)) { $x[$k] = $_[$k] } }
            $x.verification = Get-WddAppVerification $x
            $x
        } })
        $verification = [ordered]@{}
        foreach ($v in 'Verified', 'EngineReported', 'NotVerified', 'Failed', 'Deferred', 'Incomplete') { $verification[$v] = @($pk | Where-Object { $_.verification -eq $v }).Count }
        $add = @(if ($r) { @($r.additionalSoftware) | Where-Object { $_ } })
        $appsReport = [ordered]@{ state = $apps.state; status = $apps.status; reason = $apps.detail; reboots = $apps.reboots
                                  counts = $(if ($r) { $r.counts } else { $null }); packages = $pk; additionalSoftware = $add
                                  requiresInteraction = @($pk | Where-Object { $_.status -eq 'RequiresInteraction' } | ForEach-Object { $_.name })
                                  verification = $verification
                                  bootstrap = $(if ($r) { $r.bootstrap } else { $null }) }
        foreach ($p in @($pk | Where-Object { $_.verification -eq 'NotVerified' })) { $remaining += "Application $($p.name): reported installed, but WinGet does not find $($p.packageIdentifier); check it by hand." }
        foreach ($p in $pk) { if ($p.status -in 'RequiresInteraction', 'RequiresRestart', 'Failed', 'Unavailable', 'Pending') { $remaining += "Application $($p.name) ($($p.source):$($p.packageIdentifier)): $($p.status). $($p.message)" } }
        foreach ($a in $add) { if ($a.status -ne 'Succeeded') { $remaining += "Additional Software $($a.name): $($a.status). $($a.message)" } }
        if ($apps.state -ne 'Final') { $incomplete += "Applications ($($apps.state))" }
        elseif ($apps.status -eq 'Offline') { $incomplete += 'Applications (Offline)' }
        elseif ($apps.status -eq 'Failed') { $errors += "Application setup failed: $($apps.detail)" }
    }
    foreach ($n in @($Snapshot.needsAttention)) { $errors += $n }
    # Phase 4.3: written by Add-WifiProfile.ps1 when the answer file adds a Wi-Fi profile (never contains the key).
    $wifi = Read-WddJson (Join-Path $Paths.Root 'Network\\wifi-result.json')
    if ($wifi -and $wifi.status -notin 'Added', 'ConnectRequested', 'ConnectFailed') { $remaining += "Wi-Fi: $($wifi.status). $($wifi.message)" }
    $policy = $(if ($State.ContainsKey('updatePolicy')) { $State.updatePolicy } else { $null })
    if ($Manifest.ContainsKey('updatePolicy') -and $Manifest.updatePolicy) {
        if (-not $policy) { $remaining += 'Ongoing Windows Update policy: not applied. Set it under Settings &gt; Windows Update or re-run the deployment.' }
        elseif ($policy.status -notin 'Applied', 'AlreadyApplied') { $remaining += "Ongoing Windows Update policy: $($policy.status). $($policy.message)" }
    }
    # Phase 8: the driver stage's own result (reports\\drivers.json); without it, say plainly that nothing handled drivers.
    $driversReport = $null
    $drvStage = Get-WddStage $Manifest 'drivers'
    $drvPolicy = $(if ($Manifest.ContainsKey('drivers') -and $Manifest.drivers -is [hashtable] -and $Manifest.drivers.ContainsKey('policy')) { $Manifest.drivers.policy } else { $null })
    if ($drv) {
        $dr = Read-WddJson (Join-Path $Paths.Root 'reports\\drivers.json')
        $listUnresolved = -not ($drvPolicy -and $drvPolicy.ContainsKey('reportUnresolved') -and -not $drvPolicy.reportUnresolved)
        $driversReport = [ordered]@{ state = $drv.state; status = $drv.status; reason = $drv.detail; reboots = $drv.reboots
                                     health = $(if ($dr) { $dr['health'] } else { $null }); summary = $(if ($dr) { $dr['summary'] } else { $null })
                                     installed = @(if ($dr) { @($dr['operations']) | Where-Object { $_ -and $_['status'] -eq 'Succeeded' } | ForEach-Object { [ordered]@{ device = $_['device']; source = $_['source']; package = $_['package'] } } })
                                     manualActions = @(if ($dr) { @($dr['manualActions']) | Where-Object { $_ } })
                                     optionalApplications = @(if ($dr) { @($dr['optionalApplications']) | Where-Object { $_ } | ForEach-Object { $_['name'] } })
                                     networkBootstrap = $(if ($dr) { $dr['networkBootstrap'] } else { $null }); report = (Join-Path $Paths.Root 'reports\\drivers.json') }
        if ($dr -and $listUnresolved) {
            foreach ($m in @($dr['manualActions']) | Where-Object { $_ }) { $remaining += "Driver: $($m['text'])$(if ($m['url']) { " ($($m['url']))" })" }
            foreach ($o in @($dr['operations']) | Where-Object { $_ -and $_['status'] -eq 'WaitingForReboot' }) { $remaining += "Driver: $($o['device']): restart the computer to start the new driver." }
        }
        if ($drv.state -ne 'Final') { $incomplete += "Hardware &amp; drivers ($($drv.state))" }
        elseif ($drv.status -eq 'Failed') { $errors += "Driver setup failed: $($drv.detail)" }
    } elseif ($drvStage -and $drvStage['implemented']) {
        $remaining += 'Manufacturer drivers: hardware-aware driver provisioning was not part of this deployment. Install chipset, graphics and OEM drivers manually if Windows Update did not provide them.'
    } else {
        $remaining += 'Manufacturer drivers: not part of this deployment (driver stage not implemented). Install chipset, graphics and OEM drivers manually if Windows Update did not provide them.'
    }
    # Phase 5: what is still open and how to recover it, kept after the deployment ends.
    $tool = Join-Path $Paths.Package 'scripts\\recovery\\DeploymentRecovery.ps1'
    $hasTool = Test-Path -LiteralPath $tool
    $outstanding = @()
    if ($apps -and $apps.result -and $apps.result.ContainsKey('outstanding')) {
        foreach ($x in @($apps.result.outstanding) | Where-Object { $_ }) {
            $how = switch ([string] $x.lifecycle) {
                'FailedRetryable' { 'retry (automatic retries used up)' } 'BlockedByDependency' { 'retry (with its dependency)' }
                'WaitingForNetwork' { 'resume when the network is back' } 'Pending' { 'resume' } 'FailedPermanent' { 'correct the cause, then retry with -IncludePermanent' }
                'ManualActionRequired' { 'install or finish it by hand' } 'WaitingForReboot' { 'restart the computer' } default { 'check' }
            }
            $outstanding += [ordered]@{ operationId = $x.operationId; name = $x.name; lifecycle = $x.lifecycle; failureClass = $x.failureClass; retryable = $x.retryable; action = $how; message = $x.message }
        }
    } elseif ($apps -and $apps.state -ne 'Final') {
        $outstanding += [ordered]@{ operationId = 'stage:applications'; name = 'Applications'; lifecycle = 'Pending'; failureClass = ''; retryable = $true; action = 'resume'; message = "The application stage is $($apps.state)." }
    }
    if ($drv -and $drv.result -and $drv.result.ContainsKey('outstanding')) {
        foreach ($x in @($drv.result.outstanding) | Where-Object { $_ }) {
            $how = switch ([string] $x.status) {
                'FailedRetryable' { 'retry (RetryFailed)' } 'WaitingForNetwork' { 'resume when the network is back' } 'Pending' { 'resume' }
                'FailedPermanent' { $(if ([string] $x.failureClass -in 'Integrity', 'Signature') { 'replace the package with a correctly signed, unmodified one' } else { 'correct the cause, then retry with -IncludePermanent' }) }
                'ManualActionRequired' { 'install the driver by hand (see the device in drivers.json) or supply one with -Action AddDrivers' } 'WaitingForReboot' { 'restart the computer' } 'Unsupported' { 'check the device' } default { 'check' }
            }
            $outstanding += [ordered]@{ operationId = $x.operationId; name = $x.name; lifecycle = $x.status; failureClass = $x.failureClass; retryable = ($x.status -eq 'FailedRetryable'); action = $how; message = $x.message }
        }
    } elseif ($drv -and $drv.state -ne 'Final') {
        $outstanding += [ordered]@{ operationId = 'stage:drivers'; name = 'Hardware &amp; drivers'; lifecycle = 'Pending'; failureClass = ''; retryable = $true; action = 'resume'; message = "The driver stage is $($drv.state)." }
    }
    if ($wu -and $wu.state -eq 'Final' -and $wu.status -in 'CompletedWithFailures', 'Failed', 'Offline') {
        $outstanding += [ordered]@{ operationId = 'stage:windowsUpdate'; name = 'Windows Update'; lifecycle = 'FailedRetryable'; failureClass = $(if ($wu.status -eq 'Offline') { 'Network' } else { 'Transient' }); retryable = $true; action = 'retry the update stage (installed updates are never offered again)'; message = [string] $wu.detail }
    }
    $recoveryCommands = [ordered]@{
        status      = "powershell.exe -ExecutionPolicy Bypass -File \`"$tool\`" -Action Status"
        retryFailed = "powershell.exe -ExecutionPolicy Bypass -File \`"$tool\`" -Action RetryFailed"
        retryOne    = "powershell.exe -ExecutionPolicy Bypass -File \`"$tool\`" -Action Retry -Operation &lt;operationId&gt;"
        resume      = "powershell.exe -ExecutionPolicy Bypass -File \`"$tool\`" -Action Resume"
        diagnostics = "powershell.exe -ExecutionPolicy Bypass -File \`"$tool\`" -Action ExportDiagnostics"
    }
    # Phase 6: the application stage's restoration result (inventory migration and settings restore).
    $restorationFile = Join-Path $Paths.Root 'Applications\\restoration.json'
    $restoration = Read-WddJson $restorationFile
    $restorationReport = $null
    if ($restoration -and $restoration['format'] -eq 'windows-deployment-builder/restoration-result') {
        $restorationReport = [ordered]@{ file = $restorationFile; inventoryId = [string] $restoration['inventoryId']; backupId = [string] $restoration['backupId']
                                         backup = $restoration['backup']; counts = $restoration['counts']
                                         settings = @(@($restoration['settings']) | Where-Object { $_ } | ForEach-Object { [ordered]@{ adapterId = $_['adapterId']; name = $_['name']; outcome = $_['outcome']; detail = $_['detail'] } }) }
        if (@($restoration['settings']).Count) { $recoveryCommands.restoreSettings = "powershell.exe -ExecutionPolicy Bypass -File \`"$tool\`" -Action RestoreSettings -BackupPath &lt;backup folder&gt;" }
    }
    # Orchestrator 1.2.0: Device Manager at the end (read-only), restarts and recoveries.
    $devices = $(if ($State.ContainsKey('deviceReport') -and $State.deviceReport) { $State.deviceReport } else { Get-WddDeviceReport })
    foreach ($d in @($devices.unresolved)) { $remaining += "Device: $($d.name)$(if (@($d.hardwareIds).Count) { " [$(@($d.hardwareIds)[0])]" }): $($d.note)$(if ($d.Contains('driverSource') -and $d.driverSource) { " $($d.driverSource)" })" }
    if (-not $devices.checked) { $remaining += "Device Manager: $($devices.error)" }
    # Orchestrator 1.3.0: a restart Windows still needs, and what Windows Update still offers after the last run.
    $restartView = Get-WddRestartView $State
    $rcState = $(if ($State['restartCoordinator'] -is [hashtable]) { $State['restartCoordinator'] } else { @{} })
    $restartReport = [ordered]@{ status = $restartView.status; outstanding = (Test-WddRestartOutstanding $State); reasons = @($restartView.reasons); blockers = @($restartView.blockers)
                                 automaticRestarts = $restartView.restarts; message = $restartView.message; history = @(@($rcState['history']) | Where-Object { $_ }) }
    if ($restartReport.outstanding) { $remaining += "Restart: Windows still needs a restart ($(@($restartView.reasons) -join '; ')). $(if ($restartView.status -eq 'LimitReached') { 'The automatic restart limit was reached.' } elseif (@($restartView.blockers).Count) { "It was blocked: $(@($restartView.blockers) -join '; ')." }) Restart the computer, then check Device Manager." }
    $recheck = $(if ($State['updateRecheck'] -is [hashtable]) { $State['updateRecheck'] } else { $null })
    if ($recheck -and $recheck['status'] -eq 'Remaining') { foreach ($u in @($recheck['remaining']) | Where-Object { $_ }) { $remaining += "Windows Update: $((@($u['kbs']) -join ', ')) $($u['title']) is still offered after the deployment's last update run." } }
    if ($recheck -and $recheck['status'] -eq 'CheckFailed') { $remaining += "Windows Update: $($recheck['message'])" }
    # Schema 9: Office LTSC (installation) and activation, reported separately.
    $officeReport = $null
    $off = @($Snapshot.stages | Where-Object { $_.id -eq 'office' }) | Select-Object -First 1
    if ($off) {
        $r = $off.result
        $officeReport = [ordered]@{ product = $(if ($Manifest.ContainsKey('office')) { [string] $Manifest.office.displayName } else { $off.name }); state = $off.state; status = $off.status; detail = $off.detail
                                    verified = [bool] ($r -and $r['verified']); alreadyInstalled = [bool] ($r -and $r['alreadyInstalled']); category = $(if ($r) { [string] $r['category'] } else { '' })
                                    version = $(if ($r -and $r['installed']) { [string] $r['installed']['version'] } else { '' }); attempts = $(if ($r) { @($r['attempts']).Count } else { 0 })
                                    source = $(if ($Manifest.ContainsKey('office')) { $Manifest.office.source } else { $null }); activated = $false; log = (Join-Path $Paths.Root 'Office\\logs') }
        if ($off.state -ne 'Final') { $incomplete += "Microsoft Office ($($off.state))" }
        elseif ($off.status -eq 'Failed') { $errors += "Microsoft Office was not installed: $($off.detail)" }
        elseif ($off.status -in 'CompletedWithFollowUp', 'Offline') { $remaining += "Microsoft Office: $($off.detail)" }
    }
    $activationReport = $null
    if ($Manifest.ContainsKey('activation') -and $Manifest.activation) {
        $act = $(if ($State['activation'] -is [hashtable]) { $State.activation } else { @{} })
        $activationReport = [ordered]@{ windows = $act['windows']; office = $act['office']; plan = $Manifest.activation; log = (Join-Path $Paths.Root 'Activation\\activation.log'); containsSecrets = $false }
        foreach ($k in 'windows', 'office') {
            $e = $act[$k]
            if (-not $e) { if ([string] $Manifest.activation[$k]['action'] -ne 'none') { $remaining += "Activation ($k): not attempted; the deployment ended before its activation step." }; continue }
            # No key characters in the remaining tasks (they also reach the LAN monitor's final view).
            $note = [string] $e['message'] -replace '\\s*\\(key ending [A-Za-z0-9]*\\)', ''
            if ([string] $e['status'] -in 'AwaitingTechnician', 'Failed', 'Deferred', 'Blocked', 'Unavailable') { $remaining += "Activation ($k): $($e['status']). $note" }
        }
    }
    $outcome = Get-WddDeploymentOutcome @{ status = 'Completed'; overall = $Overall; message = $Reason } $null
    $report = [ordered]@{
        format             = 'windows-deployment-builder/deployment-report'
        reportVersion      = 2
        overall            = $Overall
        outcome            = $outcome.outcome
        outcomeCode        = $outcome.exitCode
        reason             = $Reason
        generatedUtc       = (Get-WddNow).ToString('o')
        packageId          = $Manifest.packageId
        packageVersion     = $Manifest.packageVersion
        orchestratorVersion = $script:DeployVersion
        startedUtc         = $State.initializedUtc
        deadlineUtc        = $State.deadlineUtc
        system             = $system
        windowsUpdate      = $wuReport
        applications       = $appsReport
        updatePolicy       = $policy
        wifi               = $wifi
        drivers            = $(if ($driversReport) { $driversReport } elseif ($drvStage -and $drvStage['implemented']) { [ordered]@{ state = 'NotPartOfDeployment'; note = 'Hardware-aware driver provisioning was off; no driver was installed or changed by this deployment.' } } else { [ordered]@{ state = 'NotImplemented'; note = 'No driver was installed or changed by this deployment.' } })
        restarts           = [ordered]@{ windowsUpdate = $(if ($wu) { $wu.reboots } else { 0 }); applications = $(if ($apps) { $apps.reboots } else { 0 }); drivers = $(if ($drv) { $drv.reboots } else { 0 }) }
        restartHistory     = @(if ($State.ContainsKey('restarts')) { @($State.restarts) | Where-Object { $_ } })
        restartCoordination = $restartReport
        updateRecheck      = $recheck
        devices            = $devices
        incompleteStages   = $incomplete
        errors             = $errors
        remainingTasks     = $remaining
        outstanding        = $outstanding
        recoveries         = @(if ($State.ContainsKey('recoveries')) { @($State.recoveries) })
        logs               = $(if ($drv) { [ordered]@{ deployment = $Paths.Log; windowsUpdate = (Join-Path $Paths.Root 'Updates\\logs\\engine.log'); applications = (Join-Path $Paths.Root 'Applications\\logs\\engine.log'); attempts = (Join-Path $Paths.Root 'Applications\\logs\\attempts.jsonl'); drivers = (Join-Path $Paths.Root 'Drivers\\logs\\engine.log') } } else { [ordered]@{ deployment = $Paths.Log; windowsUpdate = (Join-Path $Paths.Root 'Updates\\logs\\engine.log'); applications = (Join-Path $Paths.Root 'Applications\\logs\\engine.log'); attempts = (Join-Path $Paths.Root 'Applications\\logs\\attempts.jsonl') } })
        recovery           = "$(if ($hasTool) { "Recovery tool (as administrator; status, retry, resume, diagnostics): $($recoveryCommands.status). " })Resume only: powershell.exe -ExecutionPolicy Bypass -File \`"$(Join-Path $Paths.Package 'scripts\\orchestrator\\Resume-Deployment.ps1')\`""
        recoveryCommands   = $(if ($hasTool) { $recoveryCommands } else { $null })
        restoration        = $restorationReport
    }
    if ($officeReport) { $report.office = $officeReport; $report.logs['office'] = (Join-Path $Paths.Root 'Office\\logs\\engine.log') }
    if ($activationReport) { $report.activation = $activationReport; $report.logs['activation'] = $activationReport.log }
    return $report
}

function Format-WddReport {
    param($Report)
    $l = New-Object System.Collections.Generic.List[string]
    $l.Add('Windows Deployment Builder - deployment report')
    $l.Add('==============================================')
    $l.Add("Overall result : $($Report.overall)")
    if ($Report.Contains('outcome')) { $l.Add("Outcome        : $($Report.outcome) (exit code $($Report.outcomeCode))") }
    if ($Report.reason) { $l.Add("               : $($Report.reason)") }
    $l.Add("Generated (UTC): $($Report.generatedUtc)")
    $l.Add("Package        : $($Report.packageId) (package $($Report.packageVersion), orchestrator $($Report.orchestratorVersion))")
    $l.Add('')
    $l.Add('Computer')
    foreach ($k in $Report.system.Keys) { $l.Add(('  {0,-15} {1}' -f $k, $Report.system[$k])) }
    $l.Add('')
    $l.Add('Windows Update')
    if ($Report.windowsUpdate) {
        $w = $Report.windowsUpdate
        $l.Add("  Result: $($w.status) ($($w.state)). $($w.reason)")
        $l.Add("  Installed: $($w.installed)  Skipped by policy: $($w.skipped)  Restarts: $($w.reboots)")
        if ($w.Contains('installedOptional') -and $null -ne $w.installedOptional) { $l.Add("  Of these: optional updates $($w.installedOptional), drivers $($w.installedDrivers)") }
        foreach ($f in @($w.failedUpdates)) { $l.Add("  FAILED  $((@($f.kbs) -join ', ')) $($f.title) ($($f.attempts) attempts, $($f.lastHResult))") }
        if ($w.Contains('requiresInteraction')) { foreach ($f in @($w.requiresInteraction)) { $l.Add("  PERSON  $((@($f.kbs) -join ', ')) $($f.title): needs a person to install it") } }
    } else { $l.Add('  Not part of this deployment.') }
    $l.Add('')
    $l.Add('Applications (WinGet)')
    if ($Report.applications) {
        $a = $Report.applications
        $l.Add("  Result: $($a.status) ($($a.state)). $($a.reason)")
        $l.Add("  Restarts: $($a.reboots)")
        if ($a.Contains('verification') -and $a.verification) { $l.Add('  Confirmation: ' + (($a.verification.Keys | Where-Object { [int] $a.verification[$_] } | ForEach-Object { "$_ $($a.verification[$_])" }) -join ', ')) }
        foreach ($p in @($a.packages)) {
            $tries = $(if ($p.Contains('totalAttempts') -and [int] $p.totalAttempts -gt 1) { " [$($p.totalAttempts) attempts$(if ([int] $p.manualRetries) { ", $($p.manualRetries) manual retr$(if ([int] $p.manualRetries -eq 1) { 'y' } else { 'ies' })" })]" } else { '' })
            $how = $(if ($p.Contains('verification')) { " &lt;$($p.verification)&gt;" } else { '' })
            $l.Add(('  {0,-20} {1} ({2}:{3}){4}{5} {6}' -f $p.status, $p.name, $p.source, $p.packageIdentifier, $tries, $how, $p.message))
        }
        foreach ($s in @($a.additionalSoftware)) { $l.Add(('  {0,-20} {1} (Additional Software) {2}' -f $s.status, $s.name, $s.message)) }
    } else { $l.Add('  Not part of this deployment.') }
    $l.Add('')
    if ($Report.Contains('updatePolicy') -and $Report.updatePolicy) {
        $l.Add('Ongoing Windows Update policy (after the initial updates)')
        $l.Add("  $($Report.updatePolicy.status). $($Report.updatePolicy.message)")
        $l.Add('')
    }
    if ($Report.Contains('wifi') -and $Report.wifi) {
        $l.Add('Wi-Fi profile')
        $l.Add("  $($Report.wifi.status) ($($Report.wifi.profileName)). $($Report.wifi.message)")
        $l.Add('')
    }
    $l.Add('Hardware &amp; drivers')
    $d = $Report.drivers
    if ($d -and $d.Contains('status')) {
        $l.Add("  Result: $($d.status) ($($d.state)). $($d.reason)")
        if ($d.health) { $l.Add("  Health: $($d.health.status)") }
        if ($d.summary) { $l.Add(('  Devices: {0}, healthy {1}, basic driver {2}, missing {3}, not working {4}, restart pending {5}, possible hardware issue {6}' -f $d.summary.devices, $d.summary.healthy, $d.summary.basicDriver, $d.summary.driverMissing, $d.summary.malfunctioning, $d.summary.restartPending, $d.summary.hardwareIssue)) }
        foreach ($x in @($d.installed)) { $l.Add("  INSTALLED  $($x.device) ($($x.source)$(if ($x.package) { " $($x.package.provider) $($x.package.version)" }))") }
        foreach ($x in @($d.manualActions)) { $l.Add("  MANUAL     $($x.text)") }
        if (@($d.optionalApplications).Count) { $l.Add("  Optional vendor applications (not installed by the driver stage): $(@($d.optionalApplications) -join ', ')") }
        $l.Add("  Details: $($d.report)")
    } elseif ($d -and $d.state -eq 'NotPartOfDeployment') {
        $l.Add('  Not part of this deployment; nothing was installed or changed.')
    } else {
        $l.Add('  Not implemented in this version; nothing was installed or changed.')
    }
    $l.Add('')
    if ($Report.Contains('devices') -and $Report.devices) {
        $dv = $Report.devices
        $l.Add('Device Manager (at the end of the deployment)')
        if (-not $dv.checked) { $l.Add("  Not checked: $($dv.error)") }
        elseif (-not @($dv.unresolved).Count) { $l.Add("  $($dv.devices) device(s); none reports a problem.") }
        else {
            $l.Add("  $($dv.devices) device(s); $(@($dv.unresolved).Count) need attention:")
            foreach ($d in @($dv.unresolved)) {
                $l.Add(('  {0,-20} {1} ({2}{3})' -f $d.kind, $d.name, $(if ($d.class) { "$($d.class), " }), $(if ($d.problemCode) { "code $($d.problemCode): $($d.problem)" } else { $d.problem })))
                if (@($d.hardwareIds).Count) { $l.Add("                       hardware ID: $(@($d.hardwareIds) -join '; ')") }
                $l.Add("                       $($d.note)")
                if ($d.Contains('driverSource') -and $d.driverSource) { $l.Add("                       $($d.driverSource)") }
            }
        }
        $l.Add('')
    }
    if ($Report.Contains('restartHistory') -and @($Report.restartHistory).Count) {
        $l.Add('Restarts during the deployment')
        foreach ($x in @($Report.restartHistory)) { $l.Add("  $($x.bootUtc)  $(if ($x.planned) { "planned ($($x.by)$(if ($x.reason) { ": $($x.reason)" }))" } else { 'UNEXPECTED (not scheduled by the deployment)' })") }
        $l.Add('')
    }
    if ($Report.Contains('office') -and $Report.office) {
        $o = $Report.office
        $l.Add("Microsoft Office: $($o.product)")
        $l.Add("  Installation: $($o.status) ($($o.state))$(if ($o.verified) { ', verified' })$(if ($o.alreadyInstalled) { ', was already installed' })$(if ($o.version) { ", version $($o.version)" }). $($o.detail)")
        if ($o.source) { $l.Add("  Installer: $($o.source.repository) commit $($o.source.installer.commit); configuration from branch $($o.source.configuration.branch) commit $($o.source.configuration.commit)") }
        $l.Add('  Installing Office does not activate it; see Activation.')
        $l.Add('')
    }
    if ($Report.Contains('activation') -and $Report.activation) {
        $a = $Report.activation
        $l.Add('Activation (separate from the installation results)')
        foreach ($k in 'windows', 'office') {
            $e = $a[$k]
            $label = $(if ($k -eq 'windows') { 'Windows' } else { 'Office ' })
            if ($e) { $l.Add("  \${label}: $($e['status'])$(if ($e['verified']) { ' (verified by the licensing service)' }). $($e['message'])") }
            elseif ([string] $a.plan[$k]['action'] -ne 'none') { $l.Add("  \${label}: not attempted.") }
            else { $l.Add("  \${label}: no activation was requested.") }
        }
        $l.Add('')
    }
    if ($Report.Contains('restartCoordination') -and $Report.restartCoordination) {
        $rc = $Report.restartCoordination
        $l.Add('Restart required by Windows (at the end of the deployment)')
        $l.Add("  $(if ($rc.outstanding) { "OUTSTANDING: $(@($rc.reasons) -join '; ')$(if ($rc.message) { " $($rc.message)" })" } else { 'None outstanding.' })  Automatic restarts by the deployment: $($rc.automaticRestarts).")
        foreach ($h in @($rc.history)) { $l.Add("  $($h.atUtc)  automatic restart $($h.restart): $(@($h.reasons) -join '; ')") }
        $l.Add('')
    }
    if ($Report.Contains('updateRecheck') -and $Report.updateRecheck) {
        $l.Add('Windows Update re-check (after the stages finished)')
        $l.Add("  $($Report.updateRecheck['status']): $($Report.updateRecheck['message'])")
        $l.Add('')
    }
    if ($Report.Contains('recoveries') -and @($Report.recoveries).Count) {
        $l.Add('Recoveries')
        foreach ($x in @($Report.recoveries)) { $l.Add("  $($x.atUtc)  $($x.action) by $($x.by)$(if ($x.Contains('stage')) { ": $($x.stage)" })$(if ($x.Contains('reason') -and $x.reason) { " ($($x.reason))" })$(if ([string] $x.action -like 'Automatic*' -and @($x.refused).Count) { ' - FAILED' })") }
        $l.Add('')
    }
    $l.Add('Incomplete stages')
    if (@($Report.incompleteStages).Count) { foreach ($x in $Report.incompleteStages) { $l.Add("  - $x") } } else { $l.Add('  None.') }
    $l.Add('')
    $l.Add('Errors')
    if (@($Report.errors).Count) { foreach ($x in $Report.errors) { $l.Add("  - $x") } } else { $l.Add('  None.') }
    $l.Add('')
    $l.Add('Remaining tasks')
    foreach ($x in $Report.remainingTasks) { $l.Add("  - $x") }
    $l.Add('')
    if ($Report.Contains('outstanding')) {
        $l.Add('Outstanding work (kept for recovery)')
        if (@($Report.outstanding).Count) {
            foreach ($x in $Report.outstanding) { $l.Add(('  {0,-22} {1} [{2}]: {3}' -f $x.lifecycle, $x.name, $x.operationId, $x.action)) }
        } else { $l.Add('  None.') }
        $l.Add('')
    }
    if ($Report.Contains('health') -and $Report.health) {
        $l.Add('Deployment verification (Phase 9, read-only)')
        $l.Add("  $($Report.health.status): $($Report.health.summary)")
        $l.Add("  Dashboard: $($Report.health.technicianReport)")
        $l.Add('')
    }
    if ($Report.Contains('restoration') -and $Report.restoration) {
        $x = $Report.restoration
        $l.Add('Application restoration')
        if ($x.counts) { $l.Add('  ' + (($x.counts.Keys | Sort-Object | ForEach-Object { "$_ $($x.counts[$_])" }) -join ', ')) }
        if ($x.backupId) { $l.Add("  Settings backup $($x.backupId): $($x.backup.status). $($x.backup.message)") }
        foreach ($s in @($x.settings)) { $l.Add(('  {0,-32} {1}: {2}' -f $s.name, $s.outcome, $s.detail)) }
        $l.Add("  Details: $($x.file)")
        $l.Add('')
    }
    $l.Add('Logs')
    foreach ($k in $Report.logs.Keys) { $l.Add(('  {0,-14} {1}' -f $k, $Report.logs[$k])) }
    $l.Add('')
    $l.Add("Recovery: $($Report.recovery)")
    if ($Report.Contains('recoveryCommands') -and $Report.recoveryCommands) {
        foreach ($k in $Report.recoveryCommands.Keys) { $l.Add(('  {0,-12} {1}' -f $k, $Report.recoveryCommands[$k])) }
    }
    return ($l -join "\`r\`n") + "\`r\`n"
}

function Write-WddReport {
    param($Report, [hashtable] $Paths)
    Write-WddJson $Paths.ReportJson $Report
    [System.IO.File]::WriteAllText($Paths.ReportText, (Format-WddReport $Report), (New-Object System.Text.UTF8Encoding($true)))
}

&lt;#
    Ends the deployment: report, marker, event, shortcuts, monitor task removal. State is kept.
#&gt;
function Complete-WddDeployment {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State, $Snapshot, [switch] $DeadlineReached)
    if (Get-Command Step-WddUpdatePolicy -ErrorAction SilentlyContinue) { $null = Step-WddUpdatePolicy $Manifest $Paths $State $Snapshot -Force }
    $overall = Get-WddOverall $Snapshot.stages -DeadlineReached:$DeadlineReached
    # A policy that could not be applied is a follow-up, never a silent success.
    if ($overall -eq 'Succeeded' -and $Manifest.ContainsKey('updatePolicy') -and $Manifest.updatePolicy -and -not ($State.ContainsKey('updatePolicy') -and $State.updatePolicy -and $State.updatePolicy.status -in 'Applied', 'AlreadyApplied')) { $overall = 'CompletedWithFollowUp' }
    # Orchestrator 1.2.0: devices that still need attention are a follow-up too.
    $State.deviceReport = Get-WddDeviceReport
    # Orchestrator 1.3.0: the check runs after the deployment's last restart (the boot it ran in is recorded).
    try { $State.deviceReport.bootUtc = (Get-WddBootTime).ToString('o') } catch { }
    if ($overall -eq 'Succeeded' -and (@($State.deviceReport.unresolved).Count -or -not $State.deviceReport.checked)) { $overall = 'CompletedWithFollowUp' }
    # A restart Windows still needs, or updates Windows still offers, is a follow-up too.
    if ($overall -eq 'Succeeded' -and ((Test-WddRestartOutstanding $State) -or ($State['updateRecheck'] -is [hashtable] -and [string] $State['updateRecheck']['status'] -in 'Remaining', 'CheckFailed'))) { $overall = 'CompletedWithFollowUp' }
    # Schema 9: activation that needs a person is a follow-up, never an installation failure.
    if ($overall -eq 'Succeeded' -and (Get-Command Test-WddActivationAttention -ErrorAction SilentlyContinue) -and (Test-WddActivationAttention $State)) { $overall = 'CompletedWithFollowUp' }
    if ($overall -eq 'Succeeded' -and $Manifest.ContainsKey('activation') -and $Manifest.activation -and $State['activation'] -isnot [hashtable]) { $overall = 'CompletedWithFollowUp' }
    $reason = if ($DeadlineReached -and -not $Snapshot.allFinal) { "The deployment deadline ($($State.deadlineUtc)) passed before every stage finished." } elseif (@($Snapshot.stages).Count -eq 0) { 'No post-installation stage was enabled.' } else { 'Every enabled stage has a final result.' }
    $report = New-WddReport $Manifest $Paths $State $Snapshot $overall $reason
    Write-WddReport $report $Paths
    $now = (Get-WddNow).ToString('o')
    Write-WddJson $Paths.Marker ([ordered]@{ status = $overall; finishedUtc = $now; report = $Paths.ReportJson })
    $State.status = 'Completed'; $State.overall = $overall; $State.completedUtc = $now; $State.message = $reason
    Save-WddState $Paths $State
    $Snapshot.deploymentState = 'Completed'
    $Snapshot.overall = $overall
    Set-WddSnapshotOutcome $Snapshot $State
    Write-WddJson $Paths.Status $Snapshot
    Write-WddLog "FINISHED: $overall. $reason Report: $($Paths.ReportText)" $(if ($overall -eq 'Succeeded') { 'INFO' } else { 'WARN' })
    $eventId = switch ($overall) { 'Succeeded' { 3100 } 'CompletedWithFollowUp' { 3101 } 'CompletedWithFailures' { 3102 } 'Failed' { 3103 } default { 3104 } }
    Write-WddEvent $eventId "Deployment $($Manifest.packageId) finished: $overall. $reason Report: $($Paths.ReportText)" $(if ($overall -eq 'Succeeded') { 'Information' } elseif ($overall -eq 'Failed') { 'Error' } else { 'Warning' })
    Add-WddActivity $Paths "Deployment finished: $overall. $reason$(if (@($report.devices.unresolved).Count) { " $(@($report.devices.unresolved).Count) device(s) need attention." }) Report: $($Paths.ReportText)" $(if ($overall -eq 'Succeeded') { 'info' } elseif ($overall -eq 'Failed') { 'error' } else { 'warning' })
    # Phase 9: verify what the stages reported against Windows itself, now that the state says Completed.
    $health = $null
    if (Get-Command Invoke-WdhAfterDeployment -ErrorAction SilentlyContinue) {
        try { $health = Invoke-WdhAfterDeployment $Manifest $Paths } catch { Write-WddLog "Deployment verification could not run: $($_.Exception.Message)" 'WARN' }
        if ($health) {
            $report.health = [ordered]@{ status = $health.Status; summary = [string] $health.Report.overall.summary; readyForDelivery = [bool] $health.Report.overall.readyForDelivery; verificationId = [string] $health.Report.verificationId
                                         report = $health.Path; technicianReport = (Join-Path $health.Directory 'technician-report.html'); customerReport = (Join-Path $health.Directory 'customer-handoff.html') }
            Write-WddReport $report $Paths
        }
    }
    try {
        Remove-WddShortcut 'Deployment progress'
        New-WddShortcut 'Deployment report' (Join-Path $env:SystemRoot 'System32\\notepad.exe') "\`"$($Paths.ReportText)\`"" 'Windows Deployment Builder: deployment report'
        if ($health) {
            $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
            New-WddShortcut $script:HealthShortcut $ps "-NoProfile -ExecutionPolicy Bypass -File \`"$([IO.Path]::GetFullPath($script:HealthScript))\`" -Mode Dashboard -Elevate" 'Windows Deployment Builder: verify the deployment (read-only) and open the health report'
        }
    } catch { Write-WddLog "Could not update the desktop shortcuts: $($_.Exception.Message)" 'WARN' }
    try { Unregister-WddTask '\\WindowsDeploymentBuilder\\' 'Deployment' } catch { Write-WddLog "Could not remove the monitor task: $($_.Exception.Message)" 'WARN' }
    # Orchestrator 1.2.0: the progress window no longer opens at sign-in.
    try { Unregister-WddTask '\\WindowsDeploymentBuilder\\' 'Progress' } catch { Write-WddLog "Could not remove the progress window task: $($_.Exception.Message)" 'WARN' }
    return $overall
}

if ($script:CompleteMain) {
    $package = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
    $manifest = Read-WddManifest (Join-Path $package 'deployment-manifest.json')
    $paths = Get-WddPaths $manifest.dataRoot
    Initialize-WddLogging $paths
    $state = (Read-WddDeploymentState $paths).State
    if (-not $state) { Write-Output 'No deployment state found.'; exit 1 }
    $snapshot = Get-WddSnapshot $manifest $paths $state
    if ($script:CompleteArgs.Finish) {
        $overall = Complete-WddDeployment $manifest $paths $state $snapshot -DeadlineReached
        Write-Output "Deployment ended: $overall. Report: $($paths.ReportText)"
    } else {
        $report = New-WddReport $manifest $paths $state $snapshot $snapshot.overall 'Preview of the current state (the deployment continues).'
        Format-WddReport $report
    }
    exit 0
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\finalization\\Set-UpdatePolicy.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Applies the ongoing (post-deployment) Windows Update policy after the initial update stage.

.DESCRIPTION
    Phase 4.3. Dot-sourced by Complete-Deployment.ps1 (and so by DeploymentOrchestrator.ps1). It is
    part of the package only when the deployment runs the initial Windows Update engine AND the
    chosen ongoing policy is a "notify" mode; otherwise the answer file writes the policy during
    specialize exactly as before.

    The initial update engine (WindowsUpdateEngine.ps1) is not changed and does not read this
    policy. This step runs from the SYSTEM monitor only once the windowsUpdate stage has a final
    result (or when the deployment ends at its deadline), applies the documented
    "Configure Automatic Updates" registry policy once, reads it back and records the outcome:

      Applied               NoAutoUpdate/AUOptions written and read back
      AlreadyApplied        the values were already exactly these
      Unsupported           Windows Home: the policy is not supported; Windows defaults stay
      ManagedByOrganization domain, MDM or update-server management detected; nothing written
      Conflict              other Automatic Updates policy values already exist; left unchanged
      Failed                writing or reading back failed

    The outcome is stored in the deployment state (explicit completion state) and in
    &lt;dataRoot&gt;\\&lt;updatePolicy.result&gt;. It never stops the Windows Update service, never blocks
    endpoints and never touches Defender security intelligence updates.
#&gt;

$script:WddPolicyWuKey = 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate'
$script:WddPolicyAuKey = 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU'
$script:WddPolicyOkStatuses = @('Applied', 'AlreadyApplied')

# Adapters (replaced by the scenario tests) --------------------------------------------------------

function Get-WddEditionId {
    $cv = Get-ItemProperty -LiteralPath 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -ErrorAction SilentlyContinue
    if ($cv -and $cv.PSObject.Properties['EditionID']) { [string] $cv.EditionID } else { '' }
}

&lt;# Reasons why the computer is managed by an organization (empty when it is not). #&gt;
function Get-WddUpdateManagement {
    $reasons = @()
    try { if ((Get-CimInstance -ClassName Win32_ComputerSystem).PartOfDomain) { $reasons += 'joined to an Active Directory domain' } } catch { }
    $wu = Get-ItemProperty -LiteralPath $script:WddPolicyWuKey -ErrorAction SilentlyContinue
    if ($wu -and $wu.PSObject.Properties['WUServer'] -and [string] $wu.WUServer) { $reasons += 'configured for an update server (WSUS)' }
    $mdm = Get-ItemProperty -LiteralPath 'HKLM:\\SOFTWARE\\Microsoft\\PolicyManager\\current\\device\\Update' -ErrorAction SilentlyContinue
    if ($mdm -and $mdm.PSObject.Properties['AllowAutoUpdate']) { $reasons += 'Windows Update is managed by device management (MDM)' }
    $reasons
}

function Get-WddAuPolicyValues {
    $k = Get-ItemProperty -LiteralPath $script:WddPolicyAuKey -ErrorAction SilentlyContinue
    $o = @{}
    foreach ($n in 'NoAutoUpdate', 'AUOptions', 'ScheduledInstallDay', 'ScheduledInstallTime', 'NoAutoRebootWithLoggedOnUsers') {
        $o[$n] = $(if ($k -and $k.PSObject.Properties[$n]) { [int] $k.$n } else { $null })
    }
    return $o
}

function Set-WddAuPolicyValue {
    param([string] $Name, [int] $Value)
    if (-not (Test-Path -LiteralPath $script:WddPolicyAuKey)) { New-Item -Path $script:WddPolicyAuKey -Force | Out-Null }
    New-ItemProperty -LiteralPath $script:WddPolicyAuKey -Name $Name -Value $Value -PropertyType DWord -Force | Out-Null
}

# Policy -------------------------------------------------------------------------------------------

function Invoke-WddUpdatePolicy {
    param([hashtable] $Policy, [hashtable] $Paths)
    $want = [ordered]@{ NoAutoUpdate = [int] $Policy.values.NoAutoUpdate; AUOptions = [int] $Policy.values.AUOptions }
    $r = [ordered]@{ status = ''; mode = [string] $Policy.mode; values = $want; appliedUtc = (Get-WddNow).ToString('o'); message = '' }
    try {
        $edition = Get-WddEditionId
        if ($edition -match '^Core') {
            $r.status = 'Unsupported'
            $r.message = "Windows $edition (Home) does not support the Configure Automatic Updates policy. Windows' default update behaviour stays in place."
        } else {
            $managed = @(Get-WddUpdateManagement | Where-Object { $_ })
            $have = Get-WddAuPolicyValues
            if ($managed.Count -gt 0) {
                $r.status = 'ManagedByOrganization'
                $r.message = "This computer is $($managed -join '; '). Organizational policy takes precedence, so the ongoing update policy was not written."
            } elseif ($have.NoAutoUpdate -eq $want.NoAutoUpdate -and $have.AUOptions -eq $want.AUOptions) {
                $r.status = 'AlreadyApplied'
                $r.message = 'The Automatic Updates policy already had these values.'
            } elseif (@($have.Keys | Where-Object { $null -ne $have[$_] }).Count -gt 0) {
                $r.status = 'Conflict'
                $r.existing = $have
                $r.message = 'Automatic Updates policy values already exist on this computer and were left unchanged.'
            } else {
                foreach ($n in $want.Keys) { Set-WddAuPolicyValue $n $want[$n] }
                $check = Get-WddAuPolicyValues
                if ($check.NoAutoUpdate -eq $want.NoAutoUpdate -and $check.AUOptions -eq $want.AUOptions) {
                    $r.status = 'Applied'
                    $r.message = "Configure Automatic Updates = $($want.AUOptions) ($(if ($want.AUOptions -eq 3) { 'download automatically, notify before installing' } else { 'notify before downloading and installing' }))."
                } else {
                    $r.status = 'Failed'
                    $r.message = 'The policy values could not be read back after writing them.'
                }
            }
        }
    } catch {
        $r.status = 'Failed'
        $r.message = "Applying the update policy failed: $($_.Exception.Message)"
    }
    Write-WddLog "Ongoing update policy: $($r.status). $($r.message)" $(if ($r.status -in $script:WddPolicyOkStatuses) { 'INFO' } else { 'WARN' })
    try { Write-WddJson (Join-Path $Paths.Root ([string] $Policy.result)) $r } catch { Write-WddLog "Could not write the update policy result: $($_.Exception.Message)" 'WARN' }
    return $r
}

&lt;#
    Applies the policy once: only after the windowsUpdate stage is Final, or with -Force when the
    deployment ends. Returns the recorded result, or $null while it is still waiting.
#&gt;
function Step-WddUpdatePolicy {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $State, $Snapshot, [switch] $Force)
    if (-not $Manifest.ContainsKey('updatePolicy') -or -not $Manifest.updatePolicy) { return $null }
    if ($State.ContainsKey('updatePolicy') -and $State.updatePolicy) { return $State.updatePolicy }
    $wu = @(@($Snapshot.stages) | Where-Object { $_ -and $_.id -eq 'windowsUpdate' }) | Select-Object -First 1
    $final = [bool] ($wu -and $wu.state -eq 'Final')
    if (-not $final -and -not $Force) { return $null }
    $r = Invoke-WddUpdatePolicy $Manifest.updatePolicy $Paths
    if (-not $final) { $r.note = 'Applied when the deployment ended; the initial Windows Update stage had not reported a final result.' }
    $State.updatePolicy = $r
    return $r
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\monitor\\DeploymentStatusServer.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Windows Deployment Builder - read-only HTTP deployment monitor for the local network.

.DESCRIPTION
    A small status page that a technician opens from another computer, phone or tablet while the
    deployment runs: http://&lt;this computer's address&gt;:&lt;port&gt;/#t=&lt;access token&gt;. It shows the overall
    status, Windows Update, applications, drivers, devices, recent activity and, at the end, the
    final results. The page refreshes every 7 seconds.

    It reuses what the deployment already writes (state, engine status and result files, the
    activity feed, the final report) through the same functions as the progress window; it never
    starts, stops or changes anything. Windows-native only: System.Net.HttpListener (HTTP.sys) in
    Windows PowerShell 5.1; no Node.js, IIS, Docker, WinGet or Internet connection.

    Runs as SYSTEM from \\WindowsDeploymentBuilder\\StatusServer (registered by
    Initialize-Deployment.ps1 when the package enables the monitor; started at every startup,
    restarted if it stops). Independent of the progress window and of the engines.

    Security (read-only by construction):
      - GET and HEAD only. Three static resources without data (/, /app.js, /app.css) and one data
        endpoint, /api/status, that requires "Authorization: Bearer &lt;token&gt;". Anything else is 404/405.
      - The token is 256 random bits, kept in &lt;dataRoot&gt;\\state\\monitor.json for this deployment
        and compared in constant time. It is passed in the URL fragment (#t=...), which browsers
        never send to a server, so it does not appear in request lines, logs or referrers.
      - /api/status is built field by field from a whitelist (names, counts, states, the
        deployment's own messages); passwords, Wi-Fi keys, product keys, tokens and configuration
        are never read into it, and text that looks like a credential is masked.
      - No cross-origin access (no CORS headers), a strict Content-Security-Policy, no framing.
      - Bound to 127.0.0.1 unless the package enables LAN access. With LAN access, one inbound
        Windows Firewall rule is added: TCP &lt;port&gt;, Private profile, local subnet only. It is
        removed when the monitor stops. Router port forwarding is never configured.
      - Without a network the deployment and the progress window are unaffected; the monitor then
        answers on this computer only.

    After the deployment has finished the page shows the final results (read-only) for
    finalReportHours, then the monitor removes its firewall rule and its task and stops.

      -Mode Serve    (default) run the server (the scheduled task)
      -Mode Library  define the functions only (tests)
#&gt;
[CmdletBinding()]
param(
    [ValidateSet('Serve', 'Library')]
    [string] $Mode = 'Serve'
)

$script:MonMain = $MyInvocation.InvocationName -ne '.' -and $Mode -eq 'Serve'
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')
Set-StrictMode -Version 2.0

$script:MonitorVersion = '1.0.0'
$script:MonitorFormat = 'windows-deployment-builder/monitor-status'
$script:FirewallRuleName = 'WindowsDeploymentBuilder-Monitor'
$script:TokenPattern = '^[A-Za-z0-9_-]{43}$'

# ------------------------------------------------------------------------------------------------
# Adapters (replaced by the tests)
# ------------------------------------------------------------------------------------------------

function New-WddMonitorToken {
    $b = New-Object byte[] 32
    $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
    try { $rng.GetBytes($b) } finally { $rng.Dispose() }
    ([Convert]::ToBase64String($b)).TrimEnd('=').Replace('+', '-').Replace('/', '_')
}

&lt;# IPv4 addresses other devices can use (no loopback, no link-local 169.254.x.x). #&gt;
function Get-WddLanAddresses {
    @(Get-NetIPAddress -AddressFamily IPv4 -ErrorAction Stop | Where-Object { $_.IPAddress -notmatch '^(127\\.|169\\.254\\.)' -and [string] $_.AddressState -eq 'Preferred' } | ForEach-Object { [string] $_.IPAddress } | Sort-Object -Unique)
}

&lt;# Categories of the connected networks: Public, Private, DomainAuthenticated. #&gt;
function Get-WddNetworkCategories { @(Get-NetConnectionProfile -ErrorAction Stop | ForEach-Object { [string] $_.NetworkCategory }) }

function Set-WddMonitorFirewall {
    param([int] $Port)
    Get-NetFirewallRule -Name $script:FirewallRuleName -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue
    New-NetFirewallRule -Name $script:FirewallRuleName -DisplayName 'Windows Deployment Builder - deployment monitor (read-only)' -Group 'Windows Deployment Builder' \`
        -Description 'Read-only deployment status page. Private networks, local subnet only. Removed when the deployment monitor stops.' \`
        -Direction Inbound -Action Allow -Protocol TCP -LocalPort $Port -Profile Private -RemoteAddress LocalSubnet -ErrorAction Stop | Out-Null
}

function Remove-WddMonitorFirewall { Get-NetFirewallRule -Name $script:FirewallRuleName -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue }

function Remove-WddStatusServerTask { Unregister-WddTask '\\WindowsDeploymentBuilder\\' 'StatusServer' }

# ------------------------------------------------------------------------------------------------
# Settings, token, address
# ------------------------------------------------------------------------------------------------

&lt;# The manifest's monitor block with defaults; port, refresh and lifetime are clamped. #&gt;
function Get-WddMonitorSettings {
    param([hashtable] $Manifest)
    $s = @{ enabled = $false; port = 8765; lanAccess = $false; refreshSeconds = 7; finalReportHours = 24 }
    if ($Manifest.ContainsKey('monitor') -and $Manifest.monitor -is [hashtable]) { foreach ($k in @($s.Keys)) { if ($Manifest.monitor.ContainsKey($k) -and $null -ne $Manifest.monitor[$k]) { $s[$k] = $Manifest.monitor[$k] } } }
    $s.enabled = [bool] $s.enabled
    $s.lanAccess = [bool] $s.lanAccess
    $s.port = [int] [Math]::Min(65535, [Math]::Max(1024, [int] $s.port))
    $s.refreshSeconds = [int] [Math]::Min(60, [Math]::Max(2, [int] $s.refreshSeconds))
    $s.finalReportHours = [int] [Math]::Min(168, [Math]::Max(0, [int] $s.finalReportHours))
    return $s
}

&lt;#
    Writes state\\monitor.json (port, mode, token, addresses, a message for the progress window) and
    returns it. The token of this deployment is kept across restarts, so a bookmarked address keeps
    working. With LAN access the firewall rule is (re)created here.
#&gt;
function Initialize-WddMonitorInfo {
    param([hashtable] $Paths, [hashtable] $Settings, [switch] $Refresh)
    $old = Read-WddJson $Paths.MonitorInfo
    $token = $(if ($old -is [hashtable] -and [string] $old['token'] -match $script:TokenPattern) { [string] $old['token'] } else { New-WddMonitorToken })
    $info = [ordered]@{ format = 'windows-deployment-builder/monitor-info'; port = $Settings.port; lanAccess = $Settings.lanAccess; token = $token; mode = 'serving'
                        urls = @("http://127.0.0.1:$($Settings.port)"); firewall = 'NotNeeded'; message = ''; startedUtc = (Get-WddNow).ToString('o') }
    if ($Settings.lanAccess) {
        $addresses = @()
        try { $addresses = @(Get-WddLanAddresses) } catch { Write-WddLog "Monitor: network addresses could not be read: $($_.Exception.Message)" 'WARN' }
        $info.urls = @(@($addresses | ForEach-Object { "http://$($_):$($Settings.port)" }) + @("http://127.0.0.1:$($Settings.port)"))
        # A refresh (every minute) keeps an existing rule; it is only (re)created at start or after a failure.
        if ($Refresh -and $old -is [hashtable] -and [string] $old['firewall'] -eq 'Added') { $info.firewall = 'Added' }
        else { try { Set-WddMonitorFirewall $Settings.port; $info.firewall = 'Added' } catch { $info.firewall = "Failed: $($_.Exception.Message)" } }
        if ($old -is [hashtable] -and $old['startedUtc']) { $info.startedUtc = $old['startedUtc'] }
        $cats = @()
        try { $cats = @(Get-WddNetworkCategories) } catch { }
        if (-not $addresses.Count) { $info.message = 'No network connection yet: the monitor answers on this computer only. The deployment continues normally.' }
        elseif ($info.firewall -ne 'Added') { $info.message = "The firewall rule could not be added ($($info.firewall)); other devices may not reach the monitor." }
        elseif ($cats.Count -and -not @($cats | Where-Object { $_ -ne 'Public' }).Count) { $info.message = 'This network is set to Public, so Windows Firewall blocks the monitor from other devices. To use it, set the network to Private (Settings &gt; Network &amp; internet &gt; the connection &gt; Private network).' }
    }
    $same = $Refresh -and $old -is [hashtable] -and ((@($old['urls']) -join ' ') -eq (@($info.urls) -join ' ')) -and [string] $old['message'] -eq $info.message -and [string] $old['firewall'] -eq $info.firewall
    if (-not $same) { Write-WddJson $Paths.MonitorInfo $info }
    return $info
}

&lt;# Constant-time comparison of the presented token with the expected one. #&gt;
function Test-WddMonitorToken {
    param([string] $Given, [string] $Expected)
    if (-not $Given -or -not $Expected) { return $false }
    $a = [Text.Encoding]::ASCII.GetBytes($Given)
    $b = [Text.Encoding]::ASCII.GetBytes($Expected)
    $diff = $a.Length -bxor $b.Length
    for ($i = 0; $i -lt $b.Length; $i++) { $x = $(if ($i -lt $a.Length) { $a[$i] } else { 0 }); $diff = $diff -bor ($x -bxor $b[$i]) }
    return $diff -eq 0
}

# ------------------------------------------------------------------------------------------------
# The status model (whitelisted fields only)
# ------------------------------------------------------------------------------------------------

&lt;# The deployment's own text, shortened, with anything that looks like a credential masked. #&gt;
function Protect-WddText {
    param($Text, [int] $Max = 400)
    if ($null -eq $Text) { return '' }
    $t = ([string] $Text) -replace '[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]', ' '
    $t = $t -replace '(?i)\\b(password|passwd|pwd|passphrase|psk|wpa2?|key|token|secret|productkey)\\b(\\s*[:=]\\s*)\\S+', '$1$2[hidden]'
    $t = $t -replace '\\b[A-Z0-9]{5}(-[A-Z0-9]{5}){4}\\b', '[product key hidden]'
    if ($t.Length -gt $Max) { $t = $t.Substring(0, $Max - 3) + '...' }
    return $t
}

function Get-WddNumber { param($Map, [string] $Key) if ($Map -and $Map.Contains($Key) -and $null -ne $Map[$Key]) { return [int] $Map[$Key] }; return $null }

function ConvertTo-WddStageModel {
    param($S)
    if (-not $S) { return $null }
    [ordered]@{
        state = [string] $S.state; condition = [string] $S.condition; phase = [string] $S.status
        activity = Protect-WddText $S.activity; waitingReason = Protect-WddText $S.waitingReason
        lastActivityUtc = $S.lastActivityUtc; lastError = Protect-WddText $S.lastError; lastErrorUtc = $S.lastErrorUtc
        reboots = [int] $S.reboots; stale = [bool] $S.stale
    }
}

&lt;#
    The model behind /api/status. Built only from the fields named here; the snapshot, the engines'
    result files and the final report are read, never returned as they are.
#&gt;
function Get-WddMonitorStatus {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Settings)
    $now = (Get-WddNow).ToString('o')
    $m = [ordered]@{ format = $script:MonitorFormat; version = 1; serverTimeUtc = $now; refreshSeconds = $Settings.refreshSeconds
                     computerName = Protect-WddText $env:COMPUTERNAME 64; deploymentId = [string] $Manifest.packageId; status = 'waiting'; statusText = ''
                     overall = ''; startedUtc = $null; completedUtc = $null; lastActivityUtc = $null; restartPending = $false
                     windowsUpdate = $null; applications = $null; drivers = $null; attention = @(); activity = @(); final = $null }
    $read = Read-WddDeploymentState $Paths
    $state = $read.State
    if ($read.Source -eq 'corrupt') { $m.status = 'attention'; $m.statusText = 'The deployment state file is damaged; see the deployment log on the computer.'; return $m }
    if (-not $state) { $m.statusText = 'The deployment has not started yet.'; return $m }
    $snap = Get-WddSnapshot $Manifest $Paths $state
    $m.status = [string] $snap.condition
    $m.statusText = Protect-WddText $(if ([string] $state.status -eq 'Completed') { "Finished: $($state.overall). $($state.message)" } else { $snap.outcomeDetail })
    $m.overall = [string] $state['overall']
    $m.startedUtc = $state['initializedUtc']; $m.completedUtc = $state['completedUtc']
    $m.lastActivityUtc = $snap.lastActivityUtc
    # Orchestrator 1.3.0: also a restart Windows needs that the deployment is about to do.
    $m.restartPending = [bool] ($snap.restartPending -or ($snap.Contains('restart') -and $snap.restart.status -in 'Announced', 'Blocked', 'Restarting'))
    $m.attention = @(@($snap.needsAttention) | Select-Object -First 10 | ForEach-Object { Protect-WddText $_ })
    $stage = @{}
    foreach ($s in @($snap.stages)) { $stage[$s.id] = $s }

    if ($stage.ContainsKey('windowsUpdate')) {
        $s = $stage['windowsUpdate']
        $w = ConvertTo-WddStageModel $s
        $w.current = Protect-WddText $s.current
        $w.installed = Get-WddNumber $s.counts 'installed'
        $w.failed = Get-WddNumber $s.counts 'failed'
        $w.needsPerson = Get-WddNumber $s.counts 'requiresInteraction'
        $w.installedOptional = Get-WddNumber $s.counts 'installedOptional'
        $w.installedDrivers = Get-WddNumber $s.counts 'installedDrivers'
        $w.attempt = Get-WddNumber $s.counts 'attempt'
        $w.maxAttempts = Get-WddNumber $s.counts 'maxAttempts'
        $w.rebootRequired = [bool] ($snap.restartPending -or [string] $s.status -in 'Rebooting', 'RebootDeferred')
        # The Windows Update Agent calls used do not report bytes: no percentage or speed is invented.
        $w.progress = 'unavailable'
        $m.windowsUpdate = $w
    }
    if ($stage.ContainsKey('applications')) {
        $s = $stage['applications']
        $a = ConvertTo-WddStageModel $s
        $selected = Get-WddNumber $s.counts 'selected'
        $installed = Get-WddNumber $s.counts 'installed'
        $failed = Get-WddNumber $s.counts 'failed'
        if ($s.state -eq 'Final' -and $s.result -is [hashtable] -and $s.result['counts'] -is [hashtable]) {
            $c = $s.result['counts']
            $selected = [int] $c['total'] - [int] $c['skippedByUser']; $installed = [int] $c['succeeded'] + [int] $c['alreadyInstalled']; $failed = [int] $c['failed'] + [int] $c['unavailable']
            $a.needsPerson = [int] $c['requiresInteraction']
        } else { $a.needsPerson = Get-WddNumber $s.counts 'needsPerson' }
        $a.selected = $selected; $a.installed = $installed; $a.failed = $failed
        $a.remaining = $(if ($null -ne $s.total -and $null -ne $s.done -and $s.state -ne 'Final') { [Math]::Max(0, [int] $s.total - [int] $s.done) } elseif ($s.state -eq 'Final') { 0 } else { $null })
        $a.current = Protect-WddText $(if ([string] $s.status -eq 'Installing') { $s.current } else { '' })
        # WinGet does not report download progress to a redirected process: shown as unavailable.
        $a.progress = 'unavailable'; $a.percent = $null; $a.bytesPerSecond = $null
        $m.applications = $a
    }
    $drvReport = Read-WddJson (Join-Path $Paths.Root 'reports\\drivers.json')
    if ($stage.ContainsKey('drivers')) {
        $s = $stage['drivers']
        $d = ConvertTo-WddStageModel $s
        $ops = @(if ($drvReport -is [hashtable]) { @($drvReport['operations']) | Where-Object { $_ -is [hashtable] } })
        $d.installed = @($ops | Where-Object { $_['status'] -eq 'Succeeded' }).Count
        $d.failedOrSkipped = @($ops | Where-Object { [string] $_['status'] -like 'Failed*' -or [string] $_['status'] -in 'ManualActionRequired', 'Unsupported' }).Count
        $d.restartPending = [bool] (@($ops | Where-Object { $_['status'] -eq 'WaitingForReboot' }).Count -or $snap.restartPending)
        $m.drivers = $d
    } else {
        $m.drivers = [ordered]@{ state = [string] $snap.drivers.state; condition = 'finished'; activity = 'The driver stage is not part of this deployment; Windows Update installs drivers it offers.' }
    }
    # Schema 9: Office LTSC (product, phase, verified) and activation (status per target, no key).
    if ($stage.ContainsKey('office')) {
        $s = $stage['office']
        $o = ConvertTo-WddStageModel $s
        $o.product = Protect-WddText $(if ($Manifest.ContainsKey('office') -and $Manifest.office) { [string] $Manifest.office.displayName } else { $s.name }) 80
        $o.verified = [bool] ($s.state -eq 'Final' -and $s.result -is [hashtable] -and $s.result['verified'])
        $o.detail = Protect-WddText $s.detail
        # The Office Deployment Tool does not report bytes: the phase is shown, never a percentage.
        $o.progress = 'unavailable'
        $m.office = $o
    }
    if ($snap.Contains('activation') -and $snap.activation) {
        $m.activation = [ordered]@{}
        foreach ($k in 'windows', 'office') {
            $e = $snap.activation[$k]
            if ($e) { $m.activation[$k] = [ordered]@{ action = [string] $e['action']; status = [string] $e['status']; verified = [bool] $e['verified']; message = Protect-WddText $e['message'] } }
        }
    }
    # Devices: the final Device Manager check, or the driver stage's own assessment while it runs.
    $devices = @()
    if ($state.ContainsKey('deviceReport') -and $state.deviceReport -is [hashtable]) { $devices = @(@($state.deviceReport['unresolved']) | Where-Object { $_ -is [hashtable] }) }
    $m.drivers.unresolvedDevices = @($devices | Select-Object -First 25 | ForEach-Object { [ordered]@{ name = Protect-WddText $_['name'] 120; kind = [string] $_['kind']; problemCode = [int] $_['problemCode']; problem = Protect-WddText $_['problem'] 120; hardwareId = Protect-WddText (@($_['hardwareIds']) | Select-Object -First 1) 200; note = Protect-WddText $_['note'] } })

    $events = @(Read-WddActivity $Paths 40)
    [array]::Reverse($events)
    $m.activity = @($events | ForEach-Object { [ordered]@{ utc = [string] $_['utc']; level = $(if ([string] $_['level'] -in 'info', 'warning', 'error') { [string] $_['level'] } else { 'info' }); source = Protect-WddText $_['source'] 32; message = Protect-WddText $_['message'] } })

    if ([string] $state.status -eq 'Completed') { $m.final = Get-WddMonitorFinal $Paths $m }
    return $m
}

&lt;# Final results from the deployment report (whitelisted). #&gt;
function Get-WddMonitorFinal {
    param([hashtable] $Paths, $Model)
    $r = Read-WddJson $Paths.ReportJson
    $f = [ordered]@{ overall = [string] $Model.overall; completed = @(); failed = @(); unresolvedDevices = @($Model.drivers.unresolvedDevices); followUp = @() }
    if ($r -isnot [hashtable]) { return $f }
    $f.overall = [string] $r['overall']
    $w = $r['windowsUpdate']
    if ($w -is [hashtable]) {
        $f.completed += "Windows Update: $([int] $w['installed']) update(s) installed$(if ($null -ne $w['installedOptional']) { " ($([int] $w['installedOptional']) optional, $([int] $w['installedDrivers']) drivers)" }); result $($w['status'])."
        foreach ($x in @($w['failedUpdates']) | Where-Object { $_ -is [hashtable] }) { $f.failed += Protect-WddText "Windows Update $((@($x['kbs']) -join ', ')) $($x['title']): failed after $($x['attempts']) attempt(s) ($($x['lastHResult']))" }
    }
    $a = $r['applications']
    if ($a -is [hashtable]) {
        $pk = @(@($a['packages']) | Where-Object { $_ -is [hashtable] })
        $ok = @($pk | Where-Object { $_['status'] -in 'Succeeded', 'AlreadyInstalled' })
        $f.completed += "Applications: $($ok.Count) of $(@($pk | Where-Object { $_['status'] -ne 'SkippedByUser' }).Count) installed$(if ($a['verification'] -is [hashtable]) { " ($([int] $a['verification']['Verified']) confirmed by WinGet)" })."
        foreach ($x in @($pk | Where-Object { $_['status'] -in 'Failed', 'Unavailable' })) { $f.failed += Protect-WddText "Application $($x['name']): $($x['status']). $($x['message'])" }
    }
    $d = $r['drivers']
    if ($d -is [hashtable] -and $d.ContainsKey('status')) { $f.completed += "Hardware and drivers: $($d['status'])." }
    $f.followUp = @(@($r['remainingTasks']) | Where-Object { $_ } | Select-Object -First 30 | ForEach-Object { Protect-WddText $_ })
    return $f
}

# ------------------------------------------------------------------------------------------------
# HTTP
# ------------------------------------------------------------------------------------------------

$script:SecurityHeaders = [ordered]@{
    'Cache-Control'           = 'no-store'
    'X-Content-Type-Options'  = 'nosniff'
    'Referrer-Policy'         = 'no-referrer'
    'X-Frame-Options'         = 'DENY'
    'Cross-Origin-Resource-Policy' = 'same-origin'
    'Content-Security-Policy' = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
}

function New-WddResponse {
    param([int] $Status, [string] $ContentType, [string] $Body, [hashtable] $Extra = @{})
    $h = [ordered]@{}
    foreach ($k in $script:SecurityHeaders.Keys) { $h[$k] = $script:SecurityHeaders[$k] }
    foreach ($k in $Extra.Keys) { $h[$k] = $Extra[$k] }
    @{ Status = $Status; ContentType = $ContentType; Body = $Body; Headers = $h }
}

&lt;#
    Answers one request (pure: no network; the server loop and the tests call it).
    $Context: Token, Manifest, Paths, Settings.
#&gt;
function Invoke-WddMonitorRequest {
    param([string] $Method, [string] $Path, [hashtable] $Headers, [hashtable] $Context)
    if ($Method -notin 'GET', 'HEAD') { return New-WddResponse 405 'text/plain; charset=utf-8' 'Method not allowed. This monitor is read-only.' @{ Allow = 'GET, HEAD' } }
    $p = ([string] $Path).Split('?')[0]
    switch ($p) {
        { $_ -in '/', '/index.html' } { return New-WddResponse 200 'text/html; charset=utf-8' $script:DashboardHtml }
        '/app.js' { return New-WddResponse 200 'application/javascript; charset=utf-8' $script:DashboardJs }
        '/app.css' { return New-WddResponse 200 'text/css; charset=utf-8' $script:DashboardCss }
        '/favicon.ico' { return New-WddResponse 204 'text/plain' '' }
        '/api/status' {
            $auth = $(if ($Headers -and $Headers.ContainsKey('Authorization')) { [string] $Headers['Authorization'] } else { '' })
            $given = $(if ($auth -match '^Bearer\\s+(\\S+)$') { $Matches[1] } else { '' })
            if (-not (Test-WddMonitorToken $given ([string] $Context.Token))) {
                return New-WddResponse 401 'application/json; charset=utf-8' '{"error":"unauthorized","message":"Open the full address shown in the Deployment Progress window; it ends with #t= followed by the access token."}' @{ 'WWW-Authenticate' = 'Bearer realm="deployment-monitor"' }
            }
            $model = $null
            try { $model = Get-WddMonitorStatus $Context.Manifest $Context.Paths $Context.Settings }
            catch {
                # A state file being replaced at this moment, for example: the page tries again in a few seconds.
                Write-WddLog "Monitor: status could not be built: $($_.Exception.Message)" 'WARN'
                return New-WddResponse 503 'application/json; charset=utf-8' '{"error":"unavailable","message":"The status is being updated; trying again shortly."}' @{ 'Retry-After' = '5' }
            }
            return New-WddResponse 200 'application/json; charset=utf-8' ($model | ConvertTo-Json -Depth 8 -Compress)
        }
    }
    return New-WddResponse 404 'text/plain; charset=utf-8' 'Not found.'
}

function Send-WddResponse {
    param($HttpContext, [hashtable] $Response, [bool] $Head)
    $res = $HttpContext.Response
    $res.StatusCode = $Response.Status
    $res.ContentType = $Response.ContentType
    foreach ($k in $Response.Headers.Keys) {
        # Some headers can only be set through properties (HTTP.sys); a header that cannot be set is skipped.
        try { $res.AddHeader($k, [string] $Response.Headers[$k]) } catch { Write-WddLog "Monitor: header $k not sent: $($_.Exception.Message)" 'WARN' }
    }
    $bytes = (New-Object System.Text.UTF8Encoding($false)).GetBytes([string] $Response.Body)
    $res.ContentLength64 = $bytes.Length
    if (-not $Head -and $bytes.Length) { $res.OutputStream.Write($bytes, 0, $bytes.Length) }
    $res.Close()
}

&lt;# $true once the final report has been shown for finalReportHours after completion. #&gt;
function Test-WddMonitorExpired {
    param([hashtable] $Paths, [hashtable] $Settings)
    $s = (Read-WddDeploymentState $Paths).State
    if (-not $s -or [string] $s['status'] -ne 'Completed') { return $false }
    $done = ConvertTo-WddDate $s['completedUtc']
    return [bool] ($done -and (Get-WddNow) -ge $done.AddHours($Settings.finalReportHours))
}

&lt;# Removes the firewall rule and the task, and tells the progress window why the monitor stopped. #&gt;
function Stop-WddMonitor {
    param([hashtable] $Paths, [string] $Message)
    try { Remove-WddMonitorFirewall } catch { Write-WddLog "Monitor: firewall rule not removed: $($_.Exception.Message)" 'WARN' }
    $info = Read-WddJson $Paths.MonitorInfo
    if ($info -is [hashtable]) { $info.mode = 'stopped'; $info.message = $Message; $info.stoppedUtc = (Get-WddNow).ToString('o'); try { Write-WddJson $Paths.MonitorInfo $info } catch { } }
    try { Remove-WddStatusServerTask } catch { Write-WddLog "Monitor: task not removed: $($_.Exception.Message)" 'WARN' }
    Write-WddLog "Monitor stopped: $Message"
}

&lt;#
    The server loop: one request at a time (small, read-only answers). Every 60 seconds it refreshes
    the addresses (a network that appears later) and checks whether its time is over.
    -MaxSeconds limits the run (tests).
#&gt;
function Start-WddStatusServer {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Settings, [hashtable] $Info, [string[]] $Prefixes = @(), [int] $MaxSeconds = 0)
    $listener = New-Object System.Net.HttpListener
    if (-not $Prefixes.Count) { $Prefixes = $(if ($Settings.lanAccess) { @("http://+:$($Settings.port)/") } else { @("http://127.0.0.1:$($Settings.port)/", "http://localhost:$($Settings.port)/") }) }
    foreach ($p in $Prefixes) { $listener.Prefixes.Add($p) }
    $listener.IgnoreWriteExceptions = $true
    $listener.Start()
    Write-WddLog "Monitor $($script:MonitorVersion) listening on $($Prefixes -join ', ') (LAN access: $($Settings.lanAccess))."
    $context = @{ Token = [string] $Info.token; Manifest = $Manifest; Paths = $Paths; Settings = $Settings }
    $started = Get-Date
    $nextCheck = (Get-Date).AddSeconds(60)
    try {
        while ($true) {
            $ar = $listener.BeginGetContext($null, $null)
            $stop = $false
            while (-not $ar.AsyncWaitHandle.WaitOne(1000)) {
                if ($MaxSeconds -gt 0 -and ((Get-Date) - $started).TotalSeconds -ge $MaxSeconds) { $stop = $true; break }
                if ((Get-Date) -ge $nextCheck) {
                    $nextCheck = (Get-Date).AddSeconds(60)
                    if (Test-WddMonitorExpired $Paths $Settings) { $stop = $true; Stop-WddMonitor $Paths "The deployment finished; the final results were shown for $($Settings.finalReportHours) hour(s). The report stays on this computer."; break }
                    if ($Settings.lanAccess) { try { $fresh = Initialize-WddMonitorInfo $Paths $Settings -Refresh; $context.Token = [string] $fresh.token } catch { } }
                }
            }
            if ($stop) { break }
            $http = $listener.EndGetContext($ar)
            try {
                $req = $http.Request
                $h = @{}
                if ($req.Headers['Authorization']) { $h['Authorization'] = [string] $req.Headers['Authorization'] }
                $r = Invoke-WddMonitorRequest $req.HttpMethod $req.Url.AbsolutePath $h $context
                Send-WddResponse $http $r ($req.HttpMethod -eq 'HEAD')
            } catch {
                Write-WddLog "Monitor: request failed: $($_.Exception.Message)" 'WARN'
                try { $http.Response.StatusCode = 500; $http.Response.Close() } catch { }
            }
        }
    } finally {
        try { $listener.Stop() } catch { }
        $listener.Close()
    }
}

# ------------------------------------------------------------------------------------------------
# The page (no data in it; everything comes from /api/status with the token)
# ------------------------------------------------------------------------------------------------

$script:DashboardHtml = @'
&lt;!doctype html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
&lt;meta charset="utf-8"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1"&gt;
&lt;meta name="referrer" content="no-referrer"&gt;
&lt;title&gt;Deployment Monitor&lt;/title&gt;
&lt;link rel="stylesheet" href="/app.css"&gt;
&lt;script src="/app.js" defer&gt;&lt;/script&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;header&gt;
  &lt;h1 id="title"&gt;Deployment Monitor&lt;/h1&gt;
  &lt;p id="subtitle"&gt;Windows Deployment Builder - read-only status&lt;/p&gt;
&lt;/header&gt;
&lt;main&gt;
  &lt;section id="overall" class="card wide" aria-live="polite"&gt;
    &lt;div class="row"&gt;&lt;span id="badge" class="badge"&gt;Connecting&lt;/span&gt;&lt;span id="statusText"&gt;Connecting to the deployment monitor...&lt;/span&gt;&lt;/div&gt;
    &lt;dl class="facts"&gt;
      &lt;dt&gt;Computer&lt;/dt&gt;&lt;dd id="computer"&gt;-&lt;/dd&gt;
      &lt;dt&gt;Deployment&lt;/dt&gt;&lt;dd id="deployment"&gt;-&lt;/dd&gt;
      &lt;dt&gt;Last activity&lt;/dt&gt;&lt;dd id="lastActivity"&gt;-&lt;/dd&gt;
      &lt;dt&gt;Last contact with the monitor&lt;/dt&gt;&lt;dd id="lastContact"&gt;-&lt;/dd&gt;
    &lt;/dl&gt;
    &lt;ul id="attention" class="attention"&gt;&lt;/ul&gt;
  &lt;/section&gt;
  &lt;section class="card" aria-labelledby="wu-h"&gt;&lt;h2 id="wu-h"&gt;Windows Update&lt;/h2&gt;&lt;div id="wu"&gt;&lt;/div&gt;&lt;/section&gt;
  &lt;section class="card" aria-labelledby="apps-h"&gt;&lt;h2 id="apps-h"&gt;Applications&lt;/h2&gt;&lt;div id="apps"&gt;&lt;/div&gt;&lt;/section&gt;
  &lt;section class="card" aria-labelledby="drv-h"&gt;&lt;h2 id="drv-h"&gt;Drivers and devices&lt;/h2&gt;&lt;div id="drv"&gt;&lt;/div&gt;&lt;/section&gt;
  &lt;section id="officeCard" class="card" hidden aria-labelledby="off-h"&gt;&lt;h2 id="off-h"&gt;Microsoft Office&lt;/h2&gt;&lt;div id="off"&gt;&lt;/div&gt;&lt;/section&gt;
  &lt;section id="activationCard" class="card" hidden aria-labelledby="actv-h"&gt;&lt;h2 id="actv-h"&gt;Activation&lt;/h2&gt;&lt;div id="actv"&gt;&lt;/div&gt;&lt;/section&gt;
  &lt;section id="finalCard" class="card wide" hidden aria-labelledby="final-h"&gt;&lt;h2 id="final-h"&gt;Final results&lt;/h2&gt;&lt;div id="final"&gt;&lt;/div&gt;&lt;/section&gt;
  &lt;section class="card wide" aria-labelledby="act-h"&gt;&lt;h2 id="act-h"&gt;Recent activity&lt;/h2&gt;&lt;ol id="activity" class="activity"&gt;&lt;/ol&gt;&lt;/section&gt;
&lt;/main&gt;
&lt;footer&gt;&lt;p&gt;Read-only. This page cannot start, stop or change anything on the computer. It refreshes every &lt;span id="refresh"&gt;7&lt;/span&gt; seconds.&lt;/p&gt;&lt;/footer&gt;
&lt;/body&gt;
&lt;/html&gt;
'@

$script:DashboardCss = @'
:root { --bg: #f4f6f8; --card: #ffffff; --text: #1b2430; --muted: #5b6776; --line: #dde3ea; --ok: #1e7b3a; --wait: #8a6100; --bad: #b3261e; --act: #1f5fbf; --rec: #6b3fa0; }
@media (prefers-color-scheme: dark) { :root { --bg: #11161c; --card: #1a2129; --text: #e7edf3; --muted: #a3b0bf; --line: #2c3743; --ok: #5cc27a; --wait: #e0b44a; --bad: #ff8a80; --act: #7fb0ff; --rec: #c4a3f0; } }
* { box-sizing: border-box; }
body { margin: 0; font: 15px/1.45 system-ui, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); }
header, footer { padding: 16px; max-width: 1100px; margin: 0 auto; }
h1 { margin: 0; font-size: 1.5rem; }
h2 { margin: 0 0 8px; font-size: 1.1rem; }
#subtitle, footer { color: var(--muted); font-size: .9rem; }
main { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); padding: 0 16px 16px; max-width: 1100px; margin: 0 auto; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px; min-width: 0; overflow-wrap: anywhere; }
.wide { grid-column: 1 / -1; }
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-weight: 600; color: #fff; background: var(--muted); }
.badge.active { background: var(--act); } .badge.waiting { background: var(--wait); } .badge.recovering { background: var(--rec); }
.badge.complete { background: var(--ok); } .badge.attention { background: var(--bad); } .badge.offline { background: var(--bad); }
.facts { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 10px 0 0; }
.facts dt { color: var(--muted); } .facts dd { margin: 0; }
.attention { margin: 10px 0 0; padding-left: 18px; color: var(--bad); }
.kv { display: grid; grid-template-columns: max-content 1fr; gap: 2px 12px; margin: 8px 0 0; }
.kv span:nth-child(odd) { color: var(--muted); }
.activityText { margin: 0; }
.error { color: var(--bad); }
.activity { list-style: none; margin: 0; padding: 0; }
.activity li { padding: 6px 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: max-content 1fr; gap: 10px; }
.activity li:first-child { border-top: 0; }
.activity time { color: var(--muted); font-variant-numeric: tabular-nums; }
.activity .warning { color: var(--wait); } .activity .error { color: var(--bad); }
ul.plain { margin: 6px 0 0; padding-left: 18px; }
'@

$script:DashboardJs = @'
(function () {
  'use strict';
  var KEY = 'wdbMonitorToken';
  var token = '';
  var timer = null;
  var refresh = 7;
  var lastOk = null;
  try {
    var m = /(?:^#|&amp;)t=([A-Za-z0-9_-]{43})(?:&amp;|$)/.exec(window.location.hash);
    if (m) { token = m[1]; sessionStorage.setItem(KEY, token); history.replaceState(null, '', window.location.pathname); }
    else { token = sessionStorage.getItem(KEY) || ''; }
  } catch (e) { token = token || ''; }

  function $(id) { return document.getElementById(id); }
  function clear(node) { while (node.firstChild) { node.removeChild(node.firstChild); } }
  function el(tag, cls, text) { var n = document.createElement(tag); if (cls) { n.className = cls; } if (text !== undefined &amp;&amp; text !== null) { n.textContent = String(text); } return n; }
  function when(iso) { if (!iso) { return 'unknown'; } var d = new Date(iso); if (isNaN(d.getTime())) { return 'unknown'; } var s = Math.round((Date.now() - d.getTime()) / 1000); var ago = s &lt; 60 ? 'just now' : s &lt; 7200 ? Math.round(s / 60) + ' min ago' : Math.round(s / 3600) + ' h ago'; return d.toLocaleTimeString() + ' (' + ago + ')'; }
  function kv(parent, pairs) { var g = el('div', 'kv'); pairs.forEach(function (p) { if (p[1] === null || p[1] === undefined || p[1] === '') { return; } g.appendChild(el('span', null, p[0])); g.appendChild(el('span', null, p[1])); }); parent.appendChild(g); }
  function text(parent, t, cls) { if (t) { parent.appendChild(el('p', cls || 'activityText', t)); } }
  var LABEL = { active: 'Active', waiting: 'Waiting', recovering: 'Recovering', complete: 'Complete', attention: 'Attention required', offline: 'Monitor unreachable' };

  function badge(status, extra) { var b = $('badge'); b.className = 'badge ' + status; b.textContent = LABEL[status] || status; if (extra) { $('statusText').textContent = extra; } }

  function render(s) {
    refresh = s.refreshSeconds || 7; $('refresh').textContent = refresh;
    $('title').textContent = 'Deployment Monitor - ' + (s.computerName || '');
    document.title = (LABEL[s.status] || s.status) + ' - ' + (s.computerName || 'Deployment');
    badge(s.status, s.statusText || '');
    $('computer').textContent = s.computerName || '-';
    $('deployment').textContent = s.deploymentId || '-';
    $('lastActivity').textContent = when(s.lastActivityUtc);
    var at = $('attention'); clear(at); (s.attention || []).forEach(function (a) { at.appendChild(el('li', null, a)); });

    var wu = $('wu'); clear(wu);
    if (s.windowsUpdate) {
      var w = s.windowsUpdate;
      text(wu, w.activity);
      kv(wu, [['Current update', w.current || ''], ['Attempt', w.attempt ? (w.attempt + ' of ' + (w.maxAttempts || '?')) : ''],
              ['Installed', w.installed], ['Optional / drivers', w.installedOptional !== null &amp;&amp; w.installedOptional !== undefined ? (w.installedOptional + ' / ' + w.installedDrivers) : ''],
              ['Failed', w.failed], ['Need a person', w.needsPerson], ['Restart required', w.rebootRequired ? 'Yes' : 'No'],
              ['Download progress', w.phase === 'Downloading' ? 'progress unavailable' : '']]);
      if (w.lastError) { text(wu, 'Most recent error: ' + w.lastError, 'error'); }
    } else { text(wu, 'Not part of this deployment.'); }

    var ap = $('apps'); clear(ap);
    if (s.applications) {
      var a = s.applications;
      if (a.current) { text(ap, 'Installing ' + a.current + ' - progress unavailable'); }
      text(ap, a.activity);
      kv(ap, [['Selected', a.selected], ['Installed', a.installed], ['Remaining', a.remaining], ['Failed', a.failed], ['Need a person', a.needsPerson]]);
      if (a.lastError) { text(ap, a.lastError, 'error'); }
    } else { text(ap, 'Not part of this deployment.'); }

    var off = $('off'); clear(off); $('officeCard').hidden = !s.office;
    if (s.office) {
      var o = s.office;
      text(off, o.activity);
      kv(off, [['Edition', o.product], ['Phase', o.phase], ['Verified', o.state === 'Final' ? (o.verified ? 'Yes' : 'No') : ''], ['Download progress', o.phase === 'Downloading' ? 'progress unavailable' : '']]);
      if (o.state === 'Final' &amp;&amp; o.detail) { text(off, o.detail); }
      if (o.lastError) { text(off, 'Most recent error: ' + o.lastError, 'error'); }
    }
    var av = $('actv'); clear(av); $('activationCard').hidden = !s.activation;
    if (s.activation) {
      [['Windows', s.activation.windows], ['Office', s.activation.office]].forEach(function (p) {
        if (p[1]) { kv(av, [[p[0], p[1].status + (p[1].verified ? ' (verified)' : '')]]); text(av, p[1].message); }
      });
    }

    var dv = $('drv'); clear(dv);
    if (s.drivers) {
      var d = s.drivers;
      text(dv, d.activity);
      kv(dv, [['Installed', d.installed], ['Failed or skipped', d.failedOrSkipped], ['Restart pending', d.restartPending === undefined ? '' : (d.restartPending ? 'Yes' : 'No')],
              ['Unresolved devices', (d.unresolvedDevices || []).length]]);
      if ((d.unresolvedDevices || []).length) {
        var ul = el('ul', 'plain');
        d.unresolvedDevices.forEach(function (x) { ul.appendChild(el('li', null, x.name + ' (' + (x.problemCode ? 'code ' + x.problemCode + ': ' : '') + x.problem + ')' + (x.hardwareId ? ' [' + x.hardwareId + ']' : '') + '. ' + x.note)); });
        dv.appendChild(ul);
      }
    }

    var fc = $('finalCard'), f = $('final'); clear(f);
    if (s.final) {
      fc.hidden = false;
      text(f, 'Overall result: ' + s.final.overall);
      [['Completed', s.final.completed], ['Failed', s.final.failed], ['Technician follow-up', s.final.followUp]].forEach(function (g) {
        if (!g[1] || !g[1].length) { return; }
        f.appendChild(el('h3', null, g[0]));
        var list = el('ul', 'plain'); g[1].forEach(function (t) { list.appendChild(el('li', null, t)); }); f.appendChild(list);
      });
    } else { fc.hidden = true; }

    var act = $('activity'); clear(act);
    (s.activity || []).forEach(function (e) { var li = el('li'); li.appendChild(el('time', null, when(e.utc))); li.appendChild(el('span', e.level, e.message)); act.appendChild(li); });
    if (!(s.activity || []).length) { act.appendChild(el('li', null, 'No activity recorded yet.')); }
  }

  function schedule() { if (timer) { clearTimeout(timer); } timer = setTimeout(poll, refresh * 1000); }

  function poll() {
    if (!token) { badge('attention', 'No access token. Open the full address shown in the Deployment Progress window on the computer (it ends with #t=...).'); return; }
    var xhr = new XMLHttpRequest();
    xhr.open('GET', '/api/status', true);
    xhr.setRequestHeader('Authorization', 'Bearer ' + token);
    xhr.timeout = 10000;
    xhr.onload = function () {
      if (xhr.status === 200) {
        try { lastOk = new Date(); $('lastContact').textContent = lastOk.toLocaleTimeString(); render(JSON.parse(xhr.responseText)); } catch (e) { badge('offline', 'The answer could not be read; trying again.'); }
      } else if (xhr.status === 401) {
        try { sessionStorage.removeItem(KEY); } catch (e) { }
        token = ''; badge('attention', 'The access token was not accepted. Open the full address shown in the Deployment Progress window again.'); return;
      } else { badge('offline', 'The monitor answered ' + xhr.status + '; trying again.'); }
      schedule();
    };
    xhr.onerror = xhr.ontimeout = function () {
      badge('offline', 'The computer did not answer' + (lastOk ? ' since ' + lastOk.toLocaleTimeString() : '') + '. It may be restarting; trying again.');
      schedule();
    };
    xhr.send();
  }
  document.addEventListener('DOMContentLoaded', poll);
}());
'@

# ------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------

if ($script:MonMain) {
    $package = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
    $manifest = Read-WddManifest (Join-Path $package 'deployment-manifest.json')
    $paths = Get-WddPaths $manifest.dataRoot
    foreach ($d in $paths.Deployment, $paths.Logs, $paths.StateDir) { if (-not (Test-Path -LiteralPath $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null } }
    $script:WddLogFile = Join-Path $paths.Logs 'monitor.log'
    $settings = Get-WddMonitorSettings $manifest
    if (-not $settings.enabled) { Write-Output 'The deployment monitor is not enabled in this package.'; exit 0 }
    if (Test-WddMonitorExpired $paths $settings) { Stop-WddMonitor $paths 'The deployment finished; the final results were already shown. The report stays on this computer.'; exit 0 }
    try {
        $info = Initialize-WddMonitorInfo $paths $settings
        Start-WddStatusServer $manifest $paths $settings $info
    } catch {
        $msg = "The monitor could not start: $($_.Exception.Message) The deployment continues; the progress window still shows the status."
        Write-WddLog $msg 'ERROR'
        $info = Read-WddJson $paths.MonitorInfo
        if ($info -is [hashtable]) { $info.mode = 'error'; $info.message = $msg; try { Write-WddJson $paths.MonitorInfo $info } catch { } }
        exit 1
    }
    exit 0
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\recovery\\DeploymentRecovery.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Windows Deployment Recovery: status, retry of failed operations, resume and diagnostics for a
    deployment on this computer (Phase 5).

.DESCRIPTION
    A small console tool for the technician. It never installs anything itself: it re-verifies the
    staged package, reopens operations in the engines' own state (ApplicationEngine.ps1 -Mode Retry
    logic, under the engine's mutex), registers the engines' tasks again and lets the deployment
    monitor follow them, exactly as during the original deployment. Every security check of the
    first run applies again on the retried attempt.

      -Action Menu               (default) numbered menu; asks for administrator rights with -Elevate
      -Action Status [-Json]     the deployment outcome, stages and every operation (read-only)
      -Action PendingActions     what a person still has to do (manual installs, restarts, checks)
      -Action RetryFailed        reopens every retryable failed or unfinished application (and a
                                 failed Windows Update stage), keeping successful ones
      -Action Retry -Operation app:winget:git.git[,...]
                                 reopens the named operations (ids from Status); a dependency that
                                 did not install is reopened with what needs it
           [-IncludePermanent]   also permanent failures (hash, signature, policy, not found,
                                 cancelled): only after the cause has been corrected
      -Action Resume             continues interrupted provisioning: unfinished operations, a
                                 missing task or monitor, a damaged deployment state (rebuilt from
                                 the manifest and the engines' own files)
      -Action RestoreSettings -BackupPath &lt;folder or .zip&gt;
                                 Phase 6: stages the application settings backup this deployment
                                 expects (identified by the SHA-256 pinned in its configuration;
                                 any other or modified backup is refused) and restores the settings
                                 that are still outstanding; restored settings are never repeated
      -Action AddDrivers -DriverPath &lt;folder&gt;
                                 Phase 8: validates INF driver packages from a folder (for example
                                 a network driver on a USB stick when the computer has no network;
                                 Microsoft-signed only), stages them for the driver stage and runs
                                 it again for the devices that are still unresolved
      -Action ExportDiagnostics [-OutputPath &lt;zip&gt;]
                                 logs, states, results and the report as one ZIP, with passwords
                                 and Wi-Fi keys removed; answer files, Wi-Fi profiles and settings
                                 backups are never included (every entry is checked afterwards)
      -Action Verify             Phase 9: verifies the deployment against Windows itself
                                 (DeploymentHealth.ps1, read-only) and writes the health reports

    Per-user applications belong to the account the application stage ran as (Phase 5 deployment
    user). Run from another administrator account, RetryFailed, Retry, Resume and RestoreSettings
    refuse to move them; -RetargetUser installs the remaining ones into the current account instead,
    deliberately and recorded in the recovery history.

    Only operations of this deployment's verified configuration can be retried. Deselected apps,
    manual catalog entries, unresolved identifiers and anything already installed are refused. No
    input is ever executed: operation ids must match a strict pattern and the permitted set.

    Exit codes: Status returns the outcome code (0 Succeeded, 10 CompletedWithWarnings,
    20 CompletedWithFailures, 25 Incomplete, 30/31/32 paused for network/reboot/user, 40 InProgress,
    50 FailedToInitialize, 60 Failed). Actions return 0 (done), 1 (refused or nothing to do),
    2 (busy), 3 (package integrity), 4 (administrator rights needed), 5 (Partial: some stages
    were restarted, the task of another could not be registered), 6 (Failed: no stage task could
    be registered). A stage only counts as restarted when its scheduled task exists afterwards.
#&gt;
[CmdletBinding()]
param(
    [ValidateSet('Menu', 'Status', 'PendingActions', 'RetryFailed', 'Retry', 'Resume', 'RestoreSettings', 'AddDrivers', 'ExportDiagnostics', 'Verify', 'Activate', 'CheckActivation')]
    [string] $Action = 'Menu',
    [ValidateSet('', 'Windows', 'Office')]
    [string] $Target = '',
    [string] $BackupPath = '',
    [string] $DriverPath = '',
    [string[]] $Operation = @(),
    [switch] $IncludePermanent,
    [switch] $RetargetUser,
    [switch] $Json,
    [string] $OutputPath = '',
    [switch] $Elevate
)

$script:RecoveryMain = $MyInvocation.InvocationName -ne '.'
# Captured first: the scripts dot-sourced below bind their own parameters in this scope.
$script:RecoveryArgs = @{ Action = $Action; Target = $Target; BackupPath = $BackupPath; DriverPath = $DriverPath; Operation = @($Operation); IncludePermanent = [bool] $IncludePermanent; RetargetUser = [bool] $RetargetUser; Json = [bool] $Json; OutputPath = $OutputPath; Elevate = [bool] $Elevate }
. (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1')
. (Join-Path $PSScriptRoot '..\\bootstrap\\Initialize-Deployment.ps1')
. (Join-Path $PSScriptRoot '..\\orchestrator\\Show-DeploymentStatus.ps1')
# The application engine's own functions (Retry mode, lifecycle); present when the stage is part of the package.
$script:AppEngineScript = Join-Path $PSScriptRoot '..\\applications\\ApplicationEngine.ps1'
if (Test-Path -LiteralPath $script:AppEngineScript) { . $script:AppEngineScript }
# Phase 8: the driver engine's own functions (Retry, technician packages), when the stage is part of the package.
$script:DriverEngineScript = Join-Path $PSScriptRoot '..\\drivers\\DriverEngine.ps1'
if (Test-Path -LiteralPath $script:DriverEngineScript) { . $script:DriverEngineScript -Mode Library }
# Phase 9: the health engine (read-only verification), when the deployment verifies itself.
$script:HealthEngineScript = Join-Path $PSScriptRoot '..\\health\\DeploymentHealth.ps1'
if (Test-Path -LiteralPath $script:HealthEngineScript) { . $script:HealthEngineScript -Mode Library }
# Schema 9: the activation stage's functions, when the deployment activates Windows or Office.
$script:ActivationScript = Join-Path $PSScriptRoot '..\\finalization\\Activation.ps1'
if (Test-Path -LiteralPath $script:ActivationScript) { . $script:ActivationScript }
Set-StrictMode -Version 2.0

$script:RecoveryExit = @{ Done = 0; Refused = 1; NothingToDo = 1; Busy = 2; IntegrityFailed = 3; NotElevated = 4; NoState = 1; UnknownStage = 1; Partial = 5; Failed = 6 }

&lt;#
    The account the application stage belongs to (Phase 5 deployment user): its launch record, else
    the user the engine's result names. Empty when unknown.
#&gt;
function Get-WdrDeploymentUser {
    param([hashtable] $Paths, [hashtable] $State)
    if ($State -and $State['stages'] -is [hashtable] -and $State['stages'].ContainsKey('applications') -and $State['stages']['applications'] -is [hashtable] -and $State['stages']['applications']['user']) { return [string] $State['stages']['applications']['user'] }
    $r = Read-WddJson (Join-Path $Paths.Root 'Applications\\result.json')
    if ($r -and $r['user']) { return [string] $r['user'] }
    return ''
}

# ------------------------------------------------------------------------------------------------
# Adapters (replaced by the scenario tests)
# ------------------------------------------------------------------------------------------------

&lt;# The application engine configuration of the staged package (the verified copy). #&gt;
function Get-WdrAppConfig {
    param([hashtable] $Paths)
    $p = Join-Path $Paths.Package 'scripts\\applications\\applications-config.json'
    if (-not (Test-Path -LiteralPath $p) -or -not (Get-Command Get-WdaConfig -ErrorAction SilentlyContinue)) { return $null }
    Get-WdaConfig $p
}

&lt;# Registers and starts the application task again without archiving its state (Install-ApplicationEngine.ps1 -Resume). #&gt;
function Invoke-WdrAppInstaller {
    param([hashtable] $Paths)
    $installer = Join-Path $Paths.Package 'scripts\\applications\\Install-ApplicationEngine.ps1'
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $out = &amp; $ps -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $installer -Resume 2&gt;&amp;1
    foreach ($line in @($out)) { Write-WddLog "    | $line" }
    return $LASTEXITCODE
}

function Get-WdrDesktop { [Environment]::GetFolderPath('Desktop') }

&lt;# Phase 8: the driver engine configuration of the staged package (the verified copy). #&gt;
function Get-WdrDriverConfig {
    param([hashtable] $Paths)
    $p = Join-Path $Paths.Package 'scripts\\drivers\\drivers-config.json'
    if (-not (Test-Path -LiteralPath $p) -or -not (Get-Command Get-WdvConfig -ErrorAction SilentlyContinue)) { return $null }
    Get-WdvConfig $p
}

&lt;# Registers and starts the driver task again without archiving its state (Install-DriverEngine.ps1 -Resume). #&gt;
function Invoke-WdrDriverInstaller {
    param([hashtable] $Paths)
    $installer = Join-Path $Paths.Package 'scripts\\drivers\\Install-DriverEngine.ps1'
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $out = &amp; $ps -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $installer -Resume 2&gt;&amp;1
    foreach ($line in @($out)) { Write-WddLog "    | $line" }
    return $LASTEXITCODE
}

# ------------------------------------------------------------------------------------------------
# Status
# ------------------------------------------------------------------------------------------------

&lt;# Every application operation from the engine's live state (or its last result). #&gt;
function Get-WdrOperations {
    param([hashtable] $Paths)
    $app = Join-Path $Paths.Root 'Applications'
    $s = $null
    foreach ($f in 'state.json', 'state.json.bak') { $s = Read-WddJson (Join-Path $app $f); if ($s -and $s.ContainsKey('packages')) { break } }
    $ops = @()
    foreach ($map in @(if ($s) { 'packages', 'additional', 'settings' })) {
        if (-not $s.ContainsKey($map) -or $s[$map] -isnot [hashtable]) { continue }
        foreach ($e in @($s[$map].Values)) {
            if ($e -isnot [hashtable]) { continue }
            $id = $(if ($e.ContainsKey('operationId') -and $e.operationId) { [string] $e.operationId } elseif ($map -eq 'packages') { "app:$($e['key'])" } elseif ($map -eq 'settings') { "settings:$($e['id'])" } else { "additional:$($e['id'])" })
            $life = $(if (Get-Command Get-WdaLifecycle -ErrorAction SilentlyContinue) { Get-WdaLifecycle $e } else { [string] $e.status })
            $ops += [ordered]@{ operationId = $id; name = [string] $e['name']; status = [string] $e['status']; lifecycle = $life; failureClass = [string] $e['failureClass']
                                retryable = [bool] $e['retryable']; attempts = [int] $e['attempts']; totalAttempts = [int] $e['totalAttempts']; detection = [string] $e['detection']; message = [string] $e['message'] }
        }
    }
    # Phase 8: driver operations (their status already is a lifecycle name).
    $d = $null
    foreach ($f in 'state.json', 'state.json.bak') { $d = Read-WddJson (Join-Path (Join-Path $Paths.Root 'Drivers') $f); if ($d -and $d['operations'] -is [hashtable]) { break } }
    if ($d -and $d['operations'] -is [hashtable]) {
        foreach ($e in @($d['operations'].Values)) {
            if ($e -isnot [hashtable]) { continue }
            $msg = $(if ($e['manualAction'] -is [hashtable] -and $e['manualAction']['text']) { [string] $e['manualAction']['text'] } else { [string] $e['reason'] })
            $ops += [ordered]@{ operationId = [string] $e['operationId']; name = [string] $e['name']; status = [string] $e['status']; lifecycle = [string] $e['status']; failureClass = [string] $e['failureClass']
                                retryable = ([string] $e['status'] -eq 'FailedRetryable'); attempts = [int] $e['attempts']; totalAttempts = [int] $e['totalAttempts']; detection = ''; message = $msg }
        }
    }
    return @($ops | Sort-Object { $_.operationId })
}

function Get-WdrStatus {
    param([hashtable] $Manifest, [hashtable] $Paths)
    $read = Read-WddDeploymentState $Paths
    $snap = $(if ($read.State) { Get-WddSnapshot $Manifest $Paths $read.State } else { $null })
    $out = $(if ($snap) { [ordered]@{ outcome = $snap.outcome; exitCode = $snap.outcomeCode; detail = $snap.outcomeDetail } } else { Get-WddDeploymentOutcome $null $null $read.Problem })
    [ordered]@{
        format          = 'windows-deployment-builder/recovery-status'
        version         = 1
        generatedUtc    = (Get-WddNow).ToString('o')
        packageId       = $Manifest.packageId
        outcome         = $out.outcome
        exitCode        = $out.exitCode
        detail          = $out.detail
        deploymentState = $(if ($read.State) { [string] $read.State.status } elseif ($read.Source -eq 'corrupt') { 'StateCorrupt' } else { 'NotInitialized' })
        stateSource     = $read.Source
        stages          = @(if ($snap) { @($snap.stages) | ForEach-Object { [ordered]@{ id = $_.id; name = $_.name; state = $_.state; status = $_.status; detail = $_.detail; idle = $_.idle; outstanding = $_.outstanding } } })
        operations      = @(Get-WdrOperations $Paths)
        report          = $(if (Test-Path -LiteralPath $Paths.ReportText) { $Paths.ReportText } else { '' })
    }
}

function Format-WdrStatus {
    param($Status)
    $l = New-Object System.Collections.Generic.List[string]
    $l.Add('Windows Deployment Recovery - status')
    $l.Add('====================================')
    $l.Add("Outcome   : $($Status.outcome) (code $($Status.exitCode))")
    if ($Status.detail) { $l.Add("            $($Status.detail)") }
    $l.Add("State     : $($Status.deploymentState)$(if ($Status.stateSource -eq 'backup') { ' (recovered from its backup)' })")
    foreach ($s in @($Status.stages)) { $l.Add(('  {0,-24} {1,-10} {2} {3}' -f $s.name, $s.state, $s.status, $(if ($s.idle) { $s.idle } else { $s.detail }))) }
    $ops = @($Status.operations)
    if ($ops.Count) {
        $l.Add('')
        $l.Add(('{0,-22} {1,-36} {2,-10} {3}' -f 'Lifecycle', 'Operation', 'Attempts', 'Message'))
        foreach ($o in $ops) { $l.Add(('{0,-22} {1,-36} {2,-10} {3}' -f $o.lifecycle, $o.operationId, "$($o.totalAttempts)", $o.message)) }
        $retry = @($ops | Where-Object { $_.lifecycle -in 'FailedRetryable', 'BlockedByDependency', 'WaitingForNetwork' })
        $perm = @($ops | Where-Object { $_.lifecycle -eq 'FailedPermanent' })
        $l.Add('')
        $l.Add("Retryable: $($retry.Count) (RetryFailed)   Permanent: $($perm.Count) (fix the cause, then Retry -Operation &lt;id&gt; -IncludePermanent)")
    }
    if ($Status.report) { $l.Add("Report    : $($Status.report)") }
    return ($l -join "\`r\`n")
}

&lt;# What a person still has to do; never includes secrets. #&gt;
function Get-WdrPendingActions {
    param([hashtable] $Manifest, [hashtable] $Paths)
    $items = @()
    foreach ($o in @(Get-WdrOperations $Paths)) {
        switch ($o.lifecycle) {
            'ManualActionRequired' { $items += "$($o.name): $($o.message)" }
            'WaitingForReboot' { $items += "$($o.name): restart the computer to finish. $($o.message)" }
            'FailedPermanent' { $items += "$($o.name) [$($o.operationId)]: $($o.failureClass) failure; correct the cause, then retry with -IncludePermanent. $($o.message)" }
            'FailedRetryable' { $items += "$($o.name) [$($o.operationId)]: failed after automatic retries; run RetryFailed. $($o.message)" }
            'BlockedByDependency' { $items += "$($o.name) [$($o.operationId)]: blocked by a dependency; run RetryFailed. $($o.message)" }
            'WaitingForNetwork' { $items += "$($o.name): waiting for the network or its package source." }
        }
        if ($o.status -eq 'Succeeded' -and $o.detection -eq 'Unconfirmed') { $items += "$($o.name): WinGet reported success but could not confirm it; check that it is installed." }
    }
    $net = Get-WddNetworkDriverFlag $Paths
    if ($net) { $items += "Network: $net" }
    $report = Read-WddJson $Paths.ReportJson
    if ($report -and $report.ContainsKey('remainingTasks')) {
        foreach ($t in @($report.remainingTasks)) { if ($t -and $t -notmatch '^Application ' -and $t -notmatch '^Additional Software ' -and $t -notmatch '^Driver: ') { $items += [string] $t } }
    }
    return @($items | Select-Object -Unique)
}

# ------------------------------------------------------------------------------------------------
# Recovery actions
# ------------------------------------------------------------------------------------------------

&lt;#
    Rebuilds a deployment state that is damaged beyond its backup: from the verified manifest and
    what the engines wrote themselves. A stage with a result, a status file or a task counts as
    launched (it is never launched twice); the damaged file is kept for diagnosis.
#&gt;
function Repair-WddDeploymentState {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Identity)
    $stamp = (Get-WddNow).ToString('yyyyMMddHHmmss')
    foreach ($f in $Paths.State, "$($Paths.State).bak") { if (Test-Path -LiteralPath $f) { Move-Item -LiteralPath $f -Destination "$f.corrupt-$stamp" -Force } }
    $state = New-WddState $Manifest 'Embedded' $Identity
    $state.status = 'InProgress'
    $state.message = 'Rebuilt by the recovery tool after the deployment state was damaged.'
    $appUser = Get-WdrDeploymentUser $Paths $null
    $state.stagedFiles = @(@($Manifest.files) | Where-Object { $_.embedded -and (Test-Path -LiteralPath (Join-Path $Paths.Package ($_.path -replace '/', '\\'))) } | ForEach-Object { $_.path })
    foreach ($s in Get-WddEngineStages $Manifest) {
        $seen = (Test-Path -LiteralPath (Join-Path $Paths.Root $s.result)) -or (Test-Path -LiteralPath (Join-Path $Paths.Root $s.status)) -or (Get-WddTask $s.task.path $s.task.name)
        $state.stages[$s.id] = @{ launchResult = $(if ($seen) { 'Launched' } else { '' }); attempts = 0; launchedUtc = $(if ($seen) { (Get-WddNow).ToString('o') } else { $null }); exitCode = $null
                                  message = $(if ($seen) { 'Found running or finished while rebuilding the state.' } else { 'Not launched before the state was lost.' }); user = $(if ($s.context -ne 'user') { 'SYSTEM' } elseif ($appUser) { $appUser } else { [string] $Identity.Name }) }
    }
    Save-WddState $Paths $state
    Write-WddLog "Deployment state rebuilt from the manifest (stages: $(($state.stages.Keys | ForEach-Object { "$_=$($state.stages[$_].launchResult)" }) -join ', '))." 'WARN'
    return $state
}

&lt;#
    RetryFailed, Retry and Resume. Steps: administrator check, deployment mutex, state (rebuilt
    only for Resume), package integrity, the application stage (engine Retry logic, then its task
    again without archiving), the Windows Update stage (relaunched only when it ended with
    failures, or for Resume when its task is gone), then the deployment is reopened for the monitor.
#&gt;
function Invoke-WdrRecovery {
    param([hashtable] $Manifest, [hashtable] $Paths, [ValidateSet('RetryFailed', 'Retry', 'Resume')] [string] $Mode, [string[]] $Operations = @(), [switch] $IncludePermanent, [switch] $RetargetUser)
    Initialize-WddLogging $Paths
    $identity = Get-WddIdentity
    if (-not $identity.IsAdmin) { return @{ Outcome = 'NotElevated'; Message = 'Run the recovery tool as administrator.'; Accepted = @(); Refused = @() } }
    $mutex = Enter-WddMutex 60
    if (-not $mutex) { return @{ Outcome = 'Busy'; Message = 'Another deployment process (monitor or setup) is running; try again in a minute.'; Accepted = @(); Refused = @() } }
    try {
        Write-WddLog "==== Recovery ($Mode) requested by $($identity.Name)$(if (@($Operations).Count) { ': ' + (@($Operations) -join ', ') }) ===="
        $read = Read-WddDeploymentState $Paths
        $state = $read.State
        if ($read.Source -eq 'corrupt') {
            if ($Mode -ne 'Resume') { return @{ Outcome = 'Refused'; Message = "The deployment state is damaged ($($read.Problem)). Run -Action Resume first; it rebuilds the state."; Accepted = @(); Refused = @() } }
            $state = Repair-WddDeploymentState $Manifest $Paths $identity
        }
        if (-not $state) { return @{ Outcome = 'NoState'; Message = 'No deployment has been started on this computer (run setup.cmd from the package).'; Accepted = @(); Refused = @() } }
        if ($state.packageId -ne $Manifest.packageId) { return @{ Outcome = 'Refused'; Message = "The deployment on this computer ($($state.packageId)) is not this package ($($Manifest.packageId))."; Accepted = @(); Refused = @() } }
        $check = Test-WddFiles $Paths.Package $Manifest 'Text' @($state.stagedFiles)
        if (-not $check.Ok) {
            Write-WddLog "Recovery refused: the staged package is modified or incomplete ($($check.Missing.Count) missing, $($check.Mismatched.Count) modified)." 'ERROR'
            return @{ Outcome = 'IntegrityFailed'; Message = 'The staged package was modified or is incomplete; run setup.cmd from the original package to stage it again. Nothing was retried.'; Accepted = @(); Refused = @(@($check.Missing) + @($check.Mismatched) | ForEach-Object { @{ operationId = "file:$_"; reason = 'missing or modified' } }) }
        }

        $accepted = @(); $refused = @(); $notes = @()
        # Stages whose task could not be registered again: this recovery failed for them.
        $failedStages = @()
        $ops = @($Operations | Where-Object { $_ } | ForEach-Object { ([string] $_).Trim() })
        $wuRequested = $ops -contains 'stage:windowsUpdate'
        $driverOps = @($ops | Where-Object { $_ -like 'driver:*' -or $_ -eq 'stage:drivers' })
        $appOps = @($ops | Where-Object { $_ -ne 'stage:windowsUpdate' -and $_ -notlike 'driver:*' -and $_ -ne 'stage:drivers' })

        # Applications: the engine's own Retry logic decides what may run again.
        $appStage = Get-WddStage $Manifest 'applications'
        if ($appStage -and $appStage.enabled) {
            $cfg = Get-WdrAppConfig $Paths
            if (-not $cfg) { $notes += 'The application engine is not part of the staged package.' }
            elseif ($Mode -ne 'Retry' -or $appOps.Count) {
                # Phase 9: never silently move per-user installations into another administrator's profile.
                $intended = Get-WdrDeploymentUser $Paths $state
                $otherUser = $intended -and ($intended -ine [string] $identity.Name)
                if ($identity.IsSystem) {
                    $refused += @{ operationId = 'stage:applications'; reason = 'the application stage runs as the signed-in user (WinGet is not supported as SYSTEM); run the recovery tool as that user' }
                } elseif ($otherUser -and -not $RetargetUser) {
                    $refused += @{ operationId = 'stage:applications'; reason = "the application stage belongs to $intended (per-user applications and settings go into that account's profile). Sign in as $intended and run the recovery tool there, or run it with -RetargetUser to install the remaining ones into $($identity.Name) instead" }
                    Write-WddLog "Recovery ($Mode) by $($identity.Name) refused for the application stage: it belongs to $intended." 'WARN'
                } else {
                    if ($otherUser) { $notes += "Application stage moved from $intended to $($identity.Name) (-RetargetUser)."; Write-WddLog "Application stage retargeted from $intended to $($identity.Name) by an explicit -RetargetUser." 'WARN' }
                    $r = switch ($Mode) {
                        'RetryFailed' { Invoke-WdaRetry $cfg -AllFailed -IncludePermanent:$IncludePermanent -RequestedBy $identity.Name }
                        'Retry' { Invoke-WdaRetry $cfg -Operations $appOps -IncludePermanent:$IncludePermanent -RequestedBy $identity.Name }
                        'Resume' { Invoke-WdaRetry $cfg -PendingOnly -RequestedBy $identity.Name }
                    }
                    $accepted += @($r.Accepted); $refused += @($r.Refused)
                    if ($r.Outcome -eq 'Busy') { return @{ Outcome = 'Busy'; Message = $r.Message; Accepted = @(); Refused = @() } }
                    $snapApp = Get-WddStageSnapshot $appStage $Paths $state
                    $needsTask = ($r.Outcome -eq 'Accepted') -or ($Mode -eq 'Resume' -and $snapApp.state -ne 'Final' -and -not (Get-WddTask $appStage.task.path $appStage.task.name))
                    if ($needsTask) {
                        $code = $null
                        try { $code = Invoke-WdrAppInstaller $Paths } catch { $notes += "Application task: $($_.Exception.Message)" }
                        $rec = $(if ($state.stages.ContainsKey('applications')) { $state.stages['applications'] } else { @{ attempts = 0 } })
                        $rec.launchResult = $(if (Get-WddTask $appStage.task.path $appStage.task.name) { 'Launched' } else { 'LaunchFailed' })
                        $rec.launchedUtc = (Get-WddNow).ToString('o'); $rec.exitCode = $code; $rec.user = $identity.Name
                        $rec.message = $(if ($rec.launchResult -eq 'Launched') { "Restarted by the recovery tool ($Mode)." } else { "The recovery tool could not register the application task (exit code $code)." })
                        $state.stages['applications'] = $rec
                        $notes += "Application stage: $($rec.message)"
                        if ($rec.launchResult -ne 'Launched') { $refused += @{ operationId = 'stage:applications'; reason = $rec.message }; $failedStages += 'applications' }
                        elseif ($r.Outcome -ne 'Accepted') { $accepted += 'stage:applications' }
                    }
                }
            }
        }

        # Windows Update: its engine never offers an installed update again, so a relaunch is safe.
        $wuStage = Get-WddStage $Manifest 'windowsUpdate'
        if ($wuStage -and $wuStage.enabled -and ($Mode -ne 'Retry' -or $wuRequested)) {
            $wu = Get-WddStageSnapshot $wuStage $Paths $state
            $failed = $wu.state -eq 'Final' -and $wu.status -in 'CompletedWithFailures', 'Failed', 'Offline'
            $lost = $Mode -eq 'Resume' -and $wu.state -in 'Stalled', 'LaunchFailed', 'NotStarted'
            if (($Mode -ne 'Resume' -and $failed) -or $lost) {
                $state.stages['windowsUpdate'] = @{ launchResult = ''; attempts = 0; launchedUtc = $null; exitCode = $null; message = "Restarted by the recovery tool ($Mode)."; user = 'SYSTEM' }
                $rec = Invoke-WddLaunchStage $wuStage $Paths $state $identity ([int] $Manifest.failureHandling.orchestrator.launchAttempts)
                if ($rec.launchResult -eq 'Launched') { $accepted += 'stage:windowsUpdate' } else { $refused += @{ operationId = 'stage:windowsUpdate'; reason = [string] $rec.message }; $failedStages += 'windowsUpdate' }
            } elseif ($wuRequested) {
                $refused += @{ operationId = 'stage:windowsUpdate'; reason = "the Windows Update stage is $($wu.state)$(if ($wu.status) { "/$($wu.status)" }); only a stage that ended with failures is retried" }
            }
        }

        # Phase 8: driver operations, through the driver engine's own Retry logic (security failures are never reopened).
        $drvStage = Get-WddStage $Manifest 'drivers'
        if ($drvStage -and $drvStage.enabled -and $drvStage['launcher'] -and ($Mode -ne 'Retry' -or $driverOps.Count)) {
            $dcfg = Get-WdrDriverConfig $Paths
            if (-not $dcfg) { $notes += 'The driver engine is not part of the staged package.' }
            else {
                $named = @($driverOps | Where-Object { $_ -ne 'stage:drivers' })
                $r = switch ($Mode) {
                    'RetryFailed' { Invoke-WdvRetry $dcfg -AllFailed -IncludePermanent:$IncludePermanent -RequestedBy $identity.Name }
                    'Retry' { $(if ($named.Count) { Invoke-WdvRetry $dcfg -Operations $named -IncludePermanent:$IncludePermanent -RequestedBy $identity.Name } else { @{ Outcome = 'NothingToDo'; Accepted = @(); Refused = @() } }) }
                    'Resume' { @{ Outcome = 'NothingToDo'; Accepted = @(); Refused = @() } }
                }
                if ($r.Outcome -eq 'Busy') { return @{ Outcome = 'Busy'; Message = $r.Message; Accepted = @(); Refused = @() } }
                $accepted += @($r.Accepted); $refused += @($r.Refused)
                $snapD = Get-WddStageSnapshot $drvStage $Paths $state
                $needsTask = ($r.Outcome -eq 'Accepted') -or ($driverOps -contains 'stage:drivers') -or ($Mode -eq 'Resume' -and $snapD.state -ne 'Final' -and -not (Get-WddTask $drvStage.task.path $drvStage.task.name))
                if ($needsTask) {
                    $code = $null
                    try { $code = Invoke-WdrDriverInstaller $Paths } catch { $notes += "Driver task: $($_.Exception.Message)" }
                    $rec = $(if ($state.stages.ContainsKey('drivers')) { $state.stages['drivers'] } else { @{ attempts = 0 } })
                    $rec.launchResult = $(if (Get-WddTask $drvStage.task.path $drvStage.task.name) { 'Launched' } else { 'LaunchFailed' })
                    $rec.launchedUtc = (Get-WddNow).ToString('o'); $rec.exitCode = $code; $rec.user = 'SYSTEM'
                    $rec.message = $(if ($rec.launchResult -eq 'Launched') { "Restarted by the recovery tool ($Mode)." } else { "The recovery tool could not register the driver task (exit code $code)." })
                    $state.stages['drivers'] = $rec
                    $notes += "Driver stage: $($rec.message)"
                    if ($rec.launchResult -eq 'Launched' -and $r.Outcome -ne 'Accepted') { $accepted += 'stage:drivers' }
                    elseif ($rec.launchResult -ne 'Launched') { $refused += @{ operationId = 'stage:drivers'; reason = $rec.message }; $failedStages += 'drivers' }
                }
            }
        } elseif ($driverOps.Count) {
            foreach ($x in $driverOps) { $refused += @{ operationId = $x; reason = 'the driver stage is not part of this deployment' } }
        }

        $reopen = ($accepted.Count -gt 0) -or ($Mode -eq 'Resume')
        if ($reopen) {
            $stamp = (Get-WddNow).ToString('yyyyMMddHHmmss')
            if ($state.status -in 'Completed', 'IntegrityFailed' -and (Test-Path -LiteralPath $Paths.Marker)) {
                Move-Item -LiteralPath $Paths.Marker -Destination "$($Paths.Marker).$stamp.bak" -Force
            }
            # The previous report is kept (reports\\history\\); the monitor writes a new one at the end.
            foreach ($r in $Paths.ReportJson, $Paths.ReportText) {
                if (Test-Path -LiteralPath $r) {
                    $hist = Join-Path $Paths.Reports 'history'
                    if (-not (Test-Path -LiteralPath $hist)) { New-Item -ItemType Directory -Path $hist -Force | Out-Null }
                    Move-Item -LiteralPath $r -Destination (Join-Path $hist ("{0}-{1}{2}" -f [IO.Path]::GetFileNameWithoutExtension($r), $stamp, [IO.Path]::GetExtension($r))) -Force
                }
            }
            $state.status = 'InProgress'
            $state.message = "Recovery ($Mode) by $($identity.Name)."
            $state.deadlineUtc = (Get-WddNow).AddHours([double] $Manifest.failureHandling.orchestrator.deadlineHours).ToString('o')
        }
        $state.recoveries = @(@($state.recoveries) + @(@{ atUtc = (Get-WddNow).ToString('o'); by = $identity.Name; action = $Mode; accepted = @($accepted); refused = @($refused | ForEach-Object { $_.operationId }); retargetUser = [bool] $RetargetUser }))
        Save-WddState $Paths $state
        if ($reopen) {
            Register-WddMonitorTask $Paths $Manifest
            try { Start-WddTask $script:MonitorTask.path $script:MonitorTask.name } catch { }
        }
        # A stage whose task could not be registered is a failure of this recovery, never "Done".
        $outcome = $(if ($failedStages.Count -and $accepted.Count) { 'Partial' } elseif ($failedStages.Count) { 'Failed' } elseif ($accepted.Count) { 'Done' } elseif ($Mode -eq 'Resume') { 'Done' } elseif ($refused.Count) { 'Refused' } else { 'NothingToDo' })
        $msg = "Reopened: $(if ($accepted.Count) { $accepted -join ', ' } else { 'none' }). Refused: $(if ($refused.Count) { ($refused | ForEach-Object { "$($_.operationId) ($($_.reason))" }) -join '; ' } else { 'none' }).$(if ($notes.Count) { ' ' + ($notes -join ' ') })"
        Write-WddLog "Recovery ($Mode): $msg" $(if ($outcome -eq 'Done') { 'INFO' } else { 'WARN' })
        Write-WddEvent 3005 "Deployment recovery ($Mode) by $($identity.Name): $msg" $(if ($outcome -eq 'Done') { 'Information' } else { 'Warning' })
        return @{ Outcome = $outcome; Message = $msg; Accepted = @($accepted); Refused = @($refused) }
    } finally {
        Exit-WddMutex $mutex
    }
}

&lt;#
    Phase 8: technician-supplied INF driver packages (for example a network driver when the computer
    has no network). The staged package is verified first; the packages are validated by the driver
    engine of that package (Microsoft-signed INF only, every file hashed), copied into its protected
    folder, and the driver stage runs again for what is unresolved. Nothing is installed here.
#&gt;
function Invoke-WdrAddDrivers {
    param([hashtable] $Manifest, [hashtable] $Paths, [string] $DriverPath)
    Initialize-WddLogging $Paths
    $identity = Get-WddIdentity
    if (-not $identity.IsAdmin) { return @{ Outcome = 'NotElevated'; Message = 'Run the recovery tool as administrator.'; Accepted = @(); Refused = @() } }
    $drvStage = Get-WddStage $Manifest 'drivers'
    if (-not ($drvStage -and $drvStage.enabled -and $drvStage['launcher'])) { return @{ Outcome = 'Refused'; Message = 'The driver stage is not part of this deployment; install the driver with Device Manager or pnputil.'; Accepted = @(); Refused = @() } }
    if (-not $DriverPath -or -not (Test-Path -LiteralPath $DriverPath -PathType Container)) { return @{ Outcome = 'Refused'; Message = "Driver folder not found: $DriverPath"; Accepted = @(); Refused = @() } }
    $read = Read-WddDeploymentState $Paths
    if (-not $read.State) { return @{ Outcome = 'NoState'; Message = 'No deployment has been started on this computer.'; Accepted = @(); Refused = @() } }
    $check = Test-WddFiles $Paths.Package $Manifest 'Text' @($read.State.stagedFiles)
    if (-not $check.Ok) { return @{ Outcome = 'IntegrityFailed'; Message = 'The staged package was modified or is incomplete; nothing was added.'; Accepted = @(); Refused = @() } }
    $dcfg = Get-WdrDriverConfig $Paths
    if (-not $dcfg) { return @{ Outcome = 'Refused'; Message = 'The driver engine is not part of the staged package.'; Accepted = @(); Refused = @() } }
    $a = Add-WdvTechnicianPackages $dcfg $DriverPath $identity.Name
    Write-WddLog "Recovery (AddDrivers) by $($identity.Name): $($a.Outcome). $($a.Message)"
    if ($a.Outcome -eq 'Busy') { return @{ Outcome = 'Busy'; Message = $a.Message; Accepted = @(); Refused = @() } }
    $refusedPk = @($a.Refused | ForEach-Object { @{ operationId = "package:$($_.inf)"; reason = $_.reason } })
    if ($a.Outcome -ne 'Accepted') { return @{ Outcome = 'Refused'; Message = "No package was usable. $(($a.Refused | ForEach-Object { "$($_.inf): $($_.reason)" }) -join '; ')"; Accepted = @(); Refused = $refusedPk } }
    $r = Invoke-WdrRecovery $Manifest $Paths 'Retry' -Operations @('stage:drivers')
    return @{ Outcome = $r.Outcome; Message = "$($a.Message) $($r.Message)"; Accepted = @(@($a.Added) + @($r.Accepted)); Refused = @($refusedPk + @($r.Refused)) }
}

&lt;#
    Phase 6: makes the settings backup this deployment expects available and restores what is still
    outstanding. The backup is identified only by the manifest SHA-256 pinned in the verified
    application configuration; it is validated (every file, path and hash) by the restore library
    of the staged package, copied to &lt;dataRoot&gt;\\Backup\\incoming\\&lt;folder&gt; and validated again by the
    engine before anything is restored. Then the outstanding settings operations are reopened
    through the engine's own Retry logic (RetryFailed rules: restored ones are never repeated).
#&gt;
function Invoke-WdrRestoreSettings {
    param([hashtable] $Manifest, [hashtable] $Paths, [string] $BackupPath, [switch] $RetargetUser)
    Initialize-WddLogging $Paths
    $identity = Get-WddIdentity
    if (-not $identity.IsAdmin) { return @{ Outcome = 'NotElevated'; Message = 'Run the recovery tool as administrator.'; Accepted = @(); Refused = @() } }
    $cfg = Get-WdrAppConfig $Paths
    $plan = $(if ($cfg -and $cfg.ContainsKey('settingsRestore')) { $cfg['settingsRestore'] } else { $null })
    if ($plan -isnot [hashtable] -or -not @(Get-WdaSettingsPlan $cfg).Count) { return @{ Outcome = 'NothingToDo'; Message = 'This deployment does not restore application settings.'; Accepted = @(); Refused = @() } }
    if (-not $BackupPath) { return @{ Outcome = 'Refused'; Message = "Name the backup folder or ZIP with -BackupPath (expected: $($plan['folderName']))."; Accepted = @(); Refused = @() } }
    $lib = Join-Path $Paths.Package 'scripts\\applications\\WdbMigration.ps1'
    if (-not (Test-Path -LiteralPath $lib)) { return @{ Outcome = 'IntegrityFailed'; Message = 'The restore library is not part of the staged package.'; Accepted = @(); Refused = @() } }
    if (-not (Get-Command Open-WdbBackup -CommandType Function -ErrorAction SilentlyContinue)) { . $lib -Mode Library }
    $work = Join-Path $Paths.Root 'Backup\\work'
    if (-not (Test-Path -LiteralPath $work)) { New-Item -ItemType Directory -Path $work -Force | Out-Null }
    try { $v = Open-WdbBackup $BackupPath $work ([string] $plan['manifestSha256']) } catch { return @{ Outcome = 'Refused'; Message = "The backup could not be opened: $($_.Exception.Message)"; Accepted = @(); Refused = @() } }
    if (-not $v.Ok) {
        Write-WddLog "RestoreSettings refused $BackupPath\`: $(@($v.Problems) -join ' ')" 'WARN'
        return @{ Outcome = 'IntegrityFailed'; Message = "The backup is not the one this deployment expects, or it is damaged: $(@($v.Problems) -join ' ') Nothing was restored."; Accepted = @(); Refused = @() }
    }
    $incoming = Join-Path (Join-Path $Paths.Root 'Backup\\incoming') ([string] $plan['folderName'])
    [void] (Copy-WdbBackup $v $incoming)
    Write-WddLog "RestoreSettings: backup $($plan['backupId']) validated from $BackupPath and placed in $incoming."
    $ops = @(Get-WdrOperations $Paths | Where-Object { $_.operationId -like 'settings:*' -and $_.status -notin 'Succeeded', 'AlreadyInstalled', 'SkippedByUser', 'Unavailable' } | ForEach-Object { $_.operationId })
    if (-not $ops.Count) { return @{ Outcome = 'NothingToDo'; Message = 'The backup was validated and staged; no settings are outstanding.'; Accepted = @(); Refused = @() } }
    return Invoke-WdrRecovery $Manifest $Paths 'Retry' -Operations $ops -IncludePermanent -RetargetUser:$RetargetUser
}

# ------------------------------------------------------------------------------------------------
# Diagnostics
# ------------------------------------------------------------------------------------------------

&lt;#
    Removes passwords and Wi-Fi keys from text (defence in depth: these files should contain none).
    The Wi-Fi element name is written as key[M]aterial so this script itself never contains the
    literal token the answer-file secret checks look for.
#&gt;
function Protect-WdrText {
    param([string] $Text)
    $t = [regex]::Replace($Text, '(?i)("(?:password|passphrase|key[M]aterial|networkKey|secret|token|apiKey|adminPassword)"\\s*:\\s*)"(?:[^"\\\\]|\\\\.)*"', '$1"[redacted]"')
    $t = [regex]::Replace($t, '(?is)(&lt;(key[M]aterial|Password)&gt;).*?(&lt;/\\2&gt;)', '$1[redacted]$3')
    $t = [regex]::Replace($t, '(?i)\\b(password|passwd|pwd|key[M]aterial|networkKey)(\\s*[=:]\\s*)[^\\s,;"]+', '$1$2[redacted]')
    return $t
}

&lt;#
    Only these files below the data root are collected; anything else (answer files, Wi-Fi
    profiles, Panther logs, user files) is never read.
#&gt;
$script:DiagnosticFiles = @(
    'Deployment\\status.json', 'Deployment\\logs\\*.log', 'Deployment\\logs\\*.log.1',
    'state\\*.json', 'state\\*.done', 'state\\*.bak', 'state\\*.corrupt*',
    'reports\\deployment-report.json', 'reports\\deployment-report.txt', 'reports\\history\\*.json',
    'Applications\\state.json', 'Applications\\state.json.bak', 'Applications\\state.json.corrupt', 'Applications\\status.json', 'Applications\\result.json', 'Applications\\follow-up.txt',
    'Applications\\logs\\*.log', 'Applications\\logs\\*.log.1', 'Applications\\logs\\attempts.jsonl', 'Applications\\logs\\packages\\*.log', 'Applications\\history\\*.json',
    'Updates\\state.json', 'Updates\\status.json', 'Updates\\result.json', 'Updates\\policy-result.json', 'Updates\\logs\\*.log',
    'Network\\wifi-result.json', 'Network\\*.log',
    'Drivers\\state.json', 'Drivers\\state.json.bak', 'Drivers\\status.json', 'Drivers\\result.json', 'Drivers\\inventory-*.json', 'Drivers\\logs\\*.log', 'Drivers\\logs\\attempts.jsonl', 'reports\\drivers.json',
    'reports\\health\\deployment-health.json', 'reports\\health\\customer-handoff.json', 'reports\\health\\recheck.json', 'reports\\health\\history\\*.json',
    'Applications\\restoration.json',
    'Package\\scripts\\drivers\\drivers-config.json',
    'Package\\deployment-manifest.json', 'Package\\config\\orchestration.json', 'Package\\scripts\\applications\\applications-config.json', 'Package\\scripts\\windows-update\\config.json'
)

function Export-WdrDiagnostics {
    param([hashtable] $Manifest, [hashtable] $Paths, [string] $OutputPath = '')
    $identity = Get-WddIdentity
    $stamp = (Get-WddNow).ToString('yyyyMMdd-HHmmss')
    if (-not $OutputPath) {
        $dir = $(if ($identity.IsAdmin) { $Paths.Reports } else { Get-WdrDesktop })
        $OutputPath = Join-Path $dir ("deployment-diagnostics-{0}-{1}.zip" -f $env:COMPUTERNAME, $stamp)
    }
    if ($OutputPath -notmatch '\\.zip$') { throw 'The diagnostics file must end in .zip.' }
    $staging = Join-Path ([IO.Path]::GetTempPath()) ("wdr-diag-" + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Path $staging -Force | Out-Null
    $index = @()
    $redacted = 0
    try {
        $root = [IO.Path]::GetFullPath($Paths.Root).TrimEnd('\\') + '\\'
        foreach ($pattern in $script:DiagnosticFiles) {
            $dir = Join-Path $Paths.Root (Split-Path -Parent $pattern)
            if (-not (Test-Path -LiteralPath $dir)) { continue }
            foreach ($f in @(Get-ChildItem -LiteralPath $dir -Filter (Split-Path -Leaf $pattern) -File -ErrorAction SilentlyContinue)) {
                $full = [IO.Path]::GetFullPath($f.FullName)
                if (-not $full.StartsWith($root, [StringComparison]::OrdinalIgnoreCase) -or ($f.Attributes -band [IO.FileAttributes]::ReparsePoint)) { continue }
                if ($f.Extension -in '.xml', '.wim', '.exe', '.msi') { continue }
                $rel = $full.Substring($root.Length)
                $bytes = [IO.File]::ReadAllBytes($full)
                $max = 20MB
                if ($bytes.Length -gt $max) { $bytes = $bytes[($bytes.Length - $max)..($bytes.Length - 1)] }
                $text = [Text.Encoding]::UTF8.GetString($bytes)
                $safeText = Protect-WdrText $text
                if ($safeText -ne $text) { $redacted++ }
                $target = Join-Path $staging $rel
                New-Item -ItemType Directory -Path (Split-Path -Parent $target) -Force | Out-Null
                [IO.File]::WriteAllText($target, $safeText, (New-Object Text.UTF8Encoding($false)))
                $index += [ordered]@{ path = $rel; size = $f.Length; truncated = ($f.Length -gt $max); redacted = ($safeText -ne $text) }
            }
        }
        $status = Get-WdrStatus $Manifest $Paths
        $info = [ordered]@{
            format = 'windows-deployment-builder/diagnostics'; version = 1; generatedUtc = (Get-WddNow).ToString('o'); computer = $env:COMPUTERNAME
            windows = [string] [Environment]::OSVersion.VersionString; powershell = $PSVersionTable.PSVersion.ToString(); packageId = $Manifest.packageId
            outcome = $status.outcome; outcomeCode = $status.exitCode; files = $index; redactedFiles = $redacted
            excluded = 'Answer files (autounattend.xml, unattend.xml), Wi-Fi profiles (*.xml), Panther logs and anything outside the data root are never collected; password and key values are replaced by [redacted].'
        }
        [IO.File]::WriteAllText((Join-Path $staging 'diagnostics.json'), ($info | ConvertTo-Json -Depth 6), (New-Object Text.UTF8Encoding($false)))
        [IO.File]::WriteAllText((Join-Path $staging 'recovery-status.txt'), (Format-WdrStatus $status), (New-Object Text.UTF8Encoding($true)))
        $outDir = Split-Path -Parent $OutputPath
        if ($outDir -and -not (Test-Path -LiteralPath $outDir)) { New-Item -ItemType Directory -Path $outDir -Force | Out-Null }
        if (Test-Path -LiteralPath $OutputPath) { Remove-Item -LiteralPath $OutputPath -Force }
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        [IO.Compression.ZipFile]::CreateFromDirectory($staging, $OutputPath)
        # Phase 9: every entry is checked again; an archive with anything unexpected is not kept.
        $bad = @(Test-WdrDiagnosticArchive $OutputPath)
        if ($bad.Count) { Remove-Item -LiteralPath $OutputPath -Force; throw "The diagnostics archive contained entries that must not be shared ($($bad -join ', ')); it was deleted." }
        return @{ Outcome = 'Done'; Path = $OutputPath; Files = $index.Count; Redacted = $redacted }
    } finally {
        Remove-Item -LiteralPath $staging -Recurse -Force -ErrorAction SilentlyContinue
    }
}

&lt;#
    Entries a diagnostics ZIP may contain: relative paths of known text types; never a settings
    backup, an answer file, a Wi-Fi profile or an executable.
#&gt;
function Test-WdrDiagnosticArchive {
    param([string] $Path)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $z = [IO.Compression.ZipFile]::OpenRead($Path)
    try {
        return @(@($z.Entries) | Where-Object {
            $n = $_.FullName.Replace('\\', '/')
            $unsafe = -not $n -or $n.StartsWith('/') -or $n -match '(^|/)\\.\\.(/|$)' -or $n -match ':' -or $n -match '(?i)(^|/)backups?(/|$)' -or $n -match '(?i)\\.(xml|wim|exe|msi|zip|reg|pfx|key|cab|inf|sys)$'
            $known = $n -match '(?i)\\.(json|jsonl|txt|log|1|done|bak)$' -or $n -match '(?i)\\.corrupt(-\\d+)?$' -or $n -match '(?i)\\.json\\.(bak|corrupt)'
            $unsafe -or -not $known
        } | ForEach-Object { $_.FullName })
    } finally { $z.Dispose() }
}

# ------------------------------------------------------------------------------------------------
# Console
# ------------------------------------------------------------------------------------------------

&lt;#
    Schema 9: activation by the technician (elevated). Activate runs the chosen Microsoft method
    again and asks for the product key or MAK where the method needs one (never stored or logged);
    CheckActivation only reads the licensing state. The deployment report's activation block is
    updated and the change is recorded in the recovery history.
#&gt;
function Invoke-WdrActivation {
    param([hashtable] $Manifest, [hashtable] $Paths, [ValidateSet('Activate', 'CheckActivation')] [string] $Mode, [string] $Target = '', [Security.SecureString] $ProductKey = $null)
    if (-not (Get-Command Invoke-WddActivationAction -ErrorAction SilentlyContinue) -or -not ($Manifest.ContainsKey('activation') -and $Manifest.activation)) { return @{ Outcome = 'Refused'; Message = 'Activation is not part of this deployment package.'; Activation = $null } }
    $identity = Get-WddIdentity
    if (-not $identity.IsAdmin) { return @{ Outcome = 'NotElevated'; Message = 'Activation needs administrator rights.'; Activation = $null } }
    if ($Mode -eq 'Activate' -and -not $Target) { return @{ Outcome = 'Refused'; Message = 'Choose -Target Windows or -Target Office.'; Activation = $null } }
    $mutex = Enter-WddMutex 60
    if (-not $mutex) { return @{ Outcome = 'Busy'; Message = 'Another deployment process is running; try again in a minute.'; Activation = $null } }
    try {
        $read = Read-WddDeploymentState $Paths
        $state = $read.State
        if (-not $state) { return @{ Outcome = 'NoState'; Message = 'No deployment state was found.'; Activation = $null } }
        $act = Invoke-WddActivationAction $Manifest $Paths $state $Mode $Target $ProductKey
        $state.recoveries = @(@($state.recoveries) + @(@{ atUtc = (Get-WddNow).ToString('o'); by = $identity.Name; action = $Mode; target = $Target; result = (@(@('windows', 'office') | Where-Object { $act[$_] } | ForEach-Object { "$_=$($act[$_].status)" }) -join ', ') }))
        Save-WddState $Paths $state
        $report = Read-WddJson $Paths.ReportJson
        if ($report -and $report['activation'] -is [hashtable]) {
            $report.activation.windows = $act['windows']; $report.activation.office = $act['office']; $report.activation.updatedUtc = (Get-WddNow).ToString('o')
            Write-WddJson $Paths.ReportJson $report
            $lines = @('', "Activation update $((Get-WddNow).ToString('o')) by $($identity.Name) ($Mode)") + @(@('windows', 'office') | Where-Object { $act[$_] } | ForEach-Object { "  $($_): $($act[$_].status). $($act[$_].message)" })
            try { [IO.File]::AppendAllText($Paths.ReportText, ($lines -join "\`r\`n") + "\`r\`n", (New-Object System.Text.UTF8Encoding($true))) } catch { }
        }
        $requested = @(@('windows', 'office') | Where-Object { $act[$_] -and [string] $act[$_].action -ne 'none' -and (-not $Target -or $_ -eq $Target.ToLowerInvariant()) })
        $ok = $requested.Count -gt 0 -and @($requested | Where-Object { [string] $act[$_].status -ne 'Activated' }).Count -eq 0
        $msg = (@($requested | ForEach-Object { "$($_): $($act[$_].status). $($act[$_].message)" }) -join ' ')
        return @{ Outcome = $(if ($ok) { 'Done' } else { 'Refused' }); Message = $(if ($msg) { $msg } else { 'No activation was requested for this deployment.' }); Activation = $act }
    } finally { Exit-WddMutex $mutex }
}

function Invoke-WdrAction {
    param([hashtable] $Manifest, [hashtable] $Paths, [string] $Action, [string[]] $Operation = @(), [switch] $IncludePermanent, [switch] $Json, [string] $OutputPath = '', [string] $BackupPath = '', [string] $DriverPath = '', [switch] $RetargetUser, [string] $Target = '')
    switch ($Action) {
        { $_ -in 'Activate', 'CheckActivation' } {
            $r = Invoke-WdrActivation $Manifest $Paths $Action $Target
            $text = $(if ($Json) { [pscustomobject]@{ Outcome = $r.Outcome; Message = $r.Message } | ConvertTo-Json -Depth 4 } else { "$($Action): $($r.Outcome). $($r.Message)" })
            return @{ Text = $text; Exit = [int] $script:RecoveryExit[$r.Outcome] }
        }
        'Verify' {
            $cfg = Read-WddJson (Join-Path $Paths.Package 'scripts\\health\\health-config.json')
            if (-not (Get-Command Invoke-WdhVerify -ErrorAction SilentlyContinue) -or -not $cfg) { return @{ Text = 'Verification is not part of this deployment package.'; Exit = 1 } }
            $v = Invoke-WdhVerify $Manifest $Paths $cfg 'Recovery'
            $text = $(if ($Json) { $v.Report | ConvertTo-Json -Depth 12 } else { "Deployment health: $($v.Status). $($v.Report.overall.summary)\`r\`nReport: $(Join-Path $v.Directory 'technician-report.html')" })
            return @{ Text = $text; Exit = [int] $v.ExitCode }
        }
        'AddDrivers' {
            $r = Invoke-WdrAddDrivers $Manifest $Paths $DriverPath
            $text = $(if ($Json) { [pscustomobject]$r | ConvertTo-Json -Depth 6 } else { "AddDrivers: $($r.Outcome). $($r.Message)" })
            return @{ Text = $text; Exit = [int] $script:RecoveryExit[$r.Outcome] }
        }
        'RestoreSettings' {
            $r = Invoke-WdrRestoreSettings $Manifest $Paths $BackupPath -RetargetUser:$RetargetUser
            $text = $(if ($Json) { [pscustomobject]$r | ConvertTo-Json -Depth 6 } else { "RestoreSettings: $($r.Outcome). $($r.Message)" })
            return @{ Text = $text; Exit = [int] $script:RecoveryExit[$r.Outcome] }
        }
        'Status' {
            $st = Get-WdrStatus $Manifest $Paths
            return @{ Text = $(if ($Json) { $st | ConvertTo-Json -Depth 8 } else { Format-WdrStatus $st }); Exit = [int] $st.exitCode }
        }
        'PendingActions' {
            $items = @(Get-WdrPendingActions $Manifest $Paths)
            $text = $(if ($Json) { ConvertTo-Json @($items) } elseif ($items.Count) { "Pending actions\`r\`n===============\`r\`n" + (($items | ForEach-Object { "- $_" }) -join "\`r\`n") } else { 'Nothing is waiting for a person.' })
            return @{ Text = $text; Exit = 0 }
        }
        'ExportDiagnostics' {
            $r = Export-WdrDiagnostics $Manifest $Paths $OutputPath
            return @{ Text = "Diagnostics: $($r.Path) ($($r.Files) file(s), $($r.Redacted) with values redacted)."; Exit = 0 }
        }
        default {
            $r = Invoke-WdrRecovery $Manifest $Paths $Action -Operations $Operation -IncludePermanent:$IncludePermanent -RetargetUser:$RetargetUser
            $text = $(if ($Json) { [pscustomobject]$r | ConvertTo-Json -Depth 6 } else { "$($Action): $($r.Outcome). $($r.Message)" })
            return @{ Text = $text; Exit = [int] $script:RecoveryExit[$r.Outcome] }
        }
    }
}

function Show-WdrMenu {
    param([hashtable] $Manifest, [hashtable] $Paths)
    while ($true) {
        Write-Output ''
        Write-Output (Format-WdrStatus (Get-WdrStatus $Manifest $Paths))
        Write-Output ''
        Write-Output 'Windows Deployment Recovery'
        Write-Output '  1  Refresh status            4  Retry one application'
        Write-Output '  2  Retry failed operations   5  Resume interrupted provisioning'
        Write-Output '  3  View pending actions      6  Export diagnostic report'
        Write-Output '  7  Restore application settings from a backup folder'
        Write-Output '  8  Add driver packages from a folder (for example a network driver)'
        Write-Output '  9  Verify the deployment (health report; read-only)'
        if ($Manifest.ContainsKey('activation') -and $Manifest.activation) { Write-Output '  A  Activation: check the licensing state, or activate Windows or Office' }
        Write-Output '  0  Exit'
        $c = Read-Host 'Choose'
        $r = switch ($c) {
            '1' { $null }
            '2' { Invoke-WdrAction $Manifest $Paths 'RetryFailed' }
            '3' { Invoke-WdrAction $Manifest $Paths 'PendingActions' }
            '4' {
                $id = Read-Host 'Operation id (from the list, for example app:winget:git.git)'
                $perm = (Read-Host 'Is this a permanent failure whose cause you have corrected? (y/N)') -match '^(y|yes)$'
                Invoke-WdrAction $Manifest $Paths 'Retry' -Operation @($id) -IncludePermanent:$perm
            }
            '5' { Invoke-WdrAction $Manifest $Paths 'Resume' }
            '6' { Invoke-WdrAction $Manifest $Paths 'ExportDiagnostics' }
            '7' { Invoke-WdrAction $Manifest $Paths 'RestoreSettings' -BackupPath (Read-Host 'Backup folder or .zip (for example E:\\WindowsDeployment\\backups\\WDB-AppBackup-...)') }
            '8' { Invoke-WdrAction $Manifest $Paths 'AddDrivers' -DriverPath (Read-Host 'Folder with INF driver packages (for example E:\\Drivers\\Network)') }
            '9' { Invoke-WdrAction $Manifest $Paths 'Verify' }
            { $_ -ieq 'A' -and $Manifest.ContainsKey('activation') -and $Manifest.activation } {
                $t = Read-Host 'Activate Windows (W), Office (O), or only check the licensing state (C)?'
                if ($t -match '^[Ww]') { Invoke-WdrAction $Manifest $Paths 'Activate' -Target 'Windows' }
                elseif ($t -match '^[Oo]') { Invoke-WdrAction $Manifest $Paths 'Activate' -Target 'Office' }
                else { Invoke-WdrAction $Manifest $Paths 'CheckActivation' }
            }
            '0' { return }
            default { @{ Text = 'Choose 0-9.'; Exit = 0 } }
        }
        if ($r) { Write-Output ''; Write-Output $r.Text }
    }
}

if ($script:RecoveryMain) {
    $a = $script:RecoveryArgs
    $package = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
    try { $manifest = Read-WddManifest (Join-Path $package 'deployment-manifest.json') } catch { Write-Output "ERROR: $($_.Exception.Message)"; exit 50 }
    $paths = Get-WddPaths $manifest.dataRoot
    $id = Get-WddIdentity
    if ($a.Elevate -and -not $id.IsAdmin) {
        $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
        Start-Process -FilePath $ps -Verb RunAs -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', "\`"$PSCommandPath\`"", '-Action', $a.Action) + @(if ($a.Target) { '-Target', $a.Target })
        exit 0
    }
    if ($a.Action -eq 'Menu') {
        if (-not $id.IsAdmin) { Write-Output 'Not running as administrator: status only. Retry, resume and diagnostics need administrator rights (use the "Deployment recovery" shortcut or -Elevate).' }
        Show-WdrMenu $manifest $paths
        exit 0
    }
    $r = Invoke-WdrAction $manifest $paths $a.Action -Operation $a.Operation -IncludePermanent:$a.IncludePermanent -Json:$a.Json -OutputPath $a.OutputPath -BackupPath $a.BackupPath -DriverPath $a.DriverPath -RetargetUser:$a.RetargetUser -Target $a.Target
    Write-Output $r.Text
    exit $r.Exit
}
		</File>
		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\health\\DeploymentHealth.ps1">
#Requires -Version 5.1
&lt;#
.SYNOPSIS
    Windows Deployment Builder - deployment verification and health reports (Phase 9).

.DESCRIPTION
    Checks what this deployment was meant to achieve (health-config.json, the deployment manifest)
    against the installed Windows itself, and reads the engines' own results only as evidence:
    a stage that reported success is still checked (the application is looked up in Windows'
    uninstall records and Store packages, the device's problem code is read, the account and its
    groups are read, Defender and the firewall are asked).

    Verification is READ-ONLY. It never installs, removes, restarts, deletes, resets or changes a
    setting. It writes only its own reports below &lt;dataRoot&gt;\\reports\\health:
        deployment-health.json   every finding with expected and observed state, evidence, next action
        technician-report.html   the dashboard (offline; print or save as PDF)
        customer-handoff.html    plain summary for the person receiving the computer
        history\\                 earlier reports (the record of a failed deployment is never lost)

      -Mode Verify            (default) verify and write the reports; exit code = overall state
      -Mode Dashboard         verify, then open the technician report
      -Mode CleanupBackups    list the retained settings backup; with -ConfirmCleanup &lt;backup id&gt;
                              remove it (only when no restoration is outstanding; never the USB copy)
      -Mode ExportDiagnostics a sanitized ZIP (no backups, no answer files, no passwords)
      -ScanUpdates            also ask Windows Update which updates are still available (read-only)

    Exit codes (Verify): 0 Ready, 10 ReadyWithWarnings, 20 NeedsAttention, 30 Incomplete,
    50 Unverifiable, 60 Failed. Other modes: 0 done, 1 refused or nothing to do, 4 needs elevation.

    Everything that reads the system is a small adapter function (Get-Wdh*), so the scenario tests
    replace them with simulated computers. Windows PowerShell 5.1; StrictMode 2.0.
#&gt;
[CmdletBinding()]
param(
    [ValidateSet('Verify', 'Dashboard', 'CleanupBackups', 'ExportDiagnostics', 'Library')]
    [string] $Mode = 'Verify',
    [ValidateSet('Technician', 'DeploymentComplete', 'Startup', 'Recovery', 'Test')]
    [string] $Trigger = 'Technician',
    [switch] $ScanUpdates,
    [switch] $Json,
    [string] $ConfirmCleanup = '',
    [string] $OutputPath = '',
    [switch] $Elevate
)

$script:WdhMain = $MyInvocation.InvocationName -ne '.' -and $Mode -ne 'Library'
# Captured first: the shared functions dot-sourced below bind their own parameters in this scope.
$script:WdhArgs = @{ Mode = $Mode; Trigger = $Trigger; ScanUpdates = [bool] $ScanUpdates; Json = [bool] $Json; ConfirmCleanup = $ConfirmCleanup; OutputPath = $OutputPath; Elevate = [bool] $Elevate }
if (-not (Get-Command Read-WddManifest -ErrorAction SilentlyContinue)) { . (Join-Path $PSScriptRoot '..\\common\\DeploymentCommon.ps1') }
Set-StrictMode -Version 2.0

$script:WdhVersion = '1.0.0'
$script:WdhScriptRoot = $PSScriptRoot
$script:WdhStates = @('Ready', 'ReadyWithWarnings', 'NeedsAttention', 'Incomplete', 'Unverifiable', 'Failed')
$script:WdhExitCodes = @{ Ready = 0; ReadyWithWarnings = 10; NeedsAttention = 20; Incomplete = 30; Unverifiable = 50; Failed = 60 }
$script:WdhCategoryRank = @{ Verified = 0; Warning = 1; NeedsAttention = 2; Incomplete = 3; Unverifiable = 4; Failed = 5 }
$script:WdhCategoryNames = [ordered]@{
    windows = 'Windows'; accounts = 'Accounts and identity'; updates = 'Windows Update'; drivers = 'Hardware and drivers'; applications = 'Applications'
    restoration = 'Restored settings'; security = 'Security'; network = 'Network'; storage = 'Storage'; customizations = 'Windows settings'; recovery = 'Recovery and outstanding work'
}
# Windows' own documented device problem codes (CM_PROB_*), in words.
$script:WdhProblemCodes = @{
    1 = 'not configured correctly'; 3 = 'driver may be corrupted or memory is low'; 10 = 'cannot start'; 12 = 'not enough free resources'; 14 = 'needs a restart to work'
    18 = 'drivers must be reinstalled'; 19 = 'configuration in the registry is damaged'; 21 = 'being removed'; 22 = 'disabled'; 24 = 'not present, not working or missing drivers'
    28 = 'no driver installed'; 29 = 'disabled by the firmware'; 31 = 'not working properly (driver could not be loaded)'; 32 = 'driver service disabled'; 37 = 'driver failed to initialize'
    39 = 'driver is corrupted or missing'; 40 = 'driver registry entry is damaged'; 41 = 'driver loaded but the hardware was not found'; 43 = 'the device reported a problem'
    45 = 'not connected'; 47 = 'prepared for safe removal'; 48 = 'driver blocked'; 52 = 'driver signature could not be verified'
}
$script:WdhHardwareCodes = @(10, 12, 24, 29, 41, 43)
$script:WdhNow = $null

# ------------------------------------------------------------------------------------------------
# Adapters: read-only observations of the computer (replaced by the scenario tests)
# ------------------------------------------------------------------------------------------------

function Get-WdhRegValue {
    param([ValidateSet('HKLM', 'HKU')] [string] $Root, [string] $SubKey, [string] $Name, [string] $Sid = '')
    $base = $(if ($Root -eq 'HKLM') { [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64) } else { [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::Users, [Microsoft.Win32.RegistryView]::Registry64) })
    try {
        $path = $(if ($Root -eq 'HKU') { "$Sid\\$SubKey" } else { $SubKey })
        $k = $base.OpenSubKey($path)
        if (-not $k) { return $null }
        try { return $k.GetValue($Name, $null) } finally { $k.Close() }
    } finally { $base.Close() }
}

function Test-WdhRegKey {
    param([ValidateSet('HKLM', 'HKU')] [string] $Root, [string] $SubKey, [string] $Sid = '')
    $base = $(if ($Root -eq 'HKLM') { [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64) } else { [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::Users, [Microsoft.Win32.RegistryView]::Registry64) })
    try {
        $k = $base.OpenSubKey($(if ($Root -eq 'HKU') { "$Sid\\$SubKey" } else { $SubKey }))
        if ($k) { $k.Close(); return $true }
        return $false
    } finally { $base.Close() }
}

function Get-WdhOsInfo {
    $os = Get-CimInstance -ClassName Win32_OperatingSystem
    $cv = 'SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion'
    @{
        caption        = [string] $os.Caption
        editionId      = [string] (Get-WdhRegValue 'HKLM' $cv 'EditionID')
        displayVersion = [string] (Get-WdhRegValue 'HKLM' $cv 'DisplayVersion')
        build          = [int] (Get-WdhRegValue 'HKLM' $cv 'CurrentBuildNumber')
        ubr            = [int] (Get-WdhRegValue 'HKLM' $cv 'UBR')
        architecture   = ([string] [Environment]::GetEnvironmentVariable('PROCESSOR_ARCHITECTURE', 'Machine')).ToLowerInvariant()
        productType    = [int] $os.ProductType
        lastBootUtc    = $os.LastBootUpTime.ToUniversalTime().ToString('o')
    }
}

function Get-WdhSetupState {
    @{
        imageState            = [string] (Get-WdhRegValue 'HKLM' 'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Setup\\State' 'ImageState')
        oobeInProgress        = [int] (Get-WdhRegValue 'HKLM' 'SYSTEM\\Setup' 'OOBEInProgress')
        systemSetupInProgress = [int] (Get-WdhRegValue 'HKLM' 'SYSTEM\\Setup' 'SystemSetupInProgress')
    }
}

&lt;# Windows licence state only: the product key is never read. #&gt;
function Get-WdhActivation {
    $p = @(Get-CimInstance -ClassName SoftwareLicensingProduct -Filter "ApplicationID='55c92734-d682-4d71-983e-d6ec3f16059f' AND PartialProductKey IS NOT NULL" -Property LicenseStatus, Name, Description -ErrorAction Stop)
    if (-not $p.Count) { return @{ available = $true; licenseStatus = -1; channel = '' } }
    $x = $p[0]
    @{ available = $true; licenseStatus = [int] $x.LicenseStatus; channel = $(if ([string] $x.Description -match '(RETAIL|OEM|VOLUME)') { $Matches[1] } else { '' }) }
}

function Get-WdhComputerNames {
    @{
        active  = [string] (Get-WdhRegValue 'HKLM' 'SYSTEM\\CurrentControlSet\\Control\\ComputerName\\ActiveComputerName' 'ComputerName')
        pending = [string] (Get-WdhRegValue 'HKLM' 'SYSTEM\\CurrentControlSet\\Control\\ComputerName\\ComputerName' 'ComputerName')
    }
}

function Get-WdhLocalUsers {
    if (Get-Command Get-LocalUser -ErrorAction SilentlyContinue) {
        return @(Get-LocalUser -ErrorAction Stop | ForEach-Object { @{ name = [string] $_.Name; sid = [string] $_.SID.Value; enabled = [bool] $_.Enabled } })
    }
    @(Get-CimInstance -ClassName Win32_UserAccount -Filter 'LocalAccount=True' | ForEach-Object { @{ name = [string] $_.Name; sid = [string] $_.SID; enabled = -not [bool] $_.Disabled } })
}

&lt;# SIDs of the members of the local Administrators group (S-1-5-32-544), through ADSI (works with orphaned members). #&gt;
function Get-WdhAdminMembers {
    $name = (New-Object Security.Principal.SecurityIdentifier('S-1-5-32-544')).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]
    $g = [ADSI]"WinNT://./$name,group"
    @(@($g.psbase.Invoke('Members')) | ForEach-Object {
        $sidBytes = $_.GetType().InvokeMember('objectSid', 'GetProperty', $null, $_, $null)
        (New-Object Security.Principal.SecurityIdentifier($sidBytes, 0)).Value
    })
}

&lt;# SIDs that have a user profile on this computer (paths are not reported). #&gt;
function Get-WdhProfileSids {
    $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)
    try {
        $k = $base.OpenSubKey('SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList')
        if (-not $k) { return @() }
        try { return @($k.GetSubKeyNames()) } finally { $k.Close() }
    } finally { $base.Close() }
}

&lt;# Automatic sign-in: whether it is on and whether a stored password exists; the password is never read. #&gt;
function Get-WdhAutoLogon {
    $wl = 'SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon'
    $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)
    try {
        $k = $base.OpenSubKey($wl)
        if (-not $k) { return @{ autoAdminLogon = ''; autoLogonCount = $null; userName = ''; passwordStored = $false } }
        try {
            $names = @($k.GetValueNames())
            @{ autoAdminLogon = [string] $k.GetValue('AutoAdminLogon', ''); autoLogonCount = $k.GetValue('AutoLogonCount', $null); userName = [string] $k.GetValue('DefaultUserName', ''); passwordStored = ($names -contains 'DefaultPassword') }
        } finally { $k.Close() }
    } finally { $base.Close() }
}

function Resolve-WdhSid {
    param([string] $Account)
    if (-not $Account) { return '' }
    try { (New-Object Security.Principal.NTAccount($Account)).Translate([Security.Principal.SecurityIdentifier]).Value } catch { '' }
}

&lt;# True when the user's registry hive is loaded (the user is signed in or a process runs as them). Hives are never loaded by this tool. #&gt;
function Test-WdhUserHive { param([string] $Sid) if (-not $Sid) { return $false } Test-WdhRegKey 'HKU' 'Software' $Sid }

function Get-WdhServices {
    $out = @{}
    foreach ($n in 'wuauserv', 'WinDefend', 'mpssvc') {
        $s = Get-CimInstance -ClassName Win32_Service -Filter "Name='$n'" -ErrorAction SilentlyContinue
        $out[$n] = $(if ($s) { @{ startMode = [string] $s.StartMode; state = [string] $s.State } } else { $null })
    }
    return $out
}

function Get-WdhDefender {
    $s = Get-MpComputerStatus -ErrorAction Stop
    @{ amServiceEnabled = [bool] $s.AMServiceEnabled; antivirusEnabled = [bool] $s.AntivirusEnabled; realTimeProtectionEnabled = [bool] $s.RealTimeProtectionEnabled
       signatureAgeDays = [int] $s.AntivirusSignatureAge; tamperProtected = $(if ($s.PSObject.Properties['IsTamperProtected']) { [bool] $s.IsTamperProtected } else { $null }) }
}

&lt;# Products registered with Windows Security Center (product names and on/off only). #&gt;
function Get-WdhSecurityCenter {
    $decode = { param($p) @{ name = [string] $p.displayName; enabled = ((([int] $p.productState) -band 0x1000) -ne 0) } }
    @{
        antivirus = @(Get-CimInstance -Namespace 'root/SecurityCenter2' -ClassName AntiVirusProduct -ErrorAction Stop | ForEach-Object { &amp; $decode $_ })
        firewall  = @(Get-CimInstance -Namespace 'root/SecurityCenter2' -ClassName FirewallProduct -ErrorAction SilentlyContinue | ForEach-Object { &amp; $decode $_ })
    }
}

function Get-WdhFirewall { @(Get-NetFirewallProfile -ErrorAction Stop | ForEach-Object { @{ name = [string] $_.Name; enabled = ([string] $_.Enabled -eq 'True') } }) }

function Get-WdhUac {
    $k = 'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System'
    @{ enableLua = Get-WdhRegValue 'HKLM' $k 'EnableLUA'; consentPromptBehaviorAdmin = Get-WdhRegValue 'HKLM' $k 'ConsentPromptBehaviorAdmin'; promptOnSecureDesktop = Get-WdhRegValue 'HKLM' $k 'PromptOnSecureDesktop' }
}

function Get-WdhSmartScreen {
    @{ explorer = [string] (Get-WdhRegValue 'HKLM' 'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer' 'SmartScreenEnabled')
       policy = Get-WdhRegValue 'HKLM' 'SOFTWARE\\Policies\\Microsoft\\Windows\\System' 'EnableSmartScreen' }
}

&lt;# Encryption state of the system drive and the TYPES of its key protectors; recovery keys are never read. #&gt;
function Get-WdhEncryption {
    $v = Get-BitLockerVolume -MountPoint $env:SystemDrive -ErrorAction Stop
    @{ volumeStatus = [string] $v.VolumeStatus; protectionStatus = [string] $v.ProtectionStatus; percentage = [double] $v.EncryptionPercentage
       protectors = @(@($v.KeyProtector) | ForEach-Object { [string] $_.KeyProtectorType }) }
}

function Get-WdhRebootSignals {
    $s = @{ cbs = (Test-WdhRegKey 'HKLM' 'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Component Based Servicing\\RebootPending')
            windowsUpdate = (Test-WdhRegKey 'HKLM' 'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\RebootRequired')
            agent = $false; fileRenames = 0 }
    try { $s.agent = [bool] (New-Object -ComObject 'Microsoft.Update.SystemInfo').RebootRequired } catch { }
    $r = Get-WdhRegValue 'HKLM' 'SYSTEM\\CurrentControlSet\\Control\\Session Manager' 'PendingFileRenameOperations'
    if ($r) { $s.fileRenames = @($r | Where-Object { $_ }).Count }
    return $s
}

function Get-WdhUpdateAgent {
    $au = New-Object -ComObject 'Microsoft.Update.AutoUpdate'
    $r = $au.Results
    @{ lastSearchUtc = $(if ($r.LastSearchSuccessDate) { ([DateTime] $r.LastSearchSuccessDate).ToUniversalTime().ToString('o') } else { '' })
       lastInstallUtc = $(if ($r.LastInstallationSuccessDate) { ([DateTime] $r.LastInstallationSuccessDate).ToUniversalTime().ToString('o') } else { '' }) }
}

&lt;# Read-only search for updates that are still applicable (only with -ScanUpdates). Nothing is downloaded or installed. #&gt;
function Get-WdhUpdateScan {
    $session = New-Object -ComObject 'Microsoft.Update.Session'
    $searcher = $session.CreateUpdateSearcher()
    $res = $searcher.Search('IsInstalled=0 and IsHidden=0')
    $o = @{ required = 0; optional = 0; drivers = 0; feature = 0; titles = @() }
    foreach ($u in @($res.Updates)) {
        $cats = @(@($u.Categories) | ForEach-Object { [string] $_.Name })
        if ([int] $u.Type -eq 2) { $o.drivers++ }
        elseif ($cats -contains 'Upgrades') { $o.feature++ }
        elseif ([bool] $u.BrowseOnly) { $o.optional++ }
        else { $o.required++; if ($o.titles.Count -lt 10) { $o.titles += [string] $u.Title } }
    }
    return $o
}

&lt;# Present Plug and Play devices: name, class, service, problem code and the first hardware ID. #&gt;
function Get-WdhPnpDevices {
    @(Get-CimInstance -ClassName Win32_PnPEntity -ErrorAction Stop | Where-Object { $_.Present -ne $false } | ForEach-Object {
        @{ name = [string] $_.Name; class = [string] $_.PNPClass; service = [string] $_.Service; problemCode = [int] $_.ConfigManagerErrorCode
           hardwareId = $(if ($_.HardwareID) { [string] @($_.HardwareID)[0] } else { '' }) }
    })
}

&lt;# Uninstall records: machine-wide (64- and 32-bit) and, when that user's hive is loaded, the deployment user's. #&gt;
function Get-WdhUninstallEntries {
    param([string] $Sid = '')
    $out = @()
    $sub = 'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall'
    $specs = @(@('LocalMachine', 'Registry64', 'machine', $sub), @('LocalMachine', 'Registry32', 'machine', $sub))
    if ($Sid) { $specs += , @('Users', 'Registry64', 'user', "$Sid\\$sub") }
    foreach ($spec in $specs) {
        $base = $null
        try {
            $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]$spec[0], [Microsoft.Win32.RegistryView]$spec[1])
            $root = $base.OpenSubKey($spec[3])
            if (-not $root) { continue }
            foreach ($name in $root.GetSubKeyNames()) {
                $k = $root.OpenSubKey($name)
                if (-not $k) { continue }
                $dn = [string] $k.GetValue('DisplayName', '')
                $out += , @{ scope = $spec[2]; keyName = $name; displayName = $dn; displayVersion = [string] $k.GetValue('DisplayVersion', ''); publisher = [string] $k.GetValue('Publisher', '') }
                $k.Close()
            }
            $root.Close()
        } catch { } finally { if ($base) { $base.Close() } }
    }
    return $out
}

&lt;# Store (MSIX) packages of the deployment user, or of every user. Needs administrator rights. #&gt;
function Get-WdhAppxPackages {
    param([string] $Sid = '')
    $list = $(if ($Sid) { Get-AppxPackage -User $Sid -ErrorAction Stop } else { Get-AppxPackage -AllUsers -ErrorAction Stop })
    @(@($list) | ForEach-Object { @{ name = [string] $_.Name; family = [string] $_.PackageFamilyName; version = [string] $_.Version } })
}

&lt;# Shortcuts the application engine creates for portable tools (Start menu &gt; Windows Deployment Tools). #&gt;
function Get-WdhPortableShortcuts {
    $dir = Join-Path $env:ProgramData 'Microsoft\\Windows\\Start Menu\\Programs\\Windows Deployment Tools'
    if (-not (Test-Path -LiteralPath $dir)) { return @() }
    @(Get-ChildItem -LiteralPath $dir -Filter '*.lnk' -File -ErrorAction SilentlyContinue | ForEach-Object { $_.BaseName })
}

function Get-WdhNetwork {
    $adapters = @(Get-NetAdapter -Physical -ErrorAction Stop | ForEach-Object { @{ description = [string] $_.InterfaceDescription; status = [string] $_.Status; wireless = ([string] $_.PhysicalMediaType -match '802\\.11|Wireless') } })
    $gateway = $false
    try { $gateway = @(Get-NetIPConfiguration -ErrorAction Stop | Where-Object { $_.IPv4DefaultGateway -or $_.IPv6DefaultGateway }).Count -gt 0 } catch { }
    @{ adapters = $adapters; gateway = $gateway }
}

function Test-WdhDns { param([string] $HostName) try { [bool] @([System.Net.Dns]::GetHostAddresses($HostName)).Count } catch { $false } }

&lt;# The Windows connectivity test (the documented NCSI probe), then TCP 443 to a package source when needed. #&gt;
function Test-WdhInternet {
    try {
        $r = Invoke-WebRequest -Uri 'http://www.msftconnecttest.com/connecttest.txt' -UseBasicParsing -TimeoutSec 15 -ErrorAction Stop
        return ([string] $r.Content).Trim() -eq 'Microsoft Connect Test'
    } catch { return $false }
}

function Test-WdhTcp {
    param([string] $HostName, [int] $Port = 443)
    $c = New-Object System.Net.Sockets.TcpClient
    try { $t = $c.BeginConnect($HostName, $Port, $null, $null); if ($t.AsyncWaitHandle.WaitOne(8000) -and $c.Connected) { return $true } return $false } catch { return $false } finally { $c.Close() }
}

function Get-WdhVolume {
    $d = $env:SystemDrive.TrimEnd(':')
    $v = Get-Volume -DriveLetter $d -ErrorAction Stop
    $dirty = $null
    try {
        $out = (&amp; fsutil.exe dirty query "$($env:SystemDrive)" 2&gt;&amp;1 | Out-String)
        if ($LASTEXITCODE -eq 0) { $dirty = ($out -match 'is\\s+dirty' -and $out -notmatch 'NOT\\s+dirty') }
    } catch { }
    @{ fileSystem = [string] $v.FileSystem; health = [string] $v.HealthStatus; operational = [string] $v.OperationalStatus; size = [double] $v.Size; free = [double] $v.SizeRemaining; dirty = $dirty }
}

&lt;# Physical disk health as Windows reports it (no serial numbers). #&gt;
function Get-WdhPhysicalDisks {
    @(Get-PhysicalDisk -ErrorAction Stop | ForEach-Object {
        $rel = $null
        try { $c = $_ | Get-StorageReliabilityCounter -ErrorAction Stop; $rel = @{ wear = $c.Wear; temperature = $c.Temperature; readErrorsUncorrected = $c.ReadErrorsUncorrected } } catch { }
        @{ name = [string] $_.FriendlyName; media = [string] $_.MediaType; bus = [string] $_.BusType; health = [string] $_.HealthStatus; operational = [string] (@($_.OperationalStatus) -join ', '); reliability = $rel }
    })
}

&lt;# Staged settings backups the application engine kept (below &lt;dataRoot&gt;\\Backup). #&gt;
function Get-WdhBackupFolders {
    param([string] $Root)
    $b = Join-Path $Root 'Backup'
    if (-not (Test-Path -LiteralPath $b)) { return @() }
    $out = @()
    foreach ($d in @(Get-ChildItem -LiteralPath $b -Directory -Recurse -Depth 1 -ErrorAction SilentlyContinue | Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName 'backup-manifest.json') })) {
        $bytes = 0
        foreach ($f in @(Get-ChildItem -LiteralPath $d.FullName -File -Recurse -ErrorAction SilentlyContinue)) { $bytes += $f.Length }
        $out += , @{ path = $d.FullName; name = $d.Name; bytes = $bytes }
    }
    return $out
}

function Open-WdhReport { param([string] $Path) Start-Process -FilePath (Join-Path $env:SystemRoot 'explorer.exe') -ArgumentList "\`"$Path\`"" }

function Register-WdhRecheckTask {
    param([string] $Script)
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $action = New-ScheduledTaskAction -Execute $ps -Argument "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File \`"$Script\`" -Mode Verify -Trigger Startup"
    $t = New-ScheduledTaskTrigger -AtStartup
    $t.Delay = 'PT5M'
    $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -MultipleInstances IgnoreNew -ExecutionTimeLimit (New-TimeSpan -Minutes 30)
    Register-ScheduledTask -TaskName 'HealthCheck' -TaskPath '\\WindowsDeploymentBuilder\\' -Action $action -Trigger $t -Principal $principal -Settings $settings -Force \`
        -Description 'Windows Deployment Builder: verifies the deployment again after a pending restart (read-only), then removes itself.' | Out-Null
}

function Unregister-WdhRecheckTask { Unregister-WddTask '\\WindowsDeploymentBuilder\\' 'HealthCheck' }

&lt;# Runs the recovery tool's diagnostics export (its whitelist and redaction) in its own process. #&gt;
function Invoke-WdhRecoveryExport {
    param([string] $Tool, [string] $OutputPath)
    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
    $out = &amp; $ps -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $Tool -Action ExportDiagnostics -OutputPath $OutputPath 2&gt;&amp;1
    return @{ exit = $LASTEXITCODE; text = (@($out) -join ' ') }
}

# ------------------------------------------------------------------------------------------------
# Evidence and findings
# ------------------------------------------------------------------------------------------------

function Get-WdhTime { if ($script:WdhNow) { return $script:WdhNow } (Get-WddNow) }

&lt;# Reads one evidence file: ok, missing, corrupt (exists but is not valid JSON of the expected format). #&gt;
function Read-WdhSource {
    param($C, [string] $Id, [string] $Relative, [string] $Format = '', [switch] $NotApplicable)
    $path = Join-Path $C.Paths.Root $Relative
    $src = [ordered]@{ id = $Id; file = $Relative; format = $Format; version = ''; generatedUtc = ''; state = 'missing' }
    $data = $null
    if ($NotApplicable) { $src.state = 'notApplicable' }
    elseif (Test-Path -LiteralPath $path -PathType Leaf) {
        try {
            $text = [IO.File]::ReadAllText($path, [Text.Encoding]::UTF8)
            $data = ConvertTo-WddHashtable ($text | ConvertFrom-Json)
            if ($data -isnot [hashtable]) { throw 'not an object' }
            if ($Format -and $data.ContainsKey('format') -and [string] $data['format'] -ne $Format) { throw "unexpected format $($data['format'])" }
            $src.state = 'ok'
            foreach ($k in 'schemaVersion', 'formatVersion', 'version', 'reportVersion') { if ($data.ContainsKey($k) -and $null -ne $data[$k]) { $src.version = [string] $data[$k]; break } }
            foreach ($k in 'generatedUtc', 'finishedUtc', 'updatedUtc') { if ($data.ContainsKey($k) -and $data[$k]) { $src.generatedUtc = [string] $data[$k]; break } }
        } catch { $src.state = 'corrupt'; $data = $null; $C.Limitations.Add("$Relative could not be read ($($_.Exception.Message)).") }
    }
    $C.Sources.Add($src)
    return @{ Data = $data; Source = $src }
}

function Add-WdhFinding {
    param($C, [string] $Id, [string] $Category, [string] $Title, [string] $Status, [string] $Severity, [string] $Expected, [string] $Observed, [string] $Method, [string] $Evidence = '',
          [string] $NextAction = '', [bool] $Required = $true, [bool] $AutomaticRecovery = $false, [bool] $TechnicianRequired = $false, [string] $RecoveryAction = '')
    if ($Status -in 'Fail', 'Unverifiable', 'Warning' -and -not $PSBoundParameters.ContainsKey('TechnicianRequired')) { $TechnicianRequired = $true }
    $f = [ordered]@{ id = $Id; category = $Category; title = $Title; severity = $Severity; status = $Status; required = $Required; expected = $Expected; observed = $Observed; method = $Method
                     evidence = $Evidence; timestampUtc = (Get-WdhTime).ToString('o'); nextAction = $NextAction; automaticRecovery = $AutomaticRecovery; technicianRequired = $TechnicianRequired; recoveryAction = $RecoveryAction }
    $C.Findings.Add($f)
    return $f
}

&lt;#
    One probe of the computer. A probe that fails is never a pass: its checks become Unverifiable
    (or a warning when the check is optional), with the reason in the limitations.
#&gt;
function Invoke-WdhProbe {
    param($C, [string] $Name, [scriptblock] $Body)
    if ($C.Obs.ContainsKey($Name)) { return $C.Obs[$Name] }
    $v = $null
    try { $v = &amp; $Body } catch { $v = $null; $C.Limitations.Add("Could not read $Name\`: $((([string] $_.Exception.Message) -split '\\r?\\n')[0].Trim())") }
    $C.Obs[$Name] = $v
    return $v
}

function Get-WdhNorm {
    param([string] $Name)
    $n = $Name.ToLowerInvariant() -replace '[\\u00ae\\u2122\\u00a9]', ''
    $n = $n -replace '\\((x64|x86|arm64|64-bit|32-bit|[a-z]{2}-[a-z]{2}|user|machine)\\)', ' '
    $n = $n -replace '\\b(x64|x86|arm64|64-bit|32-bit)\\b', ' '
    $n = $n -replace '\\s+v?\\d+(\\.\\d+){1,3}([.-][0-9a-z]+)?\\s*$', ' '
    ($n -replace '[^a-z0-9+#]+', ' ').Trim()
}

function ConvertTo-WdhList { param($Value) if ($null -eq $Value) { return @() } return @($Value | Where-Object { $null -ne $_ }) }

function Format-WdhBytes { param([double] $Bytes) if ($Bytes -ge 1GB) { '{0:N0} GB' -f ($Bytes / 1GB) } elseif ($Bytes -ge 1MB) { '{0:N0} MB' -f ($Bytes / 1MB) } else { '{0:N0} KB' -f ($Bytes / 1KB) } }

# ------------------------------------------------------------------------------------------------
# Deployment state, integrity and the Phase 5 outcome (category "recovery")
# ------------------------------------------------------------------------------------------------

function Test-WdhDeployment {
    param($C)
    $read = $C.StateRead
    $C.Sources.Add([ordered]@{ id = 'deploymentState'; file = 'state\\deployment.json'; format = 'deployment-state'; version = $(if ($read.State) { [string] $read.State['schemaVersion'] } else { '' }); generatedUtc = $(if ($read.State -and $read.State['lastMonitorUtc']) { [string] $read.State['lastMonitorUtc'] } else { '' })
                    state = $(switch ($read.Source) { 'main' { 'ok' } 'backup' { 'ok' } 'corrupt' { 'corrupt' } default { 'missing' } }) })
    if ($read.Source -eq 'corrupt') {
        Add-WdhFinding $C 'deployment.state' 'recovery' 'Deployment state' 'Unverifiable' 'Critical' 'A readable deployment state' "Damaged, and its backup copy too ($($read.Problem))" 'state\\deployment.json and .bak' 'state\\deployment.json' 'Run "Deployment recovery" &gt; Resume: it rebuilds the state from the manifest and the engines'' own files. Then verify again.' -RecoveryAction 'Resume' | Out-Null
        return
    }
    if (-not $read.State) {
        Add-WdhFinding $C 'deployment.state' 'recovery' 'Deployment state' 'Unverifiable' 'Critical' 'The deployment has run on this computer' 'No deployment state was found: the deployment never started here, or its state was removed' 'state\\deployment.json' 'state\\deployment.json' 'Start the deployment (setup.cmd from the package) or verify on the computer it ran on.' | Out-Null
        return
    }
    $st = $read.State
    if ($read.Source -eq 'backup') { Add-WdhFinding $C 'deployment.stateBackup' 'recovery' 'Deployment state' 'Warning' 'The current state file' 'The state file was damaged; its last good copy was used' 'state\\deployment.json.bak' 'state\\deployment.json.bak' 'Nothing to do unless other findings disagree.' -Required $false | Out-Null }
    if ([string] $st['packageId'] -ne [string] $C.Manifest.packageId) {
        Add-WdhFinding $C 'deployment.package' 'recovery' 'Deployment identity' 'Unverifiable' 'Critical' "Deployment $($C.Manifest.packageId)" "The state belongs to deployment $($st['packageId'])" 'state\\deployment.json packageId vs the staged manifest' 'state\\deployment.json' 'Verify with the package that was deployed on this computer.' | Out-Null
        return
    }
    if ([string] $st['status'] -eq 'IntegrityFailed') {
        Add-WdhFinding $C 'deployment.integrity' 'recovery' 'Package integrity' 'Fail' 'The staged package is unchanged' ([string] $st['message']) 'Deployment state (monitor integrity check)' 'state\\deployment.json' 'Stage the original package again (setup.cmd from the package), then resume.' -RecoveryAction 'Resume' | Out-Null
    } else {
        $check = Test-WddFiles $C.Paths.Package $C.Manifest 'Text' @($st['stagedFiles'])
        if ($check.Ok) { Add-WdhFinding $C 'deployment.integrity' 'recovery' 'Package integrity' 'Pass' 'Critical' 'The staged package is unchanged' "$($check.Checked) staged file(s) match their SHA-256" 'SHA-256 of every staged file against the manifest' 'Package\\deployment-manifest.json' | Out-Null }
        else { Add-WdhFinding $C 'deployment.integrity' 'recovery' 'Package integrity' 'Fail' 'Critical' 'The staged package is unchanged' "$(@($check.Missing).Count) missing and $(@($check.Mismatched).Count) modified file(s): $((@($check.Missing) + @($check.Mismatched) | Select-Object -First 5) -join ', ')" 'SHA-256 of every staged file against the manifest' 'Package\\deployment-manifest.json' 'Do not trust the results of this computer''s deployment; stage the original package again.' | Out-Null }
    }
    $o = $C.Snapshot
    $outcome = [string] $o.outcome
    $map = @{ Succeeded = @('Pass', 'Informational'); CompletedWithWarnings = @('Info', 'Informational'); CompletedWithFailures = @('Info', 'Informational'); Incomplete = @('Fail', 'Error')
              PausedAwaitingNetwork = @('Pending', 'Warning'); PausedAwaitingReboot = @('Pending', 'Warning'); PausedAwaitingUser = @('Pending', 'Warning'); InProgress = @('Pending', 'Informational')
              FailedToInitialize = @('Fail', 'Critical'); Failed = @('Fail', 'Critical') }
    $m = $(if ($map.ContainsKey($outcome)) { $map[$outcome] } else { @('Unverifiable', 'Error') })
    $next = switch ($outcome) {
        'Incomplete' { 'The deployment ended before every stage finished: run "Deployment recovery" &gt; Resume.' }
        'PausedAwaitingNetwork' { 'Connect the computer to the network; the deployment continues by itself.' }
        'PausedAwaitingReboot' { 'Restart the computer; the deployment continues afterwards.' }
        'PausedAwaitingUser' { "Sign in as $($C.DeploymentUser); the application stage runs only in that account." }
        'InProgress' { 'Wait: the deployment is still running.' }
        'Failed' { 'A stage failed: see its findings, fix the cause and use "Deployment recovery".' }
        'FailedToInitialize' { 'The deployment could not start: see the deployment log, then run setup.cmd from the package.' }
        default { '' }
    }
    # Completed outcomes are context only: the per-item checks below decide, against Windows itself.
    Add-WdhFinding $C 'deployment.outcome' 'recovery' 'Deployment progress' $m[0] $m[1] 'Every stage has finished' "$outcome (code $($o.outcomeCode)). $($o.outcomeDetail)" 'Phase 5 outcome from the engines'' results (Get-WddDeploymentOutcome)' 'Deployment\\status.json, the engines'' result.json' $next -AutomaticRecovery ($outcome -like 'Paused*' -or $outcome -eq 'InProgress') -TechnicianRequired ($outcome -in 'Incomplete', 'Failed', 'FailedToInitialize') -RecoveryAction $(if ($outcome -eq 'Incomplete') { 'Resume' } else { '' }) | Out-Null
    $recs = @(ConvertTo-WdhList $st['recoveries'])
    if ($recs.Count) { Add-WdhFinding $C 'deployment.recoveries' 'recovery' 'Recovery actions' 'Info' 'Informational' 'None needed' "$($recs.Count) recovery action(s), the last by $($recs[-1]['by']) ($($recs[-1]['action']))" 'state\\deployment.json recoveries' 'state\\deployment.json' | Out-Null }
    # Who runs this check, and whose profile holds the per-user installations.
    $same = $C.SameUser
    Add-WdhFinding $C 'deployment.userContext' 'recovery' 'Deployment user' 'Info' 'Informational' "Per-user checks read $($C.DeploymentUser)'s profile" $(if ($C.HiveLoaded) { "Running as $($C.Identity.Name); $($C.DeploymentUser)'s profile is available" } elseif ($C.DeploymentSid) { "Running as $($C.Identity.Name); $($C.DeploymentUser) is not signed in, so per-user checks are deferred" } else { "Running as $($C.Identity.Name); the deployment user could not be resolved" }) 'Deployment state (the user each stage ran as) and HKEY_USERS' 'state\\deployment.json' $(if (-not $C.HiveLoaded -and $C.DeploymentSid) { "Sign in as $($C.DeploymentUser) and open the Health Report again to check per-user items." } else { '' }) -Required $false | Out-Null
    if ($same -eq $false -and -not $C.Identity.IsSystem) { $C.Limitations.Add("This check ran as $($C.Identity.Name), not as the deployment user $($C.DeploymentUser): per-user items were read from $($C.DeploymentUser)'s own profile, never from $($C.Identity.Name)'s.") }
}

# ------------------------------------------------------------------------------------------------
# Windows
# ------------------------------------------------------------------------------------------------

function Test-WdhWindows {
    param($C)
    $w = $C.Config['windows']
    $os = Invoke-WdhProbe $C 'os' { Get-WdhOsInfo }
    if (-not $os) {
        Add-WdhFinding $C 'windows.identity' 'windows' 'Windows' 'Unverifiable' 'Critical' 'Windows 11 information' 'Could not be read' 'Win32_OperatingSystem, CurrentVersion' 'WMI/registry' 'Run the check again as administrator.' | Out-Null
        return
    }
    $expected = @(ConvertTo-WdhList $w['expectedEditionIds'])
    if ($expected.Count) {
        if ($os.editionId -in $expected) { Add-WdhFinding $C 'windows.edition' 'windows' 'Windows edition' 'Pass' 'Critical' "$($expected -join ' or ') ($($w['editionName']))" $os.editionId 'Registry EditionID (HKLM\\...\\Windows NT\\CurrentVersion)' 'HKLM CurrentVersion' | Out-Null }
        else { Add-WdhFinding $C 'windows.edition' 'windows' 'Windows edition' 'Fail' 'Critical' "$($expected -join ' or ') ($($w['editionName']))" "$($os.editionId) ($($os.caption))" 'Registry EditionID (HKLM\\...\\Windows NT\\CurrentVersion)' 'HKLM CurrentVersion' 'The wrong edition is installed. Check the installation media and the answer file edition, then reinstall or upgrade the edition with a valid licence. Do not deliver this computer.' | Out-Null }
    } else {
        Add-WdhFinding $C 'windows.edition' 'windows' 'Windows edition' 'Info' 'Informational' "Chosen $($w['editionMode'])" "$($os.editionId) ($($os.caption))" 'Registry EditionID' 'HKLM CurrentVersion' -Required $false | Out-Null
    }
    $build = "$($os.build).$($os.ubr)"
    if ($os.build -ge [int] $w['minimumBuild']) { Add-WdhFinding $C 'windows.version' 'windows' 'Windows version' 'Pass' 'Error' "Windows 11 (build $($w['minimumBuild']) or later)" "Windows 11 $($os.displayVersion), build $build" 'CurrentBuildNumber, UBR, DisplayVersion' 'HKLM CurrentVersion' | Out-Null }
    else { Add-WdhFinding $C 'windows.version' 'windows' 'Windows version' 'Fail' 'Error' "Windows 11 (build $($w['minimumBuild']) or later)" "Build $build" 'CurrentBuildNumber' 'HKLM CurrentVersion' 'This deployment targets Windows 11.' | Out-Null }
    $archs = @(ConvertTo-WdhList $w['architectures'])
    if (-not $archs.Count -or $os.architecture -in $archs) { Add-WdhFinding $C 'windows.architecture' 'windows' 'Architecture' 'Pass' 'Error' ($archs -join ', ') $os.architecture 'PROCESSOR_ARCHITECTURE (machine)' 'Environment' | Out-Null }
    else { Add-WdhFinding $C 'windows.architecture' 'windows' 'Architecture' 'Fail' 'Error' ($archs -join ', ') $os.architecture 'PROCESSOR_ARCHITECTURE (machine)' 'Environment' 'Use installation media for the configured architecture.' | Out-Null }
    if ($os.productType -eq 1) { Add-WdhFinding $C 'windows.productType' 'windows' 'Product type' 'Pass' 'Error' 'Workstation' 'Workstation' 'Win32_OperatingSystem.ProductType' 'WMI' | Out-Null }
    else { Add-WdhFinding $C 'windows.productType' 'windows' 'Product type' 'Fail' 'Error' 'Workstation' "ProductType $($os.productType) (server or domain controller)" 'Win32_OperatingSystem.ProductType' 'WMI' 'This deployment is for Windows 11 client computers.' | Out-Null }
    $setup = Invoke-WdhProbe $C 'setup' { Get-WdhSetupState }
    if (-not $setup) { Add-WdhFinding $C 'windows.setup' 'windows' 'Windows Setup' 'Unverifiable' 'Error' 'Setup finished' 'Could not be read' 'Setup\\State ImageState' 'Registry' | Out-Null }
    elseif ($setup.imageState -eq 'IMAGE_STATE_COMPLETE' -and -not $setup.oobeInProgress -and -not $setup.systemSetupInProgress) { Add-WdhFinding $C 'windows.setup' 'windows' 'Windows Setup' 'Pass' 'Error' 'Setup finished' 'IMAGE_STATE_COMPLETE' 'Setup\\State ImageState, OOBEInProgress, SystemSetupInProgress' 'Registry' | Out-Null }
    else { Add-WdhFinding $C 'windows.setup' 'windows' 'Windows Setup' 'Pending' 'Error' 'Setup finished' "ImageState $($setup.imageState), OOBE in progress $($setup.oobeInProgress)" 'Setup\\State ImageState' 'Registry' 'Let Windows Setup finish (complete the out-of-box experience).' | Out-Null }
    # Licensing is not installation: an installed, unactivated Windows works and is reported as such.
    $act = Invoke-WdhProbe $C 'activation' { Get-WdhActivation }
    $lic = @{ 0 = 'unlicensed'; 1 = 'activated'; 2 = 'out-of-box grace period'; 3 = 'out-of-tolerance grace period'; 4 = 'non-genuine grace period'; 5 = 'notification mode'; 6 = 'extended grace period'; -1 = 'no product key installed' }
    if (-not $act) { Add-WdhFinding $C 'windows.activation' 'windows' 'Activation' 'Warning' 'Warning' 'Activated' 'Activation state could not be read' 'SoftwareLicensingProduct' 'WMI' 'Check Settings &gt; System &gt; Activation.' -Required $false | Out-Null }
    elseif ($act.licenseStatus -eq 1) { Add-WdhFinding $C 'windows.activation' 'windows' 'Activation' 'Pass' 'Warning' 'Activated' "Activated$(if ($act.channel) { " ($($act.channel))" })" 'SoftwareLicensingProduct.LicenseStatus (the key itself is never read)' 'WMI' -Required $false | Out-Null }
    else { Add-WdhFinding $C 'windows.activation' 'windows' 'Activation' 'Warning' 'Warning' 'Activated' "Not activated yet ($($lic[[int] $act.licenseStatus])). Windows is installed and works; a generic setup key never activates it." 'SoftwareLicensingProduct.LicenseStatus' 'WMI' 'Activate with the computer''s digital licence or a valid product key (Settings &gt; System &gt; Activation).' -Required $false | Out-Null }
    Test-WdhRestart $C
}

&lt;# Restart pending: Windows servicing, Windows Update, or a restart marker an engine wrote in this boot. #&gt;
function Test-WdhRestart {
    param($C)
    $sig = Invoke-WdhProbe $C 'reboot' { Get-WdhRebootSignals }
    $marker = $false
    try { $marker = [bool] (Test-WddRestartPending $C.Paths) } catch { }
    if (-not $sig) { Add-WdhFinding $C 'windows.restart' 'windows' 'Pending restart' 'Unverifiable' 'Error' 'No restart pending' 'Could not be read' 'Component Based Servicing, Windows Update, Update Agent' 'Registry' | Out-Null; return }
    $why = @()
    if ($sig.cbs) { $why += 'Windows servicing' }
    if ($sig.windowsUpdate -or $sig.agent) { $why += 'Windows Update' }
    if ($marker) { $why += 'the deployment scheduled one' }
    if ($why.Count) { Add-WdhFinding $C 'windows.restart' 'windows' 'Pending restart' 'Pending' 'Error' 'No restart pending' "A restart is pending ($($why -join ', '))" 'CBS RebootPending, WindowsUpdate RebootRequired, Microsoft.Update.SystemInfo, restart marker' 'Registry, Update Agent' 'Restart the computer; verification runs again after the restart.' -AutomaticRecovery $true -TechnicianRequired $false | Out-Null }
    else { Add-WdhFinding $C 'windows.restart' 'windows' 'Pending restart' 'Pass' 'Error' 'No restart pending' "None$(if ($sig.fileRenames) { " (Windows lists $($sig.fileRenames) file operation(s) for the next start; this alone is normal)" })" 'CBS RebootPending, WindowsUpdate RebootRequired, Microsoft.Update.SystemInfo, restart marker' 'Registry, Update Agent' | Out-Null }
}

# ------------------------------------------------------------------------------------------------
# Accounts and identity
# ------------------------------------------------------------------------------------------------

function Test-WdhAccounts {
    param($C)
    $id = $C.Config['identity']
    $names = Invoke-WdhProbe $C 'computerName' { Get-WdhComputerNames }
    $want = [string] $id['computerName']
    if (-not $names) { Add-WdhFinding $C 'identity.computerName' 'accounts' 'Computer name' 'Unverifiable' 'Error' $(if ($want) { $want } else { 'Chosen by Windows' }) 'Could not be read' 'ComputerName registry keys' 'Registry' | Out-Null }
    elseif (-not $want) { Add-WdhFinding $C 'identity.computerName' 'accounts' 'Computer name' 'Info' 'Informational' 'A name chosen by Windows' $names.active 'ActiveComputerName' 'Registry' -Required $false | Out-Null }
    elseif ($names.active -ieq $want -and (-not $names.pending -or $names.pending -ieq $want)) { Add-WdhFinding $C 'identity.computerName' 'accounts' 'Computer name' 'Pass' 'Error' $want "$($names.active) (active)" 'ActiveComputerName and the pending ComputerName' 'Registry' | Out-Null }
    elseif ($names.pending -ieq $want) { Add-WdhFinding $C 'identity.computerName' 'accounts' 'Computer name' 'Pending' 'Error' $want "Renamed to $($names.pending), active after a restart (now $($names.active))" 'ActiveComputerName vs ComputerName' 'Registry' 'Restart the computer to apply the new name.' -AutomaticRecovery $true -TechnicianRequired $false | Out-Null }
    else { Add-WdhFinding $C 'identity.computerName' 'accounts' 'Computer name' 'Fail' 'Error' $want "$($names.active)$(if ($names.pending -and $names.pending -ne $names.active) { " (pending: $($names.pending))" })" 'ActiveComputerName vs ComputerName' 'Registry' 'Rename the computer in Settings &gt; System &gt; About if the configured name is still wanted (nothing was changed by this check).' | Out-Null }

    $a = $C.Config['account']
    $users = Invoke-WdhProbe $C 'users' { Get-WdhLocalUsers }
    $admins = Invoke-WdhProbe $C 'admins' { Get-WdhAdminMembers }
    $profiles = Invoke-WdhProbe $C 'profiles' { Get-WdhProfileSids }
    if ($null -eq $users) {
        Add-WdhFinding $C 'account.exists' 'accounts' 'Local account' 'Unverifiable' 'Error' $(if ($a['username']) { "$($a['username']) exists" } else { 'The account created during setup' }) 'Local accounts could not be read' 'Get-LocalUser' 'Local accounts' 'Run the check again as administrator.' | Out-Null
        return
    }
    $adminSids = @(ConvertTo-WdhList $admins)
    $wantAdmin = [string] $a['expectedGroup'] -eq 'Administrators'
    if ([string] $a['mode'] -eq 'unattendedLocal' -and $a['username']) {
        $u = @($users | Where-Object { $_.name -ieq [string] $a['username'] }) | Select-Object -First 1
        if (-not $u) {
            Add-WdhFinding $C 'account.exists' 'accounts' "Local account $($a['username'])" 'Fail' 'Error' "$($a['username']) exists" 'No such local account' 'Get-LocalUser' 'Local accounts' 'The account from the answer file was not created. Check the answer file and C:\\Windows\\Panther\\setupact.log; nothing was changed by this check.' | Out-Null
        } else {
            if ($u.enabled) { Add-WdhFinding $C 'account.exists' 'accounts' "Local account $($u.name)" 'Pass' 'Error' "$($a['username']) exists and is enabled" "$($u.name) exists, enabled" 'Get-LocalUser' 'Local accounts' | Out-Null }
            else { Add-WdhFinding $C 'account.exists' 'accounts' "Local account $($u.name)" 'Fail' 'Error' "$($a['username']) exists and is enabled" "$($u.name) exists but is disabled" 'Get-LocalUser' 'Local accounts' 'Enable it in Computer Management if that is intended (not changed by this check).' | Out-Null }
            if ($null -eq $admins) { Add-WdhFinding $C 'account.role' 'accounts' 'Account type' 'Unverifiable' 'Error' $(if ($wantAdmin) { 'Administrator' } else { 'Standard user' }) 'The Administrators group could not be read' 'Administrators group (S-1-5-32-544)' 'Local groups' | Out-Null }
            else {
                $isAdmin = $u.sid -in $adminSids
                if ($isAdmin -eq $wantAdmin) { Add-WdhFinding $C 'account.role' 'accounts' 'Account type' 'Pass' 'Error' $(if ($wantAdmin) { 'Administrator' } else { 'Standard user' }) $(if ($isAdmin) { 'Member of Administrators' } else { 'Standard user (not in Administrators)' }) 'Administrators group membership (S-1-5-32-544)' 'Local groups' | Out-Null }
                elseif ($wantAdmin) { Add-WdhFinding $C 'account.role' 'accounts' 'Account type' 'Fail' 'Error' 'Administrator' 'Standard user (not in Administrators)' 'Administrators group membership' 'Local groups' 'Group membership was not changed. Add the account to Administrators only if that is still intended.' | Out-Null }
                else { Add-WdhFinding $C 'account.role' 'accounts' 'Account type' 'Fail' 'Error' 'Standard user' 'Unexpectedly a member of Administrators' 'Administrators group membership' 'Local groups' 'The everyday account has administrator rights it should not have. Remove it from Administrators after confirming another administrator account exists (not changed by this check).' | Out-Null }
            }
            $hasProfile = $u.sid -in @(ConvertTo-WdhList $profiles)
            Add-WdhFinding $C 'account.profile' 'accounts' 'User profile' $(if ($hasProfile) { 'Pass' } else { 'Warning' }) 'Warning' 'The profile exists (first sign-in done)' $(if ($hasProfile) { 'Profile created' } else { 'Not created yet: the account has never signed in' }) 'ProfileList' 'Registry' $(if ($hasProfile) { '' } else { 'Sign in once with this account.' }) -Required $false | Out-Null
        }
    } else {
        Add-WdhFinding $C 'account.exists' 'accounts' 'Local account' 'Info' 'Informational' 'Created during setup (interactive)' "$(@($users | Where-Object { $_.enabled }).Count) enabled local account(s)" 'Get-LocalUser' 'Local accounts' -Required $false | Out-Null
    }
    # An administrator the customer controls must exist; no hidden accounts are ever created.
    if ($null -ne $admins) {
        $enabledAdmins = @($users | Where-Object { $_.enabled -and $_.sid -in $adminSids -and $_.sid -notmatch '-500$' })
        if ($enabledAdmins.Count) { Add-WdhFinding $C 'account.administrator' 'accounts' 'Administrator access' 'Pass' 'Error' 'At least one enabled administrator account' "$($enabledAdmins.Count) enabled administrator account(s): $(($enabledAdmins | ForEach-Object { $_.name }) -join ', ')" 'Administrators group and local accounts' 'Local groups' | Out-Null }
        else { Add-WdhFinding $C 'account.administrator' 'accounts' 'Administrator access' 'Fail' 'Error' 'At least one enabled administrator account' 'No enabled administrator account besides the built-in Administrator' 'Administrators group and local accounts' 'Local groups' 'Create or enable an administrator account the customer controls before delivery.' | Out-Null }
    }
    $al = Invoke-WdhProbe $C 'autologon' { Get-WdhAutoLogon }
    if ($al) {
        $on = [string] $al.autoAdminLogon -eq '1' -and ($null -eq $al.autoLogonCount -or [int] $al.autoLogonCount -gt 0)
        $want = [string] $a['autoLogon']
        $obs = "$(if ($on) { "On (for $($al.userName))" } else { 'Off' })$(if ($al.passwordStored) { '; a sign-in password value is stored in the registry' } else { '' })"
        if ($want -eq 'persistent') { Add-WdhFinding $C 'account.autoLogon' 'accounts' 'Automatic sign-in' $(if ($on) { 'Info' } else { 'Warning' }) 'Warning' 'On (as configured)' $obs 'Winlogon AutoAdminLogon, AutoLogonCount (values only; no password is read)' 'Registry' $(if ($on) { 'Automatic sign-in stays on by configuration: anyone with physical access is signed in.' } else { 'Automatic sign-in is off although the configuration keeps it on.' }) -Required $false | Out-Null }
        elseif ($on) { Add-WdhFinding $C 'account.autoLogon' 'accounts' 'Automatic sign-in' 'Fail' 'Error' 'Off after the deployment' $obs 'Winlogon AutoAdminLogon, AutoLogonCount' 'Registry' 'Automatic sign-in is still on although it should not be. Turn it off (netplwiz) before delivery; nothing was changed by this check.' | Out-Null }
        else { Add-WdhFinding $C 'account.autoLogon' 'accounts' 'Automatic sign-in' 'Pass' 'Error' 'Off after the deployment' $obs 'Winlogon AutoAdminLogon, AutoLogonCount' 'Registry' | Out-Null }
    }
}

# ------------------------------------------------------------------------------------------------
# Windows Update
# ------------------------------------------------------------------------------------------------

function Test-WdhUpdates {
    param($C)
    $wu = $C.Config['windowsUpdate']
    $svc = Invoke-WdhProbe $C 'services' { Get-WdhServices }
    $agent = Invoke-WdhProbe $C 'updateAgent' { Get-WdhUpdateAgent }
    if ($svc -and $svc['wuauserv']) {
        $s = $svc['wuauserv']
        if ($s.startMode -eq 'Disabled') { Add-WdhFinding $C 'updates.service' 'updates' 'Windows Update service' 'Fail' 'Error' 'Available (not disabled)' 'Disabled' 'Win32_Service wuauserv' 'Services' 'Something disabled Windows Update; set the service back to Manual (not changed by this check).' | Out-Null }
        else { Add-WdhFinding $C 'updates.service' 'updates' 'Windows Update service' 'Pass' 'Error' 'Available (not disabled)' "$($s.startMode), $($s.state)" 'Win32_Service wuauserv' 'Services' | Out-Null }
    } else { Add-WdhFinding $C 'updates.service' 'updates' 'Windows Update service' 'Unverifiable' 'Error' 'Available' 'Could not be read' 'Win32_Service wuauserv' 'Services' | Out-Null }
    if (-not $wu['enabled']) {
        Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' 'NotApplicable' 'Informational' 'Not part of this deployment' "Windows updates itself on its own schedule$(if ($agent -and $agent.lastSearchUtc) { "; last successful search $($agent.lastSearchUtc)" })" 'Deployment configuration' 'health-config.json' -Required $false | Out-Null
    } else {
        $r = Read-WdhSource $C 'windowsUpdate' 'Updates\\result.json'
        $snap = @($C.Snapshot.stages | Where-Object { $_.id -eq 'windowsUpdate' }) | Select-Object -First 1
        $data = $r.Data
        if ($r.Source.state -eq 'corrupt') { Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' 'Unverifiable' 'Error' 'Every applicable update installed' 'The update result is damaged' 'Updates\\result.json' 'Updates\\result.json' 'Run "Deployment recovery" &gt; Retry failed operations to run the update stage again (installed updates are never offered again).' -RecoveryAction 'RetryFailed' | Out-Null }
        elseif (-not $data -or -not $snap -or $snap.state -ne 'Final') {
            $stateText = $(if ($snap) { "$($snap.state)$(if ($snap.status) { "/$($snap.status)" })" } else { 'not started' })
            $staleFinal = $C.StateRead.State -and [string] $C.StateRead.State['status'] -eq 'Completed' -and -not $data
            if ($staleFinal) { Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' 'Unverifiable' 'Error' 'Every applicable update installed' 'The deployment ended but the update stage left no result' 'Updates\\result.json vs deployment state' 'Updates\\result.json' 'Run "Deployment recovery" &gt; Resume.' -RecoveryAction 'Resume' | Out-Null }
            else { Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' 'Pending' 'Error' 'Every applicable update installed' "Still running ($stateText)" 'Updates\\status.json, the stage task' 'Updates\\status.json' 'Wait; the stage continues by itself (it restarts the computer when needed).' -AutomaticRecovery $true -TechnicianRequired $false | Out-Null }
        } else {
            $failed = @(ConvertTo-WdhList $data['failed'])
            $installed = @(ConvertTo-WdhList $data['installed']).Count
            switch ([string] $data['status']) {
                'Succeeded' { Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' 'Pass' 'Error' 'Every applicable update installed' "Succeeded: $installed installed, $([int] $data['reboots']) restart(s)$(if ($agent -and $agent.lastSearchUtc) { "; Windows Update's last successful search $($agent.lastSearchUtc)" })" 'Updates\\result.json and the Windows Update Agent' 'Updates\\result.json' | Out-Null }
                'Offline' { Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' 'Fail' 'Error' 'Every applicable update installed' 'Not done: there was no network before the stage''s time limit' 'Updates\\result.json' 'Updates\\result.json' 'Connect the network, then "Deployment recovery" &gt; Retry failed operations.' -RecoveryAction 'RetryFailed' | Out-Null }
                'Failed' { Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' 'Fail' 'Error' 'Every applicable update installed' "Failed: $($data['reason'])" 'Updates\\result.json' 'Updates\\result.json' 'See Updates\\logs\\engine.log, fix the cause, then "Deployment recovery" &gt; Retry failed operations.' -RecoveryAction 'RetryFailed' | Out-Null }
                default { Add-WdhFinding $C 'updates.stage' 'updates' 'Initial Windows Update' $(if ($failed.Count) { 'Info' } else { 'Pass' }) 'Error' 'Every applicable update installed' "$($data['status']): $installed installed, $($failed.Count) failed" 'Updates\\result.json' 'Updates\\result.json' | Out-Null }
            }
            foreach ($f in $failed) {
                $kb = @(ConvertTo-WdhList $f['kbs']) | Select-Object -First 1
                $fid = $(if ($kb) { "updates.kb.$kb" } else { "updates.update.$((Get-WddSha256 ([Text.Encoding]::UTF8.GetBytes([string] $f['title']))).Substring(0, 12))" })
                Add-WdhFinding $C $fid 'updates' "Update $(if ($kb) { "$kb " })failed" 'Fail' 'Error' 'Installed' "$($f['title']): failed after $($f['attempts']) attempt(s) ($($f['lastHResult']))" 'Updates\\result.json failed[]' 'Updates\\result.json' 'Retry the update stage ("Deployment recovery" &gt; Retry failed operations), or install it from Settings &gt; Windows Update.' -RecoveryAction 'RetryFailed' | Out-Null
            }
        }
        $skipped = @()
        if ([string] $wu['featureUpdates'] -eq 'skip') { $skipped += 'feature updates' }
        if ([string] $wu['optionalUpdates'] -eq 'skip') { $skipped += 'optional updates' }
        if ($skipped.Count) { Add-WdhFinding $C 'updates.scope' 'updates' 'Updates not installed by design' 'Info' 'Informational' "$($skipped -join ' and ') are not installed by the deployment" 'Every other applicable update was in scope; this report does not claim that optional or deferred updates are installed' 'Deployment configuration' 'health-config.json' -Required $false | Out-Null }
    }
    if ($C.ScanUpdates) {
        $scan = Invoke-WdhProbe $C 'updateScan' { Get-WdhUpdateScan }
        if ($null -eq $scan) { Add-WdhFinding $C 'updates.scan' 'updates' 'Windows Update scan' 'Unverifiable' 'Warning' 'Scan completed' 'The scan was not possible (no network, or the service is busy)' 'Microsoft.Update.Session search (read-only)' 'Windows Update Agent' 'Try again when online.' -Required $false | Out-Null }
        elseif ($scan.required) { Add-WdhFinding $C 'updates.scan' 'updates' 'Updates still available' 'Warning' 'Warning' 'No required update outstanding' "$($scan.required) update(s) available now: $($scan.titles -join '; ')$(if ($scan.optional -or $scan.drivers -or $scan.feature) { ". Also $($scan.optional) optional, $($scan.drivers) driver, $($scan.feature) feature update(s)" })" 'Microsoft.Update.Session search (read-only)' 'Windows Update Agent' 'Install them from Settings &gt; Windows Update, or retry the update stage.' -Required $false | Out-Null }
        else { Add-WdhFinding $C 'updates.scan' 'updates' 'Windows Update scan' 'Pass' 'Warning' 'No required update outstanding' "None required now ($($scan.optional) optional, $($scan.drivers) driver, $($scan.feature) feature update(s) not counted)" 'Microsoft.Update.Session search (read-only)' 'Windows Update Agent' -Required $false | Out-Null }
    } else { $C.Limitations.Add('No live Windows Update scan was made (run with -ScanUpdates to ask Windows Update what is still available). The update result above is the deployment''s own evidence.') }
    # Ongoing policy (Phase 4.3), and whether Windows Update may offer drivers (Phase 8 driver stage).
    if ($wu['ongoingPolicy']) {
        $pol = $(if ($C.StateRead.State -and $C.StateRead.State.ContainsKey('updatePolicy')) { $C.StateRead.State['updatePolicy'] } else { $null })
        if ($pol -is [hashtable] -and [string] $pol['status'] -in 'Applied', 'AlreadyApplied') { Add-WdhFinding $C 'updates.policy' 'updates' 'Ongoing update policy' 'Pass' 'Warning' "Applied ($($wu['ongoingPolicy']))" ([string] $pol['status']) 'Deployment state updatePolicy (Set-UpdatePolicy.ps1)' 'state\\deployment.json' -Required $false | Out-Null }
        elseif ($pol -is [hashtable] -and [string] $pol['status'] -in 'ManagedByOrganization', 'Unsupported') { Add-WdhFinding $C 'updates.policy' 'updates' 'Ongoing update policy' 'Info' 'Informational' "Applied ($($wu['ongoingPolicy']))" "$($pol['status']): $($pol['message'])" 'Deployment state updatePolicy' 'state\\deployment.json' -Required $false | Out-Null }
        elseif ($pol -is [hashtable]) { Add-WdhFinding $C 'updates.policy' 'updates' 'Ongoing update policy' 'Warning' 'Warning' "Applied ($($wu['ongoingPolicy']))" "$($pol['status']): $($pol['message'])" 'Deployment state updatePolicy' 'state\\deployment.json' 'Set it under Settings &gt; Windows Update, or re-run the deployment.' -Required $false | Out-Null }
        else { Add-WdhFinding $C 'updates.policy' 'updates' 'Ongoing update policy' $(if ($C.Snapshot.allFinal) { 'Warning' } else { 'Pending' }) 'Warning' "Applied ($($wu['ongoingPolicy']))" 'Not applied yet' 'Deployment state updatePolicy' 'state\\deployment.json' $(if ($C.Snapshot.allFinal) { 'Set it under Settings &gt; Windows Update.' } else { 'It is applied once the initial update stage has finished.' }) -Required $false | Out-Null }
    }
    $ex = Get-WdhRegValue 'HKLM' 'SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'ExcludeWUDriversInQualityUpdate'
    $blocked = $null -ne $ex -and [int] $ex -eq 1
    if ([string] $wu['drivers'] -eq 'include' -and $blocked) { Add-WdhFinding $C 'updates.driverPolicy' 'updates' 'Drivers from Windows Update' 'Warning' 'Warning' 'Windows Update may offer drivers' 'Blocked by policy (ExcludeWUDriversInQualityUpdate = 1, set by an organization or an older profile)' 'HKLM Policies WindowsUpdate' 'Registry' 'Leave it if an organization manages updates; otherwise drivers come only from the driver stage or Device Manager.' -Required $false | Out-Null }
    else { Add-WdhFinding $C 'updates.driverPolicy' 'updates' 'Drivers from Windows Update' 'Info' 'Informational' $(if ([string] $wu['drivers'] -eq 'include') { 'Windows Update may offer drivers' } else { 'Windows Update does not install drivers (configured)' }) $(if ($blocked) { 'Blocked by policy' } else { 'Allowed' }) 'HKLM Policies WindowsUpdate ExcludeWUDriversInQualityUpdate' 'Registry' -Required $false | Out-Null }
}

# ------------------------------------------------------------------------------------------------
# Applications: only what this deployment selected
# ------------------------------------------------------------------------------------------------

function Find-WdhInstalled {
    param($Item, [object[]] $Entries, [object[]] $Appx, [string[]] $Shortcuts)
    $pkgId = ([string] $Item['packageIdentifier']).ToLowerInvariant()
    $names = @(@(ConvertTo-WdhList $Item['names']) | ForEach-Object { Get-WdhNorm ([string] $_) } | Where-Object { $_.Length -ge 3 })
    foreach ($e in $Entries) {
        $key = ([string] $e.keyName).ToLowerInvariant()
        # WinGet registers portable packages (and some others) under "&lt;PackageIdentifier&gt;_&lt;source&gt;".
        if ($pkgId -and ($key -eq $pkgId -or $key.StartsWith("$($pkgId)_"))) { return @{ found = $true; scope = $e.scope; version = $e.displayVersion; how = 'WinGet uninstall record' } }
    }
    foreach ($e in $Entries) {
        if (-not $e.displayName) { continue }
        $n = Get-WdhNorm $e.displayName
        foreach ($want in $names) {
            if ($n -eq $want -or (" $n " -like "* $want *")) { return @{ found = $true; scope = $e.scope; version = $e.displayVersion; how = "uninstall record ""$($e.displayName)""" } }
        }
    }
    if ([string] $Item['source'] -eq 'msstore' -and $Appx) {
        foreach ($a in $Appx) {
            $flat = (([string] $a.name) + ' ' + ([string] $a.family)).ToLowerInvariant() -replace '[^a-z0-9 ]', ''
            foreach ($want in $names) { if ($flat.Contains(($want -replace ' ', ''))) { return @{ found = $true; scope = 'user'; version = $a.version; how = "Store package $($a.name)" } } }
        }
    }
    if ($Item['shortcut'] -and $Shortcuts -contains [string] $Item['shortcut']) { return @{ found = $true; scope = 'machine'; version = ''; how = 'portable tool shortcut' } }
    return @{ found = $false; scope = ''; version = ''; how = '' }
}

function Test-WdhApplications {
    param($C)
    $cfgApps = $C.Config['applications']
    $items = @(ConvertTo-WdhList $cfgApps['items'])
    if (-not $cfgApps['enabled'] -or -not $items.Count) {
        Add-WdhFinding $C 'apps.plan' 'applications' 'Applications' 'NotApplicable' 'Informational' 'No application is part of this deployment' 'Nothing to verify' 'health-config.json' 'health-config.json' -Required $false | Out-Null
        return
    }
    $res = Read-WdhSource $C 'applications' 'Applications\\result.json'
    $stRead = Read-WdhSource $C 'applicationState' 'Applications\\state.json'
    if ($stRead.Source.state -ne 'ok') {
        $bak = Join-Path $C.Paths.Root 'Applications\\state.json.bak'
        if (Test-Path -LiteralPath $bak) { $b = Read-WddJson $bak; if ($b) { $stRead = @{ Data = $b; Source = $stRead.Source }; $C.Limitations.Add('Applications\\state.json was unusable; its last good copy was read.') } }
    }
    $snap = @($C.Snapshot.stages | Where-Object { $_.id -eq 'applications' }) | Select-Object -First 1
    $stageFinal = $snap -and $snap.state -eq 'Final'
    if ($res.Source.state -eq 'corrupt' -and -not $stRead.Data) { Add-WdhFinding $C 'apps.result' 'applications' 'Application results' 'Unverifiable' 'Error' 'The application stage''s results' 'Damaged, and no usable state' 'Applications\\result.json, state.json' 'Applications' 'Run "Deployment recovery" &gt; Resume; each application is checked again before anything is installed.' -RecoveryAction 'Resume' | Out-Null }
    if ($stageFinal -and $res.Data -and $res.Data['finishedUtc'] -and $stRead.Data -and $stRead.Data['updatedUtc']) {
        $rd = ConvertTo-WddDate $res.Data['finishedUtc']; $sd = ConvertTo-WddDate $stRead.Data['updatedUtc']
        if ($rd -and $sd -and $sd -gt $rd.AddMinutes(1)) { $res.Source.state = 'stale'; $C.Limitations.Add('Applications\\result.json is older than the engine''s state (the stage was reopened); the live state was used.') }
    }
    $byKey = @{}
    $useState = $res.Source.state -ne 'ok'
    if (-not $useState -and $res.Data) {
        foreach ($p in @(ConvertTo-WdhList $res.Data['packages'])) { $byKey[([string] $p['key']).ToLowerInvariant()] = $p }
        foreach ($p in @(ConvertTo-WdhList $res.Data['additionalSoftware'])) { $byKey["additional:$(([string] $p['id']).ToLowerInvariant())"] = $p }
    }
    if ($stRead.Data -is [hashtable]) {
        $sp = $stRead.Data['packages']; $sa = $stRead.Data['additional']
        if ($sp -is [hashtable]) { foreach ($k in $sp.Keys) { if ($useState -or -not $byKey.ContainsKey($k.ToLowerInvariant())) { $byKey[$k.ToLowerInvariant()] = $sp[$k] } } }
        if ($sa -is [hashtable]) { foreach ($k in $sa.Keys) { $kk = "additional:$($k.ToLowerInvariant())"; if ($useState -or -not $byKey.ContainsKey($kk)) { $byKey[$kk] = $sa[$k] } } }
    }
    $sid = $C.DeploymentSid
    $entries = @(ConvertTo-WdhList (Invoke-WdhProbe $C 'uninstall' { Get-WdhUninstallEntries $(if ($C.HiveLoaded) { $sid } else { '' }) }))
    $appx = Invoke-WdhProbe $C 'appx' { Get-WdhAppxPackages $(if ($sid) { $sid } else { '' }) }
    $shortcuts = @(ConvertTo-WdhList (Invoke-WdhProbe $C 'shortcuts' { Get-WdhPortableShortcuts }))
    $userAvailable = $C.HiveLoaded
    foreach ($it in $items) {
        $key = ([string] $it['key']).ToLowerInvariant()
        $fid = "app.$key"
        $e = $(if ($byKey.ContainsKey($key)) { $byKey[$key] } else { $null })
        $eng = $(if ($e) { [string] $e['status'] } else { '' })
        $det = $(if ($e -and $e.ContainsKey('detection')) { [string] $e['detection'] } else { '' })
        $life = $(if ($e -and $e.ContainsKey('lifecycle')) { [string] $e['lifecycle'] } elseif ($e -and (Get-Command Get-WdaLifecycle -ErrorAction SilentlyContinue)) { [string] (Get-WdaLifecycle $e) } else { '' })
        $attempts = $(if ($e -and $e.ContainsKey('totalAttempts')) { [int] $e['totalAttempts'] } elseif ($e) { [int] $e['attempts'] } else { 0 })
        $msg = $(if ($e) { [string] $e['message'] } else { '' })
        $hit = Find-WdhInstalled $it $entries @(ConvertTo-WdhList $appx) $shortcuts
        $scope = [string] $it['scope']
        $indep = $(if ($hit.found) { 'Found' } elseif (-not $userAvailable -and $scope -ne 'machine') { 'Deferred' } else { 'NotFound' })
        $required = [bool] $it['required']
        $sev = $(if ($required) { 'Error' } else { 'Warning' })
        $name = [string] $it['name']
        $where = $(if ($hit.found) { "$($hit.how)$(if ($hit.version) { ", version $($hit.version)" }) ($($hit.scope))" } else { '' })
        $method = 'Uninstall records (machine and the deployment user), Store packages, portable shortcut; the engine''s result as evidence'
        $evidence = $(if ($e) { "engine: $eng$(if ($det) { ", detection $det" })$(if ($attempts) { ", $attempts attempt(s)" })" } else { 'no engine record' })
        $recovery = $(if ($e -and $e.ContainsKey('retryable') -and [bool] $e['retryable']) { 'RetryFailed' } elseif ($eng -in 'Failed', 'Unavailable') { 'Retry -IncludePermanent' } else { '' })
        $v = $null
        if ([string] $it['kind'] -eq 'manual') {
            if ($hit.found) { $v = @('Pass', 'InstalledManually', "Installed by hand: $where", '') }
            elseif ($indep -eq 'Deferred') { $v = @('Warning', 'ManualInstallationRequired', "Manual follow-up; not found machine-wide ($($C.DeploymentUser)'s own applications could not be checked)", [string] $it['instructions']) }
            else { $v = @('Warning', 'ManualInstallationRequired', 'Not installed: this application has no unattended installation', $(if ($it['instructions']) { [string] $it['instructions'] } else { "Install $name by hand." })) }
            $sev = 'Warning'
        } elseif ($eng -in 'Pending', 'Installing' -and -not $stageFinal) { $v = @('Pending', 'Pending', "Not installed yet (the application stage is $(if ($snap) { $snap.state } else { 'not started' }))", 'Wait; the stage continues by itself.') }
        elseif (-not $e -and -not $stageFinal -and -not $hit.found) { $v = @('Pending', 'Pending', 'Not installed yet (the application stage has not reached it)', 'Wait; the stage continues by itself.') }
        elseif ($eng -eq 'RequiresRestart') { $v = @('Pending', 'WaitingForReboot', 'Installed; needs a restart to finish', 'Restart the computer.') }
        elseif ($eng -eq 'SkippedByUser') { $v = @('NotApplicable', 'SkippedByUser', 'Deselected for this deployment', '') }
        elseif ($hit.found) {
            if ($eng -in 'Succeeded', 'AlreadyInstalled', '' -or ($eng -eq 'RequiresInteraction')) {
                $want = [string] $it['version']
                if ($want -and $hit.version -and $hit.version -ne $want) { $v = @('Warning', 'InstalledVersionDiffers', "Installed, version $($hit.version) instead of $want ($where)", 'Check whether the pinned version is still required.') }
                else { $v = @('Pass', $(if ($eng -eq 'AlreadyInstalled') { 'AlreadyInstalledVerified' } else { 'InstalledVerified' }), "Installed: $where$(if (-not $e) { '; the engine has no record of it' })", '') }
            } else { $v = @('Warning', 'InstalledVerificationUncertain', "Present ($where), although the installation reported $eng. $msg", 'Open it once to confirm it works; retry it with "Deployment recovery" if it does not.') }
        } elseif ($indep -eq 'Deferred' -and $eng -in 'Succeeded', 'AlreadyInstalled') {
            $v = @('Deferred', 'WaitingForUserContext', "The engine reported $eng in $($C.DeploymentUser)'s account; not found machine-wide, and $($C.DeploymentUser)'s own applications cannot be checked while that user is signed out", "Sign in as $($C.DeploymentUser) and open the Health Report again.")
        } elseif ($eng -in 'Succeeded', 'AlreadyInstalled') {
            $v = @('Warning', 'InstalledVerificationUncertain', "The engine reported $eng$(if ($det -eq 'Unconfirmed') { ', but WinGet could not confirm it afterwards' } elseif ($det) { " (WinGet detection: $det)" }); no uninstall record or Store package matched its name", 'Open it once to confirm it is installed; uninstall records do not exist for every installer.')
        } elseif ($eng -eq 'Skipped') { $v = @('Fail', 'BlockedByDependency', "Not installed: a dependency failed. $msg", 'Run "Deployment recovery" &gt; Retry failed operations (it retries the dependency too).') }
        elseif ($eng -eq 'RequiresInteraction') { $v = @('Warning', 'ManualInstallationRequired', "Needs a person: $msg", "Install or finish $name by hand.") }
        elseif ($eng -in 'Failed', 'Unavailable') { $v = @('Fail', 'Failed', "Missing: the installation failed$(if ($e['failureClass']) { " ($($e['failureClass']))" }) after $attempts attempt(s). $msg", $(if ($recovery -eq 'RetryFailed') { 'Run "Deployment recovery" &gt; Retry failed operations.' } else { 'Correct the cause (see the message), then "Deployment recovery" &gt; Retry one application with -IncludePermanent.' })) }
        elseif (-not $e -and $indep -eq 'Deferred') { $v = @('Deferred', 'WaitingForUserContext', "No engine record, and $($C.DeploymentUser)'s own applications cannot be checked now", "Sign in as $($C.DeploymentUser) and open the Health Report again.") }
        else { $v = @('Fail', 'Missing', "Not installed$(if (-not $e) { '; the application stage has no record of it (inconsistent results)' } else { " (engine: $eng)" })", 'Run "Deployment recovery" &gt; Resume.') ; if (-not $recovery) { $recovery = 'Resume' } }
        $status = $v[0]
        if ($status -eq 'Fail' -and -not $required) { $sev = 'Warning' }
        Add-WdhFinding $C $fid 'applications' $name $status $sev $(if ([string] $it['kind'] -eq 'manual') { 'Installed (manual follow-up)' } elseif ($it['version']) { "Installed, version $($it['version'])" } else { 'Installed' }) $v[2] $method $evidence $v[3] -Required ($required -and [string] $it['kind'] -ne 'manual') -AutomaticRecovery ($status -eq 'Pending') -TechnicianRequired ($status -in 'Fail', 'Warning', 'Deferred') -RecoveryAction $(if ($status -eq 'Fail') { $recovery } else { '' }) | Out-Null
        $C.Apps.Add([ordered]@{ key = $key; name = $name; source = [string] $it['source']; packageIdentifier = [string] $it['packageIdentifier']; method = [string] $it['method']; kind = [string] $it['kind']; required = $required
                                scope = $scope; engineStatus = $eng; lifecycle = $life; attempts = $attempts; detection = $det; independent = $indep; foundIn = $(if ($hit.found) { [string] $hit.scope } else { '' }); version = [string] $hit.version; result = $v[1]; findingId = $fid })
        if ($v[1] -eq 'ManualInstallationRequired') { $C.Manual.Add([ordered]@{ id = $fid; text = "$name\`: $($v[3])"; url = [string] $it['url'] }) }
    }
    if ($res.Data -and $res.Data['bootstrap'] -is [hashtable] -and [string] $res.Data['bootstrap']['status'] -in 'Failed', 'Unsupported', 'NeedsRepair') {
        Add-WdhFinding $C 'apps.winget' 'applications' 'WinGet' 'Fail' 'Error' 'WinGet usable' "$($res.Data['bootstrap']['status']): $($res.Data['bootstrap']['message'])" 'Applications\\result.json bootstrap' 'Applications\\result.json' 'Update App Installer from the Microsoft Store, then "Deployment recovery" &gt; Retry failed operations.' -RecoveryAction 'RetryFailed' | Out-Null
    }
}

# ------------------------------------------------------------------------------------------------
# Restored settings (Phase 6) and retained backups
# ------------------------------------------------------------------------------------------------

function Test-WdhRestoration {
    param($C)
    $plan = $C.Config['restoration']
    $folders = @(ConvertTo-WdhList (Invoke-WdhProbe $C 'backups' { Get-WdhBackupFolders $C.Paths.Root }))
    $outstanding = $false
    if (-not $plan['required']) {
        Add-WdhFinding $C 'restore.plan' 'restoration' 'Settings restoration' 'NotApplicable' 'Informational' 'Not part of this deployment' 'No settings backup was planned' 'health-config.json' 'health-config.json' -Required $false | Out-Null
    } else {
        $r = Read-WdhSource $C 'restoration' 'Applications\\restoration.json' 'windows-deployment-builder/restoration-result'
        $snap = @($C.Snapshot.stages | Where-Object { $_.id -eq 'applications' }) | Select-Object -First 1
        $final = $snap -and $snap.state -eq 'Final'
        if ($r.Source.state -eq 'corrupt') { Add-WdhFinding $C 'restore.result' 'restoration' 'Restoration result' 'Unverifiable' 'Error' 'Readable restoration result' 'restoration.json is damaged or not a restoration result' 'Applications\\restoration.json' 'Applications\\restoration.json' 'Run "Deployment recovery" &gt; Resume.' -RecoveryAction 'Resume' | Out-Null; $outstanding = $true }
        elseif (-not $r.Data) {
            if ($final) { Add-WdhFinding $C 'restore.result' 'restoration' 'Restoration result' 'Unverifiable' 'Error' 'A restoration result' 'The application stage finished without writing restoration.json' 'Applications\\restoration.json' 'Applications\\restoration.json' 'Run "Deployment recovery" &gt; Resume.' -RecoveryAction 'Resume' | Out-Null }
            else { Add-WdhFinding $C 'restore.result' 'restoration' 'Restoration result' 'Pending' 'Error' 'Settings restored' 'Not done yet: settings are restored after their applications' 'Applications\\restoration.json' 'Applications\\restoration.json' 'Wait for the application stage.' -AutomaticRecovery $true -TechnicianRequired $false | Out-Null }
            $outstanding = $true
        } else {
            $d = $r.Data
            if ([string] $d['backupId'] -and [string] $plan['backupId'] -and [string] $d['backupId'] -ne [string] $plan['backupId']) { Add-WdhFinding $C 'restore.backup' 'restoration' 'Settings backup' 'Unverifiable' 'Error' "Backup $($plan['backupId'])" "The result describes backup $($d['backupId'])" 'restoration.json backupId vs the plan' 'Applications\\restoration.json' 'Verify with the package that pins this backup.' | Out-Null }
            else {
                $bs = $(if ($d['backup'] -is [hashtable]) { [string] $d['backup']['status'] } else { '' })
                $bm = $(if ($d['backup'] -is [hashtable]) { [string] $d['backup']['message'] } else { '' })
                switch ($bs) {
                    'Staged' { Add-WdhFinding $C 'restore.backup' 'restoration' 'Settings backup' 'Pass' 'Error' "Backup $($plan['backupId']) found and validated" 'Found, every file matched its SHA-256' 'restoration.json backup (validated by the engine against the pinned manifest SHA-256)' 'Applications\\restoration.json' | Out-Null }
                    'NotSearched' { Add-WdhFinding $C 'restore.backup' 'restoration' 'Settings backup' $(if ($final) { 'Fail' } else { 'Pending' }) 'Error' "Backup $($plan['backupId']) found and validated" 'Not looked for yet' 'restoration.json backup' 'Applications\\restoration.json' 'Wait for the application stage.' | Out-Null; $outstanding = $true }
                    'NotFound' { Add-WdhFinding $C 'restore.backup' 'restoration' 'Settings backup' 'Fail' 'Error' "Backup $($plan['folderName']) found and validated" "Not found. $bm" 'restoration.json backup' 'Applications\\restoration.json' "Connect the drive with $($plan['folderName']) and run ""Deployment recovery"" &gt; Restore application settings." -RecoveryAction 'RestoreSettings' | Out-Null; $outstanding = $true }
                    'Invalid' { Add-WdhFinding $C 'restore.backup' 'restoration' 'Settings backup' 'Fail' 'Error' "Backup $($plan['folderName']) found and validated" "Rejected: damaged, modified or not the expected backup. $bm" 'restoration.json backup (SHA-256 validation)' 'Applications\\restoration.json' 'Supply the original, unmodified backup ("Deployment recovery" &gt; Restore application settings). A modified backup is never restored.' -RecoveryAction 'RestoreSettings' | Out-Null; $outstanding = $true }
                    default { Add-WdhFinding $C 'restore.backup' 'restoration' 'Settings backup' 'Fail' 'Error' "Backup $($plan['folderName']) found and validated" "$bs. $bm" 'restoration.json backup' 'Applications\\restoration.json' 'See the application engine log.' -RecoveryAction 'RestoreSettings' | Out-Null; $outstanding = $true }
                }
            }
            $settings = @{}
            foreach ($s in @(ConvertTo-WdhList $d['settings'])) { $settings[[string] $s['adapterId']] = $s }
            $appByKey = @{}
            foreach ($a in $C.Apps) { $appByKey[$a.key] = $a }
            foreach ($ad in @(ConvertTo-WdhList $plan['adapters'])) {
                $aid = [string] $ad['id']
                $s = $(if ($settings.ContainsKey($aid)) { $settings[$aid] } else { $null })
                $fid = "restore.settings.$aid"
                $title = "$($ad['name']) settings"
                if (-not $s) { Add-WdhFinding $C $fid 'restoration' $title $(if ($final) { 'Unverifiable' } else { 'Pending' }) 'Error' 'Restored' 'No result for this adapter' 'restoration.json settings[]' 'Applications\\restoration.json' 'Run "Deployment recovery" &gt; Resume.' -RecoveryAction 'Resume' | Out-Null; $outstanding = $true; continue }
                $o = [string] $s['outcome']
                $detail = "$o. $($s['detail'])"
                $review = @(@(ConvertTo-WdhList $s['items']) | Where-Object { [string] $_['action'] -eq 'review' }).Count
                switch ($o) {
                    'ConfigurationRestored' { Add-WdhFinding $C $fid 'restoration' $title $(if ($review) { 'Warning' } else { 'Pass' }) 'Error' 'Restored' $(if ($review) { "$detail $review item(s) need a manual review (conflict with existing settings)." } else { $detail }) 'restoration.json (the engine compared every restored file with the backup)' 'Applications\\restoration.json' $(if ($review) { 'Review the listed items with the customer.' } else { '' }) | Out-Null }
                    'KeptExisting' { Add-WdhFinding $C $fid 'restoration' $title 'Pass' 'Error' 'Restored' "$detail (existing settings were kept by the chosen conflict rule)" 'restoration.json' 'Applications\\restoration.json' | Out-Null }
                    'ConfigurationPartiallyRestored' { Add-WdhFinding $C $fid 'restoration' $title 'Warning' 'Warning' 'Restored' $detail 'restoration.json' 'Applications\\restoration.json' 'Check the items that were not restored with the customer.' | Out-Null }
                    'ManualActionRequired' { Add-WdhFinding $C $fid 'restoration' $title 'Warning' 'Warning' 'Restored' $detail 'restoration.json' 'Applications\\restoration.json' (@(ConvertTo-WdhList $s['followUps']) -join ' ') | Out-Null }
                    'Unsupported' { Add-WdhFinding $C $fid 'restoration' $title 'Warning' 'Warning' 'Restored' $detail 'restoration.json' 'Applications\\restoration.json' 'Restore these settings by hand.' -Required $false | Out-Null }
                    'SkippedByUser' { Add-WdhFinding $C $fid 'restoration' $title 'NotApplicable' 'Informational' 'Restored' $detail 'restoration.json' 'Applications\\restoration.json' -Required $false | Out-Null }
                    { $_ -in 'Pending', 'WaitingForUser', 'WaitingForBackup', 'BlockedByDependency' } {
                        $wait = $(if ($o -eq 'WaitingForBackup') { 'Connect the backup and run "Deployment recovery" &gt; Restore application settings.' } elseif ($o -eq 'WaitingForUser') { "Sign in as $($C.DeploymentUser); settings are restored in that account." } elseif ($o -eq 'BlockedByDependency') { 'Its application is not installed; fix that first.' } else { 'Wait for the application stage.' })
                        Add-WdhFinding $C $fid 'restoration' $title $(if ($final -and $o -ne 'WaitingForUser') { 'Fail' } else { 'Pending' }) 'Error' 'Restored' $detail 'restoration.json' 'Applications\\restoration.json' $wait -RecoveryAction $(if ($o -eq 'WaitingForBackup') { 'RestoreSettings' } else { 'RetryFailed' }) | Out-Null
                        $outstanding = $true
                    }
                    default { Add-WdhFinding $C $fid 'restoration' $title 'Fail' 'Error' 'Restored' $detail 'restoration.json' 'Applications\\restoration.json' 'Run "Deployment recovery" &gt; Retry failed operations, or restore the settings by hand.' -RecoveryAction 'RetryFailed' | Out-Null; $outstanding = $true }
                }
                # Installed is not migrated: an application can be present while its settings failed.
                if ($o -in 'ConfigurationRestored', 'KeptExisting', 'ConfigurationPartiallyRestored') {
                    $app = @($C.Apps | Where-Object { $_.name -like "*$($ad['name'])*" -or $ad['name'] -like "*$($_.name)*" }) | Select-Object -First 1
                    if ($app -and $app.independent -eq 'NotFound' -and $app.result -in 'Failed', 'Missing', 'BlockedByDependency') { Add-WdhFinding $C "restore.consistency.$aid" 'restoration' "$($ad['name']) settings without the application" 'Unverifiable' 'Error' 'Settings restored for an installed application' "The settings are reported restored, but $($app.name) is not installed" 'restoration.json vs the application check' 'Applications\\restoration.json' 'Install the application, then verify again.' | Out-Null }
                }
            }
        }
    }
    $bytes = 0; foreach ($f in $folders) { $bytes += [double] $f.bytes }
    $C.Backups = [ordered]@{ retained = $folders.Count; bytes = $bytes; location = $(if ($folders.Count) { 'C:\\ProgramData\\WindowsDeploymentBuilder\\Backup' } else { '' }); requiredForOutstanding = $outstanding
                             cleanup = $(if ($folders.Count -and -not $outstanding -and $plan['backupId']) { "powershell.exe -ExecutionPolicy Bypass -File \`"$(Join-Path $C.Paths.Package 'scripts\\health\\DeploymentHealth.ps1')\`" -Mode CleanupBackups -ConfirmCleanup $($plan['backupId'])" } else { '' }) }
    if ($folders.Count) {
        if ($outstanding) { Add-WdhFinding $C 'restore.retained' 'restoration' 'Retained settings backup' 'Info' 'Informational' 'Kept until restoration is complete' "$($folders.Count) staged backup folder(s), $(Format-WdhBytes $bytes); still needed" 'Backup folder below the data root' 'Backup' -Required $false | Out-Null }
        else { Add-WdhFinding $C 'restore.retained' 'restoration' 'Retained settings backup' 'Warning' 'Warning' 'Removed after delivery, or kept on purpose' "$($folders.Count) staged backup folder(s) with personal application settings remain ($(Format-WdhBytes $bytes)) under C:\\ProgramData\\WindowsDeploymentBuilder\\Backup" 'Backup folder below the data root' 'Backup' 'Remove it after confirming the settings with the customer: DeploymentHealth.ps1 -Mode CleanupBackups (asks for the backup id; the USB copy is never touched).' -Required $false | Out-Null }
    }
}

# ------------------------------------------------------------------------------------------------
# Hardware and drivers (Phase 8 report compared with the devices as they are now)
# ------------------------------------------------------------------------------------------------

function Get-WdhDeviceSeverity { param([string] $Class) if ($Class -in 'Display', 'Net', 'SCSIAdapter', 'HDC', 'DiskDrive', 'System') { 'Error' } else { 'Warning' } }

function Test-WdhDrivers {
    param($C)
    $cfg = $C.Config['drivers']
    $devices = Invoke-WdhProbe $C 'devices' { Get-WdhPnpDevices }
    $report = $null
    if ($cfg['enabled']) {
        $r = Read-WdhSource $C 'drivers' 'reports\\drivers.json' 'windows-deployment-builder/drivers-result'
        $snap = @($C.Snapshot.stages | Where-Object { $_.id -eq 'drivers' }) | Select-Object -First 1
        if ($r.Source.state -eq 'corrupt') { Add-WdhFinding $C 'drivers.report' 'drivers' 'Driver report' 'Unverifiable' 'Error' 'A readable driver report' 'drivers.json is damaged' 'reports\\drivers.json' 'reports\\drivers.json' 'Run "Deployment recovery" &gt; Retry failed operations to run the driver stage again.' -RecoveryAction 'RetryFailed' | Out-Null }
        elseif (-not $r.Data) { Add-WdhFinding $C 'drivers.report' 'drivers' 'Driver report' $(if ($snap -and $snap.state -eq 'Final') { 'Unverifiable' } else { 'Pending' }) 'Error' 'The driver stage finished' $(if ($snap) { "No report yet (stage $($snap.state))" } else { 'No report' }) 'reports\\drivers.json' 'reports\\drivers.json' 'Wait for the driver stage.' | Out-Null }
        elseif ([string] $r.Data['deploymentId'] -and [string] $r.Data['deploymentId'] -ne [string] $C.Manifest.packageId) { $r.Source.state = 'inconsistent'; Add-WdhFinding $C 'drivers.report' 'drivers' 'Driver report' 'Unverifiable' 'Error' "The report of deployment $($C.Manifest.packageId)" "The report belongs to deployment $($r.Data['deploymentId'])" 'drivers.json deploymentId' 'reports\\drivers.json' 'Run the driver stage of this deployment again.' | Out-Null }
        elseif (-not $r.Data['final'] -and $snap -and $snap.state -eq 'Final') { $r.Source.state = 'inconsistent'; Add-WdhFinding $C 'drivers.report' 'drivers' 'Driver report' 'Unverifiable' 'Error' 'A final driver report' 'The stage finished but its report is not final' 'drivers.json final vs Drivers\\result.json' 'reports\\drivers.json' 'Run "Deployment recovery" &gt; Resume.' | Out-Null }
        else {
            $report = $r.Data
            $hs = $(if ($report['health'] -is [hashtable]) { [string] $report['health']['status'] } else { '' })
            Add-WdhFinding $C 'drivers.report' 'drivers' 'Driver stage' $(if (-not $report['final']) { 'Pending' } else { 'Info' }) 'Informational' 'The driver stage finished' "$([string] $report['status']); health $hs (as the stage saw it; compared with the devices below)" 'reports\\drivers.json' 'reports\\drivers.json' -Required $false | Out-Null
        }
    } else {
        Add-WdhFinding $C 'drivers.stage' 'drivers' 'Driver stage' 'Info' 'Informational' 'Not part of this deployment' 'No driver was installed or changed by the deployment; the devices are still checked' 'health-config.json' 'health-config.json' -Required $false | Out-Null
    }
    if ($null -eq $devices) { Add-WdhFinding $C 'drivers.devices' 'drivers' 'Devices' 'Unverifiable' 'Error' 'Every device working' 'The device list could not be read' 'Win32_PnPEntity' 'Plug and Play' 'Run the check again as administrator.' | Out-Null; return }
    $byHw = @{}
    if ($report) { foreach ($d in @(ConvertTo-WdhList $report['devices'])) { foreach ($h in @(ConvertTo-WdhList $d['hardwareIds'])) { $byHw[([string] $h).ToUpperInvariant()] = $d } } }
    $problems = 0
    $basic = 0
    foreach ($dev in @($devices)) {
        $code = [int] $dev.problemCode
        $rep = $(if ($dev.hardwareId -and $byHw.ContainsKey($dev.hardwareId.ToUpperInvariant())) { $byHw[$dev.hardwareId.ToUpperInvariant()] } else { $null })
        $id = "drivers.device.$((Get-WddSha256 ([Text.Encoding]::UTF8.GetBytes("$($dev.hardwareId)|$($dev.name)"))).Substring(0, 12).ToLowerInvariant())"
        $isBasic = $dev.class -eq 'Display' -and ($dev.service -eq 'BasicDisplay' -or $dev.name -like 'Microsoft Basic Display*')
        if ($code -eq 0 -and $isBasic) {
            $basic++
            Add-WdhFinding $C $id 'drivers' $dev.name 'Warning' 'Warning' 'A vendor graphics driver' 'Working with the generic Microsoft Basic Display driver (functional but limited: resolution, acceleration, multiple monitors)' 'Plug and Play service and problem code' 'Win32_PnPEntity' $(if ($rep -and $rep['manualAction'] -is [hashtable]) { [string] $rep['manualAction']['text'] } else { 'Install the graphics driver from Windows Update or the manufacturer.' }) -Required $false | Out-Null
            continue
        }
        if ($code -eq 0) {
            if ($rep -and [string] $rep['state'] -in 'DriverMissing', 'Malfunctioning', 'HardwareIssue') { Add-WdhFinding $C $id 'drivers' $dev.name 'Pass' 'Error' 'Working driver' "Working now (the driver stage had reported $($rep['state']))" 'Plug and Play problem code now vs drivers.json' 'Win32_PnPEntity, reports\\drivers.json' | Out-Null }
            continue
        }
        if ($code -in 45, 47) { continue }
        $problems++
        $what = $(if ($script:WdhProblemCodes.ContainsKey($code)) { $script:WdhProblemCodes[$code] } else { 'problem' })
        $sev = Get-WdhDeviceSeverity $dev.class
        if ($code -eq 22) { Add-WdhFinding $C $id 'drivers' $dev.name 'Info' 'Informational' 'Working, or disabled on purpose' "Disabled (code 22). A disabled device is not treated as broken." 'Plug and Play problem code' 'Win32_PnPEntity' 'Enable it in Device Manager only if it should be in use.' -Required $false | Out-Null; continue }
        if ($code -eq 14 -or ($rep -and [string] $rep['state'] -eq 'RestartPending')) { Add-WdhFinding $C $id 'drivers' $dev.name 'Pending' $sev 'Working driver' "Waiting for a restart (code \${code}: $what)" 'Plug and Play problem code' 'Win32_PnPEntity' 'Restart the computer.' -AutomaticRecovery $true -TechnicianRequired $false | Out-Null; continue }
        $hw = ($rep -and [string] $rep['state'] -eq 'HardwareIssue') -or (-not $rep -and $code -in $script:WdhHardwareCodes -and $code -ne 10)
        $wasOk = $rep -and [string] $rep['state'] -in 'Healthy', 'BasicDriver'
        $obs = "$(if ($code -eq 28) { 'Missing driver' } elseif ($hw) { 'Possible hardware or firmware problem' } else { 'Not working' }) (code \${code}: $what)$(if ($wasOk) { '; it was working when the driver stage finished' })$(if ($rep -and [string] $rep['result'] -eq 'Succeeded') { '; a driver was installed for it, but the device still reports a problem' })"
        $next = $(if ($rep -and $rep['manualAction'] -is [hashtable] -and $rep['manualAction']['text']) { [string] $rep['manualAction']['text'] } elseif ($code -eq 28) { 'Install a driver: Windows Update, the manufacturer''s support page, or "Deployment recovery" &gt; Add driver packages.' } elseif ($hw) { 'Check the hardware (seating, cables, firmware settings) before replacing drivers.' } else { 'Open Device Manager for details; reinstall the driver or check the hardware.' })
        $C.Manual.Add([ordered]@{ id = $id; text = "$($dev.name): $next"; url = $(if ($rep -and $rep['manualAction'] -is [hashtable]) { [string] $rep['manualAction']['url'] } else { '' }) })
        Add-WdhFinding $C $id 'drivers' $dev.name 'Fail' $sev 'Working driver' $obs 'Plug and Play problem code (Win32_PnPEntity.ConfigManagerErrorCode), compared with drivers.json' 'Win32_PnPEntity, reports\\drivers.json' $next -RecoveryAction $(if ($code -eq 28) { 'AddDrivers' } else { '' }) | Out-Null
    }
    if (-not $problems -and -not $basic) { Add-WdhFinding $C 'drivers.devices' 'drivers' 'Devices' 'Pass' 'Error' 'Every device working' "$(@($devices).Count) device(s), none reports a problem" 'Plug and Play problem codes (Win32_PnPEntity)' 'Win32_PnPEntity' | Out-Null }
    elseif (-not $problems) { Add-WdhFinding $C 'drivers.devices' 'drivers' 'Devices' 'Pass' 'Error' 'Every device working' "$(@($devices).Count) device(s), none reports a problem ($basic with a generic driver)" 'Plug and Play problem codes' 'Win32_PnPEntity' | Out-Null }
    if ($report) {
        foreach ($m in @(ConvertTo-WdhList $report['manualActions'])) {
            $C.Manual.Add([ordered]@{ id = "drivers.manual.$($m['operationId'])"; text = [string] $m['text']; url = [string] $m['url'] })
        }
        foreach ($o in @(ConvertTo-WdhList $report['operations']) | Where-Object { $_ -and [string] $_['status'] -eq 'WaitingForReboot' }) {
            Add-WdhFinding $C "drivers.restart.$($o['operationId'] -replace '[^A-Za-z0-9_:+\\-]', '-')" 'drivers' "$($o['device']): restart needed" 'Pending' 'Warning' 'Driver active' 'The new driver starts after a restart' 'drivers.json operations[]' 'reports\\drivers.json' 'Restart the computer.' -AutomaticRecovery $true -TechnicianRequired $false | Out-Null
        }
        $tools = @(@(ConvertTo-WdhList $report['optionalApplications']) | ForEach-Object { [string] $_['name'] } | Where-Object { $_ })
        if ($tools.Count) { Add-WdhFinding $C 'drivers.vendorReview' 'drivers' 'Vendor driver review' 'Info' 'Informational' 'Optional' "Vendor driver review recommended: $($tools -join ', '). These tools have not scanned this computer; the deployment never runs them." 'drivers.json optionalApplications' 'reports\\drivers.json' 'Optionally run the vendor tool with the customer. A working driver does not need replacing.' -Required $false | Out-Null }
    }
}

# ------------------------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------------------------

function Test-WdhSecurity {
    param($C)
    $sec = $C.Config['security']
    $def = Invoke-WdhProbe $C 'defender' { Get-WdhDefender }
    $sc = Invoke-WdhProbe $C 'securityCenter' { Get-WdhSecurityCenter }
    $third = @(); $thirdFw = @()
    if ($sc) { $third = @(@($sc.antivirus) | Where-Object { $_.enabled -and $_.name -notmatch 'Windows Defender|Microsoft Defender' }); $thirdFw = @(@($sc.firewall) | Where-Object { $_.enabled }) }
    $defOn = $def -and $def.amServiceEnabled -and $def.antivirusEnabled -and $def.realTimeProtectionEnabled
    if ($defOn) { Add-WdhFinding $C 'security.antivirus' 'security' 'Antivirus' 'Pass' 'Critical' 'Real-time protection on' "Microsoft Defender Antivirus, real-time protection on (signatures $($def.signatureAgeDays) day(s) old)" 'Get-MpComputerStatus, Windows Security Center' 'Defender, SecurityCenter2' $(if ($def.signatureAgeDays -gt 7) { 'Update the security intelligence (Windows Security &gt; Virus &amp; threat protection).' } else { '' }) | Out-Null }
    elseif ($third.Count) { Add-WdhFinding $C 'security.antivirus' 'security' 'Antivirus' 'Pass' 'Critical' 'Real-time protection on' "Protected by $(($third | ForEach-Object { $_.name }) -join ', ') (registered with Windows Security; Defender hands over to it)" 'Windows Security Center (SecurityCenter2) product state' 'SecurityCenter2' | Out-Null }
    elseif (-not $def -and -not $sc) { Add-WdhFinding $C 'security.antivirus' 'security' 'Antivirus' 'Unverifiable' 'Critical' 'Real-time protection on' 'Neither Defender nor Windows Security Center could be read' 'Get-MpComputerStatus, SecurityCenter2' 'Defender, SecurityCenter2' 'Run the check again as administrator; open Windows Security to confirm.' | Out-Null }
    else { Add-WdhFinding $C 'security.antivirus' 'security' 'Antivirus' 'Fail' 'Critical' 'Real-time protection on' "No active antivirus: $(if ($def) { "Defender service $($def.amServiceEnabled), antivirus $($def.antivirusEnabled), real-time $($def.realTimeProtectionEnabled)" } else { 'Defender unavailable' }), and no other product is registered" 'Get-MpComputerStatus, Windows Security Center' 'Defender, SecurityCenter2' 'Turn real-time protection on in Windows Security (nothing was changed by this check). Do not deliver an unprotected computer.' | Out-Null }
    $fw = Invoke-WdhProbe $C 'firewall' { Get-WdhFirewall }
    if ($null -eq $fw) { Add-WdhFinding $C 'security.firewall' 'security' 'Firewall' 'Unverifiable' 'Critical' 'On for every profile' 'Could not be read' 'Get-NetFirewallProfile' 'Firewall' | Out-Null }
    else {
        $off = @(@($fw) | Where-Object { -not $_.enabled } | ForEach-Object { $_.name })
        if (-not $off.Count) { Add-WdhFinding $C 'security.firewall' 'security' 'Firewall' 'Pass' 'Critical' 'On for every profile' "On: $((@($fw) | ForEach-Object { $_.name }) -join ', ')" 'Get-NetFirewallProfile' 'Firewall' | Out-Null }
        elseif ($thirdFw.Count) { Add-WdhFinding $C 'security.firewall' 'security' 'Firewall' 'Pass' 'Critical' 'On for every profile' "Windows Firewall off for $($off -join ', '); $(($thirdFw | ForEach-Object { $_.name }) -join ', ') is registered and on" 'Get-NetFirewallProfile, SecurityCenter2' 'Firewall' | Out-Null }
        elseif ($off.Count -eq @($fw).Count) { Add-WdhFinding $C 'security.firewall' 'security' 'Firewall' 'Fail' 'Critical' 'On for every profile' 'Off for every profile' 'Get-NetFirewallProfile' 'Firewall' 'Turn the firewall on (Windows Security &gt; Firewall &amp; network protection); nothing was changed by this check.' | Out-Null }
        else { Add-WdhFinding $C 'security.firewall' 'security' 'Firewall' 'Fail' 'Error' 'On for every profile' "Off for $($off -join ', ')" 'Get-NetFirewallProfile' 'Firewall' 'Turn the firewall on for every profile.' | Out-Null }
    }
    $uac = Invoke-WdhProbe $C 'uac' { Get-WdhUac }
    $want = $sec['uac']
    if ($uac) {
        $lua = $(if ($null -eq $uac.enableLua) { 1 } else { [int] $uac.enableLua })
        if ([int] $want['enableLua'] -eq 0) { Add-WdhFinding $C 'security.uac' 'security' 'User Account Control' $(if ($lua -eq 0) { 'Warning' } else { 'Info' }) 'Warning' 'Off (configured)' $(if ($lua -eq 0) { 'Off, as configured: every program runs with full rights' } else { 'On' }) 'Policies\\System EnableLUA' 'Registry' 'UAC is off by configuration; consider turning it on before delivery.' -Required $false | Out-Null }
        elseif ($lua -eq 0) { Add-WdhFinding $C 'security.uac' 'security' 'User Account Control' 'Fail' 'Error' 'On' 'Off (EnableLUA = 0)' 'Policies\\System EnableLUA' 'Registry' 'UAC was turned off although the configuration keeps it on; turn it on (restart needed).' | Out-Null }
        else {
            $cp = $want['consentPromptBehaviorAdmin']; $sd = $want['promptOnSecureDesktop']
            $mism = ($null -ne $cp -and $null -ne $uac.consentPromptBehaviorAdmin -and [int] $uac.consentPromptBehaviorAdmin -ne [int] $cp) -or ($null -ne $sd -and $null -ne $uac.promptOnSecureDesktop -and [int] $uac.promptOnSecureDesktop -ne [int] $sd)
            Add-WdhFinding $C 'security.uac' 'security' 'User Account Control' $(if ($mism) { 'Warning' } else { 'Pass' }) 'Error' "On ($($want['level']))" "On (ConsentPromptBehaviorAdmin $($uac.consentPromptBehaviorAdmin), PromptOnSecureDesktop $($uac.promptOnSecureDesktop))" 'Policies\\System EnableLUA, ConsentPromptBehaviorAdmin, PromptOnSecureDesktop' 'Registry' $(if ($mism) { 'The prompt level differs from the configuration (an organization policy or a later change).' } else { '' }) | Out-Null
        }
    } else { Add-WdhFinding $C 'security.uac' 'security' 'User Account Control' 'Unverifiable' 'Error' 'On' 'Could not be read' 'Policies\\System' 'Registry' | Out-Null }
    $ss = Invoke-WdhProbe $C 'smartScreen' { Get-WdhSmartScreen }
    if ($ss) {
        $offBy = @()
        if ($ss.explorer -ieq 'Off') { $offBy += 'Explorer SmartScreenEnabled = Off' }
        if ($null -ne $ss.policy -and [int] $ss.policy -eq 0) { $offBy += 'policy EnableSmartScreen = 0' }
        if ($sec['smartScreenExpected']) { Add-WdhFinding $C 'security.smartScreen' 'security' 'SmartScreen' $(if ($offBy.Count) { 'Warning' } else { 'Pass' }) 'Warning' 'On (reputation-based protection)' $(if ($offBy.Count) { "Turned off: $($offBy -join '; ')" } else { 'Not turned off by setting or policy' }) 'Explorer SmartScreenEnabled and the EnableSmartScreen policy (Windows Security shows the full state)' 'Registry' $(if ($offBy.Count) { 'Turn SmartScreen on in Windows Security &gt; App &amp; browser control.' } else { '' }) -Required $false | Out-Null }
        else { Add-WdhFinding $C 'security.smartScreen' 'security' 'SmartScreen' 'Info' 'Informational' 'Off (configured)' $(if ($offBy.Count) { "Off: $($offBy -join '; ')" } else { 'Not turned off' }) 'Explorer SmartScreenEnabled, EnableSmartScreen policy' 'Registry' -Required $false | Out-Null }
    }
    $enc = Invoke-WdhProbe $C 'encryption' { Get-WdhEncryption }
    if (-not $enc) { Add-WdhFinding $C 'security.encryption' 'security' 'Encryption' 'Info' 'Informational' 'Reported' 'The encryption state could not be read (BitLocker is not available on every edition)' 'Get-BitLockerVolume' 'BitLocker' -Required $false | Out-Null }
    else {
        $protected = $enc.protectionStatus -eq 'On'
        $obs = "$($enc.volumeStatus), protection $($enc.protectionStatus)$(if ($enc.volumeStatus -eq 'EncryptionInProgress') { " ($([int] $enc.percentage) %)" })"
        Add-WdhFinding $C 'security.encryption' 'security' 'Encryption of the system drive' 'Info' 'Informational' $(if ($sec['deviceEncryptionPrevented']) { 'Not encrypted automatically (configured)' } else { 'Reported (never turned on by the deployment)' }) $obs 'Get-BitLockerVolume (protector types only; keys are never read)' 'BitLocker' -Required $false | Out-Null
        if ($protected -or $enc.volumeStatus -in 'FullyEncrypted', 'EncryptionInProgress') {
            $hasRecovery = @($enc.protectors) -contains 'RecoveryPassword'
            Add-WdhFinding $C 'security.recoveryKey' 'security' 'Recovery key backup' 'Warning' 'Warning' 'The customer can retrieve the recovery key' "$(if ($hasRecovery) { 'A recovery password protector exists' } else { 'No recovery password protector' }); where it is backed up cannot be verified from this computer" 'BitLocker key protector types' 'BitLocker' 'Confirm with the customer where the recovery key is kept (for example their Microsoft account at https://aka.ms/myrecoverykey). The key is not in this report.' -Required $false | Out-Null
        }
    }
}

# ------------------------------------------------------------------------------------------------
# Network
# ------------------------------------------------------------------------------------------------

function Test-WdhNetwork {
    param($C)
    $mode = [string] $C.Config['network']['requirement']
    $need = @()
    foreach ($s in @($C.Snapshot.stages)) { if ($s.state -ne 'Final' -and $s.id -in 'windowsUpdate', 'applications') { $need += $s.name } }
    foreach ($a in $C.Apps) { if ($a.lifecycle -in 'WaitingForNetwork', 'FailedRetryable') { $need += $a.name } }
    if ($C.ScanUpdates) { $need += 'the Windows Update scan' }
    $required = $(if ($mode -eq 'required') { $true } elseif ($mode -eq 'notRequired') { $false } else { $need.Count -gt 0 })
    $why = $(if ($mode -eq 'required') { 'required by the configuration' } elseif ($need.Count) { "needed by $(@($need | Select-Object -Unique) -join ', ')" } else { 'not needed: nothing outstanding uses the network' })
    $netFlag = Get-WddNetworkDriverFlag $C.Paths
    $net = Invoke-WdhProbe $C 'network' { Get-WdhNetwork }
    $sevNeed = $(if ($required) { 'Error' } else { 'Warning' })
    if ($netFlag) { Add-WdhFinding $C 'network.driver' 'network' 'Network adapter driver' 'Fail' $sevNeed 'A network adapter with a working driver' $netFlag 'Driver stage flag (state\\network-driver-missing.json) and the adapter list' 'state\\network-driver-missing.json' 'The network will not appear by itself: supply the adapter''s driver ("Deployment recovery" &gt; Add driver packages, from a USB stick).' -RecoveryAction 'AddDrivers' -Required $required | Out-Null }
    if (-not $net) { Add-WdhFinding $C 'network.adapter' 'network' 'Network adapters' 'Unverifiable' $sevNeed 'A connected adapter' 'Could not be read' 'Get-NetAdapter' 'Network' -Required $required | Out-Null; return }
    $up = @(@($net.adapters) | Where-Object { $_.status -eq 'Up' })
    if (-not @($net.adapters).Count) { Add-WdhFinding $C 'network.adapter' 'network' 'Network adapters' $(if ($required) { 'Fail' } else { 'Warning' }) $sevNeed 'A physical network adapter' 'None is visible to Windows (often a missing driver)' 'Get-NetAdapter -Physical' 'Network' 'Check Hardware and drivers; install the network driver.' -Required $required -RecoveryAction 'AddDrivers' | Out-Null; return }
    if (-not $up.Count) { Add-WdhFinding $C 'network.adapter' 'network' 'Network connection' $(if ($required) { 'Fail' } else { 'Info' }) $sevNeed "Connected ($why)" "$(@($net.adapters).Count) adapter(s), none connected" 'Get-NetAdapter -Physical' 'Network' $(if ($required) { 'Connect a cable or Wi-Fi; the deployment continues once online.' } else { 'Not a problem for this computer now.' }) -Required $required | Out-Null; return }
    Add-WdhFinding $C 'network.adapter' 'network' 'Network connection' 'Pass' $sevNeed "Connected ($why)" "$($up.Count) adapter(s) connected$(if (@($up | Where-Object { $_.wireless }).Count) { ' (Wi-Fi)' })" 'Get-NetAdapter -Physical' 'Network' -Required $required | Out-Null
    $dns = Test-WdhDns 'www.msftconnecttest.com'
    $inet = $(if ($dns) { Test-WdhInternet } else { $false })
    $obs = $(if (-not $net.gateway) { 'No default gateway (local network only)' } elseif (-not $dns) { 'DNS does not resolve names' } elseif (-not $inet) { 'Names resolve, but the Windows connectivity test failed (proxy, captive portal or no Internet)' } else { 'Reachable (DNS and the Windows connectivity test)' })
    $ok = $net.gateway -and $dns -and $inet
    Add-WdhFinding $C 'network.internet' 'network' 'Internet' $(if ($ok) { 'Pass' } elseif ($required) { 'Fail' } else { 'Info' }) $sevNeed "Reachable ($why)" $obs 'Default gateway, DNS lookup, the Windows connectivity test (msftconnecttest.com); never a single ping' 'Network' $(if ($ok -or -not $required) { '' } else { 'Fix the connection; outstanding work continues once online.' }) -Required $required | Out-Null
    if ($ok -and @($C.Apps | Where-Object { $_.lifecycle -in 'WaitingForNetwork', 'FailedRetryable' -and $_.source -in 'winget', 'msstore' }).Count) {
        $src = Test-WdhTcp 'cdn.winget.microsoft.com' 443
        Add-WdhFinding $C 'network.packageSource' 'network' 'WinGet package source' $(if ($src) { 'Pass' } else { 'Fail' }) 'Error' 'Reachable for the outstanding applications' $(if ($src) { 'cdn.winget.microsoft.com:443 reachable' } else { 'cdn.winget.microsoft.com:443 not reachable (Internet works: the source or a filter blocks it)' }) 'TCP 443 to the source host' 'Network' $(if ($src) { '' } else { 'Check firewalls or filters for the WinGet source.' }) | Out-Null
    }
}

# ------------------------------------------------------------------------------------------------
# Storage (non-destructive observations only)
# ------------------------------------------------------------------------------------------------

function Test-WdhStorage {
    param($C)
    $v = Invoke-WdhProbe $C 'volume' { Get-WdhVolume }
    if (-not $v) { Add-WdhFinding $C 'storage.systemVolume' 'storage' 'System drive' 'Unverifiable' 'Error' 'Accessible and healthy' 'Could not be read' 'Get-Volume' 'Storage' | Out-Null }
    else {
        $healthy = $v.health -in 'Healthy', '' -and $v.operational -in 'OK', ''
        Add-WdhFinding $C 'storage.systemVolume' 'storage' "System drive ($env:SystemDrive)" $(if ($healthy) { 'Pass' } else { 'Fail' }) 'Error' 'Accessible, NTFS, healthy' "$($v.fileSystem), health $($v.health), $($v.operational)" 'Get-Volume (what Windows reports; not a physical drive test)' 'Storage' $(if ($healthy) { '' } else { 'Back up important data and check the drive; this check repairs nothing.' }) | Out-Null
        if ($v.size -gt 0) {
            $pct = [Math]::Round(100 * $v.free / $v.size)
            $st = $(if ($v.free -lt 3GB) { 'Fail' } elseif ($v.free -lt 10GB -or $pct -lt 10) { 'Warning' } else { 'Pass' })
            Add-WdhFinding $C 'storage.freeSpace' 'storage' "Free space on $env:SystemDrive" $st $(if ($st -eq 'Fail') { 'Error' } else { 'Warning' }) 'At least 10 GB and 10 %' "$(Format-WdhBytes $v.free) free of $(Format-WdhBytes $v.size) ($pct %)" 'Get-Volume' 'Storage' $(if ($st -eq 'Pass') { '' } else { 'Free up space; Windows Update needs room to install updates.' }) -Required ($st -eq 'Fail') | Out-Null
        }
        if ($null -ne $v.dirty) { Add-WdhFinding $C 'storage.dirtyBit' 'storage' 'File system state' $(if ($v.dirty) { 'Warning' } else { 'Pass' }) 'Warning' 'No check pending' $(if ($v.dirty) { 'Marked dirty: Windows will check the file system at the next start' } else { 'Not marked dirty' }) 'fsutil dirty query (read-only)' 'Storage' $(if ($v.dirty) { 'Restart and let Windows check the drive. Nothing was repaired by this check.' } else { '' }) -Required $false | Out-Null }
    }
    if ($C.Config['options']['storageObservations']) {
        $disks = Invoke-WdhProbe $C 'physicalDisks' { Get-WdhPhysicalDisks }
        if ($null -eq $disks) { $C.Limitations.Add('Physical disk health is not available on this computer.') }
        foreach ($d in @(ConvertTo-WdhList $disks)) {
            $rel = $d.reliability
            $relText = $(if ($rel) { "; wear $($rel.wear) %, temperature $($rel.temperature) C, uncorrected read errors $($rel.readErrorsUncorrected)" } else { '' })
            $bad = $d.health -notin 'Healthy', ''
            Add-WdhFinding $C "storage.disk.$((Get-WddSha256 ([Text.Encoding]::UTF8.GetBytes([string] $d.name))).Substring(0, 12).ToLowerInvariant())" 'storage' "Drive: $($d.name)" $(if ($bad) { 'Warning' } else { 'Info' }) 'Warning' 'Healthy' "$($d.media) $($d.bus), health $($d.health), $($d.operational)$relText" 'Get-PhysicalDisk, Get-StorageReliabilityCounter (as reported by the drive; not a full diagnosis or surface scan)' 'Storage' $(if ($bad) { 'Possible physical drive problem: back up data and run the manufacturer''s diagnostics.' } else { '' }) -Required $false | Out-Null
        }
    }
    $sd = @(@(ConvertTo-WdhList $C.Obs['devices']) | Where-Object { $_.class -in 'SCSIAdapter', 'HDC', 'DiskDrive' -and $_.problemCode -notin 0, 22, 45, 47 })
    foreach ($x in $sd) { $C.Limitations.Add("Storage device $($x.name) reports problem code $($x.problemCode) (see Hardware and drivers).") }
}

# ------------------------------------------------------------------------------------------------
# Windows settings from earlier phases (verification adapters; Phase 8.5 will register more)
# ------------------------------------------------------------------------------------------------

function Test-WdhCustomizations {
    param($C)
    $list = @(ConvertTo-WdhList $C.Config['customizations'])
    if (-not $list.Count) { Add-WdhFinding $C 'custom.none' 'customizations' 'Windows settings' 'NotApplicable' 'Informational' 'No verifiable setting is configured' 'Nothing to check' 'health-config.json' 'health-config.json' -Required $false | Out-Null; return }
    foreach ($a in $list) {
        $reg = $a['registry']
        $exp = [string] $reg['expected']
        if ([string] $a['scope'] -eq 'user') {
            if (-not $C.HiveLoaded) { $obs = "Not checked: $($C.DeploymentUser) is not signed in"; $res = 'Deferred' }
            else { $val = Get-WdhRegValue 'HKU' ([string] $reg['path']) ([string] $reg['name']) $C.DeploymentSid; $obs = $(if ($null -eq $val) { 'Not set (Windows default)' } else { [string] $val }); $res = $(if ("$val" -eq $exp) { 'Pass' } else { 'Warning' }) }
        } else { $val = Get-WdhRegValue 'HKLM' ([string] $reg['path']) ([string] $reg['name']); $obs = $(if ($null -eq $val) { 'Not set (Windows default)' } else { [string] $val }); $res = $(if ("$val" -eq $exp) { 'Pass' } else { 'Warning' }) }
        $where = "$(if ([string] $a['scope'] -eq 'user') { "HKU\\&lt;$($C.DeploymentUser)&gt;" } else { 'HKLM' })\\$($reg['path'])\\$($reg['name'])"
        Add-WdhFinding $C "custom.$($a['id'])" 'customizations' ([string] $a['label']) $res 'Warning' "$($reg['name']) = $exp" $obs "Registry $where$(if ([string] $a['effect'] -ne 'immediate') { " (takes effect after $(if ([string] $a['effect'] -eq 'signIn') { 'the next sign-in' } else { 'a restart' }))" })" 'Registry' $(if ($res -eq 'Warning') { "Set it again if still wanted: $($a['reversible'])." } elseif ($res -eq 'Deferred') { "Sign in as $($C.DeploymentUser) and verify again." } else { '' }) -Required $false | Out-Null
        $C.Custom.Add([ordered]@{ id = [string] $a['id']; label = [string] $a['label']; scope = [string] $a['scope']; expected = $exp; observed = $obs; result = $res; effect = [string] $a['effect']; reversible = [string] $a['reversible'] })
    }
}

# ------------------------------------------------------------------------------------------------
# Evaluation: finding -&gt; category -&gt; overall (deterministic; documented in health-states.md)
# ------------------------------------------------------------------------------------------------

&lt;# What one finding means for its category. #&gt;
function Get-WdhEffective {
    param($F)
    switch ([string] $F.status) {
        'Fail' { if ($F.severity -eq 'Critical') { return 'Failed' } elseif ($F.severity -eq 'Error') { return 'NeedsAttention' } else { return 'Warning' } }
        'Warning' { return 'Warning' }
        'Pending' { return 'Incomplete' }
        'Unverifiable' { if ($F.required) { return 'Unverifiable' } return 'Warning' }
        'Deferred' { if ($F.required) { return 'Unverifiable' } return 'Warning' }
        default { return 'Verified' }
    }
}

function Get-WdhCategories {
    param($C)
    $out = @()
    foreach ($id in $script:WdhCategoryNames.Keys) {
        $fs = @($C.Findings | Where-Object { $_.category -eq $id })
        $counted = @($fs | Where-Object { $_.status -ne 'NotApplicable' })
        if (-not $counted.Count) {
            $out += , [ordered]@{ id = $id; name = $script:WdhCategoryNames[$id]; status = 'NotApplicable'; summary = $(if ($fs.Count) { [string] $fs[0].observed } else { 'Not checked' }); findings = $fs.Count }
            continue
        }
        $worst = 'Verified'
        foreach ($f in $counted) { $e = Get-WdhEffective $f; if ($script:WdhCategoryRank[$e] -gt $script:WdhCategoryRank[$worst]) { $worst = $e } }
        $bad = @($counted | Where-Object { (Get-WdhEffective $_) -ne 'Verified' })
        $passed = @($counted | Where-Object { $_.status -eq 'Pass' }).Count
        $summary = $(if ($bad.Count) { "$($bad.Count) of $($counted.Count) check(s) need attention: $((@($bad | Select-Object -First 3) | ForEach-Object { $_.title }) -join ', ')$(if ($bad.Count -gt 3) { ', ...' })" } else { "$passed of $($counted.Count) check(s) verified" })
        $out += , [ordered]@{ id = $id; name = $script:WdhCategoryNames[$id]; status = $worst; summary = $summary; findings = $fs.Count }
    }
    return $out
}

&lt;#
    Overall state, first match wins:
      Failed        a critical check failed (wrong edition, no antivirus, firewall off, package modified, stage failed)
      Unverifiable  required evidence is missing, damaged, inconsistent or inaccessible (deferred user context)
      Incomplete    work still in progress or waiting for a restart / the network / the user
      NeedsAttention a required objective failed verification
      ReadyWithWarnings  required objectives verified; optional failures or follow-ups remain
      Ready         every required objective verified, nothing outstanding
#&gt;
function Get-WdhOverall {
    param([object[]] $Findings)
    $eff = @($Findings | ForEach-Object { Get-WdhEffective $_ })
    foreach ($s in 'Failed', 'Unverifiable', 'Incomplete', 'NeedsAttention') { if ($eff -contains $s) { return $s } }
    if ($eff -contains 'Warning') { return 'ReadyWithWarnings' }
    return 'Ready'
}

function Get-WdhOverallText {
    param([string] $Status, [object[]] $Findings)
    $n = @($Findings | Where-Object { (Get-WdhEffective $_) -ne 'Verified' }).Count
    $first = @($Findings | Where-Object { (Get-WdhEffective $_) -eq $(switch ($Status) { 'Failed' { 'Failed' } 'Unverifiable' { 'Unverifiable' } 'Incomplete' { 'Incomplete' } 'NeedsAttention' { 'NeedsAttention' } default { 'Warning' } }) } | Select-Object -First 3 | ForEach-Object { $_.title })
    switch ($Status) {
        'Ready' { @('Ready for delivery', 'Every required objective was verified on this computer and nothing is outstanding.') }
        'ReadyWithWarnings' { @('Ready with warnings', "Every required objective was verified. $n item(s) need a technician or the customer: $($first -join ', ').") }
        'NeedsAttention' { @('Needs attention', "At least one required objective is not met: $($first -join ', '). $n item(s) in total.") }
        'Incomplete' { @('Still completing', "The deployment is still working or waiting (restart, network or user): $($first -join ', '). Verify again afterwards.") }
        'Unverifiable' { @('Cannot be verified', "Required evidence is missing, damaged or not accessible: $($first -join ', '). This is not a success.") }
        'Failed' { @('Failed', "A critical check failed: $($first -join ', '). Do not deliver this computer.") }
    }
}

# ------------------------------------------------------------------------------------------------
# Checklist, customer handoff, recovery actions
# ------------------------------------------------------------------------------------------------

function Get-WdhChecklist {
    param($C)
    $fs = $C.Findings.ToArray()
    $item = {
        param([string] $Id, [string] $Label, [string[]] $Patterns, [string] $Note = '')
        $m = @($fs | Where-Object { $f = $_; @($Patterns | Where-Object { $f.id -like $_ }).Count })
        $counted = @($m | Where-Object { $_.status -ne 'NotApplicable' })
        $state = $(if (-not $counted.Count) { 'notApplicable' }
                    elseif (@($counted | Where-Object { $_.status -in 'Fail', 'Unverifiable' -or ($_.status -eq 'Deferred') }).Count) { 'notDone' }
                    elseif (@($counted | Where-Object { $_.status -eq 'Pending' }).Count) { 'pending' }
                    elseif (@($counted | Where-Object { $_.status -eq 'Warning' -and $_.required }).Count) { 'notDone' }
                    else { 'done' })
        $notes = @($counted | Where-Object { $_.status -notin 'Pass', 'Info' } | Select-Object -First 3 | ForEach-Object { "$($_.title): $($_.observed)" })
        [ordered]@{ id = $Id; label = $Label; state = $state; note = $(if ($Note) { $Note } else { $notes -join ' | ' }); findingIds = @($m | ForEach-Object { $_.id }) }
    }
    $list = @(
        (&amp; $item 'windows' "Windows installed ($(if ($C.Config['windows']['editionName']) { $C.Config['windows']['editionName'] } else { 'edition chosen during setup' }))" @('windows.edition', 'windows.version', 'windows.setup', 'windows.architecture', 'windows.productType'))
        (&amp; $item 'account' 'Expected account present, with the intended rights' @('account.*'))
        (&amp; $item 'computerName' 'Computer name correct' @('identity.computerName'))
    )
    $act = &amp; $item 'activation' 'Windows activated, or activation pending clearly identified' @('windows.activation')
    $actF = @($fs | Where-Object { $_.id -eq 'windows.activation' }) | Select-Object -First 1
    if ($actF -and $actF.status -ne 'Pass') { $act.state = 'pending'; $act.note = [string] $actF.observed }
    $list += $act
    $list += &amp; $item 'updates' 'Windows Update completed as required' @('updates.*')
    $list += &amp; $item 'drivers' 'Hardware drivers healthy' @('drivers.*')
    $list += &amp; $item 'apps' 'Selected applications verified' @('app.*', 'apps.*')
    $list += &amp; $item 'restoration' 'Settings restoration completed' @('restore.*')
    $list += &amp; $item 'security' 'Security protections checked' @('security.antivirus', 'security.firewall', 'security.uac', 'security.smartScreen')
    $list += &amp; $item 'network' 'Network functional where required' @('network.*')
    $list += &amp; $item 'restart' 'No required restart pending' @('windows.restart', 'drivers.restart.*')
    $list += [ordered]@{ id = 'recoveryInfo'; label = 'Backup and recovery information available to the customer'; state = 'confirm'; note = $(if (@($fs | Where-Object { $_.id -eq 'security.recoveryKey' }).Count) { 'The system drive is encrypted: confirm where the recovery key is kept.' } else { 'Confirm by hand.' }); findingIds = @(@($fs | Where-Object { $_.id -eq 'security.recoveryKey' } | ForEach-Object { $_.id })) }
    $signIn = @(@(ConvertTo-WdhList $C.Config['applications']['items']) | Where-Object { $_['signIn'] } | ForEach-Object { [string] $_['name'] })
    $list += [ordered]@{ id = 'customerSignIn'; label = 'Customer sign-in tasks documented'; state = 'confirm'; note = $(if ($signIn.Count) { "Applications that need the customer's account: $($signIn -join ', ')." } else { 'Confirm by hand (accounts, e-mail, cloud storage).' }); findingIds = @() }
    return $list
}

function Get-WdhCustomerHandoff {
    param($C, [string] $Status, $Os)
    $ok = $Status -in 'Ready', 'ReadyWithWarnings'
    $headline = switch ($Status) {
        'Ready' { 'Your computer is set up and ready to use.' }
        'ReadyWithWarnings' { 'Your computer is ready to use. A few items need your attention.' }
        default { 'Setup is not finished yet. Your technician needs to complete the items below before this computer is ready.' }
    }
    $installed = @($C.Apps | Where-Object { $_.kind -ne 'manual' -and ($_.independent -eq 'Found' -or $_.result -in 'InstalledVerificationUncertain', 'WaitingForUserContext') } | ForEach-Object { $_.name })
    $manual = @($C.Apps | Where-Object { $_.kind -eq 'manual' -and $_.result -eq 'ManualInstallationRequired' } | ForEach-Object { $a = $_; $it = @(@(ConvertTo-WdhList $C.Config['applications']['items']) | Where-Object { ([string] $_['key']).ToLowerInvariant() -eq $a.key }) | Select-Object -First 1; [ordered]@{ name = $a.name; how = $(if ($it -and $it['instructions']) { [string] $it['instructions'] } else { 'Ask your technician.' }) } })
    $notYet = @($C.Apps | Where-Object { $_.kind -ne 'manual' -and $_.independent -ne 'Found' -and $_.result -notin 'InstalledVerificationUncertain', 'WaitingForUserContext', 'SkippedByUser' } | ForEach-Object { $_.name })
    $f = @{}; foreach ($x in $C.Findings) { $f[$x.id] = $x }
    $state = { param([string] $Id, [string] $On, [string] $Off) if (-not $f.ContainsKey($Id)) { 'Not checked' } elseif ($f[$Id].status -eq 'Pass') { $On } elseif ($f[$Id].status -in 'Unverifiable', 'Deferred') { 'Could not be checked' } else { $Off } }
    $security = @(
        [ordered]@{ label = 'Virus protection'; state = (&amp; $state 'security.antivirus' 'On' 'Off - ask your technician') }
        [ordered]@{ label = 'Firewall'; state = (&amp; $state 'security.firewall' 'On' 'Off - ask your technician') }
    )
    if ($f.ContainsKey('security.encryption')) { $security += [ordered]@{ label = 'Device encryption'; state = $(if ($f.ContainsKey('security.recoveryKey')) { "On $([char] 0x2014) keep your recovery key safe" } else { 'Off' }) } }
    $updates = $(if (-not $f.ContainsKey('updates.stage') -or $f['updates.stage'].status -eq 'NotApplicable') { 'Windows installs updates automatically.' } elseif ($f['updates.stage'].status -eq 'Pass') { 'Windows was updated during setup.' } elseif ($f['updates.stage'].status -eq 'Pending') { 'Updates are still being installed.' } else { 'Some updates still need to be installed (your technician will finish this).' })
    $actions = @()
    if ($f.ContainsKey('windows.activation') -and $f['windows.activation'].status -ne 'Pass') { $actions += 'Activate Windows (Settings &gt; System &gt; Activation).' }
    if ((@($C.Findings | Where-Object { $_.status -eq 'Pending' -and $_.id -in 'windows.restart', 'identity.computerName' })).Count) { $actions += 'Restart the computer once.' }
    foreach ($m in $manual) { $actions += "Install $($m.name): $($m.how)" }
    foreach ($a in @(@(ConvertTo-WdhList $C.Config['applications']['items']) | Where-Object { $_['signIn'] })) { $actions += "Sign in to $($a['name']) with your account." }
    if ($f.ContainsKey('security.recoveryKey')) { $actions += 'Keep your BitLocker recovery key safe (for example in your Microsoft account).' }
    $account = $(if ($C.Config['account']['mode'] -eq 'unattendedLocal') { [string] $C.Config['account']['username'] } else { '' })
    [ordered]@{
        format = 'windows-deployment-builder/customer-handoff'; schemaVersion = 1; generatedUtc = (Get-WdhTime).ToString('o')
        computerName = [string] $Os.computerName; windows = $(if ($Os.caption) { ([string] $Os.caption) -replace '^Microsoft\\s+', '' } else { 'Windows' })
        status = $Status; headline = $headline
        statusText = $(if ($ok) { 'Windows, updates, drivers, applications and security protection were checked on this computer.' } else { 'Some checks did not pass yet, so this summary does not say that everything is working.' })
        account = $account
        applications = [ordered]@{ installed = @($installed); toDoYourself = @($manual); notYet = @($notYet) }
        security = $security; updates = $updates; actions = @($actions | Select-Object -Unique); notes = [string] $C.Config['customerNotes']
    }
}

function Get-WdhRecoveryActions {
    param($C)
    $tool = Join-Path $C.Paths.Package 'scripts\\recovery\\DeploymentRecovery.ps1'
    $me = Join-Path $C.Paths.Package 'scripts\\health\\DeploymentHealth.ps1'
    $has = Test-Path -LiteralPath $tool
    $ps = 'powershell.exe -ExecutionPolicy Bypass -File'
    $a = @([ordered]@{ id = 'verify'; label = 'Verify again'; command = "$ps \`"$me\`""; sideEffects = $false }
           [ordered]@{ id = 'scanUpdates'; label = 'Recheck Windows Update (live scan)'; command = "$ps \`"$me\`" -ScanUpdates"; sideEffects = $false })
    if ($has) {
        $a += [ordered]@{ id = 'recovery'; label = 'Open Deployment recovery'; command = "$ps \`"$tool\`""; sideEffects = $false }
        $a += [ordered]@{ id = 'RetryFailed'; label = 'Retry failed operations'; command = "$ps \`"$tool\`" -Action RetryFailed"; sideEffects = $true }
        $a += [ordered]@{ id = 'Resume'; label = 'Resume provisioning'; command = "$ps \`"$tool\`" -Action Resume"; sideEffects = $true }
        if ($C.Config['restoration']['required']) { $a += [ordered]@{ id = 'RestoreSettings'; label = 'Retry settings restoration'; command = "$ps \`"$tool\`" -Action RestoreSettings -BackupPath &lt;backup folder&gt;"; sideEffects = $true } }
        if ($C.Config['drivers']['enabled']) { $a += [ordered]@{ id = 'AddDrivers'; label = 'Provide a verified driver package'; command = "$ps \`"$tool\`" -Action AddDrivers -DriverPath &lt;folder&gt;"; sideEffects = $true } }
        $a += [ordered]@{ id = 'ExportDiagnostics'; label = 'Export diagnostics'; command = "$ps \`"$me\`" -Mode ExportDiagnostics"; sideEffects = $false }
    }
    @{ toolAvailable = $has; actions = $a }
}

function Get-WdhOutstanding {
    param($C)
    $out = @()
    foreach ($a in $C.Apps) {
        if ($a.result -in 'InstalledVerified', 'AlreadyInstalledVerified', 'InstalledManually', 'SkippedByUser', 'InstalledVersionDiffers') { continue }
        $f = @($C.Findings | Where-Object { $_.id -eq $a.findingId }) | Select-Object -First 1
        if (-not $f -or $f.status -in 'Pass', 'Info', 'NotApplicable') { continue }
        $out += , [ordered]@{ operationId = $(if ($a.kind -eq 'additional' -or $a.key -like 'additional:*') { "additional:$($a.key.Substring(11))" } else { "app:$($a.key)" }); name = $a.name; lifecycle = $(if ($a.lifecycle) { $a.lifecycle } else { $a.result }); action = [string] $f.nextAction; retryable = ($f.recoveryAction -eq 'RetryFailed') }
    }
    foreach ($s in @($C.Snapshot.stages)) { if ($s.state -ne 'Final') { $out += , [ordered]@{ operationId = "stage:$($s.id)"; name = [string] $s.name; lifecycle = [string] $s.state; action = 'resume'; retryable = $true } } }
    return $out
}

# ------------------------------------------------------------------------------------------------
# Writing the reports, history and comparison
# ------------------------------------------------------------------------------------------------

function Write-WdhText { param([string] $Path, [string] $Text) $dir = Split-Path -Parent $Path; if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }; [IO.File]::WriteAllText($Path, $Text, (New-Object Text.UTF8Encoding($false))) }

function ConvertTo-WdhHtml {
    param([string] $Template, $Data)
    $json = ($Data | ConvertTo-Json -Depth 12 -Compress)
    $json = $json.Replace('&lt;', '\\u003c').Replace('&gt;', '\\u003e').Replace('&amp;', '\\u0026')
    return $Template.Replace('__WDB_HEALTH_DATA__', $json)
}

function Get-WdhProblemIds { param($Report) @(@(ConvertTo-WdhList $Report['findings']) | Where-Object { $_ -is [System.Collections.IDictionary] -and [string] $_['status'] -notin 'Pass', 'Info', 'NotApplicable' } | ForEach-Object { [string] $_['id'] }) }

function Save-WdhHistory {
    param($C, [string] $Dir, [string] $Current)
    $hist = Join-Path $Dir 'history'
    $prev = $null
    if (Test-Path -LiteralPath $Current) {
        $prev = Read-WddJson $Current
        if (-not (Test-Path -LiteralPath $hist)) { New-Item -ItemType Directory -Path $hist -Force | Out-Null }
        $stamp = $(if ($prev -and $prev['generatedUtc']) { (ConvertTo-WddDate $prev['generatedUtc']).ToString('yyyyMMdd-HHmmss') } else { (Get-WdhTime).ToString('yyyyMMdd-HHmmss') })
        $name = "deployment-health-$stamp-$(if ($prev -and $prev['overall'] -is [hashtable]) { [string] $prev['overall']['status'] } else { 'Unknown' }).json"
        $target = Join-Path $hist $name
        $n = 1
        while (Test-Path -LiteralPath $target) { $n++; $target = Join-Path $hist ($name -replace '\\.json$', "-$n.json") }
        Move-Item -LiteralPath $Current -Destination $target
    } elseif (Test-Path -LiteralPath $hist) {
        # A restart between archiving and writing leaves no current report: compare with the newest archived one.
        $last = @(Get-ChildItem -LiteralPath $hist -Filter 'deployment-health-*.json' -File -ErrorAction SilentlyContinue | Sort-Object Name) | Select-Object -Last 1
        if ($last) { $prev = Read-WddJson $last.FullName }
    }
    # Keep the first report ever (the original record) and the newest ones.
    $limit = [int] $C.Config['options']['historyLimit']
    if ($limit -lt 2) { $limit = 2 }
    $files = @(Get-ChildItem -LiteralPath $hist -Filter 'deployment-health-*.json' -File -ErrorAction SilentlyContinue | Sort-Object Name)
    if ($files.Count -gt $limit) { foreach ($f in $files[1..($files.Count - $limit)]) { Remove-Item -LiteralPath $f.FullName -Force } }
    $list = @(@(Get-ChildItem -LiteralPath $hist -Filter 'deployment-health-*.json' -File -ErrorAction SilentlyContinue | Sort-Object Name) | ForEach-Object {
        $m = [regex]::Match($_.Name, '^deployment-health-(\\d{8})-(\\d{6})-([A-Za-z]+)')
        [ordered]@{ file = "history\\$($_.Name)"; generatedUtc = $(if ($m.Success) { [DateTime]::ParseExact($m.Groups[1].Value + $m.Groups[2].Value, 'yyyyMMddHHmmss', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy-MM-ddTHH:mm:ssZ') } else { '' }); status = $(if ($m.Success) { $m.Groups[3].Value } else { '' }) }
    })
    return @{ Previous = $prev; History = $list }
}

function Get-WdhComparison {
    param($Previous, [object[]] $Findings)
    if (-not ($Previous -is [hashtable]) -or -not ($Previous['overall'] -is [hashtable])) { return $null }
    $before = @(Get-WdhProblemIds $Previous)
    $now = @($Findings | Where-Object { $_.status -notin 'Pass', 'Info', 'NotApplicable' } | ForEach-Object { $_.id })
    [ordered]@{
        previousStatus = [string] $Previous['overall']['status']; previousUtc = [string] $Previous['generatedUtc']; previousVerificationId = [string] $Previous['verificationId']
        resolved = @($before | Where-Object { $_ -notin $now }); new = @($now | Where-Object { $_ -notin $before }); remaining = @($now | Where-Object { $_ -in $before })
    }
}

# ------------------------------------------------------------------------------------------------
# Verify
# ------------------------------------------------------------------------------------------------

function New-WdhContext {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Config, [switch] $ScanUpdates)
    $read = Read-WddDeploymentState $Paths
    $identity = Get-WddIdentity
    $snap = $(if ($read.State) { Get-WddSnapshot $Manifest $Paths $read.State } else { [ordered]@{ stages = @(); allFinal = $false; outcome = 'FailedToInitialize'; outcomeCode = 50; outcomeDetail = ''; restartPending = $false } })
    $user = ''
    if ($read.State -and $read.State['stages'] -is [hashtable] -and $read.State['stages'].ContainsKey('applications') -and $read.State['stages']['applications'] -is [hashtable]) { $user = [string] $read.State['stages']['applications']['user'] }
    if (-not $user -and $read.State) { $user = [string] $read.State['initializedBy'] }
    if (-not $user -and $Config['account']['username']) { $user = "$($env:COMPUTERNAME)\\$($Config['account']['username'])" }
    $sid = Resolve-WdhSid $user
    $hive = $(if ($sid) { [bool] (Test-WdhUserHive $sid) } else { $false })
    @{
        Manifest = $Manifest; Paths = $Paths; Config = $Config; StateRead = $read; Snapshot = $snap; Identity = $identity
        DeploymentUser = $(if ($user) { $user } else { 'the deployment user' }); DeploymentSid = $sid; HiveLoaded = $hive
        SameUser = $(if ($identity.IsSystem -or -not $user) { $null } else { $identity.Name -ieq $user })
        ScanUpdates = [bool] $ScanUpdates
        Findings = New-Object System.Collections.Generic.List[object]; Sources = New-Object System.Collections.Generic.List[object]
        Apps = New-Object System.Collections.Generic.List[object]; Manual = New-Object System.Collections.Generic.List[object]; Custom = New-Object System.Collections.Generic.List[object]
        Limitations = New-Object System.Collections.Generic.List[string]; Obs = @{}; Backups = [ordered]@{ retained = 0; bytes = 0; location = ''; requiredForOutstanding = $false; cleanup = '' }
    }
}

&lt;#
    Verifies the deployment and writes the reports. Returns @{ Status; ExitCode; Report; Paths }.
    Nothing outside &lt;dataRoot&gt;\\reports\\health is written.
#&gt;
function Invoke-WdhVerify {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Config, [string] $Trigger = 'Technician', [switch] $ScanUpdates)
    $script:WdhNow = Get-WddNow
    $C = New-WdhContext $Manifest $Paths $Config -ScanUpdates:$ScanUpdates
    foreach ($t in 'Test-WdhDeployment', 'Test-WdhWindows', 'Test-WdhAccounts', 'Test-WdhUpdates', 'Test-WdhApplications', 'Test-WdhRestoration', 'Test-WdhDrivers', 'Test-WdhSecurity', 'Test-WdhNetwork', 'Test-WdhStorage', 'Test-WdhCustomizations') {
        try { &amp; $t $C } catch {
            $cat = @{ 'Test-WdhDeployment' = 'recovery'; 'Test-WdhWindows' = 'windows'; 'Test-WdhAccounts' = 'accounts'; 'Test-WdhUpdates' = 'updates'; 'Test-WdhApplications' = 'applications'; 'Test-WdhRestoration' = 'restoration'; 'Test-WdhDrivers' = 'drivers'; 'Test-WdhSecurity' = 'security'; 'Test-WdhNetwork' = 'network'; 'Test-WdhStorage' = 'storage'; 'Test-WdhCustomizations' = 'customizations' }[$t]
            Add-WdhFinding $C "$cat.checkError" $cat "$($script:WdhCategoryNames[$cat]) check" 'Unverifiable' 'Error' 'The check completes' "The check stopped: $($_.Exception.Message)" $t 'DeploymentHealth.ps1' 'Run the check again; report this message if it repeats.' | Out-Null
        }
    }
    # ToArray: @() on a generic List can fail in Windows PowerShell 5.1 ("Argument types do not match").
    $findings = $C.Findings.ToArray()
    # Stable ids: a duplicate id would make reverification ambiguous.
    $seen = @{}
    foreach ($f in $findings) { if ($seen.ContainsKey($f.id)) { $n = 2; while ($seen.ContainsKey("$($f.id)-$n")) { $n++ }; $f.id = "$($f.id)-$n" }; $seen[$f.id] = $true }
    $status = Get-WdhOverall $findings
    $text = Get-WdhOverallText $status $findings
    $os = $(if ($C.Obs['os']) { $C.Obs['os'] } else { @{ caption = ''; editionId = ''; displayVersion = ''; build = 0; ubr = 0; architecture = ''; productType = 0 } })
    $names = $C.Obs['computerName']
    $osBlock = [ordered]@{ computerName = $(if ($names -and $names.active) { [string] $names.active } else { [string] $env:COMPUTERNAME }); caption = [string] $os.caption; editionId = [string] $os.editionId; displayVersion = [string] $os.displayVersion; build = $(if ($os.build) { "$($os.build).$($os.ubr)" } else { '' }); architecture = [string] $os.architecture; productType = [int] $os.productType }
    $dir = Join-Path $Paths.Root ([string] $Config['reportDir'])
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    $current = Join-Path $dir 'deployment-health.json'
    $h = Save-WdhHistory $C $dir $current
    $limitations = @($C.Limitations | Select-Object -Unique)
    $limitations += 'Verification is read-only and tested with simulated computers; physical validation on real hardware is outstanding.'
    $limitations += 'Applications are found by their uninstall records, Store packages or portable shortcut; an installer that registers none is reported as uncertain, never as missing on that basis alone.'
    $report = [ordered]@{
        format = 'windows-deployment-builder/deployment-health'; schemaVersion = 1; engineVersion = $script:WdhVersion
        verificationId = ([guid]::NewGuid().ToString('N')).Substring(0, 16); deploymentId = [string] $Manifest.packageId; generatedUtc = $script:WdhNow.ToString('o'); trigger = $Trigger; readOnly = $true
        context = [ordered]@{ runAs = $(if ($C.Identity.IsSystem) { 'SYSTEM' } else { [string] $C.Identity.Name }); deploymentUser = [string] $C.DeploymentUser; sameUser = $C.SameUser
                              userContext = $(if (-not @(@(ConvertTo-WdhList $Config['applications']['items']) + @(ConvertTo-WdhList $Config['customizations'])).Count) { 'NotNeeded' } elseif ($C.HiveLoaded) { 'Available' } else { 'Deferred' }) }
        os = $osBlock
        overall = [ordered]@{ status = $status; title = $text[0]; summary = $text[1]; readyForDelivery = ($status -in 'Ready', 'ReadyWithWarnings'); exitCode = $script:WdhExitCodes[$status] }
        categories = @(Get-WdhCategories $C)
        findings = $findings
        applications = $C.Apps.ToArray()
        outstanding = @(Get-WdhOutstanding $C)
        manualActions = @($C.Manual | Group-Object { $_.id } | ForEach-Object { $_.Group[0] })
        checklist = @(Get-WdhChecklist $C)
        recovery = (Get-WdhRecoveryActions $C)
        backups = $C.Backups
        customizations = $C.Custom.ToArray()
        sources = $C.Sources.ToArray()
        limitations = @($limitations)
        comparison = (Get-WdhComparison $h.Previous $findings)
        history = @($h.History)
    }
    Write-WddJson $current $report
    $template = Join-Path $Paths.Package 'scripts\\health\\HealthReport.html'
    if (-not (Test-Path -LiteralPath $template)) { $template = Join-Path $script:WdhScriptRoot 'HealthReport.html' }
    if (Test-Path -LiteralPath $template) {
        $tpl = [IO.File]::ReadAllText($template, [Text.Encoding]::UTF8)
        if ($Config['options']['technicianReport']) { Write-WdhText (Join-Path $dir 'technician-report.html') (ConvertTo-WdhHtml $tpl ([ordered]@{ mode = 'technician'; report = $report })) }
        if ($Config['options']['customerReport']) {
            $handoff = Get-WdhCustomerHandoff $C $status $osBlock
            Write-WddJson (Join-Path $dir 'customer-handoff.json') $handoff
            Write-WdhText (Join-Path $dir 'customer-handoff.html') (ConvertTo-WdhHtml $tpl ([ordered]@{ mode = 'customer'; handoff = $handoff }))
        }
    } else { Write-WddLog 'Health report template missing; only deployment-health.json was written.' 'WARN' }
    $eventId = @{ Ready = 5000; ReadyWithWarnings = 5001; NeedsAttention = 5002; Incomplete = 5003; Unverifiable = 5004; Failed = 5005 }[$status]
    if ($Trigger -ne 'Test') { Write-WddEvent $eventId "Deployment $($Manifest.packageId) verified: $status. $($text[1]) Report: $current" $(if ($status -in 'Ready', 'ReadyWithWarnings') { 'Information' } elseif ($status -eq 'Failed') { 'Error' } else { 'Warning' }) }
    Write-WddLog "Health verification ($Trigger): $status. $($findings.Count) finding(s). Report: $current"
    return @{ Status = $status; ExitCode = $script:WdhExitCodes[$status]; Report = $report; Path = $current; Directory = $dir }
}

&lt;#
    Called by Complete-Deployment.ps1 when the deployment ends: verifies (read-only), and when a
    restart is pending registers a startup re-check that removes itself afterwards.
#&gt;
function Invoke-WdhAfterDeployment {
    param([hashtable] $Manifest, [hashtable] $Paths)
    # The verified staged copy of the plan (the monitor checked the package before calling this).
    $cfgPath = Join-Path $Paths.Package 'scripts\\health\\health-config.json'
    if (-not (Test-Path -LiteralPath $cfgPath)) { $cfgPath = Join-Path $script:WdhScriptRoot 'health-config.json' }
    $cfg = Read-WddJson $cfgPath
    if (-not $cfg) { Write-WddLog "Health verification skipped: $cfgPath is missing or unreadable." 'WARN'; return $null }
    $r = Invoke-WdhVerify $Manifest $Paths $cfg 'DeploymentComplete'
    $restart = @($r.Report.findings | Where-Object { $_.status -eq 'Pending' -and ($_.id -eq 'windows.restart' -or $_.id -like 'drivers.restart.*' -or $_.id -eq 'identity.computerName') }).Count -gt 0
    if ($restart) {
        try { Register-WdhRecheckTask (Join-Path $script:WdhScriptRoot 'DeploymentHealth.ps1'); Write-WdhRecheckState $Paths $cfg 0 } catch { Write-WddLog "Could not register the health re-check after restart: $($_.Exception.Message)" 'WARN' }
    }
    return $r
}

function Write-WdhRecheckState { param([hashtable] $Paths, $Config, [int] $Runs) Write-WddJson (Join-Path (Join-Path $Paths.Root ([string] $Config['reportDir'])) 'recheck.json') ([ordered]@{ runs = $Runs; updatedUtc = (Get-WddNow).ToString('o') }) }

&lt;# Startup re-check: verifies again; removes its task once no restart is pending, or after the configured number of runs. #&gt;
function Invoke-WdhStartupRecheck {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Config)
    $statePath = Join-Path (Join-Path $Paths.Root ([string] $Config['reportDir'])) 'recheck.json'
    $s = Read-WddJson $statePath
    $runs = $(if ($s) { [int] $s['runs'] } else { 0 }) + 1
    $r = Invoke-WdhVerify $Manifest $Paths $Config 'Startup'
    $restart = @($r.Report.findings | Where-Object { $_.status -eq 'Pending' -and ($_.id -eq 'windows.restart' -or $_.id -like 'drivers.restart.*' -or $_.id -eq 'identity.computerName') }).Count -gt 0
    Write-WdhRecheckState $Paths $Config $runs
    if (-not $restart -or $runs -ge [int] $Config['options']['startupRechecks']) { try { Unregister-WdhRecheckTask } catch { } }
    return $r
}

# ------------------------------------------------------------------------------------------------
# Separately confirmed cleanup of the retained settings backup, and diagnostics
# ------------------------------------------------------------------------------------------------

function Invoke-WdhCleanupBackups {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Config, [string] $Confirm = '')
    $identity = Get-WddIdentity
    if (-not $identity.IsAdmin) { return @{ Outcome = 'NotElevated'; Message = 'Run as administrator.'; Removed = @() } }
    $plan = $Config['restoration']
    $folders = @(ConvertTo-WdhList (Get-WdhBackupFolders $Paths.Root))
    if (-not $folders.Count) { return @{ Outcome = 'NothingToDo'; Message = 'No retained settings backup on this computer.'; Removed = @() } }
    # Never while a restoration is outstanding: the backup is still needed.
    $r = Read-WddJson (Join-Path $Paths.Root 'Applications\\restoration.json')
    $open = @()
    if ($plan['required']) {
        if (-not $r) { $open += 'no restoration result yet' }
        else { foreach ($s in @(ConvertTo-WdhList $r['settings'])) { if ([string] $s['outcome'] -notin 'ConfigurationRestored', 'KeptExisting', 'ConfigurationPartiallyRestored', 'Unsupported', 'SkippedByUser', 'ManualActionRequired') { $open += "$($s['name']) ($($s['outcome']))" } } }
    }
    $total = 0; foreach ($f in $folders) { $total += [double] $f.bytes }
    $list = "$($folders.Count) folder(s), $(Format-WdhBytes $total) below $(Join-Path $Paths.Root 'Backup')"
    if ($open.Count) { return @{ Outcome = 'Refused'; Message = "The backup is still needed for outstanding restoration: $($open -join ', '). Nothing was removed."; Removed = @() } }
    $id = [string] $plan['backupId']
    if (-not $Confirm -or ($id -and $Confirm -ne $id) -or (-not $id -and $Confirm -ne 'REMOVE')) {
        return @{ Outcome = 'ConfirmationRequired'; Message = "Retained: $list. To remove it (the USB or source copy is never touched), run again with -ConfirmCleanup $(if ($id) { $id } else { 'REMOVE' })."; Removed = @() }
    }
    $root = [IO.Path]::GetFullPath((Join-Path $Paths.Root 'Backup')).TrimEnd('\\') + '\\'
    $removed = @()
    foreach ($f in $folders) {
        $full = [IO.Path]::GetFullPath($f.path)
        $item = Get-Item -LiteralPath $full -Force
        if (-not $full.StartsWith($root, [StringComparison]::OrdinalIgnoreCase) -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { continue }
        Remove-Item -LiteralPath $full -Recurse -Force
        $removed += $f.name
    }
    Write-WddLog "Retained settings backup removed by $($identity.Name) after confirmation: $($removed -join ', ')." 'WARN'
    Write-WddEvent 5010 "Retained settings backup removed by $($identity.Name): $($removed -join ', ')." 'Information'
    return @{ Outcome = 'Done'; Message = "Removed $($removed.Count) staged backup folder(s). The original backup on your drive was not touched."; Removed = $removed }
}

&lt;# Entries of a diagnostics ZIP that may be shared: relative paths, known text types, never a backup or an answer file. #&gt;
function Test-WdhArchiveEntry {
    param([string] $Name)
    $n = $Name.Replace('\\', '/')
    if (-not $n -or $n.StartsWith('/') -or $n -match '(^|/)\\.\\.(/|$)' -or $n -match ':' -or $n.Length -gt 240) { return $false }
    if ($n -match '(?i)(^|/)(backup|backups)(/|$)' -or $n -match '(?i)(unattend|autounattend)\\.xml$' -or $n -match '(?i)\\.(xml|wim|exe|msi|zip|reg|pfx|key)$') { return $false }
    return $n -match '(?i)\\.(json|jsonl|txt|log|1|done|bak|corrupt[-0-9]*)$' -or $n -match '(?i)\\.json\\.(bak|corrupt)'
}

function Test-WdhArchive {
    param([string] $Path)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $z = [IO.Compression.ZipFile]::OpenRead($Path)
    try { return @(@($z.Entries) | Where-Object { -not (Test-WdhArchiveEntry $_.FullName) } | ForEach-Object { $_.FullName }) } finally { $z.Dispose() }
}

function Invoke-WdhExport {
    param([hashtable] $Manifest, [hashtable] $Paths, [hashtable] $Config, [string] $OutputPath = '')
    $stamp = (Get-WddNow).ToString('yyyyMMdd-HHmmss')
    if (-not $OutputPath) { $OutputPath = Join-Path $Paths.Reports ("deployment-diagnostics-{0}-{1}.zip" -f $env:COMPUTERNAME, $stamp) }
    if ($OutputPath -notmatch '\\.zip$') { return @{ Outcome = 'Refused'; Message = 'The diagnostics file must end in .zip.'; Path = '' } }
    $tool = Join-Path $Paths.Package 'scripts\\recovery\\DeploymentRecovery.ps1'
    if (Test-Path -LiteralPath $tool) {
        $x = Invoke-WdhRecoveryExport $tool $OutputPath
        if ($x.exit -ne 0 -or -not (Test-Path -LiteralPath $OutputPath)) { return @{ Outcome = 'Failed'; Message = "The recovery tool could not export diagnostics: $($x.text)"; Path = '' } }
    } else {
        # Without the recovery tool: the health reports only (written by this engine, no secrets).
        $staging = Join-Path ([IO.Path]::GetTempPath()) ('wdh-diag-' + [guid]::NewGuid().ToString('N'))
        try {
            $dir = Join-Path $Paths.Root ([string] $Config['reportDir'])
            foreach ($f in @(Get-ChildItem -LiteralPath $dir -Filter '*.json' -File -Recurse -ErrorAction SilentlyContinue)) {
                $rel = $f.FullName.Substring($Paths.Root.TrimEnd('\\').Length + 1)
                $t = Join-Path $staging $rel
                New-Item -ItemType Directory -Path (Split-Path -Parent $t) -Force | Out-Null
                Copy-Item -LiteralPath $f.FullName -Destination $t
            }
            if (Test-Path -LiteralPath $OutputPath) { Remove-Item -LiteralPath $OutputPath -Force }
            Add-Type -AssemblyName System.IO.Compression.FileSystem
            [IO.Compression.ZipFile]::CreateFromDirectory($staging, $OutputPath)
        } finally { Remove-Item -LiteralPath $staging -Recurse -Force -ErrorAction SilentlyContinue }
    }
    $bad = @(Test-WdhArchive $OutputPath)
    if ($bad.Count) { Remove-Item -LiteralPath $OutputPath -Force; return @{ Outcome = 'Refused'; Message = "The archive contained entries that must not be shared ($($bad -join ', ')); it was deleted."; Path = '' } }
    return @{ Outcome = 'Done'; Message = "Diagnostics: $OutputPath (sanitized; no backups, answer files or passwords). Nothing was sent anywhere."; Path = $OutputPath }
}

# ------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------

if ($script:WdhMain) {
    $a = $script:WdhArgs
    $package = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
    try { $manifest = Read-WddManifest (Join-Path $package 'deployment-manifest.json') } catch { Write-Output "Unverifiable: $($_.Exception.Message)"; exit 50 }
    $config = Read-WddJson (Join-Path $PSScriptRoot 'health-config.json')
    if (-not $config) { Write-Output 'Unverifiable: health-config.json is missing or damaged.'; exit 50 }
    $paths = Get-WddPaths $manifest.dataRoot
    $id = Get-WddIdentity
    if ($a.Elevate -and -not $id.IsAdmin) {
        $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'
        Start-Process -FilePath $ps -Verb RunAs -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', "\`"$PSCommandPath\`"", '-Mode', $a.Mode)
        exit 0
    }
    if (-not $id.IsAdmin -and $a.Mode -in 'Verify', 'Dashboard') { Write-Output 'Note: not running as administrator; some checks (accounts, encryption, Store packages) may be reported as not verifiable.' }
    try { Initialize-WddLogging $paths } catch { }
    switch ($a.Mode) {
        'CleanupBackups' { $r = Invoke-WdhCleanupBackups $manifest $paths $config $a.ConfirmCleanup; Write-Output "CleanupBackups: $($r.Outcome). $($r.Message)"; exit $(if ($r.Outcome -eq 'Done') { 0 } elseif ($r.Outcome -eq 'NotElevated') { 4 } else { 1 }) }
        'ExportDiagnostics' { $r = Invoke-WdhExport $manifest $paths $config $a.OutputPath; Write-Output "ExportDiagnostics: $($r.Outcome). $($r.Message)"; exit $(if ($r.Outcome -eq 'Done') { 0 } else { 1 }) }
        default {
            $r = $(if ($a.Trigger -eq 'Startup') { Invoke-WdhStartupRecheck $manifest $paths $config } else { Invoke-WdhVerify $manifest $paths $config $a.Trigger -ScanUpdates:$a.ScanUpdates })
            if ($a.Json) { $r.Report | ConvertTo-Json -Depth 12 } else {
                Write-Output "Deployment health: $($r.Status) - $($r.Report.overall.summary)"
                foreach ($k in $r.Report.categories) { Write-Output ('  {0,-32} {1}' -f $k.name, $k.status) }
                Write-Output "Report: $(Join-Path $r.Directory 'technician-report.html')"
            }
            if ($a.Mode -eq 'Dashboard') { try { Open-WdhReport (Join-Path $r.Directory 'technician-report.html') } catch { Write-Output "Open the report by hand: $($_.Exception.Message)" } }
            exit $r.ExitCode
        }
    }
}
		</File>
