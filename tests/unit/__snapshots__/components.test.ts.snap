		<File path="C:\\Windows\\Setup\\Scripts\\Deployment\\scripts\\health\\HealthReport.html">
&lt;!doctype html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
&lt;meta charset="utf-8"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1"&gt;
&lt;title&gt;Windows Deployment Health Report&lt;/title&gt;
&lt;!--
  Windows Deployment Builder - deployment health report template (Phase 9).
  DeploymentHealth.ps1 replaces the data placeholder below with the verified results and writes
  technician-report.html and customer-handoff.html. Works offline from the local disk: no external
  files, fonts or scripts. Every value is inserted as text, never as HTML.
--&gt;
&lt;style&gt;
:root {
  --bg: #f6f7f9; --surface: #ffffff; --text: #1d2330; --muted: #5b6475; --line: #d9dde5;
  --ok: #1f7a3f; --ok-bg: #e6f4ea; --warn: #8a5a00; --warn-bg: #fff4d6; --bad: #b42318; --bad-bg: #fde8e7;
  --wait: #1f4fa8; --wait-bg: #e5eefc; --unk: #5a3e9e; --unk-bg: #efe9fb; --na: #5b6475; --na-bg: #eef0f3;
  --accent: #1f4fa8; --code: #f0f2f5;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12151b; --surface: #1b2029; --text: #e6e9ef; --muted: #a2abbb; --line: #313847;
    --ok: #6fd391; --ok-bg: #173523; --warn: #f2c35b; --warn-bg: #3a2e12; --bad: #ff8a80; --bad-bg: #42201e;
    --wait: #8fb4ff; --wait-bg: #1c2a46; --unk: #c3a8ff; --unk-bg: #2c2346; --na: #a2abbb; --na-bg: #262c37;
    --accent: #8fb4ff; --code: #232a35;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 "Segoe UI", system-ui, -apple-system, sans-serif; }
main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 26px; margin: 0 0 4px; }
h2 { font-size: 19px; margin: 28px 0 10px; }
h3 { font-size: 16px; margin: 0; }
p { margin: 6px 0; }
a { color: var(--accent); }
.muted { color: var(--muted); }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px; }
.sample { background: var(--warn-bg); color: var(--warn); border: 2px dashed var(--warn); border-radius: 10px; padding: 10px 14px; font-weight: 600; margin-bottom: 16px; }
.overall { display: flex; gap: 16px; align-items: flex-start; border-left: 8px solid var(--na); }
.overall .badge { font-size: 13px; }
.overall h2 { margin: 2px 0 6px; font-size: 22px; }
.st-Ready, .st-Verified, .st-Pass, .st-done { --c: var(--ok); --cb: var(--ok-bg); }
.st-ReadyWithWarnings, .st-Warning { --c: var(--warn); --cb: var(--warn-bg); }
.st-NeedsAttention, .st-Fail, .st-Failed, .st-notDone { --c: var(--bad); --cb: var(--bad-bg); }
.st-Incomplete, .st-Pending, .st-pending { --c: var(--wait); --cb: var(--wait-bg); }
.st-Unverifiable, .st-Deferred, .st-confirm { --c: var(--unk); --cb: var(--unk-bg); }
.st-NotApplicable, .st-Info, .st-notApplicable { --c: var(--na); --cb: var(--na-bg); }
.overall[class*="st-"] { border-left-color: var(--c); }
.badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 600; font-size: 12px; color: var(--c, var(--na)); background: var(--cb, var(--na-bg)); border: 1px solid var(--c, var(--line)); white-space: nowrap; }
.grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
.cat { display: block; text-decoration: none; color: inherit; border-top: 4px solid var(--c, var(--line)); }
.cat:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.cat .row { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
.list { list-style: none; margin: 0; padding: 0; }
.list li { padding: 10px 0; border-top: 1px solid var(--line); display: flex; gap: 10px; align-items: flex-start; }
.list li:first-child { border-top: 0; }
.list .body { flex: 1; min-width: 0; }
.next { margin-top: 4px; }
.next strong { font-weight: 600; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; vertical-align: top; padding: 8px 10px; border-top: 1px solid var(--line); }
th { color: var(--muted); font-weight: 600; font-size: 13px; }
details { margin-top: 10px; }
summary { cursor: pointer; font-weight: 600; padding: 6px 0; }
code, .cmd { font-family: Consolas, "Cascadia Mono", monospace; font-size: 13px; background: var(--code); padding: 2px 6px; border-radius: 4px; overflow-wrap: anywhere; }
.cmdrow { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 4px 0; }
button { font: inherit; padding: 4px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--text); cursor: pointer; }
.tools { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 10px; }
input[type="search"], select, textarea { font: inherit; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--text); }
input[type="search"] { min-width: 220px; flex: 1; }
textarea { width: 100%; min-height: 70px; }
.check { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; border-top: 1px solid var(--line); }
.check:first-child { border-top: 0; }
.kv { display: grid; grid-template-columns: minmax(130px, 220px) 1fr; gap: 4px 14px; }
.kv dt { color: var(--muted); }
.kv dd { margin: 0; overflow-wrap: anywhere; }
.cols { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
.big { font-size: 20px; font-weight: 600; }
footer { margin-top: 32px; font-size: 13px; color: var(--muted); }
@media (max-width: 600px) { .overall { flex-direction: column; } .kv { grid-template-columns: 1fr; } h1 { font-size: 22px; } }
@media print {
  body { background: #fff; color: #000; font-size: 12px; }
  main { max-width: none; padding: 0; }
  .card { break-inside: avoid; border-color: #999; }
  .tools, button, .noprint { display: none !important; }
  details { display: block; }
  details &gt; summary { list-style: none; }
  a { color: #000; }
}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;main id="app" aria-live="polite"&gt;&lt;noscript&gt;&lt;p&gt;This report needs JavaScript to display. The same results are in deployment-health.json next to this file.&lt;/p&gt;&lt;/noscript&gt;&lt;/main&gt;
&lt;script id="wdb-data" type="application/json"&gt;__WDB_HEALTH_DATA__&lt;/script&gt;
&lt;script&gt;
(function () {
  'use strict';
  var app = document.getElementById('app');
