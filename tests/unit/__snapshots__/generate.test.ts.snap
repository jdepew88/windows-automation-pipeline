  "coordination": {
    "policy": "updatesFirst",
    "description": "updatesFirst: preparation (network, WinGet check, package availability) may run while Windows Update works; application installation starts only after the Windows Update stage is final. Installing anything and scheduling a restart both require the install lock.",
    "installLock": "C:\\\\ProgramData\\\\WindowsDeploymentBuilder\\\\state\\\\install.lock",
    "restartMarker": "C:\\\\ProgramData\\\\WindowsDeploymentBuilder\\\\state\\\\restart-pending.json",
    "lockSemantics": "Exclusive file handle; released by Windows when the holder exits. restart-pending.json is valid only in the boot it was written in (and for 30 minutes)."
