{
  "format": "windows-deployment-builder/deployment-manifest",
  "manifestVersion": 1,
  "packageVersion": "1.0.0",
  "packageId": "D428DC2BC0534AAA",
  "scope": "answerFile",
  "generator": {
    "name": "Windows Deployment Builder",
    "orchestrator": "1.0.0",
    "windowsUpdateEngine": "1.1.0",
    "applicationEngine": "1.0.0"
  },
  "dataRoot": "C:\\\\ProgramData\\\\WindowsDeploymentBuilder",
  "packageFolder": "WindowsDeployment",
  "answerFile": {
    "fileName": "autounattend.xml",
    "location": "Root of the Windows installation USB drive",
    "foundAutomatically": true,
    "containsSecrets": false,
    "startsDeployment": true
  },
  "windows": {
    "edition": "Windows 11 Pro",
    "editionMode": "genericKey",
    "computerName": "Alex-Computer",
    "architectures": [
      "amd64"
    ],
    "diskSelection": "interactive"
  },
  "stages": [
    {
      "id": "staging",
      "order": 0,
      "name": "Verify and stage the package",
      "enabled": true,
      "implemented": true,
      "context": "user",
      "when": "Last FirstLogon command (or setup.cmd)",
