        "CompletedWithFailures",
        "Failed",
        "Offline"
      ],
      "waitsFor": [
        "windowsUpdate"
      ],
      "coordination": "updatesFirst",
      "requiresInternet": true
    },
    {
      "id": "drivers",
      "order": 3,
      "name": "Manufacturer drivers",
