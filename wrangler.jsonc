{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: serves the Vite build in dist/. No server code; generation runs in the browser.
  "name": "windows-automation-pipeline",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
